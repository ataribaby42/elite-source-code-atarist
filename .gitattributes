# Consistent new source files on Windows and in GitHub.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.m68 text eol=lf
*.s text eol=lf
*.def text eol=lf
*.ld text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Preserve original bytes, including historic text encodings and line endings.
src-orig/** -text linguist-vendored
src/assets/** binary
src/vendor/** binary linguist-vendored
tools/*.exe binary
