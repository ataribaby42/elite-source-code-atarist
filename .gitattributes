# Consistent new source files on Windows and in GitHub.
* text=auto
*.md text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.svg text eol=lf
.nojekyll text eol=lf
*.m68 text eol=lf linguist-language=Assembly
*.s text eol=lf
*.def text eol=lf
*.inc text eol=lf
*.ld text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation and the project website are not game implementation languages.
docs/** linguist-documentation
game-docs/** linguist-documentation

# Original-version converted sources use the text rules above.
src_orig/asm/** text eol=lf linguist-vendored
src_orig/assets/** binary
# Preserve historical archives and binary assets byte for byte.
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
src_atari/assets/** binary
src_amiga/assets/** binary
src_atari/vendor/** binary linguist-vendored
tools/*.exe binary
*.adf binary
*.ADF binary
*.st binary
*.ST binary

tools/vasmm68k_mot binary
tools/vlink binary
