    dc.w -11585,11585
    dc.w -12665,10394
    dc.w -13623,9102
    dc.w -14449,7723
    dc.w -15137,6270
    dc.w -15679,4756
    dc.w -16069,3196
    dc.w -16305,1606
    dc.w -16384,0
    dc.w -16305,-1606
    dc.w -16069,-3196
    dc.w -15679,-4756
    dc.w -15137,-6270
    dc.w -14449,-7723
