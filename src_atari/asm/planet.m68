    dc.w 4756,15679
    dc.w 3196,16069
    dc.w 1606,16305
    dc.w 0,16384
    dc.w -1606,16305
    dc.w -3196,16069
    dc.w -4756,15679
    dc.w -6270,15137
    dc.w -7723,14449
