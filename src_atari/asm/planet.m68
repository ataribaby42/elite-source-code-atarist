    include "common.def"
    include "macros.m68"
    xref begin_polygon_batch,end_polygon_batch

; Seeded surface markings on a sphere. Q12 geometry, Q14 object orientation.
; The globe retains the flight renderer's circular, orthographic silhouette.
; Its viewing axis follows the actual eye-to-centre direction in all four views.
; Flight and Planet Data maps are cached separately; gameplay RNG never advances.
    xref sqrt,calc_yvector,set_colour,c_solid_polygon,c_line,solid_polygon
    xref set_planet_colour,draw_point,w_swap_front,comm_now

ps_features: equ 6 ; maximum seeded continents or craters
ps_land_vertices: equ 8
ps_points: equ 13 ; centre, eight crater rim vertices and four rays
ps_feature_bytes: equ ps_points*6
ps_min_radius: equ 12 ; details start at a 24-pixel diameter

    q_vars planet_surface
ps_map: rs.b ps_features*ps_feature_bytes
ps_rng: rs.l 1
ps_kind: rs.w 1 ; 0 = plain, 1 = crater outlines, 2 = filled regions
ps_ink: rs.w 1
ps_radius: rs.w 1
ps_size: rs.w 1
ps_aspect: rs.w 1
ps_cos: rs.w 1
ps_sin: rs.w 1
ps_active: rs.w 1
ps_vertices: rs.w 1 ; outline/ray points per feature, excluding its centre
ps_spin_minutes: rs.w 1 ; seeded sidereal period: 30..120 status-clock minutes
ps_spin_direction: rs.w 1 ; seeded local yaw: +1 or -1
ps_cache_bytes: equ __RS-ps_map ; immutable geometry and its seeded parameters
ps_rim_radii: rs.w 8
ps_feature: rs.w 1
ps_vertex: rs.w 1
ps_colour: rs.l 4
ps_source: rs.l 1
ps_dest: rs.l 1
ps_centre: rs.w 3
ps_tangent: rs.w 3
ps_bitangent: rs.w 3
ps_eye: rs.w 3
ps_right: rs.w 3
ps_up: rs.w 3
ps_matrix: rs.w 9
ps_view_points: rs.w ps_points*3
ps_triangle: rs.w 9
ps_clipped: rs.w 12
ps_count: rs.w 1
ps_nodes: rs.b 12*node_len
ps_segment: rs.w 6
ps_line: rs.w 4
; Per-feature projection cache. Negative IDs denote newly clipped vertices.
; Include it in the portrait backup so Planet Data preserves all flight state.
ps_projected: rs.w ps_points*2
ps_triangle_ids: rs.w 3
ps_clipped_ids: rs.w 4
ps_work_bytes: equ __RS-ps_map
ps_portrait_backup: rs.b ps_work_bytes
ps_portrait_object: rs.b obj_len
ps_portrait_destination: rs.l 1
ps_portrait_colours: rs.w 1 ; palette indices needed by the last portrait
ps_portrait_cache: rs.b ps_cache_bytes
ps_portrait_base: rs.w 1
ps_portrait_cached: rs.w 1
ps_portrait_phase: rs.w 1 ; unsigned full turn = 65536
ps_portrait_tick: rs.l 1 ; last preview frame, hardware flybacks
ps_portrait_cursor_end: rs.l 1 ; end of the saved cursor's screen rows
ps_portrait_cursor_stride: rs.w 1 ; bytes per saved row (per plane on Amiga)
ps_portrait_top: rs.w 1 ; first destination row, in logical pixels
ps_portrait_dirty: rs.w 81 ; changed 16-pixel groups per row
ps_portrait_dirty_row: rs.l 1
ps_portrait_word_changed: rs.w 1
    q_end_vars planet_surface

    q_module planet_surface

; Planet Data portrait. D0/D1 = logical screen centre, radius 40 pixels.
; Return D0 = palette-index mask; preserve all other registers.
; Use the same invisible-screen scratch as the old texture path, then copy
; only globe pixels inside a bounded rectangle. Preserve flight state and arrival yaw.
    q_subr draw_planet_portrait,global
    movem.l d0-d7/a0-a5,-(sp)
    clr.w ps_portrait_phase(a6)
    clr.w ps_portrait_cached(a6)
    jsr comm_now
    move.l d0,ps_portrait_tick(a6)
    movem.l (sp),d0-d1
    bra.s ps_portrait_render

; One accelerated preview step per game frame, capped by the game's three-VBL
; minimum frame interval when docked. Never catch up with a burst of frames.
    q_subr animate_planet_portrait,global
    movem.l d0-d7/a0-a5,-(sp)
    tst.w ps_portrait_cached(a6)
    beq.s .done
    jsr comm_now
    move.l d0,d1
    sub.l ps_portrait_tick(a6),d0
    cmp.l #3,d0
    blo.s .done
    move.l d1,ps_portrait_tick(a6)
    move.w ps_portrait_cache+ps_spin_direction-ps_map(a6),d0
    asl.w #8,d0 ; 1/256 turn per rendered frame, in the real planet's direction
    add.w d0,ps_portrait_phase(a6)
    movem.l (sp),d0-d1
    bra.s ps_portrait_render
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

ps_portrait_render:
    ; VBL input and cursor drawing continue on the visible page during rendering.
    move.l scr_base(a6),ui_scr_base(a6)
    move.l colour_ptr(a6),-(sp)
    move.w sun_flare(a6),-(sp)
    move.l w_view_ptr(a6),-(sp)
    move.l scr_base(a6),-(sp)
    sub.w #48,d0
    sub.w #40,d1
    move.w d1,ps_portrait_top(a6)
    lsr.w #1,d0 ; ST interleaved planes: eight bytes per 16 pixels
    and.l #$ffff,d0 ; callers supply word coordinates; discard stale upper bits
    mulu.w #160,d1
    add.l d1,d0
    add.l scr_base(a6),d0
    move.l d0,ps_portrait_destination(a6)
    lea ps_map(a6),a0
    lea ps_portrait_backup(a6),a1
    move.w #ps_work_bytes/2-1,d7
.save_map:
    move.w (a0)+,(a1)+
    dbra d7,.save_map
    lea ps_portrait_object(a6),a4
    move.l a4,a0
    move.w #obj_len/2-1,d7
.clear_object:
    clr.w (a0)+
    dbra d7,.clear_object
    move.w #planet,type(a4)
    move.l #100000,this_zpos(a4)
    move.w #41,scr_radius(a4)
    tst.w ps_portrait_cached(a6)
    bne .cached_map
    move.l splanet+seed(a6),-(sp)
    move.w splanet+seed+4(a6),-(sp)
    move.w current(a6),-(sp)
    move.l cplanet+seed(a6),splanet+seed(a6)
    move.w cplanet+seed+4(a6),splanet+seed+4(a6)
    move.w req_planet(a6),current(a6)
    jsr set_planet_colour ; use the existing galaxy/planet colour lookup
    bsr init_planet_surface ; identity orientation, without arrival rotation
    move.w obj_colour(a4),ps_portrait_base(a6)
    moveq #0,d0
    move.w obj_colour(a4),d1
    bset d1,d0
    tst.w ps_kind(a6)
    beq.s .portrait_colours_ready
    move.w ps_ink(a6),d1
    bset d1,d0
.portrait_colours_ready:
    move.w d0,ps_portrait_colours(a6)
    move.w (sp)+,current(a6)
    move.w (sp)+,splanet+seed+4(a6)
    move.l (sp)+,splanet+seed(a6)
    lea ps_map(a6),a0
    lea ps_portrait_cache(a6),a1
    move.w #ps_cache_bytes/2-1,d7
.cache_map:
    move.w (a0)+,(a1)+
    dbra d7,.cache_map
    st ps_portrait_cached(a6)
    bra.s .portrait_map_ready
.cached_map:
    lea ps_portrait_cache(a6),a0
    lea ps_map(a6),a1
    move.w #ps_cache_bytes/2-1,d7
.load_map:
    move.w (a0)+,(a1)+
    dbra d7,.load_map
    move.w #unit,x_vector+i(a4)
    move.w #unit,y_vector+j(a4)
    move.w #unit,z_vector+k(a4)
    bset #yvector_ok,flags(a4)
    ; The object's base colour is saved separately from the mutable workspace.
    move.w ps_portrait_base(a6),obj_colour(a4)
.portrait_map_ready:
    move.l #w_swap_front,w_view_ptr(a6)
    move.l scr_base(a6),d0
    move.l flip_screen(a6),d1
    eor.l d1,d0
    move.l d0,scr_base(a6)
    move.l d0,a0
    lea (y_top+y_max-40)*160+(x_left-x_min-48)/2(a0),a0
    moveq #80,d7
.clear_row:
    moveq #11,d6
.clear_words:
    clr.l (a0)+
    dbra d6,.clear_words
    lea 160-48(a0),a0
    dbra d7,.clear_row
    clr.w sun_flare(a6)
    lea ps_portrait_object(a6),a5
    move.w #planet,d0
    jsr draw_point
    ; Compose complete page pixels offscreen, including the cursor background.
    move.w csr_on(a6),-(sp)
    clr.w csr_on(a6)
    bsr ps_portrait_merge
    ; Keep the drawn cursor and its background stable through the short wait
    ; and transfer. VBL, sound and queued input continue normally.
    bsr ps_portrait_wait
    bsr ps_portrait_present
    move.w (sp)+,csr_on(a6)
    move.l (sp)+,scr_base(a6)
    clr.l ui_scr_base(a6)
    move.l (sp)+,w_view_ptr(a6)
    move.w (sp)+,sun_flare(a6)
    move.l (sp)+,colour_ptr(a6)
    lea ps_portrait_backup(a6),a0
    lea ps_map(a6),a1
    move.w #ps_work_bytes/2-1,d7
.restore_map:
    move.w (a0)+,(a1)+
    dbra d7,.restore_map
    movem.l (sp)+,d0-d7/a0-a5
    moveq #0,d0
    move.w ps_portrait_colours(a6),d0
    rts


; Snapshot the currently visible cursor's saved-background rectangle.
    q_subr ps_portrait_cursor_bounds
    lea cursor_spr(a6),a4
    movea.l #-1,a3
    btst #back_saved,sp_flags(a4)
    beq.s .none
    move.l buffer_ptr(a4),a2
    move.l video_ptr(a4),a3
    move.w sp_width(a4),d5
    addq.w #1,d5
    lsl.w #3,d5
    move.w d5,ps_portrait_cursor_stride(a6)
    move.w sp_depth(a4),d0
    addq.w #1,d0
    mulu.w #160,d0
    add.l a3,d0
    move.l d0,ps_portrait_cursor_end(a6)
    move.l a3,a4
    adda.w d5,a4
    rts
.none:
    move.l a3,a4
    rts

; Align the cursor's background row with the next portrait destination row.
    q_subr ps_portrait_cursor_row
.advance:
    cmpa.l a4,a1
    blo.s .done
    lea 160(a3),a3
    lea 160(a4),a4
    move.w ps_portrait_cursor_stride(a6),d5
    adda.w d5,a2
    cmpa.l ps_portrait_cursor_end(a6),a3
    blo.s .advance
    movea.l #-1,a3
    move.l a3,a4
.done:
    rts

; A5 is the page/background word corresponding to A1, never cursor artwork.
    q_subr ps_portrait_target
    move.l a1,a5
    cmpa.l a3,a1
    blo.s .done
    cmpa.l a4,a1
    bhs.s .done
    suba.l a3,a5
    adda.l a2,a5
.done:
    rts

; Complete all masked merging in the invisible source. The presentation pass
; then needs only direct copies, and cannot expose intermediate plane colours.
    q_subr ps_portrait_merge
    lea ps_portrait_dirty(a6),a0
    move.l a0,ps_portrait_dirty_row(a6)
    bsr ps_portrait_cursor_bounds
    move.l scr_base(a6),a0
    lea (y_top+y_max-40)*160+(x_left-x_min-48)/2(a0),a0
    move.l ps_portrait_destination(a6),a1
    move.w #80,d7
.row:
    move.l ps_portrait_dirty_row(a6),a5
    clr.w (a5)
    bsr ps_portrait_cursor_row
    move.w #5,d6
.word:
    clr.w ps_portrait_word_changed(a6)
    bsr ps_portrait_target
    movem.w (a0)+,d0-d3
    move.w d0,d4
    or.w d1,d4
    or.w d2,d4
    or.w d3,d4
    not.w d4
    move.w d6,-(sp)
    move.w (a5),d6
    and.w d4,d6
    or.w d6,d0
    cmp.w (a5)+,d0
    beq.s .unchanged_0
    st ps_portrait_word_changed(a6)
.unchanged_0:
    move.w (a5),d6
    and.w d4,d6
    or.w d6,d1
    cmp.w (a5)+,d1
    beq.s .unchanged_1
    st ps_portrait_word_changed(a6)
.unchanged_1:
    move.w (a5),d6
    and.w d4,d6
    or.w d6,d2
    cmp.w (a5)+,d2
    beq.s .unchanged_2
    st ps_portrait_word_changed(a6)
.unchanged_2:
    move.w (a5),d6
    and.w d4,d6
    or.w d6,d3
    cmp.w (a5)+,d3
    beq.s .unchanged_3
    st ps_portrait_word_changed(a6)
.unchanged_3:
    movem.w d0-d3,-8(a0)
    move.w (sp)+,d6
    tst.w ps_portrait_word_changed(a6)
    beq.s .unchanged_word
    move.l ps_portrait_dirty_row(a6),a5
    move.w (a5),d4
    bset d6,d4
    move.w d4,(a5)
.unchanged_word:
    addq.l #8,a1
    dbra d6,.word
    lea 160-48(a0),a0
    lea 160-48(a1),a1
    addq.l #2,ps_portrait_dirty_row(a6)
    dbra d7,.row
    rts

; Start just below the portrait, leaving the rest of this field and the upper
; border of the next one for the short direct copy. Never stop VBL/input here.
    q_subr ps_portrait_wait,global
    move.w ps_portrait_top(a6),d1
    add.w #82,d1
    mulu.w #160,d1
    add.l ui_scr_base(a6),d1
    move.l d1,d2
    add.l #320,d2
    lea $ffff8203,a0
.beam:
    movep.l 0(a0),d0 ; skip base-low, then read the three video-counter bytes
    and.l #$00ffffff,d0
    cmp.l d1,d0
    blo.s .beam
    cmp.l d2,d0
    bhs.s .beam
    rts

; Only direct stores reach the visible page. Most rows use wide MOVEM copies;
; words under the cursor go to its saved background for the next VBL redraw.
    q_subr ps_portrait_present,global
    lea ps_portrait_dirty(a6),a0
    move.l a0,ps_portrait_dirty_row(a6)
    bsr ps_portrait_cursor_bounds
    move.l scr_base(a6),a0
    lea (y_top+y_max-40)*160+(x_left-x_min-48)/2(a0),a0
    move.l ps_portrait_destination(a6),a1
    move.w #80,d7
.row:
    move.l ps_portrait_dirty_row(a6),a5
    move.w (a5)+,d4
    move.l a5,ps_portrait_dirty_row(a6)
    tst.w d4
    beq .unchanged_row
    bsr ps_portrait_row_wait
    bsr ps_portrait_cursor_row
    cmp.w #$3f,d4
    bne.s .cursor_row
    move.l a1,d0
    add.l #48,d0
    cmp.l a3,d0
    bhi.s .cursor_row
    movem.l (a0)+,d0-d5
    movem.l d0-d5,(a1)
    movem.l (a0)+,d0-d5
    movem.l d0-d5,24(a1)
    lea 160-48(a0),a0
    lea 160(a1),a1
    bra.s .next
.cursor_row:
    move.w #5,d6
.word:
    btst d6,d4
    beq.s .unchanged_word
    bsr ps_portrait_target
    movem.w (a0),d0-d3
    movem.w d0-d3,(a5)
.unchanged_word:
    addq.l #8,a0
    addq.l #8,a1
    dbra d6,.word
    lea 160-48(a0),a0
    lea 160-48(a1),a1
    bra.s .next
.unchanged_row:
    lea 160(a0),a0
    lea 160(a1),a1
.next:
    dbra d7,.row
    rts

; If a transfer crosses a field boundary, keep all four interleaved plane words
; ahead of the Shifter or wait until it has fetched the complete current row.
; A1 includes the portrait's 224-pixel X offset. Preserve the dirty mask in D4.
    q_subr ps_portrait_row_wait
    move.l a1,d1
    sub.l #224/2,d1
    move.l d1,d2
    sub.l #16*160,d2
    add.l #160,d1
    lea $ffff8203,a5
.beam:
    movep.l 0(a5),d0
    and.l #$ffffff,d0
    cmp.l d2,d0
    blo.s .safe
    cmp.l d1,d0
    blo.s .beam
.safe:
    rts

; A4 = newly created planet. Preserve every register, including A5.
    q_subr init_planet_surface,global
    movem.l d0-d7/a0-a5,-(sp)
    clr.w ps_kind(a6)
    clr.w ps_active(a6)
    clr.w ps_vertices(a6)
    clr.w ps_spin_minutes(a6)
    clr.w ps_spin_direction(a6)
    lea ps_map(a6),a0
    move.w #ps_features*ps_feature_bytes/4-1,d7
.clear_map:
    clr.l (a0)+
    dbra d7,.clear_map
    lea x_vector(a4),a0
    moveq #8,d7
.clear_orientation:
    clr.w (a0)+
    dbra d7,.clear_orientation
    move.w #unit,x_vector+i(a4)
    move.w #unit,y_vector+j(a4)
    move.w #unit,z_vector+k(a4)
    bset #yvector_ok,flags(a4)
    clr.w rot_count(a4)
    move.w obj_colour(a4),d0
    cmp.w #yellow,d0
    bne.s .base_ready
    moveq #red,d0
    move.w d0,obj_colour(a4)
.base_ready:
    cmp.w #lgt_grey,d0
    beq.s .craters
    cmp.w #lgt_green,d0
    blo.s .other_colour
    cmp.w #mid_green,d0
    bls.s .seas
    cmp.w #lgt_blue,d0
    blo.s .other_colour
    cmp.w #mid_blue,d0
    bhi.s .other_colour
    move.w #mid_green,ps_ink(a6)
    bra.s .land
.seas:
    move.w #mid_blue,ps_ink(a6)
    bra.s .land
.other_colour:
    ; Match the valid, static planet backgrounds accepted by DRAW_POINT.
    cmp.w #white,d0
    bhi .done
    tst.w d0
    beq .done
    cmp.w #drk_grey,d0
    beq .done
    cmp.w #black,d0
    beq .done
    cmp.w #pulse,d0
    beq .done
    move.w #-1,ps_ink(a6) ; choose a different static colour after seeding
.land:
    move.w #ps_land_vertices,ps_vertices(a6)
    move.w #2,ps_kind(a6)
    bra.s .seed
.craters:
    move.w #ps_points-1,ps_vertices(a6)
    move.w #1,ps_kind(a6)
    move.w #drk_grey,ps_ink(a6)
.seed:
    move.l splanet+seed(a6),d0
    rol.l #5,d0
    move.w splanet+seed+4(a6),d1
    eor.w d1,d0
    bne.s .seed_ok
    move.l #$6d2b79f5,d0
.seed_ok:
    move.l d0,ps_rng(a6)
    ; One solid shade per planet, without advancing the geometry generator.
    cmp.w #2,ps_kind(a6)
    bne.s .colour_ready
    tst.w ps_ink(a6)
    bmi.s .continent_colour
    btst #8,d0
    beq.s .colour_ready
    subq.w #1,ps_ink(a6) ; medium -> light blue/green
    bra.s .colour_ready
.continent_colour:
    move.l d0,d1
    swap d1
    eor.w d0,d1
    and.l #$ffff,d1
    divu.w #ps_continent_count,d1
    swap d1
    add.w d1,d1
    lea ps_continent_colours(pc),a0
    move.w (a0,d1.w),d2
    cmp.w obj_colour(a4),d2
    bne.s .store_continent_colour
    addq.w #2,d1 ; skip a match, wrapping within the static palette
    cmp.w #ps_continent_count*2,d1
    blo.s .next_continent_colour
    clr.w d1
.next_continent_colour:
    move.w (a0,d1.w),d2
.store_continent_colour:
    move.w d2,ps_ink(a6)
.colour_ready:
    ; One private value chooses counts and rotation without consuming gameplay RNG.
    bsr ps_random
    move.l d0,d2
    and.w #3,d0
    addq.w #3,d0
    move.w d0,ps_active(a6) ; 3..6 regions or craters
    moveq #1,d1
    btst #16,d2
    beq.s .spin_direction
    moveq #-1,d1
.spin_direction:
    move.w d1,ps_spin_direction(a6)
    swap d2
    mulu.w #91,d2
    swap d2
    add.w #30,d2
    move.w d2,ps_spin_minutes(a6) ; 30..120 minutes on the status-screen clock
    lea ps_map(a6),a0
    move.l a0,ps_dest(a6)
    lea ps_centres(pc),a0
    cmp.w #1,ps_kind(a6)
    beq.s .anchors
    lea ps_sea_centres(pc),a0
.anchors:
    move.l a0,ps_source(a6)
    move.w ps_active(a6),ps_feature(a6)
    subq.w #1,ps_feature(a6)
.feature:
    move.l ps_source(a6),a2
    lea ps_centre(a6),a3
    moveq #2,d7
.jitter:
    bsr ps_random
    and.w #2047,d0
    sub.w #1024,d0
    add.w (a2)+,d0
    move.w d0,(a3)+
    dbra d7,.jitter
    move.l a2,ps_source(a6)
    movem.w ps_centre(a6),d0-d2
    bsr ps_normalize
    movem.w d0-d2,ps_centre(a6)
    move.l ps_dest(a6),a3
    move.w d0,(a3)+
    move.w d1,(a3)+
    move.w d2,(a3)+
    move.l a3,ps_dest(a6)
    move.w d0,d2
    move.w d1,d0
    neg.w d0
    move.w d2,d1
    clr.w d2
    bsr ps_normalize
    movem.w d0-d2,ps_tangent(a6)
    lea ps_centre(a6),a0
    lea ps_tangent(a6),a1
    bsr ps_cross
    movem.w d0-d2,ps_bitangent(a6)
    move.w #4096,ps_aspect(a6)
    move.w #16384,ps_cos(a6)
    clr.w ps_sin(a6)
    bsr ps_random
    cmp.w #1,ps_kind(a6)
    bne.s .sea_shape
    and.w #511,d0
    add.w #400,d0
    move.w d0,ps_size(a6)
    bra.s .size_ok
.sea_shape:
    ; Elongated, independently oriented regions with variable-width coasts.
    ; Their overlap forms larger connected seas, narrows and peninsulas.
    and.w #2047,d0
    add.w #2500,d0
    move.w d0,ps_size(a6)
    bsr ps_random
    and.w #1023,d0
    add.w #1300,d0
    move.w d0,ps_aspect(a6)
    bsr ps_random
    and.w #63,d0
    lsl.w #2,d0
    lea ps_longitudes(pc),a0
    move.w (a0,d0.w),ps_cos(a6)
    move.w 2(a0,d0.w),ps_sin(a6)
.size_ok:
    clr.w ps_vertex(a6)
.vertex:
    bsr ps_random
    and.w #1023,d0
    cmp.w #1,ps_kind(a6)
    beq.s .crater_radius
    add.w d0,d0
    add.w #1900,d0
    bra.s .radius_ready
.crater_radius:
    add.w #3072,d0
.radius_ready:
    mulu.w ps_size(a6),d0
    lsr.l #8,d0
    lsr.l #4,d0
    move.w d0,d6
    move.w ps_vertex(a6),d5
    lea ps_ring8(pc),a2
    cmp.w #1,ps_kind(a6)
    bne.s .trig
    lea ps_ring8(pc),a2
    cmp.w #8,d5
    blo.s .rim_vertex
    bsr ps_make_ray
    bra.s .point_ready
.rim_vertex:
    move.w d5,d0
    add.w d0,d0
    lea ps_rim_radii(a6),a0
    move.w d6,(a0,d0.w)
.trig:
    lsl.w #2,d5
    move.w (a2,d5.w),d3
    move.w 2(a2,d5.w),d4
    muls.w d6,d3
    muls.w d6,d4
    asr.l #8,d3
    asr.l #4,d3
    asr.l #8,d4
    asr.l #4,d4
.point_ready:
    muls.w ps_aspect(a6),d4
    asr.l #8,d4
    asr.l #4,d4
    move.w d3,d0
    muls.w ps_cos(a6),d0
    move.w d4,d1
    muls.w ps_sin(a6),d1
    sub.l d1,d0
    move.w d3,d1
    muls.w ps_sin(a6),d1
    muls.w ps_cos(a6),d4
    add.l d4,d1
    asr.l #8,d0
    asr.l #6,d0
    asr.l #8,d1
    asr.l #6,d1
    move.w d0,d3
    move.w d1,d4
    lea ps_tangent(a6),a0
    lea ps_bitangent(a6),a1
    lea ps_centre(a6),a2
    lea ps_segment(a6),a3
    moveq #2,d7
.component:
    move.w (a0)+,d0
    muls.w d3,d0
    move.w (a1)+,d1
    muls.w d4,d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #4,d0
    add.w (a2)+,d0
    move.w d0,(a3)+
    dbra d7,.component
    movem.w ps_segment(a6),d0-d2
    bsr ps_normalize
    move.l ps_dest(a6),a3
    move.w d0,(a3)+
    move.w d1,(a3)+
    move.w d2,(a3)+
    move.l a3,ps_dest(a6)
    addq.w #1,ps_vertex(a6)
    move.w ps_vertex(a6),d0
    cmp.w ps_vertices(a6),d0
    blo .vertex
    cmp.w #1,ps_kind(a6)
    beq.s .feature_ready
    ; Keep the fixed crater-sized record stride; unused coast slots stay zero.
    lea (ps_points-ps_land_vertices-1)*6(a3),a3
    move.l a3,ps_dest(a6)
.feature_ready:
    subq.w #1,ps_feature(a6)
    bpl .feature
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Extend an actual rim vertex by 0.5..1.0 of its radius, with an
; independent -10..+10 degree deflection. Geometry is generated only once.
ps_make_ray:
    move.w ps_vertex(a6),d5
    subq.w #8,d5
    lsl.w #2,d5 ; byte offset of every other rim radius
    lea ps_rim_radii(a6),a0
    move.w (a0,d5.w),d6
    add.w d5,d5 ; byte offset of that vertex's sine/cosine
    lea ps_ring8(pc),a2
    adda.w d5,a2
    bsr ps_random
    and.w #511,d0
    add.w #512,d0
    mulu.w d6,d0
    lsr.l #8,d0
    lsr.l #2,d0
    move.w d0,d7
    bsr ps_random
    and.w #7,d0
    lsl.w #2,d0
    lea ps_ray_angles(pc),a0
    move.w 2(a0,d0.w),d1
    move.w (a0,d0.w),d0
    muls.w d7,d0
    muls.w d7,d1
    asr.l #8,d0
    asr.l #4,d0
    asr.l #8,d1
    asr.l #4,d1
    add.w d0,d6
    move.w d1,d7
    move.w (a2),d3
    muls.w d6,d3
    move.w 2(a2),d4
    muls.w d7,d4
    sub.l d4,d3
    move.w (a2),d0
    muls.w d7,d0
    move.w 2(a2),d4
    muls.w d6,d4
    add.l d0,d4
    asr.l #8,d3
    asr.l #4,d3
    asr.l #8,d4
    asr.l #4,d4
    rts

; Nonzero xorshift32. Only D0/D1 and our private state change.
ps_random:
    move.l ps_rng(a6),d0
    move.l d0,d1
    lsl.l #8,d1
    lsl.l #5,d1
    eor.l d1,d0
    move.l d0,d1
    lsr.l #8,d1
    lsr.l #8,d1
    lsr.l #1,d1
    eor.l d1,d0
    move.l d0,d1
    lsl.l #5,d1
    eor.l d1,d0
    move.l d0,ps_rng(a6)
    rts

; Hyperspace arrival or station launch: choose a cosmetic longitude from the existing
; random state without consuming gameplay randomness or changing geography.
; A4 = planet, all registers preserved. 64 longitudes, 5.625 degrees apart.
    q_subr turn_planet_surface,global
    movem.l d0-d2/a0,-(sp)
    move.l random_seed(a6),d0
    move.l d0,d1
    swap d1
    eor.w d1,d0
    and.w #63,d0
    lsl.w #2,d0
    lea ps_longitudes(pc),a0
    move.w (a0,d0.w),d1
    move.w 2(a0,d0.w),d2
    move.w d1,x_vector+i(a4)
    move.w d1,z_vector+k(a4)
    move.w d2,z_vector+i(a4)
    neg.w d2
    move.w d2,x_vector+k(a4)
    bclr #yvector_ok,flags(a4)
    movem.l (sp)+,d0-d2/a0
    rts

; Normalize a nonzero signed triple (each component <= 16384) to Q12.
; A zero vector is handled defensively. All other registers are preserved.
ps_normalize:
    movem.l d3-d7,-(sp)
    move.w d0,d4
    move.w d1,d5
    move.w d2,d6
    muls.w d0,d0
    muls.w d1,d1
    muls.w d2,d2
    add.l d1,d0
    add.l d2,d0
    jsr sqrt
    tst.w d2
    beq.s .zero
    move.w d2,d3
    move.w d4,d0
    ext.l d0
    asl.l #8,d0
    asl.l #4,d0
    divs.w d3,d0
    move.w d5,d1
    ext.l d1
    asl.l #8,d1
    asl.l #4,d1
    divs.w d3,d1
    move.w d6,d2
    ext.l d2
    asl.l #8,d2
    asl.l #4,d2
    divs.w d3,d2
    bra.s .done
.zero:
    clr.w d0
    clr.w d1
    move.w #4096,d2
.done:
    movem.l (sp)+,d3-d7
    rts

; Cross product A0 x A1, Q12 -> D0/D1/D2. D3 corrupted.
ps_cross:
    move.w 2(a0),d0
    muls.w 4(a1),d0
    move.w 4(a0),d3
    muls.w 2(a1),d3
    sub.l d3,d0
    asr.l #8,d0
    asr.l #4,d0
    move.w 4(a0),d1
    muls.w (a1),d1
    move.w (a0),d3
    muls.w 4(a1),d3
    sub.l d3,d1
    asr.l #8,d1
    asr.l #4,d1
    move.w (a0),d2
    muls.w 2(a1),d2
    move.w 2(a0),d3
    muls.w (a1),d3
    sub.l d3,d2
    asr.l #8,d2
    asr.l #4,d2
    rts

    q_subr draw_planet_surface,global
    btst #f_planets,user+1(a6)
    beq .return
    tst.w ps_kind(a6)
    beq .return
    cmp.w #ps_min_radius,scr_radius(a5)
    blt .return ; no transformation or raster work for distant planets
    movem.l d0-d7/a0-a5,-(sp)
    move.w scr_radius(a5),d0
    subq.w #3,d0 ; allow for the circle's radius decrement and raster rounding
    move.w d0,d1
    lsr.w #8,d1 ; bound accumulated fixed-point rounding on very large globes
    sub.w d1,d0
    move.w d0,ps_radius(a6)
    bsr ps_make_matrix
    move.w ps_ink(a6),d0
    jsr set_colour
    ; SOLID_POLYGON selects two alternating eight-byte rows. Use the same
    ; solid masks for both rows, while crater lines use the first row.
    move.l colour_ptr(a6),a0
    lea ps_colour(a6),a1
    move.l (a0),(a1)
    move.l 4(a0),4(a1)
    move.l (a0),8(a1)
    move.l 4(a0),12(a1)
    move.l a1,colour_ptr(a6)
    lea ps_map(a6),a0
    move.l a0,ps_source(a6)
    move.w ps_active(a6),ps_feature(a6)
    subq.w #1,ps_feature(a6)
.feature:
    move.l ps_source(a6),a0
    lea ps_feature_bytes(a0),a1
    move.l a1,ps_source(a6)
    lea ps_view_points(a6),a2
    lea ps_matrix+4(a6),a1
    move.w ps_vertices(a6),d7
    moveq #0,d5 ; any vertex on the near hemisphere, including exactly z=0
.depth:
    move.w (a0),d0
    muls.w (a1),d0
    move.w 2(a0),d1
    muls.w 6(a1),d1
    add.l d1,d0
    move.w 4(a0),d1
    muls.w 12(a1),d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #4,d0
    move.w d0,4(a2)
    bgt.s .back_vertex
    moveq #1,d5
.back_vertex:
    addq.l #6,a0
    addq.l #6,a2
    dbra d7,.depth
    tst.w d5
    beq .next_feature ; X/Y cannot contribute when every vertex is hidden
    move.l ps_source(a6),a0
    lea -ps_feature_bytes(a0),a0
    lea ps_view_points(a6),a2
    lea ps_projected(a6),a3
    move.w ps_vertices(a6),d7
    cmp.w #1,ps_kind(a6)
    bne.s .transform
    ; Craters draw vertices 1..12 only. Their centre still took part in the
    ; exact visibility test, but its X/Y and projection are never consumed.
    addq.l #6,a0
    addq.l #6,a2
    addq.l #4,a3
    subq.w #1,d7
.transform:
    lea ps_matrix(a6),a1
    moveq #1,d6 ; Z is already exact; retain the original X/Y arithmetic
.axis:
    move.w (a0),d0
    muls.w (a1),d0
    move.w 2(a0),d1
    muls.w 6(a1),d1
    add.l d1,d0
    move.w 4(a0),d1
    muls.w 12(a1),d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #4,d0
    move.w d0,(a2)+
    addq.l #2,a1
    dbra d6,.axis
    ; Project every near-side vertex once while its transformed coordinates
    ; are at hand. Hidden endpoints only participate in horizon clipping.
    tst.w (a2)
    bgt.s .no_projection
    movem.w -4(a2),d0-d1
    bsr ps_project
    move.w d0,(a3)
    move.w d1,2(a3)
.no_projection:
    addq.l #4,a3
    addq.l #2,a2 ; preserve the Z word from the visibility pass
    addq.l #6,a0
    dbra d7,.transform
    clr.w ps_vertex(a6)
    cmp.w #1,ps_kind(a6)
    beq .crater
    bsr ps_fast_region
    tst.w d0
    bne .next_feature
    jsr begin_polygon_batch
.face:
    ; Carry each original vertex ID through horizon clipping. Intersections
    ; remain uncached and keep their original directed-edge rounding.
    clr.w ps_triangle_ids(a6)
    move.w ps_vertex(a6),d0
    addq.w #1,d0
    move.w d0,ps_triangle_ids+2(a6)
    addq.w #1,d0
    cmp.w #ps_land_vertices+1,d0
    bne.s .triangle_id
    moveq #1,d0
.triangle_id:
    move.w d0,ps_triangle_ids+4(a6)
    lea ps_triangle(a6),a2
    lea ps_view_points(a6),a0
    move.l (a0),(a2)+
    move.w 4(a0),(a2)+
    move.w ps_vertex(a6),d0
    move.w d0,d1
    add.w d0,d0
    add.w d1,d0
    add.w d0,d0 ; six-byte vertex offset, coast index is bounded to 0..7
    lea 6(a0,d0.w),a1
    move.l (a1),(a2)+
    move.w 4(a1),(a2)+
    addq.l #6,a1
    cmp.w #ps_land_vertices-1,ps_vertex(a6)
    bne.s .next_point
    lea 6(a0),a1
.next_point:
    move.l (a1),(a2)+
    move.w 4(a1),(a2)+
    bsr ps_triangle_cached_draw
    addq.w #1,ps_vertex(a6)
    cmp.w #ps_land_vertices,ps_vertex(a6)
    blo .face
    jsr end_polygon_batch
    bra.s .next_feature
.crater:
    move.w ps_vertex(a6),d0
    move.w d0,d1
    addq.w #1,d1
    and.w #7,d1
    addq.w #1,d0
    addq.w #1,d1
    bsr ps_segment_draw
    addq.w #1,ps_vertex(a6)
    cmp.w #8,ps_vertex(a6)
    blo .crater
    clr.w ps_vertex(a6)
.ray:
    move.w ps_vertex(a6),d0
    move.w d0,d1
    add.w d0,d0
    addq.w #1,d0
    add.w #9,d1
    bsr ps_segment_draw
    addq.w #1,ps_vertex(a6)
    cmp.w #4,ps_vertex(a6)
    blo .ray
.next_feature:
    subq.w #1,ps_feature(a6)
    bpl .feature
    movem.l (sp)+,d0-d7/a0-a5
.return:
    rts

; An entirely visible, screen-contained, y-monotone coast can be filled in
; one pass. Concave coasts with multiple spans fall back to the triangle fan.
; This check is geometric: it never changes or simplifies the seeded map.
ps_fast_region:
    lea ps_view_points+6(a6),a0
    lea ps_nodes(a6),a2
    move.w #32767,poly_min_y(a6)
    move.w #-32768,poly_max_y(a6)
    moveq #ps_land_vertices-1,d7
.node:
    tst.w 4(a0)
    bgt .fallback
    moveq #ps_land_vertices,d2
    sub.w d7,d2 ; coast vertices 1..8, all on the near hemisphere
    lsl.w #2,d2
    lea ps_projected(a6),a3
    movem.w (a3,d2.w),d0-d1
    cmp.w #x_min,d0
    blt .fallback
    cmp.w #x_max,d0
    bgt .fallback
    cmp.w #y_min,d1
    blt .fallback
    cmp.w #y_max,d1
    bgt .fallback
    move.w d0,scr_x(a2)
    move.w d1,scr_y(a2)
    cmp.w poly_min_y(a6),d1
    bge.s .min
    move.w d1,poly_min_y(a6)
.min:
    cmp.w poly_max_y(a6),d1
    ble.s .max
    move.w d1,poly_max_y(a6)
    move.l a2,top_ptr(a6)
.max:
    lea -node_len(a2),a1
    move.l a1,prev(a2)
    lea node_len(a2),a1
    move.l a1,next(a2)
    move.l a1,a2
    addq.l #6,a0
    dbra d7,.node
    lea ps_nodes(a6),a0
    lea -node_len(a2),a1
    move.l a0,next(a1)
    move.l a1,prev(a0)
    moveq #0,d4 ; first non-horizontal edge direction
    moveq #0,d5 ; previous direction
    moveq #0,d6 ; direction changes
    moveq #ps_land_vertices-1,d7
.edge:
    move.l next(a0),a1
    move.w scr_y(a1),d0
    sub.w scr_y(a0),d0
    beq.s .flat
    moveq #1,d1
    tst.w d0
    bpl.s .sign
    moveq #-1,d1
.sign:
    tst.w d4
    bne.s .first
    move.w d1,d4
    move.w d1,d5
.first:
    cmp.w d1,d5
    beq.s .flat
    addq.w #1,d6
    move.w d1,d5
.flat:
    move.l a1,a0
    dbra d7,.edge
    cmp.w d4,d5
    beq.s .closed
    addq.w #1,d6
.closed:
    cmp.w #2,d6
    bne.s .fallback
    jsr solid_polygon
    moveq #1,d0
    rts
.fallback:
    moveq #0,d0
    rts

; Compose the object's orientation, current cockpit view and eye direction.
ps_make_matrix:
    jsr calc_yvector
    movem.l this_xpos(a5),d0-d2
.reduce:
    move.l d0,d3
    bpl.s .abs_x
    neg.l d3
.abs_x:
    move.l d1,d4
    bpl.s .abs_y
    neg.l d4
.abs_y:
    or.l d4,d3
    or.l d2,d3 ; visible planet centre always has positive view Z
    cmp.l #8191,d3
    bls.s .reduced
    asr.l #1,d0
    asr.l #1,d1
    asr.l #1,d2
    bra.s .reduce
.reduced:
    bsr ps_normalize
    movem.w d0-d2,ps_eye(a6)
    neg.w d0
    exg d0,d2
    clr.w d1
    bsr ps_normalize
    movem.w d0-d2,ps_right(a6)
    lea ps_eye(a6),a0
    lea ps_right(a6),a1
    bsr ps_cross
    movem.w d0-d2,ps_up(a6)
    lea x_vector(a5),a2
    lea ps_matrix(a6),a3
    moveq #2,d7
.basis:
    movem.w (a2),d0-d2
    move.l w_view_ptr(a6),a0
    jsr (a0)
    lea ps_right(a6),a1
    bsr ps_dot_basis
    move.w d3,(a3)+
    lea ps_up(a6),a1
    bsr ps_dot_basis
    move.w d3,(a3)+
    lea ps_eye(a6),a1
    bsr ps_dot_basis
    move.w d3,(a3)+
    addq.l #6,a2
    dbra d7,.basis
    lea ps_portrait_object(a6),a0
    cmpa.l a0,a5
    beq.s .preview_phase
    bsr ps_clock_phase
    bra.s .spin
.preview_phase:
    move.w ps_portrait_phase(a6),d0
.spin:
    tst.w d0
    beq.s .done
    bsr ps_phase_trig
    lea ps_matrix(a6),a0
    moveq #2,d7
.spin_axis:
    move.w (a0),d0
    move.w 12(a0),d1
    move.w d0,d2
    muls.w d5,d2
    move.w d1,d3
    muls.w d6,d3
    sub.l d3,d2
    asr.l #8,d2
    asr.l #6,d2
    move.w d2,(a0)
    muls.w d6,d0
    muls.w d5,d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #6,d0
    move.w d0,12(a0)
    addq.l #2,a0
    dbra d7,.spin_axis
.done:
    rts

; D0.W = signed-direction phase, one full turn = 65536. Read the four
; status-clock words in one instruction, so a VBL cannot split a rollover.
; Work in minutes to keep every DIVU quotient within the 68000 word limit.
    q_subr ps_clock_phase,global
    movem.l d1-d4,-(sp)
    moveq #0,d0
    move.w ps_spin_minutes(a6),d4
    beq.s .done
    movem.w game_time(a6),d0-d3
    mulu.w #24,d3
    add.w d2,d3
    mulu.w #60,d3
    add.w d1,d3
    divu.w d4,d3
    clr.w d3 ; remaining minutes in the high word
    swap d0 ; seconds * 65536
    clr.w d0
    divu.w #60,d0
    and.l #$ffff,d0
    add.l d3,d0
    divu.w d4,d0
    tst.w ps_spin_direction(a6)
    bpl.s .done
    neg.w d0
.done:
    movem.l (sp)+,d1-d4
    rts

; D0.W = phase. D5/D6 = Q14 cosine/sine. Interpolate the 64-entry table
; with ten fractional bits, avoiding drift from repeated object rotations.
ps_phase_trig:
    move.w d0,d2
    and.w #1023,d2
    lsr.w #8,d0
    and.w #252,d0
    lea ps_longitudes(pc),a0
    lea (a0,d0.w),a1
    addq.w #4,d0
    and.w #255,d0
    move.w (a1),d5
    move.w (a0,d0.w),d3
    sub.w d5,d3
    muls.w d2,d3
    asr.l #8,d3
    asr.l #2,d3
    add.w d3,d5
    move.w 2(a1),d6
    move.w 2(a0,d0.w),d3
    sub.w d6,d3
    muls.w d2,d3
    asr.l #8,d3
    asr.l #2,d3
    add.w d3,d6
    rts

ps_dot_basis:
    move.w d0,d3
    muls.w (a1),d3
    move.w d1,d4
    muls.w 2(a1),d4
    add.l d4,d3
    move.w d2,d4
    muls.w 4(a1),d4
    add.l d4,d3
    asr.l #8,d3
    asr.l #6,d3
    rts

; Clip one triangle against the spherical horizon, z <= 0. Intersections
; are normalized onto the limb; simply clipping screen polygons would show
; the far hemisphere through the near side of the planet.
ps_triangle_draw:
    ; Standalone callers supply only coordinates, without per-feature IDs.
    moveq #-1,d0
    move.l d0,ps_triangle_ids(a6)
    move.w d0,ps_triangle_ids+4(a6)
ps_triangle_cached_draw:
    lea ps_clipped_ids(a6),a3
    lea ps_triangle_ids(a6),a4
    lea ps_triangle+12(a6),a0
    lea ps_triangle(a6),a1
    lea ps_clipped(a6),a2
    clr.w ps_count(a6)
    moveq #2,d7
.edge:
    ; A vertex exactly on the horizon is inside. A sign-bit XOR alone
    ; would emit it twice on both adjacent edges and overflow four slots.
    tst.w 4(a0)
    bgt.s .from_back
    tst.w 4(a1)
    ble.s .no_cross
    bra.s .crossing
.from_back:
    tst.w 4(a1)
    bgt.s .no_cross
.crossing:
    bsr ps_intersection
    move.w d0,(a2)+
    move.w d1,(a2)+
    clr.w (a2)+
    move.w #-1,(a3)+ ; generated horizon point, not an original map vertex
    addq.w #1,ps_count(a6)
.no_cross:
    tst.w 4(a1)
    bgt.s .outside
    move.l (a1),(a2)+
    move.w 4(a1),(a2)+
    move.w (a4),(a3)+
    addq.w #1,ps_count(a6)
.outside:
    addq.l #2,a4
    move.l a1,a0
    addq.l #6,a1
    dbra d7,.edge
    cmp.w #3,ps_count(a6)
    blo .done
    lea ps_clipped(a6),a0
    lea ps_clipped_ids(a6),a4
    lea ps_nodes(a6),a2
    move.w ps_count(a6),d7
    subq.w #1,d7
    clr.w clip_panel(a6)
    move.w #32767,poly_min_y(a6)
    move.w #-32768,poly_max_y(a6)
.node:
    movem.w (a0),d0-d1
    move.w (a4)+,d2
    bsr ps_project_cached
    move.w d0,scr_x(a2)
    move.w d1,scr_y(a2)
    moveq #0,d2
    cmp.w #x_min,d0
    bge.s .left_ok
    bset #off_left,d2
.left_ok:
    cmp.w #x_max,d0
    ble.s .right_ok
    bset #off_right,d2
.right_ok:
    cmp.w #y_min,d1
    bge.s .bottom_ok
    bset #off_bottom,d2
.bottom_ok:
    cmp.w #y_max,d1
    ble.s .top_ok
    bset #off_top,d2
.top_ok:
    clr.w nflags(a2)
    move.b d2,nflags(a2)
    or.b d2,clip_panel(a6)
    cmp.w poly_min_y(a6),d1
    bge.s .min_ok
    move.w d1,poly_min_y(a6)
.min_ok:
    cmp.w poly_max_y(a6),d1
    ble.s .max_ok
    move.w d1,poly_max_y(a6)
    move.l a2,top_ptr(a6)
.max_ok:
    lea -node_len(a2),a3
    move.l a3,prev(a2)
    lea node_len(a2),a3
    move.l a3,next(a2)
    move.l a3,a2
    addq.l #6,a0
    dbra d7,.node
    lea -node_len(a2),a3
    lea ps_nodes(a6),a4
    move.l a4,next(a3)
    move.l a3,prev(a4)
    ; Rasterising a zero-height face adds no useful detail.
    move.w poly_min_y(a6),d0
    cmp.w poly_max_y(a6),d0
    beq.s .done
    jsr c_solid_polygon
.done:
    rts

; A0/A1 straddle z=0. Return the normalized intersection in D0/D1/D2.
ps_intersection:
    movem.l d3-d7,-(sp)
    move.w 4(a0),d6
    move.w 4(a1),d5
    sub.w d6,d5
    move.w (a1),d0
    sub.w (a0),d0
    muls.w d6,d0
    divs.w d5,d0
    neg.w d0
    add.w (a0),d0
    move.w 2(a1),d1
    sub.w 2(a0),d1
    muls.w d6,d1
    divs.w d5,d1
    neg.w d1
    add.w 2(a0),d1
    ; The intersection lies in Z=0. Keep the same integer square root and
    ; signed divisions, but omit the zero Z square/division. D3-D7 are already
    ; saved by this routine, so no nested normalizer save/restore is needed.
    move.w d0,d4
    move.w d1,d5
    muls.w d0,d0
    muls.w d1,d1
    add.l d1,d0
    jsr sqrt
    tst.w d2
    beq.s .zero
    move.w d2,d3
    move.w d4,d0
    ext.l d0
    asl.l #8,d0
    asl.l #4,d0
    divs.w d3,d0
    move.w d5,d1
    ext.l d1
    asl.l #8,d1
    asl.l #4,d1
    divs.w d3,d1
    moveq #0,d2
    bra.s .done
.zero:
    clr.w d0
    clr.w d1
    move.l #4096,d2 ; retain the original zero-vector fallback, including high word
.done:
    movem.l (sp)+,d3-d7
    rts

; D0/D1 are point indices. The two endpoints get independent hemisphere and
; viewport clipping, so a crater never disappears as a whole at the limb.
ps_segment_draw:
    move.w d0,d4
    move.w d1,d5
    add.w d0,d0
    add.w d4,d0
    add.w d0,d0 ; six-byte offsets; D4/D5 retain the original cache IDs
    add.w d1,d1
    add.w d5,d1
    add.w d1,d1
    lea ps_view_points(a6),a2
    lea (a2,d0.w),a0
    lea (a2,d1.w),a1
    lea ps_segment(a6),a2
    move.l (a0),(a2)
    move.w 4(a0),4(a2)
    move.l (a1),6(a2)
    move.w 4(a1),10(a2)
    move.l a2,a0
    lea 6(a2),a1
    tst.w 4(a0)
    ble.s .first_front
    tst.w 4(a1)
    bgt .done
    bsr ps_intersection
    move.w d0,(a0)
    move.w d1,2(a0)
    moveq #-1,d4 ; clipping replaced this endpoint
    bra.s .project
.first_front:
    tst.w 4(a1)
    ble.s .project
    bsr ps_intersection
    move.w d0,(a1)
    move.w d1,2(a1)
    moveq #-1,d5
.project:
    movem.w (a0),d0-d1
    move.w d4,d2
    bsr ps_project_cached
    movem.w d0-d1,ps_line(a6)
    movem.w (a1),d0-d1
    move.w d5,d2
    bsr ps_project_cached
    move.w d0,d2
    move.w d1,d3
    movem.w ps_line(a6),d0-d1
    jsr c_line
.done:
    rts

; D0/D1 = Q12 coordinate, D2 = original near-side vertex ID (0..12),
; or -1 for a generated intersection. Return the same signed pixel words as
; PS_PROJECT. The current feature's near-side entries are always initialized.
; D2/A3 are scratch; all point/list pointers and loop counters are preserved.
ps_project_cached:
    tst.w d2
    bmi ps_project
    lsl.w #2,d2
    lea ps_projected(a6),a3
    movem.w (a3,d2.w),d0-d1
    rts

; Q12 disk coordinate -> view pixel. Long additions saturate safely before
; the existing viewport clipper; no signed-word wrap for very close planets.
ps_project:
    muls.w ps_radius(a6),d0
    muls.w ps_radius(a6),d1
    add.l #2048,d0 ; round to nearest, avoiding a negative-coordinate bias
    add.l #2048,d1
    asr.l #8,d0
    asr.l #4,d0
    asr.l #8,d1
    asr.l #4,d1
    move.w centre_x(a5),d2
    ext.l d2
    add.l d2,d0
    move.w centre_y(a5),d2
    ext.l d2
    add.l d2,d1
    cmp.l #16000,d0
    ble.s .x_high
    move.l #16000,d0
.x_high:
    cmp.l #-16000,d0
    bge.s .x_low
    move.l #-16000,d0
.x_low:
    cmp.l #16000,d1
    ble.s .y_high
    move.l #16000,d1
.y_high:
    cmp.l #-16000,d1
    bge.s .done
    move.l #-16000,d1
.done:
    rts

; Icosahedral anchors distribute features around the entire sphere.
ps_sea_centres:
    dc.w 2365,2365,2365,-2365,-2365,-2365,2365,-2365,-2365,-2365,2365,2365
    dc.w -2365,2365,-2365,2365,-2365,2365,-2365,-2365,2365,2365,2365,-2365
ps_centres:
    dc.w 0,2153,3484,0,-2153,3484,0,2153,-3484,0,-2153,-3484
    dc.w 2153,3484,0,-2153,3484,0,2153,-3484,0,-2153,-3484,0
    dc.w 3484,0,2153,3484,0,-2153,-3484,0,2153,-3484,0,-2153
ps_ring8:
    dc.w 4096,0,2896,2896,0,4096,-2896,2896
    dc.w -4096,0,-2896,-2896,0,-4096,2896,-2896

ps_longitudes:
    dc.w 16384,0
    dc.w 16305,1606
    dc.w 16069,3196
    dc.w 15679,4756
    dc.w 15137,6270
