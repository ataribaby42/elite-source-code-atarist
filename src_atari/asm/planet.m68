; The same visible colours allowed for planet backgrounds; yellow is for suns.
ps_continent_colours:
    dc.w lgt_grey,orange,magenta,red,lgt_green,mid_green
    dc.w drk_green,lgt_blue,mid_blue,drk_blue,white
ps_continent_count: equ (*-ps_continent_colours)/2

ps_ray_angles:
    dc.w 4034,-711
    dc.w 4065,-499
    dc.w 4086,-286
    dc.w 4095,-71
    dc.w 4095,71
    dc.w 4086,286
    dc.w 4065,499
    dc.w 4034,711
