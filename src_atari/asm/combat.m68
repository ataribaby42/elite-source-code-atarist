	include "common.def"
; Ported from src_orig/asm/combat.m68; edit this copy.
;	@@@@	@@@   @@   @@ @@@@@@	 @@    @@@@@@
;  @@  @@  @@ @@  @@@ @@@  @@  @@	@@@@   @ @@ @
; @@	  @@   @@ @@@@@@@  @@  @@  @@  @@	 @@
; @@	  @@   @@ @@@@@@@  @@@@@   @@  @@	 @@
; @@	  @@   @@ @@ @ @@  @@  @@  @@@@@@	 @@
;  @@  @@  @@ @@  @@   @@  @@  @@  @@  @@	 @@
