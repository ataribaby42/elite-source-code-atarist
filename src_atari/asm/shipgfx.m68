; Runtime UI portraits from the relocated flight meshes, first material variant.
; Dedicated NOLOAD storage: no screen, sprite backup or flight workspace aliases.
    include "common.def"
    include "macros.m68"
    xref obj_data,panel_colours,ship_profile,put_bitmap
    xdef ship_graphics_begin,ship_yard_atlas,ship_yard_end
    xdef ship_status_image,ship_status_end,ship_planet_image,ship_planet_end
    xdef ship_graphics_work,ship_graphics_end
    q_module shipgfx

sg_yard_bytes equ 4+4*41*10
sg_status_bytes equ 4+8*51*10
sg_planet_bytes equ 4+2*45*10
sg_guard equ $53484950

; Called once, after relocation of OBJECTS.IMG, before the first UI is exposed.
    q_subr ship_graphics_init,global
    movem.l d0-d7/a0-a5,-(sp)
    lea ship_graphics_begin,a0
    move.w #(ship_graphics_end-ship_graphics_begin)/2-1,d0
.clear:
    clr.w (a0)+
    dbra d0,.clear
    move.l #sg_guard,ship_graphics_begin
    move.l #sg_guard,ship_yard_end
    move.l #sg_guard,ship_status_end
    move.l #sg_guard,ship_planet_end
    move.l #sg_guard,ship_graphics_end-4
    moveq #0,d7
.ship:
    move.w d7,d0
    jsr ship_profile
    move.w sp_model(a0),d0
    move.w sp_atlas(a0),d1
    mulu #sg_yard_bytes,d1
    lea ship_yard_atlas,a1
    adda.l d1,a1
    moveq #2,d1
    bsr sg_render
    addq.w #1,d7
    cmp.w #ship_count,d7
    blo.s .ship
    move.w #1,sg_ready
    movem.l (sp)+,d0-d7/a0-a5
    rts

; SHIP_APPLY invokes this after new-game restore, load and successful purchase.
; The two player images are always regenerated, even when loading the same hull.
    q_subr ship_refresh,global
    tst.w sg_ready
    beq.s .done
    movem.l d0-d7/a0-a5,-(sp)
    move.w hull_model(a6),d0
    moveq #0,d1
    lea ship_status_image,a1
    bsr sg_render
    move.w hull_model(a6),d0
    moveq #1,d1
    lea ship_planet_image,a1
    bsr sg_render
    movem.l (sp)+,d0-d7/a0-a5
.done:
    rts

; D0 group -> A0 unscaled, masked image. All other registers are preserved.
    q_subr ship_bitmap,global
    lea ship_status_image,a0
    tst.w d0
    beq.s .done
    lea ship_planet_image,a0
    cmp.w #1,d0
    beq.s .done
    move.l d0,-(sp)
    move.w hull_atlas(a6),d0
    bsr ship_yard_bitmap
    move.l (sp)+,d0
.done:
    rts

; D0 atlas slot -> A0 yard image. Caller never owns writable cache storage.
    q_subr ship_yard_bitmap,global
    move.l d0,-(sp)
    cmp.w #ship_count,d0
    blo.s .valid
    moveq #7,d0
.valid:
    mulu #sg_yard_bytes,d0
    lea ship_yard_atlas,a0
    adda.l d0,a0
    move.l (sp)+,d0
    rts

; D0 model, D1 view (rear/above, top/right, top/up), A1 output bitmap.
; Project in Q6, fit visible geometry uniformly with one authoring pixel margin.
    q_subr sg_render
    movem.l d0-d7/a0-a5,-(sp)
    move.l a1,sg_output
    move.w d1,sg_view
    lsl.w #2,d1
    lea sg_dimensions(pc),a2
    move.w (a2,d1.w),sg_width
    move.w 2(a2,d1.w),sg_height
    move.w sg_width,d2
    lsr.w #4,d2
    move.w d2,sg_words
    move.w d2,(a1)+
    move.w sg_height,d3
    move.w d3,(a1)+
    mulu d2,d3
    subq.w #1,d3
.empty:
    move.w #$ffff,(a1)+
    clr.l (a1)+
    clr.l (a1)+
    dbra d3,.empty
    lsl.w #2,d0
    lea obj_data,a0
    move.l (a0,d0.w),a0
    move.w no_nodes-nodes(a0),sg_node_count
    cmp.w #max_nodes,sg_node_count
    bhs .done
    move.l 4(a0),a2
    move.l 2(a2),sg_surfaces ; first colour variant, after the count word
    move.l (a0),a0
    lea sg_points,a1
    move.w sg_node_count,d7
.project:
    move.w (a0),d0
    move.w 2(a0),d1
    move.w 4(a0),d2
    addq.l #8,a0
    tst.w sg_view
    bne.s .top
    add.w d2,d1
    neg.w d1
    muls #181,d1 ; 64/sqrt(2), accurate to 0.01 percent
    asr.l #2,d1
    asl.w #6,d0
    bra.s .point
.top:
    cmp.w #1,sg_view
    bne.s .up
    move.w d0,d1
    move.w d2,d0
    bra.s .scale64
.up:
    move.w d2,d1
    neg.w d1
.scale64:
    asl.w #6,d0
    asl.w #6,d1
.point:
    move.w d0,(a1)+
    move.w d1,(a1)+
    dbra d7,.project
    move.w #32767,sg_minx
    move.w #32767,sg_miny
    move.w #-32768,sg_maxx
    move.w #-32768,sg_maxy
    move.l sg_surfaces,a4
.bounds_surface:
    bsr sg_facing
    beq.s .bounds_next
    lea 10(a4),a3
.bounds_panel:
    move.w (a3)+,d0
    beq.s .bounds_next
    addq.l #2,a3 ; material
    tst.w d0
    bpl.s .bounds_node
    addq.l #2,a3 ; unique line ID
.bounds_node:
    move.w (a3)+,d0
    bmi.s .bounds_panel
    bsr sg_point
    cmp.w sg_minx,d0
    bge.s .bx1
    move.w d0,sg_minx
.bx1:
    cmp.w sg_maxx,d0
    ble.s .bx2
    move.w d0,sg_maxx
.bx2:
    cmp.w sg_miny,d1
    bge.s .by1
    move.w d1,sg_miny
.by1:
    cmp.w sg_maxy,d1
    ble.s .bounds_node
    move.w d1,sg_maxy
    bra.s .bounds_node
.bounds_next:
    move.l 6(a4),a4
    move.l a4,d0
    bne.s .bounds_surface
    move.w sg_maxx,d2
    sub.w sg_minx,d2
    ble .done
    move.w sg_maxy,d3
    sub.w sg_miny,d3
    ble .done
    moveq #0,d0
    move.w sg_width,d0
    subq.w #3,d0
    swap d0
    divu d2,d0
    moveq #0,d1
    move.w sg_height,d1
    subq.w #3,d1
    swap d1
    divu d3,d1
    cmp.w d1,d0
    bls.s .fit
    move.w d1,d0
.fit:
    move.w d0,sg_scale
    lea sg_points,a1
    move.w sg_node_count,d7
.normalise:
    move.w (a1),d0
    add.w d0,d0
    sub.w sg_minx,d0
    sub.w sg_maxx,d0
    muls sg_scale,d0
    moveq #0,d1
    move.w sg_width,d1
    swap d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #8,d0
    asr.l #1,d0
    move.w d0,(a1)+
    move.w (a1),d0
    add.w d0,d0
    sub.w sg_miny,d0
    sub.w sg_maxy,d0
    muls sg_scale,d0
    moveq #0,d1
    move.w sg_height,d1
    swap d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #8,d0
    asr.l #1,d0
    move.w d0,(a1)+
    dbra d7,.normalise
    lea sg_lines,a0
    clr.l (a0)+
    clr.l (a0)+
    clr.l (a0)+
    clr.l (a0)+
    move.l sg_surfaces,a4
.surface:
    bsr sg_facing
    beq .next_surface
    lea 10(a4),a3
.panel:
    move.w (a3)+,d0
    beq .next_surface
    move.w d0,sg_solid
    move.w (a3)+,d0
    lsl.w #4,d0
    lea panel_colours,a0
    adda.w d0,a0
    move.l a0,sg_material
    tst.w sg_solid
    bpl.s .polygon
    move.w (a3)+,d0
    cmp.w #16,d0
    bhs.s .skip
    lea sg_lines,a0
    tst.b (a0,d0.w)
    bne.s .skip
    st.b (a0,d0.w)
    bra.s .first
.skip:
    tst.w (a3)+
    bpl.s .skip
    bra.s .panel
.polygon:
    lea sg_spans,a0
    moveq #50,d0
.clear_spans:
    move.w #32767,(a0)+
    move.w #-1,(a0)+
    dbra d0,.clear_spans
.first:
    move.w (a3)+,d0
    bsr sg_point
    move.w d0,sg_firstx
    move.w d1,sg_firsty
    move.w d0,sg_lastx
    move.w d1,sg_lasty
.edge:
    move.w (a3)+,d0
    bmi.s .close
    bsr sg_point
    move.w d0,d2
    move.w d1,d3
    move.w sg_lastx,d0
    move.w sg_lasty,d1
    bsr sg_edge
    move.w d2,sg_lastx
    move.w d3,sg_lasty
    bra.s .edge
.close:
    tst.w sg_solid
    bmi .panel
    move.w sg_lastx,d0
    move.w sg_lasty,d1
    move.w sg_firstx,d2
    move.w sg_firsty,d3
    bsr sg_edge
    lea sg_spans,a2
    moveq #0,d1
.row:
    move.w (a2)+,d0
    move.w (a2)+,d2
.span:
    cmp.w d2,d0
    bgt.s .next_row
    bsr sg_plot
    addq.w #1,d0
    bra.s .span
.next_row:
    addq.w #1,d1
    cmp.w sg_height,d1
    blo.s .row
    bra .panel
.next_surface:
    move.l 6(a4),a4
    move.l a4,d0
    bne .surface
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Z=visible test result. Normals use exactly the PNG camera's half-space.
sg_facing:
    move.w 2(a4),d0
    tst.w sg_view
    bne.s .top
    sub.w 4(a4),d0
.top:
    tst.w d0
    sgt d0
    and.w #255,d0
    rts

; D0 node -> D0/D1 coordinates. Mesh data is already validated by the build.
sg_point:
    lsl.w #2,d0
    lea sg_points,a0
    move.w 2(a0,d0.w),d1
    move.w (a0,d0.w),d0
    rts

; Inclusive Bresenham edge; either collect convex polygon spans or draw detail.
sg_edge:
    movem.l d0-d7/a0,-(sp)
    moveq #1,d7
    move.w d7,sg_sx
    move.w d7,sg_sy
    move.w d2,d4
    sub.w d0,d4
    bpl.s .dx
    neg.w d4
    neg.w sg_sx
.dx:
    move.w d3,d5
    sub.w d1,d5
    bpl.s .dy
    neg.w d5
    neg.w sg_sy
.dy:
    neg.w d5
    move.w d4,d6
    add.w d5,d6
.loop:
    tst.w sg_solid
    bmi.s .line
    cmp.w sg_height,d1
    bhs.s .step
    move.w d1,d7
    lsl.w #2,d7
    lea sg_spans,a0
    adda.w d7,a0
    cmp.w (a0),d0
    bge.s .right
    move.w d0,(a0)
.right:
    cmp.w 2(a0),d0
    ble.s .step
    move.w d0,2(a0)
    bra.s .step
.line:
    bsr sg_plot
.step:
    cmp.w d2,d0
    bne.s .advance
    cmp.w d3,d1
    beq.s .done
.advance:
    move.w d6,d7
    add.w d7,d7
    cmp.w d5,d7
    blt.s .vertical
    add.w d5,d6
    add.w sg_sx,d0
.vertical:
    cmp.w d4,d7
    bgt.s .loop
    add.w d4,d6
    add.w sg_sy,d1
    bra.s .loop
.done:
    movem.l (sp)+,d0-d7/a0
    rts

; The only renderer write to image pixels. Unsigned bounds also reject negatives.
; Opaque material black becomes UI 13; flashing 14 becomes steady red 6.
sg_plot:
    cmp.w sg_width,d0
    bhs .done
    cmp.w sg_height,d1
    bhs .done
    movem.l d0-d6/a0-a1,-(sp)
    move.l sg_material,a1
    move.w d1,d2
    and.w #1,d2
    lsl.w #3,d2
    adda.w d2,a1
    move.w d0,d3
    and.w #15,d3
    eor.w #15,d3
    moveq #0,d4
    moveq #0,d5
.colour:
    move.w (a1)+,d2
    btst d3,d2
    beq.s .bit
    bset d5,d4
.bit:
    addq.w #1,d5
    cmp.w #4,d5
    blo.s .colour
    tst.w d4
    bne.s .steady
    moveq #13,d4
.steady:
    cmp.w #14,d4
    bne.s .address
    moveq #6,d4
.address:
    mulu sg_words,d1
    lsr.w #4,d0
    add.w d0,d1
    mulu #10,d1
    move.l sg_output,a0
    lea 4(a0,d1.l),a0
    moveq #1,d5
    lsl.w d3,d5
    move.w d5,d6
    not.w d6
    and.w d6,(a0)+ ; opacity mask
    moveq #3,d3
.plane:
    and.w d6,(a0)
    lsr.w #1,d4
    bcc.s .next
    or.w d5,(a0)
.next:
    addq.l #2,a0
    dbra d3,.plane
    movem.l (sp)+,d0-d6/a0-a1
.done:
    rts

sg_dimensions: dc.w 128,51,32,45,64,41

; Atari bitmaps already use the authoring pixel dimensions.
    q_subr ship_put_bitmap,global
    jmp put_bitmap

    section ship_graphics,bss
ship_graphics_begin: ds.l 1
ship_yard_atlas: ds.b ship_count*sg_yard_bytes
ship_yard_end: ds.l 1
ship_status_image: ds.b sg_status_bytes
ship_status_end: ds.l 1
ship_planet_image: ds.b sg_planet_bytes
ship_planet_end: ds.l 1
ship_graphics_work:
sg_ready: ds.w 1
sg_view: ds.w 1
sg_output: ds.l 1
sg_surfaces: ds.l 1
sg_material: ds.l 1
sg_width: ds.w 1
sg_height: ds.w 1
sg_words: ds.w 1
sg_node_count: ds.w 1
sg_scale: ds.w 1
sg_minx: ds.w 1
sg_maxx: ds.w 1
sg_miny: ds.w 1
sg_maxy: ds.w 1
sg_solid: ds.w 1
sg_firstx: ds.w 1
sg_firsty: ds.w 1
sg_lastx: ds.w 1
sg_lasty: ds.w 1
sg_sx: ds.w 1
sg_sy: ds.w 1
sg_lines: ds.b 16
sg_points: ds.w max_nodes*2
sg_spans: ds.w 51*2
    ds.l 1
ship_graphics_end:
