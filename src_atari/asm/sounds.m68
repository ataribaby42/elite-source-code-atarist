	dc.l fx_alert ; F
	dc.l fx_error ; G
	dc.l fx_hexagon ; H
	dc.l fx_ecm ; I
	dc.l fx_hit ; J
	dc.l fx_spacejump ; K
	dc.l fx_missile ; L
	dc.l fx_warp ; M
	dc.l fx_cargo ; N
