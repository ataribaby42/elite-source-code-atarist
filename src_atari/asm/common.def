hold: rs.l max_products ; amount of in cargo hold
police_record: rs.w 1 ; police record (0=harmless)
galaxy_no: rs.w 1 ; current galaxy no.
current: rs.w 1 ; current planet system
range: rs.l 1 ; range to point
roll_sin: rs.l 1 ; sine and cosine of roll !!
roll_cos: rs.l 1
climb_sin: rs.l 1 ; sine and cosine of climb !!
climb_cos: rs.l 1
view: rs.w 1 ; current view
radius: rs.w 1 ; misc. radius values
objects: rs.b obj_size ; array of object records
who_ecm: rs.w 1 ; flag  who started ECM
witch_space: rs.w 1 ; flag  in witch space
tharg_count: rs.w 1 ; thargoid kill counter
witch_x: rs.w 1 ; galactic coords of witchspace
witch_y: rs.w 1
tharg_max: rs.w 1 ; no. thargoids to kill
controls_locked: rs.w 1 ; flag  controls are locked
shuttle_ctr: rs.w 1 ; counter to next shuttle launch
asteroid_ctr: rs.w 1 ; counter to next asteroid launch
trader_ctr: rs.w 1 ; counter to next trader launch
pirate_ctr: rs.w 1 ; counter to next pirate launch
fast_ticker: rs.w 1 ; interrupt fast ticker
pad_char: rs.w 1 ; pad character for BUILD_NUMBER
no_entry: rs.w 1 ; flag  prevent entry to space station
visible: rs.w 1 ; flag  object is visible
in_sights: rs.w 1 ; flag  object is in sights
checkpoint: rs.w 1 ; flag  set at space station checkpoint
id_trigger: rs.w 1 ; flag  trigger ID message
cloaking_on: rs.w 1 ; flag  cloaking device active
max_laser: rs.w 1 ; max. energy laser fitted (0..3)
collided: rs.w 1 ; flag  collided with object
mission_planet: rs.w 1 ; current mission planet
mission_count: rs.w 1 ; no. planets left to visit on mission
ecm_jammed: rs.w 1 ; flag  ECM jammed
station_destroyed: rs.w 1 ; flag  space station destroyed
fluctuation: rs.w 1 ; random price fluctutation
scr_base: rs.l 1 ; base address of current screen
charset_ptr: rs.l 1 ; ptr  character set
ink_ptr: rs.l 1 ; ptr  ink data table
paper_ptr: rs.l 1 ; ptr  paper data table
stack: rs.l stack_size ; program stack
stack_top: rs.l 0 ; top of stack
number_buffer: rs.b 16 ; buffer for PRINT_NUMBER
l_view_ptr: rs.l 1 ; ptr  view swap routine (32 bit)
w_view_ptr: rs.l 1 ; ptr  view swap routine (16 bit)
debug_data: rs.b 16 ; debug data area
save_ssp: rs.l 1 ; saved value of system stack
file_source: rs.w 1 ; flag  file load source (disk/com-link)
flyback: rs.w 1 ; flag  flyback has occured
obj_ctr: rs.b max_obj_num ; count of each object
	rs.w 0
key_states: rs.b 128 ; keyboard key states
pad: rs.b 128 ; pad buffer
text_buffer: rs.b 128 ; text blatt buffer
player_record: rs.b obj_len ; player's object record
print_ptr: rs.l 1 ; ptr  print character
sys_key: rs.l 1 ; ptr  system keyboard/midi exception
range_spr: rs.b sprite_len ; range circle sprite
cursor_spr: rs.b sprite_len ; cross-hair cursor sprite
missile_spr: rs.b sprite_len ; missile sprite
view_spr: rs.b sprite_len ; cockpit view sprite
radar1_spr: rs.b sprite_len ; mini-radar sprites (dual screen)
radar2_spr: rs.b sprite_len
io_buffer: rs.b io_size ; disk i/o buffer
display_clock: rs.w 1 ; flag  display clock on vblank
vblank_ptr: rs.l 1 ; ptr  entry used in VBLANK list
pulse_dir: rs.w 1 ; direction of pulse (0=none)
pulse_ctr: rs.w 1 ; pulse counter
game_frozen: rs.w 1 ; flag  game is frozen
planet_list: rs.w 64 ; list of planets on local chart
rotate_vars: rs.w rotate_vsize ; local variables
attract_vars: rs.w attract_vsize
sounds_vars: rs.w sounds_vsize
disk_vars: rs.w disk_vsize
galaxy_vars: rs.w galaxy_vsize
cockpit_vars: rs.w cockpit_vsize
dust_vars: rs.w dust_vsize
graphics_vars: rs.w graphics_vsize
flight_vars: rs.w flight_vsize
orbit_vars: rs.w orbit_vsize
init_vars: rs.w init_vsize
radar_vars: rs.w radar_vsize
combat_vars: rs.w combat_vsize
special_vars: rs.w special_vsize
vector_vars: rs.w vector_vsize
except_vars: rs.w except_vsize
cargo_vars: rs.w cargo_vsize
sprites_vars: rs.w sprites_vsize
bios_vars: rs.w bios_vsize
equip_vars: rs.w equip_vsize
pdata_vars: rs.b pdata_vsize
options_vars: rs.b options_vsize
funny_vars: rs.w funny_vsize
effects_vars: rs.w effects_vsize
auto_vars: rs.w auto_vsize
action_vars: rs.w action_vsize
reduce_ctr: rs.w 1 ; energy reduction counter
dust_ctr: rs.w 1 ; ctr  increase length of dust
end_hyperspace: rs.w 1 ; flag  end of hyperspace effect
latch: rs.w 1 ; rate of dust length increase
radar_obj: rs.w 1 ; object # on mini-radar
last1_ptr: rs.l 1 ; ptr  last record in buffers
last2_ptr: rs.l 1
last_ptr: rs.l 1 ; ptr  last record stored
approach: rs.w 1 ; object approach speed
hit_check: rs.w 1 ; flag  check for laser hit
laser_pending: rs.w 1 ; shot accepted before the current game frame
laser_beam: rs.w 1 ; held beam/military visual request for this frame
laser_flash: rs.w 1 ; flag  short pulse flash is active
laser_flash_end: rs.l 1 ; pulse flash expiry (50 Hz flyback clock)
laser_tip_x: rs.w 1 ; cosmetic jitter only, never used for targeting
laser_tip_y: rs.w 1
judder_ctr: rs.w 1 ; screen judder counter
radar_scale: rs.l 1 ; current radar scale range
old_speed: rs.w 1 ; speed of cobra before jump
max_len: rs.w 1 ; maximum length of dust
colour_ptr: rs.l 1 ; ptr  graphics colour masks
sun_flare: rs.w 1 ; flag  add sun flare to circle
flare_count: rs.w 1 ; flare bits counter
clip_panel: rs.w 1 ; panel clip flags
poly_min_y: rs.w 1 ; min y coord of polygon
poly_max_y: rs.w 1 ; max y coord of polygon
top_ptr: rs.l 1 ; ptr  node on top of polygon
top_memory: rs.l 1 ; ptr  top of memory
next_record: rs.l 1 ; ptr  next record in draw list
sys_hblank: rs.l 1 ; ptr  system hblank exception
f_front: rs.w 1 ; instrument change flags
f_aft: rs.w 1
f_fuel: rs.w 1
f_temp: rs.w 1
f_laser: rs.w 1
f_altitude: rs.w 1
f_missiles: rs.w 1
f_speed: rs.w 1
f_roll: rs.w 1
f_climb: rs.w 1
f_energy: rs.w 1
f_magnify: rs.w 1
f_echar: rs.w 1
f_schar: rs.w 1
action_table: rs.l 1 ; ptr  mouse action table
button_pressed: rs.w 1 ; flag  mouse button pressed
action_ptr: rs.l 1 ; ptr  routine to execute
function: rs.w 1 ; function # (as in action table)
cursor_type: rs.w 1 ; type of cursor (0,1 or 2)
icon_inverted: rs.w 1 ; flag  icon is inverted
temp_spr: rs.b sprite_len ; temporary sprite
click_rate: rs.w 1 ; double click rate (usually 10)
hyper_spr: rs.b sprite_len ; hyperspace destination sprite
saved_palette: rs.b 32 ; saved system palette
move_x: rs.w 1 ; mouse cursor movement counters
move_y: rs.w 1
exp_distance: rs.w 1 ; distance of explosion from centre
prog_checksum: rs.w 1 ; checksum of program
ok_checksum: rs.w 1 ; correct checkum
device: rs.w 1 ; input device, 0=mouse,!0=joystick
from_mouse: rs.w 1 ; flag  control from mouse
stop_cycle: rs.w 1 ; flag  stop colour cyling
check_key: rs.w 1 ; flag  check next key press
fx_off: rs.w 1 ; flag  kill doors sound effect
slow_print: rs.w 1 ; flag  print text string slowly
invisible: rs.w 1 ; flag  object invisible
retro_used: rs.w 1 ; no. times retro's have been used
retro_count: rs.w 1 ; retro-rocket duration counter
reverse_draw: rs.w 1 ; flag  draw objects backwards
torus_ctr: rs.w 1 ; jump drive counter
allow_hack: rs.w 1 ; flag  allow hacking
logo_shown: rs.w 1 ; flag  Elite logo already shown
cycle_type: rs.w 1 ; colour cycle type
screen1_ptr: rs.l 1 ; ptr  screen #1
screen2_ptr: rs.l 1 ; ptr  screen #2
flip_screen: rs.l 1 ; eor mask for flipping screens

var_size: equ __RS ; size of variables

; Pointers to common objects.

planet_rec: equ objects+obj_len*0
station_rec: equ objects+obj_len*1
sun_rec: equ objects+obj_len*2
