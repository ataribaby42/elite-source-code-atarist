	include "common.def"
; Ported from src-orig/VECTOR_M68; edit this copy.
* @@  @@ @@@@@@@   @@@@   @@@@@@   @@@	 @@@@@@
* @@  @@  @@   @  @@  @@  @ @@ @  @@ @@   @@  @@
* @@  @@  @@ @	 @@ 		@@	 @@   @@  @@  @@
* @@  @@  @@@@	 @@ 		@@	 @@   @@  @@@@@
* @@  @@  @@ @	 @@ 		@@	 @@   @@  @@ @@
