	include "common.def"
; Ported from src_orig/asm/special.m68; edit this copy.
*	@@@@  @@@@@@  @@@@@@@	@@@@   @@@@@@	 @@   @@@@
*  @@  @@  @@  @@  @@	@  @@  @@	 @@ 	@@@@   @@
*  @@	   @@  @@  @@ @   @@		 @@    @@  @@  @@
*	@@@@   @@@@@   @@@@   @@		 @@    @@  @@  @@
*	   @@  @@	   @@ @   @@		 @@    @@@@@@  @@	@
*  @@  @@  @@	   @@	@  @@  @@	 @@    @@  @@  @@  @@
*	@@@@  @@@@	  @@@@@@@	@@@@   @@@@@@  @@  @@ @@@@@@@

* Routines to draw special objects in the 3D world. These basically covers
* all non-3D objects, i.e. planets, suns, lasers, explosions.

* Version 1.0 25th June 1988 Copyright (c) 1988 Mr. Micro Ltd.
* Designed and coded by Rob Nicholson.

	include "macros.m68"

	xref draw_planet_surface
	xref set_colour,polygon,circle,c_line,c_plotxy,explode_vectors
	xref solid_polygon,line
	xref calc_yvector,transform

	q_module special

* ---- LOCAL CONSTANTS ----


* ---- LOCAL VARIABLES ----

	q_vars special

exp_colour: rs.w 1 ; colour of explosion points
ai_laser_colour: rs.w 1 ; normal AI beam colour cached for the current flight

	q_end_vars special

	q_module special

* *****************************************
* **									 **
* ** DRAW_POINT - DRAW POINT TYPE OBJECT **
* **									 **
* *****************************************

* Draws a point type object, i.e. sun, planet or small object.

* Entry: D0 = object type
* Exit:  None

* Regs:  ?
* Subr:  ?

	q_subr draw_point,global

	cmp #hyp_circle,d0 ; hyperspace circle ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_special_m68_1
	move obj_colour(a5),d0
	bra.s q_special_m68_2
q_special_m68_1:
	cmp #planet,d0 ; planet ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_special_m68_3
	move obj_colour(a5),d0 ; colour derived from the Planet Data image
	cmp #15,d0
	bhi.s .planet_grey
	tst d0 ; transparent colour
	beq.s .planet_grey
	cmp #drk_grey,d0
	beq.s .planet_grey
	cmp #black,d0
	beq.s .planet_grey
	cmp #14,d0 ; pulsing engine colour
	bne.s .planet_visible
.planet_grey:
	moveq #lgt_grey,d0
.planet_visible:
	cmp #yellow,d0
	bne.s .planet_ready
	moveq #red,d0
.planet_ready:
	bra.s q_special_m68_4
q_special_m68_3:
	cmp #sun,d0 ; sun ?
; Quelo: 			if <eq> then.s				yes
	bne.s q_special_m68_5
	st sun_flare(a6) ; start flare
	moveq #yellow,d0 ; draw in yellow
	bra.s q_special_m68_6
q_special_m68_5:
	cmp #photon,d0 ; photon ?
; Quelo: 				if <eq> then.s			yes, draw in red
	bne.s q_special_m68_7
	moveq #red,d0
	bra.s q_special_m68_8
q_special_m68_7:
	moveq #lgt_grey,d0 ; draw blob in grey
q_special_m68_8:
q_special_m68_6:
q_special_m68_4:
q_special_m68_2:
	jsr set_colour
	movem centre_x(a5),d5/d6 ; draw a solid circle
	move scr_radius(a5),d7
	q_dec d7
	jsr circle
	clr sun_flare(a6) ; clear flare flag
	cmp.w #planet,type(a5)
	bne.s .no_surface
	jsr draw_planet_surface
.no_surface:

	q_ret return


* ********************************************
* **										**
* ** DRAW_EXPLOSION - DRAW OBJECT EXPLOSION **
* **										**
* ********************************************

* Draws the explosion of an object.

* Entry: A5 = ptr: object record
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr draw_explosion,global

	move exp_timer(a5),d7 ; determine no. pixels to draw
	cmp #75,d7
; Quelo: 	if <hs> then.s
	blo.s q_special_m68_9
	moveq #75-1,d7
q_special_m68_9:
	lea explode_vectors,a2 ; point to explosion vectors
	q_loop 1 ; loop for each point
	move exp_colour(a6),d0 ; set pixel colour
	q_inc d0
	and #15,d0
	move d0,exp_colour(a6)
	jsr set_colour
	move (a2)+,d0 ; x = i * exp_radius
	muls exp_rad(a5),d0
	asl.l #2,d0
	swap d0
	move (a2)+,d1 ; y = i * exp_radius
	muls exp_rad(a5),d1
	asl.l #2,d1
	swap d1
	add this_xpos+2(a5),d0 ; add coords of object
	add this_ypos+2(a5),d1
	move this_zpos+2(a5),d2 ; (z = 0)
	ext.l d0 ; xs = x*512/z
	moveq #9,d3
	asl.l d3,d0
	divs d2,d0
; Quelo: 		if <vs> then.s
	bvc.s q_special_m68_11
	tst.l d0
; Quelo: 			if <pl> then.s
	bmi.s q_special_m68_13
	move #maxint,d0
	bra.s q_special_m68_14
q_special_m68_13:
	move #-maxint,d0
q_special_m68_14:
q_special_m68_11:
	ext.l d1 ; ys = y*512/z
	asl.l d3,d1
	divs d2,d1
; Quelo: 		if <vs> then.s
	bvc.s q_special_m68_15
	tst.l d1
; Quelo: 			if <pl> then.s
	bmi.s q_special_m68_17
	move #maxint,d1
	bra.s q_special_m68_18
q_special_m68_17:
	move #-maxint,d1
q_special_m68_18:
q_special_m68_15:
	jsr c_plotxy ; plot pixel (with clipping)
	q_next 1 ; next point

	q_ret


; Two thin, jagged electrical arcs cross the flight viewport for the bomb's
; sound lifetime. MAIN draws a new pair after CLEAR_IMAGE on every frame.
; Coordinates are physical viewport pixels; the native ST raster keeps both
; arcs inside the cockpit window.
; No game RNG calls: this cosmetic effect cannot change encounters or combat.
; All registers and the caller's colour are preserved.
	q_subr draw_bomb_discharge,global

	tst bomb_flash_ticks(a6)
	beq .done
	tst cockpit_on(a6)
	beq .done
	tst docked(a6)
	bne .done
	tst game_over(a6)
	bne .done
	movem.l d0-d7/a0-a5,-(sp)
	move.l colour_ptr(a6),-(sp)
	subq.l #4,sp
	move.l sp,a4 ; previous vertex: physical x,y
	moveq #lgt_blue,d0
	jsr set_colour
	bsr .bolt
	bsr .bolt
	addq.l #4,sp
	move.l (sp)+,colour_ptr(a6)
	movem.l (sp)+,d0-d7/a0-a5
.done:
	rts

.bolt:
	move.w #x_left,(a4)
	bsr .height
	move.w d3,2(a4)
	moveq #7,d7
.segment:
	move.w (a4),d2
	add.w #x_size/8,d2
	cmp.w #x_left+x_size-1,d2
	bls.s .inside
	move.w #x_left+x_size-1,d2
.inside:
	bsr .height
	movem.w (a4),d0-d1
	movem.w d2-d3,(a4)
	jsr line ; native LINE preserves D7 and A4
	dbra d7,.segment
	rts

.height:
	moveq #0,d3
	move.w bomb_flash_seed(a6),d3
	mulu #25173,d3
	add.w #13849,d3
	move.w d3,bomb_flash_seed(a6)
	and.l #$ffff,d3
	mulu #y_size-2*(y_size/12),d3
	swap d3
	add.w #y_top+y_size/12,d3 ; leave a small margin at top and bottom
	rts


* ---- BBC-STYLE SCREEN-SPACE LASERS ----

	q_subr draw_lasers,global

; Tick in the same place as the original projectile renderer, including
; frames with the trigger released. Damage cadence is independent of VBL time.
	tst firing(a6)
	beq.s .visual
	subq #1,firing(a6)
.visual:
	tst laser_beam(a6) ; consume this frame's held beam/military request
	beq.s .pulse
	clr laser_beam(a6)
	bra.s .draw
.pulse:
	tst hit_check(a6)
	bne.s .draw
	tst laser_flash(a6)
	beq.s .done
	move.l frclock,d0
	sub.l laser_flash_end(a6),d0
	bmi.s .draw
	clr laser_flash(a6)
	bra.s .done
.draw:
	jsr random ; cosmetic jitter continues even between beam damage ticks
	and.w #7,d0
	subq.w #4,d0
	move.w d0,laser_tip_x(a6)
	jsr random
	and.w #3,d0
	subq.w #2,d0
	move.w d0,laser_tip_y(a6)
	move.w laser_type(a6),d0 ; pulse, mining, beam, military (0..3)
	lsl.w #4,d0 ; sixteen bytes: four plane masks for each row parity
	lea laser_colours(pc),a0
	lea (a0,d0.w),a0
	move.l a0,colour_ptr(a6)
	ifne laser_singlebeam
	moveq #-3,d0 ; one narrow base at the bottom centre
	moveq #3,d2
	bsr draw_laser_wedge
	else
	moveq #-92,d0 ; two filled beams converge on the same cosmetic tip
	moveq #-80,d2
	bsr draw_laser_wedge
	moveq #80,d0
	moveq #92,d2
	bsr draw_laser_wedge
	endc
.done:
	rts

; Existing cockpit palette; duplicate each four-plane mask for even/odd rows.
laser_colours:
	dc.w $0000,$ffff,$ffff,$0000 ; pulse: red (6)
	dc.w $0000,$ffff,$ffff,$0000
	dc.w $0000,$0000,$ffff,$0000 ; mining: instrument-bar magenta (4)
	dc.w $0000,$0000,$ffff,$0000
	dc.w $ffff,$ffff,$0000,$0000 ; beam: orange (3)
	dc.w $ffff,$ffff,$0000,$0000
	dc.w $ffff,$ffff,$ffff,$ffff ; military: white (15)
	dc.w $ffff,$ffff,$ffff,$ffff

; D0/D2 = left/right base x. The tip and both bases are inside the viewport.
; Reuse the native solid raster with three temporary linked screen vertices.
; Stack storage keeps code read-only and leaves the world node list intact.
	q_subr draw_laser_wedge

	lea -3*node_len(sp),sp
	move.l sp,a0 ; tip
	lea node_len(a0),a1 ; left base
	lea node_len(a1),a2 ; right base
	move.w laser_tip_x(a6),scr_x(a0)
	move.w laser_tip_y(a6),scr_y(a0)
	move.w d0,scr_x(a1)
	move.w #y_min,scr_y(a1)
	move.w d2,scr_x(a2)
	move.w #y_min,scr_y(a2)
	move.l a1,next(a0)
	move.l a2,prev(a0)
	move.l a2,next(a1)
	move.l a0,prev(a1)
	move.l a0,next(a2)
	move.l a1,prev(a2)
	move.l a0,top_ptr(a6)
	move.w laser_tip_y(a6),poly_max_y(a6)
	move.w #y_min,poly_min_y(a6)
	jsr solid_polygon
	lea 3*node_len(sp),sp
	rts

; Refresh only on station launch or completed hyperspace/galactic jump.
; Preserve all registers; drawing never recomputes this from a changing rating.
	q_subr init_ai_laser_colour,global

	move.l d0,-(sp)
	moveq #white,d0
	cmp.w #6,rating(a6) ; Dangerous through Elite
	bhs.s .store
	moveq #orange,d0
	cmp.w #3,rating(a6) ; Average through Competent
	bhs.s .store
	moveq #red,d0 ; Harmless through Poor
.store:
	move.w d0,ai_laser_colour(a6)
	move.l (sp)+,d0
	rts

; Render an enemy's shot with its ship, so nearer ships can cover it and the
; sight/text overlays remain above it. Use the same view-space position and
; orientation as the model, rather than the next frame's advanced position.
	q_subr draw_ai_laser,global

	tst ai_laser(a5)
	beq .done
	cmp #log_exploding,logic(a5)
	beq .done
	move.w gun_node(a5),d0
	bmi .done
	cmp.w no_nodes(a5),d0
	bhi .done
	tst.l this_zpos(a5)
	ble .done
	movem.l d0-d7/a0-a5,-(sp)
; Thargoids and Thargons always use light blue, independent of player rating.
	moveq #lgt_blue,d0
	cmp.w #thargoid,type(a5)
	beq.s .laser_colour
	cmp.w #thargon,type(a5)
	beq.s .laser_colour
; Constrictor stays white; other ships keep the colour selected for this flight.
	moveq #white,d0
	cmp.w #constr,type(a5)
	beq.s .laser_colour
	move.w ai_laser_colour(a6),d0
.laser_colour:
	jsr set_colour
	jsr calc_yvector
	move.w gun_node(a5),d0
	lsl.w #3,d0
	move.l nodes(a5),a0
	adda.w d0,a0
	jsr transform
	move.l w_view_ptr(a6),a0
	jsr (a0)
	ext.l d0
	ext.l d1
	ext.l d2
	add.l this_xpos(a5),d0
	add.l this_ypos(a5),d1
	add.l this_zpos(a5),d2
	ble .restore
	cmp.l #32767,d2
	bhi .restore
	moveq #9,d3
	asl.l d3,d0
	divs.w d2,d0
	bvs .restore
	asl.l d3,d1
	divs.w d2,d1
	bvs .restore
	cmp.w #32000,d0 ; keep deltas representable in the 16-bit line clipper
	bgt .restore
	cmp.w #-32000,d0
	blt .restore
	cmp.w #32000,d1
	bgt .restore
	cmp.w #-32000,d1
	blt .restore
	move.l target(a5),d4 ; shooting at another ship ?
	ble .screen_edge ; no, keep the original endpoint
	move.l d4,a1
	move.l this_zpos(a1),d6
	ble .restore ; the target is behind the camera
	cmp.l #32767,d6
	bhi .restore
	move.l this_xpos(a1),d4
	move.l this_ypos(a1),d5
	moveq #9,d7
	asl.l d7,d4
	divs.w d6,d4
	bvs .restore
	asl.l d7,d5
	divs.w d6,d5
	bvs .restore
	cmp.w #32000,d4 ; keep deltas inside the 16-bit line clipper
	bgt .restore
	cmp.w #-32000,d4
	blt .restore
	cmp.w #32000,d5
	bgt .restore
	cmp.w #-32000,d5
	blt .restore
	cmp.w #2,ai_laser(a5) ; a hit lands exactly on the target
	beq.s .aimed
	movem.l d0-d1,-(sp) ; RANDOM's scratch registers are D0 and D1
	jsr random ; the same magnitude as the player's tip jitter
	and.w #7,d0
	subq.w #4,d0
	add.w d0,d4
	jsr random
	and.w #3,d0
	subq.w #2,d0
	add.w d0,d5
	movem.l (sp)+,d0-d1
.aimed:
	move.w d4,d2
	move.w d5,d3
	jsr c_line
	bra .restore

; BBC sends the beam at the player to the opposite screen edge. Its moving
; endpoint is cosmetic; AI damage has already been decided from the actual
; firing angle.
.screen_edge:
	move.w #x_min,d2
	tst.w d0
	bpl.s .endpoint
	move.w #x_max,d2
.endpoint:
	moveq #0,d3
	move.b this_zpos+3(a5),d3
	mulu.w #y_max-y_min+1,d3
	lsr.w #8,d3
	neg.w d3
	add.w #y_max,d3
	jsr c_line
.restore:
	movem.l (sp)+,d0-d7/a0-a5
.done:
	rts



; One byte per system: galaxy (0..7) * 256 + planet (0..255).
; Entry: A4 = planet record. All registers preserved; independent of mission.
    q_subr set_planet_colour,global
    movem.l d0-d1/a0,-(sp)
    move.w galaxy_no(a6),d1
    cmp.w #7,d1
    bhi.s .fallback
    lsl.w #8,d1
    move.w current(a6),d0
    cmp.w #255,d0
    bhi.s .fallback
    add.w d0,d1
    lea planet_colours(pc),a0
    moveq #0,d0
    move.b (a0,d1.w),d0
    bra.s .store
.fallback:
    moveq #lgt_grey,d0
.store:
    cmp.w #yellow,d0
    beq.s .red
    cmp.w #pulse,d0 ; legacy UI brown
    bne.s .store_colour
.red:
    moveq #red,d0
.store_colour:
    move.w d0,obj_colour(a4)
    movem.l (sp)+,d0-d1/a0
    rts

planet_colours:
    incbin "PLANET_COL.BIN"
    even
