	include "common.def"
; Ported from src-orig/MAIN_M68; edit this copy.
* @@   @@	 @@    @@@@@@ @@   @@
* @@@ @@@	@@@@	 @@   @@@  @@
* @@@@@@@  @@  @@	 @@   @@@@ @@
* @@@@@@@  @@  @@	 @@   @@ @@@@
* @@ @ @@  @@@@@@	 @@   @@  @@@
