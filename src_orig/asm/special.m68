	include "common.def"
; Converted from SPECIAL.M68 in resources/elite_atarist_source.zip.
*	@@@@  @@@@@@  @@@@@@@	@@@@   @@@@@@	 @@   @@@@
*  @@  @@  @@  @@  @@	@  @@  @@	 @@ 	@@@@   @@
*  @@	   @@  @@  @@ @   @@		 @@    @@  @@  @@
*	@@@@   @@@@@   @@@@   @@		 @@    @@  @@  @@
*	   @@  @@	   @@ @   @@		 @@    @@@@@@  @@	@
*  @@  @@  @@	   @@	@  @@  @@	 @@    @@  @@  @@  @@
*	@@@@  @@@@	  @@@@@@@	@@@@   @@@@@@  @@  @@ @@@@@@@

* Routines to draw special objects in the 3D world. These basically covers
* all non-3D objects, i.e. planets, suns, lasers, explosions.

* Version 1.0 25th June 1988 Copyright (c) 1988 Mr. Micro Ltd.
* Designed and coded by Rob Nicholson.

	include "macros.m68"

	xref set_colour,polygon,circle,c_line,c_plotxy,explode_vectors

	q_module special

* ---- LOCAL CONSTANTS ----

pulse_size: equ 150 ; length of laser beam pulse
pulse_speed: equ 550 ; speed of the laser

* ---- LOCAL VARIABLES ----

	q_vars special

exp_colour: rs.w 1 ; colour of explosion points

	q_end_vars special

	q_module special

* *****************************************
* **									 **
* ** DRAW_POINT - DRAW POINT TYPE OBJECT **
* **									 **
* *****************************************

* Draws a point type object, i.e. sun, planet or small object.

* Entry: D0 = object type
* Exit:  None

* Regs:  ?
* Subr:  ?

	q_subr draw_point,global

	cmp #hyp_circle,d0 ; hyperspace circle ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_special_m68_1
	move obj_colour(a5),d0
	bra.s q_special_m68_2
q_special_m68_1:
	cmp #planet,d0 ; planet ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_special_m68_3
	moveq #drk_green,d0 ; draw in green
	bra.s q_special_m68_4
q_special_m68_3:
	cmp #sun,d0 ; sun ?
; Quelo: 			if <eq> then.s				yes
	bne.s q_special_m68_5
	st sun_flare(a6) ; start flare
	moveq #yellow,d0 ; draw in yellow
	bra.s q_special_m68_6
q_special_m68_5:
	cmp #photon,d0 ; photon ?
; Quelo: 				if <eq> then.s			yes, draw in red
	bne.s q_special_m68_7
	moveq #red,d0
	bra.s q_special_m68_8
q_special_m68_7:
	moveq #lgt_grey,d0 ; draw blob in grey
q_special_m68_8:
q_special_m68_6:
q_special_m68_4:
q_special_m68_2:
	jsr set_colour
	movem centre_x(a5),d5/d6 ; draw a solid circle
	move scr_radius(a5),d7
	q_dec d7
	jsr circle
	clr sun_flare(a6) ; clear flare flag

	q_ret return


* ********************************************
* **										**
* ** DRAW_EXPLOSION - DRAW OBJECT EXPLOSION **
* **										**
* ********************************************

* Draws the explosion of an object.

* Entry: A5 = ptr: object record
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr draw_explosion,global

	move exp_timer(a5),d7 ; determine no. pixels to draw
	cmp #75,d7
; Quelo: 	if <hs> then.s
	blo.s q_special_m68_9
	moveq #75-1,d7
q_special_m68_9:
	lea explode_vectors,a2 ; point to explosion vectors
	q_loop 1 ; loop for each point
	move exp_colour(a6),d0 ; set pixel colour
	q_inc d0
	and #15,d0
	move d0,exp_colour(a6)
	jsr set_colour
	move (a2)+,d0 ; x = i * exp_radius
	muls exp_rad(a5),d0
	asl.l #2,d0
	swap d0
	move (a2)+,d1 ; y = i * exp_radius
	muls exp_rad(a5),d1
	asl.l #2,d1
	swap d1
	add this_xpos+2(a5),d0 ; add coords of object
	add this_ypos+2(a5),d1
	move this_zpos+2(a5),d2 ; (z = 0)
	ext.l d0 ; xs = x*512/z
	moveq #9,d3
	asl.l d3,d0
	divs d2,d0
; Quelo: 		if <vs> then.s
	bvc.s q_special_m68_11
	tst.l d0
; Quelo: 			if <pl> then.s
	bmi.s q_special_m68_13
	move #maxint,d0
	bra.s q_special_m68_14
q_special_m68_13:
	move #-maxint,d0
q_special_m68_14:
q_special_m68_11:
	ext.l d1 ; ys = y*512/z
	asl.l d3,d1
	divs d2,d1
; Quelo: 		if <vs> then.s
	bvc.s q_special_m68_15
	tst.l d1
; Quelo: 			if <pl> then.s
	bmi.s q_special_m68_17
	move #maxint,d1
	bra.s q_special_m68_18
q_special_m68_17:
	move #-maxint,d1
q_special_m68_18:
q_special_m68_15:
	jsr c_plotxy ; plot pixel (with clipping)
	q_next 1 ; next point

	q_ret


* ****************************************
* **									**
* ** DRAW_LASERS - DRAW OUT LASER BEAMS **
* **									**
* ****************************************

* Draws out aser beams in the 3D world.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr draw_lasers,global

	tst firing(a6) ; laser fire timer
; Quelo: 	if <ne> then.s
	beq.s q_special_m68_19
	q_dec firing(a6)
q_special_m68_19:
	moveq #lgt_blue,d0 ; draw lasers lines in light blue
	jsr set_colour
	lea lasers(a6),a5 ; point to 1st laser
	q_loop 1,max_lasers ; loop for each laser
	tst active(a5) ; laser in use ?
; Quelo: 		if <ne> then.s					yes
	beq.s q_special_m68_21
	bsr draw_laser ; draw the laser
q_special_m68_21:
	add.l #laser_len,a5 ; next record
	q_next 1

	q_ret


* ************************************
* **								**
* ** DRAW_LASER - DRAW A LASER BEAM **
* **								**
* ************************************

* Draws the current laser beam.

* Entry: A5 = ptr: laser beam record
* Exit:  None

* Regs: ?
* Subr: C_LINE

	q_subr draw_laser

	q_push d7 ; save D7
	movem pulse_x(a5),d0-d2 ; fetch laser coords
	move vector+i(a5),d3 ; calculate coords of end point
	muls #pulse_size,d3
	asl.l #2,d3
	swap d3
	add d0,d3
	move vector+j(a5),d4
	muls #pulse_size,d4
	asl.l #2,d4
	swap d4
	add d1,d4
	move vector+k(a5),d5
	muls #pulse_size,d5
	asl.l #2,d5
	swap d5
	add d2,d5
	moveq #9,d6 ; xs1 = x1 * 512 / z1
	asl.l d6,d0
	divs d2,d0
; Quelo: 	if <vs> then.s
	bvc.s q_special_m68_23
	move #-maxint,d0
q_special_m68_23:
	asl.l d6,d1 ; ys1 = y1 * 512 / z1
	divs d2,d1
; Quelo: 	if <vs> then.s
	bvc.s q_special_m68_25
	move #-maxint,d1
q_special_m68_25:
	ext.l d3 ; xs2 = x2 * 512 / z2
	asl.l d6,d3
	divs d5,d3
; Quelo: 	if <vs> then.s
	bvc.s q_special_m68_27
	move #-maxint,d3
q_special_m68_27:
	ext.l d4 ; ys2 = y2 * 512 / z2
	asl.l d6,d4
	divs d5,d4
; Quelo: 	if <vs> then.s
	bvc.s q_special_m68_29
	move #-maxint,d3
q_special_m68_29:
	move d3,d2 ; draw the lines
	move d4,d3
	movem d0-d3,-(sp)
	jsr c_line
	movem (sp)+,d0-d3
	neg d0
	neg d2
	jsr c_line
	lea pulse_x(a5),a0 ; move laser through space
	lea vector(a5),a1
	q_loop 1,3
	move (a1)+,d0 ; fetch vector component
	muls #pulse_speed,d0 ; multiply by laser speed
	asl.l #2,d0
	swap d0
	add d0,(a0)+ ; add to coordinate
	q_next 1
	q_dec life(a5) ; laser reached target ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_special_m68_31
	st at_target(a6) ; set reached target flag
	clr active(a5) ; record is free
q_special_m68_31:
	q_pop d7 ; restore D7

	q_ret

