	include "common.def"
; Converted from EXCEPT.M68 in resources/elite_atarist_source.zip.
* @@@@@@@ @@   @@	@@@@  @@@@@@@ @@@@@@   @@@@@@
*  @@	@  @@ @@   @@  @@  @@	@  @@  @@  @ @@ @
*  @@ @ 	@@@   @@	   @@ @    @@  @@	 @@
*  @@@@ 	@@@   @@	   @@@@    @@@@@	 @@
*  @@ @    @@ @@  @@	   @@ @    @@		 @@
