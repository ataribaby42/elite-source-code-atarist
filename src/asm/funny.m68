* Base string for planet description

base_string: dc.b 6,146,'is ',147,4,'.',0

* 'IAN' suffix to planet name.

ianstr: dc.b 'ian ',0

* The 5 vowels.

vowels: dc.b 'aeiou'

* The mission text message.

text1: dc.b 'There''s a mean nasty ship out there waiting to destroy you!',0
