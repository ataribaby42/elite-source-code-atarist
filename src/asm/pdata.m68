	include "common.def"
; Ported from src-orig/PDATA_M68; edit this copy.
* @@@@@@  @@@@@ 	 @@    @@@@@@	 @@
*  @@  @@  @@ @@	@@@@   @ @@ @	@@@@
*  @@  @@  @@  @@  @@  @@	 @@    @@  @@
*  @@@@@   @@  @@  @@  @@	 @@    @@  @@
*  @@	   @@  @@  @@@@@@	 @@    @@@@@@
*  @@	   @@ @@   @@  @@	 @@    @@  @@
