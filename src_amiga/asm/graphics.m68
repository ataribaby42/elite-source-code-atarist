	include "common.def"
; Ported from src-orig/GRAPHICS_M68; edit this copy.
*	@@@@  @@@@@@	 @@   @@@@@@   @@  @@  @@@@@@	@@@@	@@@@
*  @@  @@  @@  @@	@@@@   @@  @@  @@  @@	 @@    @@  @@  @@  @@
* @@	   @@  @@  @@  @@  @@  @@  @@  @@	 @@   @@	   @@
* @@	   @@@@@   @@  @@  @@@@@   @@@@@@	 @@   @@		@@@@
* @@  @@@  @@ @@   @@@@@@  @@	   @@  @@	 @@   @@		   @@
*  @@  @@  @@  @@  @@  @@  @@	   @@  @@	 @@    @@  @@  @@  @@
