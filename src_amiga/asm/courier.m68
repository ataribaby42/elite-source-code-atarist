; Elite Unbound / Elite-A Special Cargo delivery rules, native 68000 UI.
    include "common.def"
    include "macros.m68"
    xref check_docked,invert_icon,prepare_text,print_centre,init_cursor
    xref locate,text_colour,print_string,print_number,build_name,error_box,fx,wait,read_key
    xref disp_distance
    xref launch,buy_cargo,sell_cargo,equip_ship,galactic_chart,local_chart
    xref data,status,disk,find_planet,home_cursor,options,market_prices,inventory
    q_module courier

; Validate the optional eight-byte SCG1 tail without treating load as docking.
    q_subr courier_validate,global
    clr.w courier_mode(a6)
    clr.w courier_count(a6)
    clr.l courier_next_action(a6)
    cmp.l #$53434731,courier_tag(a6)
    beq.s .target
    move.l #$53434731,courier_tag(a6)
    clr.l courier_reward(a6)
    rts
.target:
    tst.w courier_reward(a6)
    beq.s .done
    bsr courier_find_target
    tst.w d0
    bpl.s .done
    clr.w courier_reward(a6)
.done:
    rts

; Private galaxy seed: exactly four 16-bit twists per planet, no flight RNG.
courier_next:
    moveq #3,d3
.twist:
    move.w courier_seed(a6),d0
    add.w courier_seed+2(a6),d0
    add.w courier_seed+4(a6),d0
    move.w courier_seed+2(a6),courier_seed(a6)
    move.w courier_seed+4(a6),courier_seed+2(a6)
    move.w d0,courier_seed+4(a6)
    dbra d3,.twist
    rts

courier_first:
    move.l gal_seed(a6),courier_seed(a6)
    move.w gal_seed+4(a6),courier_seed+4(a6)
    rts

; D0.w = target index, or -1. Old coordinates survive completion/expiry.
    q_subr courier_find_target,global
    movem.l d1-d7/a0-a5,-(sp)
    bsr courier_first
    moveq #0,d7
.planet:
    move.b courier_seed+2(a6),d0
    cmp.b courier_x(a6),d0
    bne.s .next
    move.b courier_seed(a6),d0
    cmp.b courier_y(a6),d0
    beq.s .found
.next:
    bsr courier_next
    addq.w #1,d7
    cmp.w #256,d7
    blo.s .planet
    moveq #-1,d7
.found:
    move.w d7,d0
    movem.l (sp)+,d1-d7/a0-a5
    rts

; 6502 ADC/SBC helpers: byte accumulator D0, operand D1, carry D2 (0/1).
courier_adc:
    add.w d1,d0
    add.w d2,d0
    move.w d0,d2
    lsr.w #8,d2
    and.w #255,d0
    rts
courier_sbc:
    sub.w d1,d0
    add.w d2,d0
    subq.w #1,d0
    moveq #0,d2
    tst.w d0
    bmi.s .mask
    moveq #1,d2
.mask:
    and.w #255,d0
    rts

; Deterministic offers. Each record: planet, packed X/Y, legal, fee, reward.
; The walk matches Unbound: advance before testing, stop before system wrap.
    q_subr courier_generate,global
    movem.l d0-d7/a0-a5,-(sp)
    clr.w courier_count(a6)
    tst.w courier_reward(a6)
    bne .done
    moveq #0,d0
    move.b fluctuation+1(a6),d0
    move.b splanet+seed+2(a6),d1
    eor.b d1,d0
    move.b splanet+seed(a6),d1
    eor.b d1,d0
    move.b police_record+1(a6),d1
    eor.b d1,d0
    move.b score+3(a6),d1
    eor.b d1,d0
    move.w d0,courier_skip(a6)
    moveq #0,d0
    move.b police_record+1(a6),d0
    moveq #0,d1
    move.b galaxy_no+1(a6),d1
    moveq #1,d2
    bsr courier_adc
    move.w player_ship(a6),d1
    bsr courier_adc
    move.w d0,courier_stride(a6)
    move.w courier_skip(a6),d1
    bsr courier_adc
    moveq #0,d1
    move.b courier_x(a6),d1
    bsr courier_sbc
    move.b courier_y(a6),d1
    bsr courier_sbc
    and.w #15,d0
    move.w d0,courier_limit(a6)
    beq .done
    bsr courier_first
    moveq #0,d7
    lea courier_offers(a6),a5
.walk:
    bsr courier_next
    addq.w #1,d7
    cmp.w #256,d7
    beq .done
    subq.b #1,courier_skip+1(a6)
    bne .walk
    move.b courier_seed+2(a6),d0
    cmp.b splanet+seed+2(a6),d0
    bne.s .offer
    move.b courier_seed(a6),d0
    cmp.b splanet+seed(a6),d0
    beq .next_offer
.offer:
    move.w d7,(a5)
    move.b courier_seed+2(a6),2(a5)
    move.b courier_seed(a6),3(a5)
    moveq #0,d0
    move.b courier_seed+2(a6),d0
    move.b courier_seed+4(a6),d1
    eor.b d1,d0
    move.b courier_stride+1(a6),d1
    eor.b d1,d0
    cmp.b police_record+1(a6),d0
    blo.s .legal
    moveq #0,d0
.legal:
    move.w d0,4(a5)
    moveq #0,d0
    move.b 2(a5),d0
    moveq #0,d1
    move.b splanet+seed+2(a6),d1
    sub.w d1,d0
    bpl.s .dx
    neg.w d0
.dx:
    mulu.w d0,d0
    move.l d0,d4
    moveq #0,d0
    move.b 3(a5),d0
    move.b splanet+seed(a6),d1
    sub.w d1,d0
    bpl.s .dy
    neg.w d0
.dy:
    lsr.w #1,d0
    mulu.w d0,d0
    add.w d0,d4 ; preserve the reference's 16-bit square-sum overflow
    and.l #65535,d4
    moveq #0,d5
.sqrt:
    move.w d5,d0
    addq.w #1,d0
    mulu.w d0,d0
    cmp.l d4,d0
    bhi.s .distance
    addq.w #1,d5
    bra.s .sqrt
.distance:
    moveq #0,d0
    move.b courier_seed(a6),d0
    move.b courier_seed+4(a6),d1
    eor.b d1,d0
    move.b courier_stride+1(a6),d1
    eor.b d1,d0
    lsr.w #3,d0
    cmp.w d5,d0
    bhs.s .value
    move.w d5,d0
.value:
    or.w 4(a5),d0
    move.w d0,d1
    lsl.w #8,d0
    or.w d1,d0
    lsr.w #3,d0 ; entry fee = floor(high * 257 / 8), in tenths
    move.w d0,6(a5)
    and.w #255,d0
    lsl.w #8,d1
    or.w d1,d0 ; reward high is NOT the shifted fee high
    move.w d0,8(a5)
    lea 10(a5),a5
    addq.w #1,courier_count(a6)
    move.w courier_count(a6),d0
    cmp.w courier_limit(a6),d0
    bhs.s .done
.next_offer:
    move.w courier_stride(a6),courier_skip(a6)
    bra .walk
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; D0 = displayed row. Returns 0 success, 1 insufficient cash, 2 invalid.
    q_subr courier_accept,global
    tst.w docked(a6)
    beq.s .invalid
    tst.w courier_reward(a6)
    bne.s .invalid
    cmp.w courier_count(a6),d0
    bhs.s .invalid
    mulu.w #10,d0
    lea courier_offers(a6),a0
    adda.l d0,a0
    moveq #0,d0
    move.w 6(a0),d0
    cmp.l cash(a6),d0
    bhi.s .cash
    sub.l d0,cash(a6)
    move.l #$53434731,courier_tag(a6)
    move.w 8(a0),courier_reward(a6)
    move.w 2(a0),courier_x(a6)
    move.w police_record(a6),d0
    add.w 4(a0),d0
    and.w #255,d0 ; Unbound retains eight-bit legal-status wraparound
    move.w d0,police_record(a6)
    moveq #0,d0
    rts
.cash:
    moveq #1,d0
    rts
.invalid:
    moveq #2,d0
    rts

; Called only by real docking. D0=0 inactive, 1 depreciated, 2 delivered;
; D1=paid amount in tenths. No navigation, inventory or story state changes.
    q_subr courier_settle,global
    moveq #0,d0
    moveq #0,d1
    tst.w courier_reward(a6)
    beq.s .done
    move.b courier_x(a6),d0
    cmp.b splanet+seed+2(a6),d0
    bne.s .half
    move.b courier_y(a6),d0
    cmp.b splanet+seed(a6),d0
    bne.s .half
    move.w courier_reward(a6),d1
    add.l d1,cash(a6)
    clr.w courier_reward(a6) ; clear before displaying any acknowledgement
    moveq #2,d0
    rts
.half:
    lsr.w courier_reward(a6)
    moveq #1,d0
.done:
    rts

    q_subr courier_dock,global
    movem.l d0-d7/a0-a5,-(sp)
    clr.l courier_next_action(a6)
    bsr courier_settle
    cmp.w #2,d0
    bne.s .done
    move.w d1,courier_paid(a6)
    jsr prepare_text
    lea courier_delivered(pc),a0
    moveq #title_y,d1
    jsr print_centre
    bsr courier_detail
    lea courier_receipt_actions(pc),a0
    jsr init_cursor
    bsr courier_wait_receipt
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Poll between VBLs so either a navigation key or a bottom icon dismisses
; the receipt immediately. Dispatch after dock_check, preserving story events.
    q_subr courier_wait_receipt,global
    moveq #95,d7
.wait:
    bsr courier_poll_receipt
    tst.w d0
    bne.s .done
    moveq #1,d0
    jsr wait
    dbra d7,.wait
.done:
    rts

    q_subr courier_poll_receipt,global
    tst.w button_pressed(a6)
    beq.s .key
    move.l action_ptr(a6),courier_next_action(a6)
    move.w function(a6),courier_next_function(a6)
    clr.w button_pressed(a6)
    moveq #1,d0
    rts
.key:
    jsr read_key
    tst.w d0
    beq.s .none
    lea courier_receipt_keys(pc),a0
.scan:
    move.w (a0)+,d1
    bmi.s .none
    cmp.w d1,d0
    beq.s .found
    addq.l #4,a0
    bra.s .scan
.found:
    move.l (a0),courier_next_action(a6)
    clr.w courier_next_function(a6)
    moveq #1,d0
    rts
.none:
    moveq #0,d0
    rts

    q_subr courier_continue,global
    move.l courier_next_action(a6),d0
    clr.l courier_next_action(a6) ; consume once, before a menu can load a game
    tst.l d0
    beq.s .done
    move.l d0,a0
    move.w courier_next_function(a6),d0
    jmp (a0)
.done:
    rts

    q_subr courier_open,global
    jsr check_docked
    move.w #1,courier_mode(a6)
    clr.w courier_paid(a6)
    moveq #icon_buy,d0
    jsr invert_icon
    jsr prepare_text
    lea courier_title(pc),a0
    moveq #title_y,d1
    jsr print_centre
    tst.w courier_reward(a6)
    beq.s .offers
    bsr courier_detail
    lea courier_detail_actions(pc),a0
    jmp init_cursor
.offers:
    bsr courier_generate
    move.w #white,d0
    moveq #black,d1
    jsr text_colour
    clr.w courier_row(a6)
    tst.w courier_count(a6)
    beq.s .none
.row:
    move.w courier_row(a6),d0
    mulu.w #10,d0
    lea courier_offers(a6),a0
    move.w (a0,d0.w),d0
    jsr build_name
    moveq #1,d0
    bsr courier_row_position
    lea planet_name(a6),a0
    jsr print_string
    moveq #20,d0
    bsr courier_row_position
    move.w courier_row(a6),d0
    mulu.w #10,d0
    lea courier_offers(a6),a0
    move.w 6(a0,d0.w),d0
    and.l #65535,d0
    move.w #$8086,d1
    jsr print_number
    addq.w #1,courier_row(a6)
    move.w courier_row(a6),d0
    cmp.w courier_count(a6),d0
    blo.s .row
    lea courier_select_text(pc),a0
    bra.s .footer
.none:
    lea courier_none(pc),a0
.footer:
    jsr print_string
    lea courier_offer_actions(pc),a0
    jmp init_cursor

courier_row_position:
    move.w courier_row(a6),d1
    lsl.w #3,d1
    add.w #26,d1
    jmp locate

courier_detail:
    bsr courier_find_target
    tst.w d0
    bmi.s .done
    jsr build_name
    moveq #white,d0
    moveq #black,d1
    jsr text_colour
    moveq #2,d0
    moveq #34,d1
    jsr locate
    lea planet_name(a6),a0
    jsr print_string
    lea courier_value(pc),a0
    jsr print_string
    moveq #0,d0
    move.w courier_reward(a6),d0
    tst.w courier_paid(a6)
    beq.s .amount
    move.w courier_paid(a6),d0
.amount:
    move.w #$8086,d1
    jsr print_number
    lea courier_cr(pc),a0
    jsr print_string
.done:
    rts

    q_subr courier_click,global
    bsr courier_accept
    tst.w d0
    beq.s .accepted
    cmp.w #1,d0
    bne.s .done
    lea courier_no_cash(pc),a0
    jmp error_box
.accepted:
    q_sfx keyclick
    bra courier_open
.done:
    rts

; Final overlay below Cash, allowed to cover the equipment tree.
    q_subr courier_status,global
    tst.w courier_reward(a6)
    beq.s .done
    bsr courier_find_target
    tst.w d0
    bmi.s .done
    jsr build_name
    lea courier_status_text(pc),a0
    jsr print_string
    lea planet_name(a6),a0
    jsr print_string
    lea courier_space(pc),a0
    jsr print_string
    moveq #0,d0
    move.w courier_reward(a6),d0
    move.w #128,d1
    jsr print_number
    lea courier_cr(pc),a0
    jmp print_string
.done:
    rts

courier_receipt_keys:
    dc.w '1'
    dc.l launch
    dc.w 128
    dc.l launch
    dc.w '2'
    dc.l buy_cargo
    dc.w 129
    dc.l buy_cargo
    dc.w '3'
    dc.l sell_cargo
    dc.w 130
    dc.l sell_cargo
    dc.w '4'
    dc.l equip_ship
    dc.w 131
    dc.l equip_ship
    dc.w '5'
    dc.l galactic_chart
    dc.w 132
    dc.l galactic_chart
    dc.w '6'
    dc.l local_chart
    dc.w 133
    dc.l local_chart
    dc.w '7'
    dc.l data
    dc.w 134
    dc.l data
    dc.w '8'
    dc.l market_prices
    dc.w 135
    dc.l market_prices
    dc.w '9'
    dc.l status
    dc.w 136
    dc.l status
    dc.w '0'
    dc.l inventory
    dc.w 137
    dc.l inventory
    dc.w '-'
    dc.l disk
    dc.w '='
    dc.l options
    dc.w 'F'
    dc.l find_planet
    dc.w 'B'
    dc.l home_cursor
    dc.w 'D'
    dc.l disp_distance
    dc.w -1
courier_receipt_actions:
    include "icons.m68"
    dc.w -1
    dc.l 0
courier_offer_actions:
    q_action 104,title_y,159,title_y+7,0,0,buy_cargo
    q_action 8,26,224,33,0,0,courier_click
    q_action 8,34,224,41,1,0,courier_click
    q_action 8,42,224,49,2,0,courier_click
    q_action 8,50,224,57,3,0,courier_click
    q_action 8,58,224,65,4,0,courier_click
    q_action 8,66,224,73,5,0,courier_click
    q_action 8,74,224,81,6,0,courier_click
    q_action 8,82,224,89,7,0,courier_click
    q_action 8,90,224,97,8,0,courier_click
    q_action 8,98,224,105,9,0,courier_click
    q_action 8,106,224,113,10,0,courier_click
    q_action 8,114,224,121,11,0,courier_click
    q_action 8,122,224,129,12,0,courier_click
    q_action 8,130,224,137,13,0,courier_click
    q_action 8,138,224,145,14,0,courier_click
    include "icons.m68"
    dc.w -1
    dc.l 0
courier_detail_actions:
    q_action 104,title_y,159,title_y+7,0,0,buy_cargo
    include "icons.m68"
    dc.w -1
    dc.l 0
courier_title: dc.b c_ink,lgt_blue,'Special',c_ink,white,' Cargo',0
courier_value: dc.b c_cursor,2,50,'Value: ',0
courier_cr: dc.b ' CR',0
courier_space: dc.b ' ',0
courier_none: dc.b c_cursor,1,162,c_ink,yellow,'No contracts',0
courier_select_text: dc.b c_cursor,1,162,c_ink,yellow,'Select Cargo',0
courier_delivered: dc.b 'Cargo Delivered',0
courier_no_cash: dc.b 'Not enough credits for this contract.',0
courier_status_text: dc.b c_cursor,0,text_top+2+56,c_ink,magenta,c_paper,black,'Cargo:',c_ink,white,0
    even
