	include "common.def"
; Ported from src_orig/asm/attract.m68; edit this copy.
*	 @@    @@@@@@  @@@@@@ @@@@@@	 @@ 	@@@@   @@@@@@
*	@@@@   @ @@ @  @ @@ @  @@  @@	@@@@   @@  @@  @ @@ @
*  @@  @@	 @@ 	 @@    @@  @@  @@  @@ @@		 @@
*  @@  @@	 @@ 	 @@    @@@@@   @@  @@ @@		 @@
*  @@@@@@	 @@ 	 @@    @@ @@   @@@@@@ @@		 @@
*  @@  @@	 @@ 	 @@    @@  @@  @@  @@  @@  @@	 @@
