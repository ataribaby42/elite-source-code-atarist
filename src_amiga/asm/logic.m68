	include "common.def"
; Ported from src_orig/asm/logic.m68; edit this copy.
* @@@@		@@@ 	@@@@   @@@@@@	@@@@
*  @@	   @@ @@   @@  @@	 @@    @@  @@
*  @@	  @@   @@ @@		 @@   @@
*  @@	  @@   @@ @@		 @@   @@
*  @@	@ @@   @@ @@  @@@	 @@   @@
*  @@  @@  @@ @@   @@  @@	 @@    @@  @@
* @@@@@@@	@@@ 	@@@@@  @@@@@@	@@@@

* Logic routines for moving objects around 3D space. Calls many routines in
* COMBAT. Note - the logic routines for the launch/dock sequence are in the
* ENDGAME file (although they are included in the jump block).

* Version 1.0 4th April 1988 Copyright (c) 1988 Mr. Micro Ltd.
* Designed and coded by Rob Nicholson. Adapted from the MSX version.

	include "macros.m68"

	xref build_number,disp_message,str_copy,str_cat,local_z_rotate
	xref explode_object,find_object,release_cargo,fx,do_circle
	xref random,auto_pilot,inst_echar,get_dist,reduce_shields
	xref target_lost,local_x_rotate,rand,move_object,alloc_object,damage_target
	xref is_combat_ship
	xref create_object,copy_object,monst,transform,random_direction
	xref do_launch1a,do_launch1b,do_launch2a,do_launch2b,do_launch3a
	xref do_launch3b,do_launch4a,do_launch4b,do_dock1a,do_dock1b,do_dock1c
	xref do_dock2a,do_dock2b,do_dock3a,do_dock3b,do_dock3c,do_dock3d
	xref do_dock4a,do_dock4b,do_dock5a

* ---- LOCAL CONSTANTS ----

launch_dist: equ 3600 ; distance of launch before turn
land_dist: equ $10000*3/4 ; distance of ship before land
missile_range: equ 300 ; missile hit range before detonate
missile_damage: equ 48 ; damage to shields from missile
dist_peel_off: equ 480 ; distance to peel off (max)
max_rad: equ 255 ; maximum explosion radius
fire_range: equ radar_range/2 ; 12288 world units: half the scanner range at x1
npc_damage: equ 3 ; fixed AI to AI strength, below the DAMAGE table's own
; range: a hit between two ships is 1..3 times the 2..3 multiplier, so it
; averages 5 against the 7.5 an average-rated player takes. Their fights are
; meant to last long enough to be worth flying into.
run_limit: equ $1200 ; min. run away distance
run_range: equ $1000 ; range of run away distances
avoid_range: equ 32 ; range of avoid distances
avoid_limit: equ 60 ; min. avoid distance
judder: equ 5 ; length of judder
ecm_range: equ 1000 ; range of ECM
ecm_prob: equ 25 ; probability of ECM trigger
fspeed: equ 10 ; fragment explosion speed (end game)
bspeed: equ 7 ; barrel explosion speed

	q_module logic


* *************************************
* **								 **
* ** DO_LOGIC - EXECUTE OBJECT LOGIC **
* **								 **
* *************************************

* Executes the appropriate object logic routine. The UNDER_ATTACK flag is
* also set if the object is angry with the player.

* Entry: None
* Exit:  None

* Regs:  ?
* Subr:  ?

	q_subr do_logic,global

	cmp #log_cruise,logic(a5)
	beq.s .convoy_checked
	clr convoy_speed(a5) ; combat/evasion ends formation; never rejoin afterwards
.convoy_checked:
	btst #angry,flags(a5) ; angry with player ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_1
	st under_attack(a6) ; set under attack flag
q_logic_m68_1:
	move logic(a5),d0 ; fetch logic routine address
	asl #2,d0
	lea logic_vectors(pc),a0
	move.l (a0,d0),a0
	jmp (a0) ; execute logic and exit


* *************************************
* **								 **
* ** ROTATING - ROTATE AROUND Z AXIS **
* **								 **
* *************************************

* Rotates the object around its own z axis by 0.8 degree in a clockwise
* direction. Only rotates if the space station is visible.

	q_subr do_rotating

	tst visible(a6) ; visible ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_3
	move #8,d0 ; rotate around z axis
	jsr local_z_rotate
q_logic_m68_3:

	q_ret


* **************************************************
* **											  **
* ** DO_TWISTING - TWIST OBJECT AROUND THE Z AXIS **
* **											  **
* **************************************************

* Twists the current object around the z axis. Used to spin the cargo
* canisters

	q_subr do_twisting

	bsr do_cruising ; perform cruise logic
	tst visible(a6) ; visible ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_5
	moveq #25,d0 ; rotate through 2.5 degrees
	jsr local_z_rotate
q_logic_m68_5:

	q_ret return


* *************************************
* **								 **
* ** EXPLOSION - OBJECT IS EXPLODING **
* **								 **
* *************************************

* Advances the explosion to the next stage.

	q_subr do_explosion

	q_dec exp_timer(a5) ; explosion over ?
; Quelo: 	if <ne> then.s						no
	beq.s q_logic_m68_7
	move force(a5),d0 ; add force to radius
	add d0,exp_rad(a5)
	q_dec force_timer(a5) ; ready for change in force ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_logic_m68_9
	move #rate,force_timer(a5)
	tst force(a5)
; Quelo: 			if <ne> then.s
	beq.s q_logic_m68_11
	q_dec force(a5)
q_logic_m68_11:
q_logic_m68_9:
	bra.s q_logic_m68_8
q_logic_m68_7:
	bset #remove,flags(a5) ; explosion over, remove object
	btst #no_bounty,flags(a5) ; any bounty message ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_logic_m68_13
	move bounty(a5),d0 ; any bounty ?
; Quelo: 			if <ne> then.s				yes
	beq.s q_logic_m68_15
	lea text2(pc),a0 ; build message 'Bounty xxx credits'
	lea pad(a6),a1
	jsr str_copy
	q_hclr d0
	move #$80,d1
	move.l a1,a0
	q_dec.l a0
	jsr build_number
	lea pad(a6),a0
	lea text3(pc),a1
	jsr str_cat
	lea pad(a6),a0 ; display message
	jsr disp_message
	movem bounty(a5),d0 ; add bounty to cash
	add.l d0,cash(a6)
	bra.s q_logic_m68_16
q_logic_m68_15:
	lea text4(pc),a0 ; print "No bounty"
	jsr disp_message
q_logic_m68_16:
q_logic_m68_13:
q_logic_m68_8:

	q_ret


* **********************************************
* **										  **
* ** POLICE - LAUNCH VIPER FROM SPACE STATION **
* **										  **
* ***********************************************

* Launch police vipers from space station and attack player.

	q_subr do_police

	bsr speed_control ; increase speed
	bsr peel_off_check ; close to player ?
	bcc.s avoid1 ; yes, avoid player
	lea station_rec(a6),a4 ; compute distance from space station
	jsr get_dist
	cmp.l #launch_dist,d2 ; reached turn distance ?
	q_ret lo ; no

avoid1:

	move #log_run_off,next_logic(a5) ; run after peel off
	bra start_peel_off ; start to peel off, then attack


* ***********************************************
* **										   **
* ** LAUNCH - LAUNCH TRADER FROM SPACE STATION **
* **										   **
* ***********************************************

* Launch trader ship from space station.

	q_subr do_launch

	bsr speed_control ; speed up
	bsr peel_off_check ; close to player ?
; Quelo: 	if <cs> then.s						no
	bcc.s q_logic_m68_17
	lea station_rec(a6),a4 ; compute distance from space station
	jsr get_dist
	cmp.l #launch_dist,d2 ; outside launch distance ?
	q_ret lo ; no, return
q_logic_m68_17:
	move type(a5),d0 ; rotate thro' either 90 or 135 degrees
	sub #cobra,d0 ; depending on the object type
	btst #1,d0
; Quelo: 	if <eq> then.s
	bne.s q_logic_m68_19
	move.l #90*10,d1
	bra.s q_logic_m68_20
q_logic_m68_19:
	move.l #135*10,d1
q_logic_m68_20:
	move turn_rate(a5),d2 ; calculate no. turns required to
	divu d2,d1 ; reach this angle
	move d1,peel_x_count(a5)
	btst #0,d0 ; either + or - rotation
; Quelo: 	if <ne> then.s
	beq.s q_logic_m68_21
	neg d2
q_logic_m68_21:
	move d2,peel_x(a5)
	clr peel_z_count(a5) ; no z rotation
	move #log_peel_off,logic(a5) ; set logic type
	move #log_cruise,next_logic(a5) ; cruise after peel off

	q_ret


* *************************************
* **								 **
* ** CRUISING - CRUISE INTO DISTANCE **
* **								 **
* *************************************

* Logic routine: Cruise at full speed, or keep a peaceful convoy's shared speed.

	q_subr do_cruising

	bclr #angry,flags(a5) ; not angry any more
	move #1,on_course(a5) ; speed up to maximum
	tst convoy_speed(a5)
	beq.s .ordinary
	move convoy_speed(a5),velocity(a5) ; same speed even with different trader models
	bra.s do_abandoned ; still discard a convoy member beyond scanner range
.ordinary:
	bsr speed_control

; An abandoned hull keeps its velocity and orientation. Share only the
; range cleanup with cruising; LOG_NONE also serves planets and animations.
	q_subr do_abandoned

	move.l obj_range(a5),d0 ; way off radar ?
	cmp.l #radar_range,d0
; Quelo: 	if <hi> then.s						yes
	bls.s q_logic_m68_23

; Also used by missiles leaving scanner range. Invalidate this record, never
; the ship a discarded missile was chasing; free it in REMOVE_OBJECTS.
discard_distant_object:
	move.l a5,a4 ; check for lost target
	jsr target_lost
	bset #remove,flags(a5) ; remove object from world
q_logic_m68_23:

	q_ret


* *****************************************
* **									 **
* ** FLY_PLANET - FLY TOWARDS THE PLANET **
* **									 **
* *****************************************

* Logic routine: Fly a shuttle towards the planet.

	q_subr do_fly_planet

	bsr peel_off_check ; close to player ?
; Quelo: 	if <cc> then.s						yes, peel off and run
	bcs.s q_logic_m68_25
	move #log_cruise,next_logic(a5)
	bra start_peel_off
q_logic_m68_25:
	move.b loop_ctr(a6),d0 ; only check 1 in 4
	and.b #3,d0
; Quelo: 	if <eq> then.s
	bne.s q_logic_m68_27
	bsr speed_control ; speed up to maximum
	lea planet_rec(a6),a4 ; within landing distance ?
	jsr get_dist
	cmp.l #land_dist,d2
; Quelo: 		if <lo> then.s					yes
	bhs.s q_logic_m68_29
	bset #remove,flags(a5) ; remove the object
q_logic_m68_29:
q_logic_m68_27:

	q_ret


* *************************************
* **								 **
* ** PEEL_OFF - PEEL OFF FROM COURSE **
* **								 **
* *************************************

* Logic routine: Peels from current path.

	q_subr do_peel_off

	bsr speed_control ; speed up to maximum
	tst peel_x_count(a5) ; peeling in x direction ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_31
	q_dec peel_x_count(a5) ; rotate in x direction
	move peel_x(a5),d0
	jsr local_x_rotate
q_logic_m68_31:
	tst peel_z_count(a5) ; peeling in z direction ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_33
	q_dec peel_z_count(a5) ; rotate in z direction
	move peel_z(a5),d0
	jsr local_z_rotate
q_logic_m68_33:
	move peel_x_count(a5),d0 ; finished peel off ?
	or peel_z_count(a5),d0
	q_ret ne ; no
	move next_logic(a5),d0 ; move to next logic sequence
	move d0,logic(a5)
	cmp #log_cruise,d0 ; cruising ?
	q_ret eq ; yes, return
	cmp #log_avoid,d0 ; avoid player ?
	q_ret eq ; yes, return
	cmp #log_run_off,d0 ; run off ?
	beq start_run_off ; yes, start to run off
	move #100,counter(a5) ; time to run

	q_ret



* ************************************************
* **											**
* ** DO_ESCAPE - FLY OFF PART OF ESCAPE CAPSULE **
* **											**
* ************************************************

* Process the logic of the escape capsule (Cobra).

	q_subr do_escape

	clr controls_locked(a6) ; release controls
	st just_docked(a6) ; phew!

	q_ret return


* ****************************
* **						**
* ** ATTACK - ATTACK PLAYER **
* **						**
* ****************************

* Flies towards the player, lasers blasting.

; The one place that knows TARGET = 0 means the player, who is the origin of
; every object coordinate. NO_TARGET also reads back as the origin; callers
; must establish that a target exists before relying on the result.
	q_subr target_coords,global

	move.l target(a5),d0
	ble.s .player
	move.l d0,a0
	move.l xpos(a0),d0
	move.l ypos(a0),d1
	move.l zpos(a0),d2
	rts
.player:
	moveq #0,d0
	moveq #0,d1
	moveq #0,d2
	rts

; A target can vanish without any destruction event, because DO_CRUISING and
; REMOVE_OBJECT free records silently. Two tests per frame cover every path.
	q_subr validate_target,global

	move.l target(a5),d0
	beq.s .usable ; 0 is the player, who never vanishes
	cmp.l #no_target,d0
	beq.s .none
	move.l d0,a0
	btst #in_use,flags(a0)
	beq.s .none
	btst #remove,flags(a0)
	bne.s .none
	cmp #log_exploding,logic(a0)
	beq.s .none
.usable:
	moveq #1,d0
	rts
.none:
	move.l #no_target,target(a5)
	moveq #0,d0
	rts


; OBJ_RANGE must keep meaning "distance from the player", because RADAR,
; COLLISION and DO_CRUISING all depend on it. The attacker's distance to its
; own target therefore lives in its own scratch variable.
	q_subr target_range_calc,global

	move.l target(a5),d0
	bne.s .ship
	move.l obj_range(a5),target_range(a6) ; the player is the origin
	rts
.ship:
	move.l d0,a4
	jsr get_dist ; D2.L = distance between A5 and A4
	move.l d2,target_range(a6)
	rts


; BBC's two aim cones, expressed in the game's Q14 orientation vectors.
; The 12288-unit fire-range guard keeps each component of the line of fire
; safely inside signed words. Compare dot products directly: no square root
; or division is needed.
	q_subr ai_laser_aim

	moveq #0,d0
	tst.l target_range(a6)
	ble.s .done
	cmp.l #fire_range,target_range(a6)
	bhi.s .done
	movem.l d3-d5,-(sp)
	moveq #0,d5
	bsr target_coords ; (D0,D1,D2) = the target's position
	sub.l xpos(a5),d0 ; direction from the shooter to the target
	sub.l ypos(a5),d1
	sub.l zpos(a5),d2
	move.w d0,d3
	muls.w z_vector+i(a5),d3
	move.w d1,d4
	muls.w z_vector+j(a5),d4
	add.l d4,d3
	move.w d2,d4
	muls.w z_vector+k(a5),d4
	add.l d4,d3
	move.w target_range+2(a6),d4
	mulu.w #unit*32/36,d4
	cmp.l d4,d3
	blt.s .restore
	moveq #1,d5 ; within the firing cone, but can still miss
	move.w target_range+2(a6),d4
	mulu.w #unit*35/36,d4
	cmp.l d4,d3
	blt.s .restore
	moveq #2,d5 ; within the narrower hit cone
.restore:
	move.l d5,d0
	movem.l (sp)+,d3-d5
.done:
	rts

; Additional miss threshold out of 200, returned in D2 for the accuracy roll.
; Only called for an otherwise well-aimed shot, never on every flight frame.
; Interpolate the four distance anchors, rounding down to half a percentage point.
; Clobbers D0/D1/D2/A0; random preserves D2. All other registers are unchanged.
	q_subr ai_laser_miss_threshold

	move.l target_range(a6),d0
	moveq #20,d2
	cmp.l #1000,d0
	ble.s .done
	moveq #100,d2
	cmp.l #7000,d0
	bhs.s .done
	lea .distance_miss+4(pc),a0 ; first upper endpoint is 3000
.interval:
	cmp.w (a0),d0
	bls.s .interpolate
	addq.l #4,a0
	bra.s .interval
.interpolate:
	move.w -2(a0),d1 ; lower endpoint's miss threshold
	move.w 2(a0),d2
	sub.w d1,d2 ; threshold increase over this 2000-unit interval
	sub.w -4(a0),d0 ; distance beyond the lower endpoint
	mulu.w d2,d0
	divu.w #2000,d0
	move.w d1,d2
	add.w d0,d2
.done:
	rts

.distance_miss:
	dc.w 1000,20,3000,40,5000,60,7000,100 ; 10%, 20%, 30%, 50%

	q_subr do_attack

	bsr validate_target ; is there still something to fight ?
	tst d0
; Quelo: 	if <eq> then.s						no
	bne.s .have_target
; RETARGET only looks after ships inside the faction whitelist. For anything
; else -- the Cougar and the Constrictor -- NO_TARGET is all it will ever hold,
; and LOG_ATTACK has always meant "attack the player", so say so. A ship
; RETARGET does look after has genuinely run out of things to fight and falls
; back to cruising, which is section 5.1 of the design.
	move.l a5,a4
	jsr is_combat_ship
	tst d0
	beq.s .hunts_the_player
; RETARGET reaches a slot once every MAX_OBJECTS frames, and START_PEEL_OFF can
; be done in 450/turn_rate -- eleven frames for a Thargoid. A ship the player
; provoked often gets here first, and cruising away would clear ANGRY in
; DO_CRUISING and lose the provocation for good.
	btst #angry,flags(a5) ; did the player provoke it ?
	bne.s .hunts_the_player ; yes, whatever RETARGET has managed so far
	move #log_cruise,logic(a5) ; fly off
	move #1,on_course(a5)
	rts
.hunts_the_player:
	clr.l target(a5)
.have_target:
	tst.l target(a5) ; fighting the player ?
	bne.s .not_player
	bset #angry,flags(a5) ; only he gets the cockpit warning
.not_player:
	bsr target_range_calc ; distance to whatever is being fought
; RADAR_OBJ is set from the player's own distance to the station, but station
; space ($22500) is nearly six times the scanner range ($6000), so when it is
; set every ship he can see is inside it too. It therefore describes the
; region, not the player, and a pirate breaking off applies just as well to a
; fight between two other ships. Deliberately not narrowed to TARGET = 0.
	tst radar_obj(a6) ; within space station space ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_35
	cmp #typ_pirate,ship_type(a5) ; pirate ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_logic_m68_37
	move #log_cruise,logic(a5) ; bugger off
q_logic_m68_37:
q_logic_m68_35:
	cmp.l #fire_range,target_range(a6) ; close enough to fire ?
	bhi no_fire ; no
	tst.l target(a5) ; shooting at the player ?
	bne.s .may_fire ; no, and neither of his states hides another ship
	tst cloaking_on(a6) ; cloaking device on ?
	bne no_fire ; yes
	tst controls_locked(a6)
	bne no_fire
.may_fire:
	jsr random ; preserve the original chance of firing
	cmp mood(a5),d0
	bhi no_fire
	bsr ai_laser_aim ; fresh aim: 0 = no shot, 1 = miss, 2 = hit
	tst.w d0
	beq no_fire
	move d0,ai_laser(a5) ; 1 = miss, 2 = hit
	cmp.w #2,d0
	bne.s .laser_sound
	bsr ai_laser_miss_threshold ; distance-dependent chance, D2 survives random
.accuracy_roll:
	jsr random
	cmp.w #200,d0
	bhs.s .accuracy_roll ; reject 200..255 for 200 equally weighted outcomes
	cmp.w d2,d0
	bhs.s .on_target
	move #1,ai_laser(a5) ; drawn as a miss, no damage
	bra.s .laser_sound
.on_target:
	tst.l target(a5) ; shooting at the player ?
	bne.s .npc_power ; no, another ship
	cmp #constr,type(a5)
	bne.s .ordinary_power
	moveq #6,d0 ; original Constrictor projectile strength
	bra.s .damage
.ordinary_power:
	move rating(a6),d0
	add d0,d0
	lea damage(pc),a0
	move (a0,d0),d2
	bra.s .roll
.npc_power:
	moveq #npc_damage,d2 ; the player's rating means nothing here
.roll:
	jsr rand
	q_inc d0 ; original per-projectile damage, unchanged
.damage:
	move.w d0,-(sp) ; retain the original projectile's base strength
.damage_multiplier:
	jsr random
	and.w #1,d0 ; one random bit: equal chances for 2 or 3
	addq.w #2,d0
	mulu.w (sp)+,d0 ; combine the old projectile's repeated hits into one hit
	tst.l target(a5) ; the player or another ship ?
	bne.s .hit_ship
	jsr reduce_shields ; A5 is the shooter: selects front/aft by its position
	bra.s .laser_sound
.hit_ship:
	bsr damage_target
.laser_sound:
	ifne aifiresound
	q_sfx laser ; only the AI firing sound; impacts are handled by reduce_shields
	endc

no_fire:

	bsr peel_off_check ; peel off ?
; Quelo: 	if <cc> then.s						yes
	bcs.s q_logic_m68_41
	move #log_run_off,next_logic(a5)
	bra start_peel_off
q_logic_m68_41:
	bsr target_coords ; auto-pilot towards whatever is being fought
	bsr auto_pilot
	moveq #6,d0 ; adjust speed and exit
	bra speed_control


* *******************************************
* **									   **
* ** RUN_OFF - RUN OFF INTO DISTANCE LOGIC **
* **									   **
* *******************************************

* Logic to run into the distance.

	q_subr do_run_off

	bsr speed_control ; speed upto maximum
	q_dec counter(a5) ; still running ?
; Quelo: 	if <eq> then.s						no
	bne.s q_logic_m68_43
	move #log_attack,logic(a5) ; turn to attack
	move health(a5),pre_attack(a5) ; save health before attack
	clr on_course(a5) ; not on course
q_logic_m68_43:

	q_ret


* *************************
* **					 **
* ** TIMER - TIMER LOGIC **
* **					 **
* *************************

* Decrements a timer, when zero the object is removed.

	q_subr do_timer

	q_dec counter(a5) ; timeout ?
	q_ret ne ; no
	bset #remove,flags(a5) ; remove object from world

	q_ret


* **************************************
* **								  **
* ** AVOID - AVOID PLAYER FOR A WHILE **
* **								  **
* **************************************

* Avoid player after being hit.

	q_subr do_avoid

	moveq #avoid_range,d2 ; set run distance
	jsr rand
	add #avoid_limit,d0
	move d0,counter(a5)
	move #log_run_off,logic(a5) ; run off for a while
	move #1,on_course(a5)

	q_ret


* *****************************************************
* **												 **
* ** DO_LOCKED - TRACK MISSILE FROM PLAYER TO TARGET **
* **												 **
* *****************************************************

* Tracks a missile launched by the player towards its target

	q_subr do_locked

	cmp.l #radar_range,obj_range(a5) ; distance from player, not target
	bhi discard_distant_object

	move.l target(a5),a4 ; get target's coords
	movem.l xpos(a4),d0-d2
	jsr auto_pilot ; execute auto-pilot
	moveq #6,d0 ; more/less gas
	bsr speed_control
	jsr get_dist ; calculate distance to target
	tst ecm_fitted(a4) ; ECM fitted to target ?
	beq.s no_ecm ; no
	tst ecm_on(a6) ; ECM already on ?
	bne.s no_ecm ; yes
	cmp.l #ecm_range,d2 ; within ECM range ?
; Quelo: 	if <lo> then.s						yes
	bhs.s q_logic_m68_47
	move type(a4),d0 ; target = space station ?
	cmp #spacestn,d0
	beq ecm_missile ; yes
	cmp #constr,d0 ; constrictor ?
	beq ecm_missile ; yes
	cmp #cougar,d0 ; cougar ?
	beq ecm_missile ; yes
; The ECM jammer silences the use of ECM in the space around the player, his
; own included: ENGAGE_ECM refuses him while it is on. So it is read for every
; missile, not only his, and belongs with RADAR_OBJ among the globals that
; describe where everyone is rather than what the player is doing.
	tst ecm_jammed(a6) ; ECM jammed ?
	bne no_ecm ; yes
	jsr random ; random chance to ECM
	cmp #ecm_prob,d0
	bhi no_ecm

ecm_missile:

	q_sfx ecm ; trigger ECM effect
	clr f_echar(a6) ; flag instrument change
	st who_ecm(a6) ; computer started ECM
	q_ret return
q_logic_m68_47:

no_ecm:

	lsr.l #1,d2 ; within range ?
	cmp.l #255,d2
	q_ret hi ; definately not!
	cmp obj_rad(a4),d2
	q_ret hi ; no
	cmp #log_locked,logic(a5) ; one of the player's own missiles ?
	beq.s q_logic_m68_48
	st npc_kill(a6) ; no, so no score, rating, bounty or record
q_logic_m68_48:
	bset #remove,flags(a5) ; this missile is spent; flag it before
	jsr explode_object ; TARGET_LOST so it does not report itself
	jsr target_lost ; nothing else may keep chasing the record
	jsr release_cargo ; release any cargo
	clr npc_kill(a6) ; EXPLODE_OBJECT already decided whether it was heard

	q_ret


* ***********************************************
* **										   **
* ** DO_MISSILE - TRACK MISSILE TOWARDS PLAYER **
* **										   **
* ***********************************************

* Tracks a missile towards the player.

	q_subr do_missile

	cmp.l #radar_range,obj_range(a5) ; same limit for missiles aimed at player
	bhi discard_distant_object

	moveq #0,d0 ; auto-pilot towards the player
	moveq #1,d1
	moveq #2,d2
	jsr auto_pilot
	moveq #6,d0 ; more/less gas
	bsr speed_control
	cmp.l #missile_range,obj_range(a5) ; within range ?
; Quelo: 	if <lo> then.s						yes
	bhs.s q_logic_m68_49
	move.l a5,a4 ; explode the missile
	jsr explode_object
	moveq #missile_damage,d0 ; reduce shields
	jsr reduce_shields
q_logic_m68_49:

	q_ret return


* **********************************************
* **										  **
* ** DO_ENDGAME1 - END GAME EXPLOSION PART #1 **
* **										  **
* **********************************************

* Moves the Cobra closer towards the front of the screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr do_endgame1

	sub.l #100,zpos(a5) ; move closer
	cmp.l #1000,zpos(a5) ; reached the front ?
; Quelo: 	if <le> then						yes
	bgt q_logic_m68_51
	move #15,force(a5) ; initialise explosion
	move #rate,force_timer(a5)
	move #exp_dur,exp_timer(a5)
	clr exp_rad(a5)
	clr velocity(a5)
	move #log_exploding,logic(a5)
	bset #point,flags(a5) ; not normal 3D object
	q_loop 1,2 ; release 2 canisters
	jsr alloc_object ; allocate an object
	q_push d7 ; copy main object
	jsr copy_object
	move.b #%1,flags(a4) ; in use
	jsr random_direction ; move in random direction
	move #barrel,type(a4) ; it's a twisting barrel
	move #log_twisting,logic(a4)
	jsr create_object ; create the object
	move #bspeed,velocity(a4) ; set speed of barrel
	q_pop d7 ; next barrel
	q_next 1
	q_loop 1,5 ; release 5 platlets
	jsr alloc_object ; allocate an object
	q_push d7 ; copy main object
	jsr copy_object
	move.b #%1,flags(a4) ; in use
	jsr random_direction ; move in random direction
	move #platlet,type(a4) ; it's a twisting platlet
	move #log_twisting,logic(a4)
	jsr create_object ; create the object
	move #fspeed,velocity(a4) ; set speed of fragment
	jsr random ; random colour
	and #7*2,d0
	lea fragment_cols(pc),a0
	move (a0,d0),obj_colour(a4)
	moveq #50,d0 ; move fragment out a tidge
	jsr move_object
	q_pop d7 ; next fragment
	q_next 1
	q_sfx explosion ; sfx: explosion
	bra.s q_logic_m68_52
q_logic_m68_51:
	moveq #30,d0 ; rotate
	jsr local_x_rotate
	moveq #-30,d0
	jsr local_z_rotate
q_logic_m68_52:

	q_ret return


* *******************************************
* **									   **
* ** SPEED_CONTROL - CONTROL SPEED OF SHIP **
* **									   **
* *******************************************

* Controls the speed of the current object. If the object is on course, then
* it's speed is increased upto the maximum speed. If not on course, then the
* speed in decreased.

* Entry:  ON_COURSE = On course counter
*		  D0 = Minimum speed
* Exit:   None

* Regs:   D1 corrupt.
* Subr:   None

	q_subr speed_control

	move velocity(a5),d1 ; fetch objects speed
	tst on_course(a5) ; on course ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_logic_m68_53
	addq #2,d1 ; increase speed
	cmp vel_max(a5),d1
; Quelo: 		if <gt> then.s
	ble.s q_logic_m68_55
	move vel_max(a5),d1
q_logic_m68_55:
	bra.s q_logic_m68_54
q_logic_m68_53:
	subq #2,d1 ; reduce speed
; Quelo: 		if d1 <lt> d0 then.s
	cmp d0,d1
	bge.s q_logic_m68_57
	move d0,d1
q_logic_m68_57:
q_logic_m68_54:
	move d1,velocity(a5) ; update speed

	q_ret


* ****************************************
* **									**
* ** START_PEEL_OFF - START TO PEEL OFF **
* **									**
* ****************************************

* Start the current object peeling off from it's current path. The angle for
* the x and z rotations are randomized between 45 and 180 degrees. The number
* of turns required to reach this angle is calculated and stored in the
* objects record. NOTE - the peel related entries in the record must be laid
* out as follows as they are accessed directly:

*		peel_x_count:	ds.w 1
*		peel_x: 		ds.w 1
*		peel_z_count:	ds.w 1
*		peel_z: 		ds.w 1

* Entry: A5 = ptr: object's record
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr start_peel_off,global

	lea peel_x_count(a5),a0 ; point to peel x count
	q_loop 1,2 ; loop for x and z
	move #180-45,d2 ; choose random angle
	jsr rand
	add #45,d0
	mulu #10,d0 ; calculate no. turns required to
	move turn_rate(a5),d2 ; achieve this angle
	divu d2,d0
	move d0,0(a0)
	jsr random ; set peel angle (+/- turn_rate)
	tst.b d0
; Quelo: 		if <mi> then.s
	bpl.s q_logic_m68_59
	neg d2
q_logic_m68_59:
	move d2,2(a0)
	addq.l #4,a0 ; next angle
	q_next 1
	move #log_peel_off,logic(a5) ; peel off logic
	move #1,on_course(a5) ; object on course

	q_ret


* *****************************************
* **									 **
* ** PEEL_OFF_CHECK - CHECK FOR PEEL OFF **
* **									 **
* *****************************************

* Checks if the current object is close enough to peel off.

* Entry: None
* Exit:  IF close enough THEN
*			Carry flag clear (CC)
*		 ELSE
*			Carry flag set (CS)
*		 ENDIF

* Regs: ?
* Subr: ?

	q_subr peel_off_check

	lea target_range(a6),a0 ; range this peel distance is compared against
	move.l target(a5),d0 ; chasing another ship ?
	ble.s q_logic_m68_60 ; NO_TARGET and the player both mean the origin
	move velocity(a5),d0 ; a pair of ships has no closing speed
	bra.s q_logic_m68_61
q_logic_m68_60:
	lea obj_range(a5),a0
	move approach(a6),d0 ; flying away from us ?
; Quelo: 	if <mi> then.s						yes
	bpl.s q_logic_m68_61
	clr d0 ; peel distance = 0
	bra.s q_logic_m68_62
q_logic_m68_61:
	mulu #600,d0 ; calculate peel distance
	divu turn_rate(a5),d0
	add #1024,d0
q_logic_m68_62:
	q_hclr d0 ; set carry if within distance
	cmp.l (a0),d0

	q_ret


* **********************************************
* **										  **
* ** START_RUN_OFF - START OBJECT RUNNING OFF **
* **										  **
* **********************************************

* Initialises the logic for running away for a while.

	q_subr start_run_off,global

	move #run_range,d2 ; range = rand(run_range)+run_limit
	jsr rand
	add #run_limit,d0
	q_hclr d0 ; calculate no. loops required to reach
	divu vel_max(a5),d0 ; this range
	move d0,counter(a5)
	move #1,on_course(a5) ; object is on course

	q_ret


* ---- LOCAL DATA ----

* Table of logic vectors. The former photon slot is reserved and inert. The
* last entry, LOG_AI_MISSILE, runs DO_LOCKED as well: a missile a ship fired
* at another ship flies and detonates exactly like the player's, and the
* separate logic value is what tells the two apart.

logic_vectors:

	dc.l return,do_explosion,do_rotating,do_locked,do_launch,do_police
	dc.l do_attack,do_peel_off,do_run_off,do_twisting,do_fly_planet,do_avoid
	dc.l do_cruising,do_missile,do_escape,do_timer,return,do_endgame1
	dc.l do_launch1a,do_launch1b,do_launch2a,do_launch2b,do_launch3a
	dc.l do_launch3b,do_launch4a,do_launch4b,do_circle,do_dock1a,do_dock1b
	dc.l do_dock1c,do_dock2a,do_dock2b,do_dock3a,do_dock3b,do_dock3c
	dc.l do_dock3d,do_dock4a,do_dock4b,do_dock5a,do_locked
	dc.l do_abandoned

* Table of laser damage range for ratings.

damage:

	dc.w 3,3,3,5,5,5,7,7,7

* List of colours for fragments.

fragment_cols:

	dc 6,7,8,17,18,19,1,47

* Text strings.

text2:
	dc.b "Bounty: ",0
text3:
	dc.b " credits",0
text4:
	dc.b "No bounty!",0
