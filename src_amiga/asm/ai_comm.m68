; Cosmetic AI radio: observe decisions, never make combat/spawn decisions.
    include "common.def"
    include "macros.m68"
    xref comm_id_player,comm_id_object,comm_enqueue,comm_enqueue_player
    xref combat_state
    q_module ai_comm

; A4 slot. Called at allocation, creation (after parent copies), and removal.
; The complete object pool is also cleared by CLEAR_OBJECTS.
    q_subr ai_comm_clear,global
    clr.l radio_instance(a4)
    move.l #no_target,radio_target(a4)
    clr.w radio_flags(a4)
    clr.l radio_owner(a4)
    clr.w radio_owner_player(a4)
    clr.w radio_cooldown(a4)
    rts

; Every created object gets a fresh serial, independent of registrations/RNG.
; Zero denotes the player and -1 denotes no target; neither is an NPC serial.
    q_subr ai_comm_created,global
    bsr ai_comm_clear
.serial:
    addq.l #1,ai_comm_serial(a6)
    beq.s .serial
    cmp.l #no_target,ai_comm_serial(a6)
    beq.s .serial
    move.l ai_comm_serial(a6),radio_instance(a4)
    rts

; A4 new missile, A5 firing AI. Preserve a printable owner, never a pointer.
    q_subr ai_comm_missile_ai,global
    movem.l d0/a4,-(sp)
    move.l a4,-(sp)
    move.l a5,a4
    jsr comm_id_object
    move.l (sp)+,a4
    move.l d0,radio_owner(a4)
    clr.w radio_owner_player(a4)
    movem.l (sp)+,d0/a4
    rts

    q_subr ai_comm_missile_player,global
    move.l d0,-(sp)
    jsr comm_id_player
    move.l d0,radio_owner(a4)
    move.w #1,radio_owner_player(a4)
    move.l (sp)+,d0
    rts

; Separate full-period 16-bit LCG. Reject the incomplete final group of 20.
; Ten outcomes are silent, ten select one of the ten texts: exactly 50/50.
; D0 = -1 (silent) or 0..9. All other registers preserved.
    q_subr ai_comm_roll,global
.again:
    moveq #0,d0
    move.w ai_comm_seed(a6),d0
    mulu #25173,d0
    add.w #13849,d0
    move.w d0,ai_comm_seed(a6)
    and.l #$ffff,d0
    cmp.w #65520,d0
    bhs.s .again
    divu #20,d0
    swap d0
    sub.w #10,d0
    bpl.s .done
    moveq #-1,d0
.done:
    rts

; A5 current ship. Once per game frame, even off-screen or on in-flight UI.
; Preserve registers and stop at zero; no hardware-clock or render dependency.
    q_subr ai_comm_tick,global
    tst.w radio_cooldown(a5)
    beq.s .done
    subq.w #1,radio_cooldown(a5)
.done:
    rts

; A4 sending ship; D0 text-set base, D1 sender, D2 recipient, D7 player flag.
; Events are already consumed, so cooldown suppression never queues a retry.
; Only a real receipt arms the cooldown; a silent 50% roll leaves it at zero.
    q_subr ai_comm_send
    tst.w cloaking_on(a6)
    bne.s .done
    tst.w radio_cooldown(a4)
    bne.s .done
    move.w d0,d6
    bsr ai_comm_roll
    tst.w d0
    bmi.s .done
    add.w d6,d0
    bra ai_comm_deliver
.done:
    rts

; Inputs as AI_COMM_SEND, with a complete text ID and no further chance roll.
    q_subr ai_comm_deliver
    tst.w cloaking_on(a6)
    bne.s .done
    tst.w d7
    bne.s .player
    jsr comm_enqueue
    bra.s .sent
.player:
    jsr comm_enqueue_player
.sent:
    move.w #ai_comm_cooldown_frames,radio_cooldown(a4)
.done:
    rts

; A4 ordinary human hull. Excludes mission hulls, aliens and non-ship objects.
; D0 = 1/0; flags reflect result. Preserve all other registers.
    q_subr ai_comm_human
    move.w type(a4),d0
    cmp.w #viper,d0
    blo.s .no
    cmp.w #transporter,d0
    bhi.s .no
    cmp.w #dodec,d0
    beq.s .no
    cmp.w #thargoid,d0
    beq.s .no
    moveq #1,d0
    rts
.no:
    moveq #0,d0
    rts

; Uniform index 0..D0.W-1 from the cosmetic RNG; other registers preserved.
; Divide the 16-bit range into equal contiguous buckets and reject its tail.
; Using high-order buckets avoids alternating low-bit choices for two ships.
    q_subr ai_comm_pick,global
    cmp.w #1,d0
    bhi.s .multiple
    moveq #0,d0
    rts
.multiple:
    movem.l d1-d2,-(sp)
    moveq #0,d2
    move.w d0,d2
    move.l #$10000,d1
    divu d0,d1
    and.l #$ffff,d1 ; bucket size
    mulu d1,d2 ; exclusive accepted limit, possibly 65536
.again:
    moveq #0,d0
    move.w ai_comm_seed(a6),d0
    mulu #25173,d0
    add.w #13849,d0
    move.w d0,ai_comm_seed(a6)
    and.l #$ffff,d0
    cmp.l d2,d0
    bhs.s .again
    divu d1,d0
    and.l #$ffff,d0 ; quotient is the bucket index
    movem.l (sp)+,d1-d2
    rts

; A4 candidate, A5 sender, D6 required faction. D0 = 1/0; others preserved.
; The whole bubble is eligible, not only the player's scanner range. Exclude
; the sender, dead/abandoned ships, aliens, mission hulls and non-ship objects.
    q_subr ai_comm_candidate
    cmpa.l a5,a4
    beq.s .no
    btst #in_use,flags(a4)
    beq.s .no
    btst #remove,flags(a4)
    bne.s .no
    cmp.w ship_type(a4),d6
    bne.s .no
    bsr ai_comm_human
    tst.w d0
    beq.s .no
    tst.w health(a4)
    ble.s .no
    cmp.w #log_exploding,logic(a4)
    beq.s .no
    cmp.w #act_nothing,attack_type(a4)
    beq.s .no
    moveq #1,d0
    rts
.no:
    moveq #0,d0
    rts

; Count eligible NPCs of faction D6. D3 output; D0/D5/A4 scratch.
    q_subr ai_comm_count
    moveq #0,d3
    lea objects(a6),a4
    moveq #max_objects-1,d5
.slot:
    bsr ai_comm_candidate
    tst.w d0
    beq.s .next
    addq.w #1,d3
.next:
    lea obj_len(a4),a4
    dbra d5,.slot
    rts

; A5 peaceful trader. Observe only: selecting a radio recipient never changes
; its combat target. First prefer pirates plus a wanted player, then pirates
; alone for a Clean player, then other traders plus a Clean player.
    q_subr ai_comm_trader_greeting
    btst #0,radio_flags(a5)
    bne .done
    moveq #1,d7 ; the observer has already excluded active player cloaking
    move.w #typ_pirate,d6
    move.w #comm_cautious_text,d4
    bsr ai_comm_count
    tst.w police_record(a6)
    bne.s .pool
    tst.w d3
    bne.s .pirates
    move.w #typ_trader,d6
    move.w #comm_trader_text,d4
    bsr ai_comm_count
    bra.s .pool
.pirates:
    moveq #0,d7 ; Clean players never join the pirate pool
.pool:
    add.w d7,d3
    beq .done ; no recipient yet; leave the greeting opportunity available
    bset #0,radio_flags(a5)
    tst.w radio_cooldown(a5)
    bne .done ; consume the event without random draws or a deferred retry
    bsr ai_comm_roll
    tst.w d0
    bmi .done
    add.w d0,d4 ; complete text ID; the original 50% roll happens only once
    move.w d3,d0
    bsr ai_comm_pick
    move.w d0,d2
    tst.w d7
    beq.s .npcs
    subq.w #1,d2
    bmi.s .player
.npcs:
    lea objects(a6),a4
    moveq #max_objects-1,d5
.slot:
    bsr ai_comm_candidate
    tst.w d0
    beq.s .next
    subq.w #1,d2
    bmi.s .npc
.next:
    lea obj_len(a4),a4
    dbra d5,.slot
    bra.s .done
.npc:
    jsr comm_id_object
    moveq #0,d7
    bra.s .addressed
.player:
    jsr comm_id_player
    moveq #1,d7
.addressed:
    move.l d0,d2
    move.l a5,a4
    jsr comm_id_object
    move.l d0,d1
    move.w d4,d0
    bra ai_comm_deliver
.done:
    rts

; A5 current ship, called after its existing AI logic settles for this frame.
; This only writes radio fields. Every register is preserved.
    q_subr ai_comm_observe,global
    movem.l d0-d7/a0-a5,-(sp)
    tst.w cloaking_on(a6) ; active cloaking suppresses all new radio, even AI-to-AI
    bne .done
    tst.w docked(a6)
    bne .done
    tst.w game_over(a6)
    bne .done
    btst #in_use,flags(a5)
    beq .done
    btst #remove,flags(a5)
    bne .done
    cmp.w #log_exploding,logic(a5)
    beq .done
    cmp.l #radar_range,obj_range(a5)
    bhi .done
    move.l a5,a4
    bsr ai_comm_human
    bne.s .classified
    cmp.w #thargoid,type(a5)
    bne .done ; Tharglets and special mission hulls remain silent
.classified:
    move.w logic(a5),d1
    jsr combat_state
    cmp.w #2,d0
    beq .combat
    move.l #no_target,radio_target(a5)
    cmp.w #1,d0
    bne .done ; no launch/docking/escape greetings
    btst #angry,flags(a5)
    bne .done
    cmp.w #typ_trader,ship_type(a5)
    beq.s .trader
    tst.w cloaking_on(a6)
    bne .done
    cmp.w #typ_pirate,ship_type(a5)
    bne .done
    tst.w pirate_truce(a5)
    beq .done
    move.w #comm_friend_text,d4 ; trust the existing truce; never reroll it
    bra.s .greeting
.trader:
    bsr ai_comm_trader_greeting
    bra .done
.greeting:
    bset #0,radio_flags(a5)
    bne .done
    jsr comm_id_object
    move.l d0,d1
    jsr comm_id_player
    move.l d0,d2
    moveq #1,d7
    move.w d4,d0
    bsr ai_comm_send
    bra .done
.combat:
; A truce is with the player, not with every AI. A pirate already fighting
; another ship can still greet its fellow pirate once, then address its target.
    cmp.w #typ_pirate,ship_type(a5)
    bne.s .threat
    tst.w pirate_truce(a5)
    beq.s .threat
    btst #angry,flags(a5)
    bne.s .threat
    tst.w cloaking_on(a6)
    bne.s .threat
    bset #0,radio_flags(a5)
    bne.s .threat
    jsr comm_id_object
    move.l d0,d1
    jsr comm_id_player
    move.l d0,d2
    moveq #1,d7
    move.w #comm_friend_text,d0
    bsr ai_comm_send
.threat:
    move.w #comm_alien_text,d4
    cmp.w #thargoid,type(a5)
    beq.s .target
    move.w #comm_pirate_text,d4
    cmp.w #typ_pirate,ship_type(a5)
    beq.s .target
    cmp.w #viper,type(a5)
    bne .done
    cmp.w #typ_police,ship_type(a5)
    bne .done
    move.w #comm_police_text,d4
.target:
    move.l target(a5),d3
    bmi.s .lost
    beq.s .player
    move.l d3,a4
    lea objects(a6),a0
    cmpa.l a0,a4
    blo.s .lost
    lea objects+obj_size(a6),a0
    cmpa.l a0,a4
    bhs.s .lost
    btst #in_use,flags(a4)
    beq.s .lost
    btst #remove,flags(a4)
    bne.s .lost
    cmp.w #log_exploding,logic(a4)
    beq.s .lost
    cmp.l #radar_range,obj_range(a4)
    bhi.s .lost
    move.l radio_instance(a4),d3
    beq.s .lost
    cmp.l radio_target(a5),d3
    beq.s .done
    jsr comm_id_object
    moveq #0,d7
    bra.s .addressed
.player:
    cmp.l radio_target(a5),d3
    beq.s .done
    jsr comm_id_player
    moveq #1,d7
.addressed:
    move.l d3,radio_target(a5) ; consume before rolling, including failures
    move.l d0,d2
    move.l a5,a4
    jsr comm_id_object
    move.l d0,d1
    move.w d4,d0
    bsr ai_comm_send
    bra.s .done
.lost:
    move.l #no_target,radio_target(a5)
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; A4 living victim, A0 laser attacker (0 player) or the threatening missile.
; Called after positive weapon damage or a successful player missile launch.
; Both events share one protest opportunity. Does not include collision damage.
; All registers preserved, including the damage routine's D0 return value.
    q_subr ai_comm_hit,global
    movem.l d0-d7/a0-a5,-(sp)
    tst.w cloaking_on(a6)
    bne .done ; keep the protest opportunity; damage/hostility still apply
    move.l a4,a3 ; retain the victim while resolving an AI shooter's identity
    cmp.w #typ_trader,ship_type(a4)
    bne .done
    bsr ai_comm_human
    beq .done
    btst #in_use,flags(a4)
    beq .done
    btst #remove,flags(a4)
    bne .done
    cmp.w #log_exploding,logic(a4)
    beq .done
    tst.w docked(a6)
    bne .done
    tst.w game_over(a6)
    bne .done
    bset #1,radio_flags(a4)
    bne .done ; the first threat or survived hit consumes the opportunity
    cmp.l #radar_range,obj_range(a4)
    bhi .done
    jsr comm_id_object
    move.l d0,d1
    move.l a0,d0
    beq.s .player
    cmp.w #missile,type(a0)
    bne.s .ship
    move.l radio_owner(a0),d2
    beq.s .done ; no known shooter, never address the missile itself
    move.w radio_owner_player(a0),d7
    bra.s .send
.ship:
    move.l a0,a4
    jsr comm_id_object
    moveq #0,d7
    bra.s .recipient
.player:
    jsr comm_id_player
    moveq #1,d7
.recipient:
    move.l d0,d2
.send:
    move.l a3,a4 ; the cooldown belongs to the protesting ship, not the attacker
    move.w #comm_protest_text,d0
    bsr ai_comm_send
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts
