	include "common.def"
; Ported from src-orig/SPECIAL_M68; edit this copy.
*	@@@@  @@@@@@  @@@@@@@	@@@@   @@@@@@	 @@   @@@@
*  @@  @@  @@  @@  @@	@  @@  @@	 @@ 	@@@@   @@
*  @@	   @@  @@  @@ @   @@		 @@    @@  @@  @@
*	@@@@   @@@@@   @@@@   @@		 @@    @@  @@  @@
*	   @@  @@	   @@ @   @@		 @@    @@@@@@  @@	@
