; Relocatable workspace. Only display and audio DMA buffers require Chip RAM.
amiga_workspace_implementation: equ 1
    include "common.def"
    xdef var_size,textscr,hyper_buffer,left_arm,right_arm
    xdef save1_buffer,max1,save2_buffer,max2,texture,obj_data
    xdef logo,cockpit,vars,ram_end,other_screen
    section workspace,bss
textscr: ds.b 3590
hyper_buffer: ds.b 360*zoom_x*zoom_y ; a wider sprite saves more background
left_arm: ds.w arm_entries ; indexed by physical screen row, not viewport row
right_arm: ds.w arm_entries
save1_buffer: ds.b 4096
max1:
save2_buffer: ds.b 4096
max2:
texture: ds.b 24358
obj_data: ds.b 20292
logo: ds.b 16276
cockpit: ds.b 13386
vars: ds.b var_size
ram_end:
    section amiga_video,bss
    xdef amiga_primary
amiga_primary: ds.b scr_bytes
    section amiga_video2,bss     ; a second hunk: the KS1.x limit is per hunk
other_screen: ds.b scr_bytes    ; original bitmap loader uses this as its disk buffer
