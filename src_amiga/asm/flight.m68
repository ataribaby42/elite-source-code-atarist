	include "common.def"
; Ported from src_orig/asm/flight.m68; edit this copy.
; @@@@@@@ @@@@	   @@@@@@	@@@@   @@  @@  @@@@@@
;  @@	@  @@		 @@    @@  @@  @@  @@  @ @@ @
;  @@ @    @@		 @@   @@	   @@  @@	 @@
;  @@@@    @@		 @@   @@	   @@@@@@	 @@
;  @@ @    @@	@	 @@   @@  @@@  @@  @@	 @@
;  @@	   @@  @@	 @@    @@  @@  @@  @@	 @@
