	include "common.def"
; Ported from src_orig/asm/except.m68; edit this copy.
* @@@@@@@ @@   @@	@@@@  @@@@@@@ @@@@@@   @@@@@@
*  @@	@  @@ @@   @@  @@  @@	@  @@  @@  @ @@ @
*  @@ @ 	@@@   @@	   @@ @    @@  @@	 @@
*  @@@@ 	@@@   @@	   @@@@    @@@@@	 @@
*  @@ @    @@ @@  @@	   @@ @    @@		 @@
