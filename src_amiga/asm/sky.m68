; Distant white stars: immutable directions, cone-tree culling and cached pixels.
    include "common.def"
    include "macros.m68"
    xref set_colour,c_plotxy
    xdef sky_enabled

sky_capacity: equ 64
    q_vars sky
sky_basis: rs.l 9             ; row-major celestial-to-ship matrix, signed Q24
sky_matrix: rs.w 9            ; celestial-to-current-view matrix, signed Q14
sky_pixels: rs.w sky_capacity*2
sky_count: rs.w 1
sky_dirty: rs.w 1
sky_view: rs.w 1
sky_turns: rs.w 1
sky_enabled: rs.w 1           ; rendering cache of the saved user/f_no_stars preference
    q_end_vars sky
    q_module sky

    q_subr init_sky,global
    movem.l d0-d7/a0-a5,-(sp)
    bclr #f_no_stars,user(a6) ; startup and a freshly enabled sky default to ON
    move.w #1,sky_enabled(a6)
    lea sky_basis(a6),a0
    moveq #8,d0
.clear:
    clr.l (a0)+
    dbra d0,.clear
    move.l #$1000000,sky_basis(a6)
    move.l #$1000000,sky_basis+16(a6)
    move.l #$1000000,sky_basis+32(a6)
    clr.w sky_count(a6)
    clr.w sky_turns(a6)
    move.w #-1,sky_view(a6)
    st sky_dirty(a6)
    movem.l (sp)+,d0-d7/a0-a5
    rts

; D0 = zero to disable, nonzero to enable. Preserve all data/address registers.
; Only an OFF -> ON transition restarts the sky; another ON click does nothing.
    q_subr set_sky_enabled,global
    tst.w d0
    beq.s .off
    bclr #f_no_stars,user(a6)
    tst.w sky_enabled(a6)
    beq init_sky
    rts
.off:
    bset #f_no_stars,user(a6)
    clr.w sky_enabled(a6)
    rts

; Apply the saved flag after RESTORE_STATE. Legacy saves have bit 6 clear (ON).
; Keep the renderer cache in sync without changing any other saved preference.
    q_subr restore_sky,global
    move.l d0,-(sp)
    moveq #1,d0
    btst #f_no_stars,user(a6)
    beq.s .apply
    moveq #0,d0
.apply:
    bsr set_sky_enabled
    move.l (sp)+,d0
    rts

; Called after the flight scene, once per simulation frame, including menus.
; Uses the same roll-then-pitch order as world objects. Translation is ignored.
    q_subr advance_sky,global
    tst.w sky_enabled(a6)
    bne.s .enabled
    rts
.enabled:
    movem.l d0-d7/a0-a5,-(sp)
    move.w roll_angle(a6),d0
    or.w climb_angle(a6),d0
    beq .done
    st sky_dirty(a6)
    tst.w roll_angle(a6)
    beq.s .pitch
    lea sky_basis(a6),a0
    lea sky_basis+12(a6),a1
    lea roll_sin(a6),a2
    bsr sky_rotate_rows
.pitch:
    tst.w climb_angle(a6)
    beq.s .normalise
    lea sky_basis+12(a6),a0
    lea sky_basis+24(a6),a1
    lea climb_sin(a6),a2
    bsr sky_rotate_rows
.normalise:
    addq.w #1,sky_turns(a6)
    cmp.w #128,sky_turns(a6)
    blo.s .done
    clr.w sky_turns(a6)
    bsr sky_normalise
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Rotate two rows without discarding their Q24 fractional components.
    q_subr sky_rotate_rows
    moveq #2,d7
.loop:
    move.l 4(a2),d0
    move.l (a0),d1
    bsr sky_multiply
    move.l d3,d6
    move.l (a2),d0
    move.l (a1),d1
    bsr sky_multiply
    sub.l d3,d6
    move.l d6,-(sp)
    move.l (a2),d0
    move.l (a0),d1
    bsr sky_multiply
    move.l d3,d6
    move.l 4(a2),d0
    move.l (a1),d1
    bsr sky_multiply
    add.l d6,d3
    move.l d3,(a1)+
    move.l (sp)+,(a0)+
    dbra d7,.loop
    rts

; Signed Q24 product, rounded, using only MC68000 16x16 multiplication.
; The operands are unit-vector components/trigonometric values (abs <= ~1).
    q_subr sky_multiply
    move.l d0,d2
    eor.l d1,d2
    q_abs.l d0
    q_abs.l d1
    move.w d0,d3
    mulu.w d1,d3
    move.w d0,d4
    swap d1
    mulu.w d1,d4
    move.w d1,d5
    swap d0
    mulu.w d0,d5
    swap d1
    mulu.w d1,d0
    add.l d0,d4
    clr.w d3
    swap d3
    add.l d4,d3
    lsl.l #8,d5
    add.l #128,d3
    lsr.l #8,d3
    add.l d5,d3
    tst.l d2
    bpl.s .done
    neg.l d3
.done:
    rts

; First Newton normalisation step: v *= (3 - dot(v,v))/2. The matrix is
; already very close to orthonormal; this bounds long-session scale drift.
    q_subr sky_normalise
    lea sky_basis(a6),a0
    moveq #2,d7
.row:
    moveq #0,d6
    move.l a0,a1
    moveq #2,d0
.length:
    move.l (a1)+,d1
    asr.l #8,d1
    asr.l #2,d1
    muls.w d1,d1
    add.l d1,d6
    dbra d0,.length
    neg.l d6
    add.l #$30000000,d6
    asr.l #5,d6           ; Q28 length squared -> Q24 scale
    moveq #2,d0
    move.l d0,-(sp)
.scale:
    move.l d6,d0
    move.l (a0),d1
    bsr sky_multiply
    move.l d3,(a0)+
    subq.l #1,(sp)
    bpl.s .scale
    addq.l #4,sp
    dbra d7,.row
    rts

; The bitmap is cleared each frame, so cached pixels must still be plotted.
; Everything, including planets, sun and the moving dark grey dust, covers them.
    q_subr draw_sky,global
    tst.w sky_enabled(a6)
    bne.s .enabled
    rts
.enabled:
    movem.l d0-d7/a0-a5,-(sp)
    tst.w witch_space(a6)
    bne.s .done
    move.w view(a6),d0
    cmp.w sky_view(a6),d0
    bne.s .rebuild
    tst.b sky_dirty(a6)
    beq.s .plot
.rebuild:
    move.w d0,sky_view(a6)
    sf sky_dirty(a6)
    bsr sky_make_matrix
    bsr sky_project
.plot:
    move.w sky_count(a6),d7
    beq.s .done
    subq.w #1,d7
    moveq #white,d0
    jsr set_colour
    lea sky_pixels(a6),a5
.pixel:
    move.w (a5)+,d0
    move.w (a5)+,d1
    movem.l d7/a5,-(sp)
    jsr c_plotxy
    movem.l (sp)+,d7/a5
    dbra d7,.pixel
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

    q_subr sky_make_matrix
    lea sky_basis(a6),a0
    lea sky_matrix(a6),a1
    moveq #8,d7
.convert:
    move.l (a0)+,d0
    asr.l #8,d0
    asr.l #2,d0
    move.w d0,(a1)+
    dbra d7,.convert
    move.w view(a6),d7
    beq.s .done
    lea sky_matrix(a6),a0
    lea sky_matrix+12(a6),a1
    moveq #2,d6
.view:
    move.w (a0),d0
    move.w (a1),d1
    cmp.w #1,d7
    beq.s .rear
    cmp.w #2,d7
    beq.s .left
    ; Right: screen x = -ship z, depth = ship x.
    neg.w d1
    bra.s .side
.left:
    ; Left: screen x = ship z, depth = -ship x.
    neg.w d0
.side:
    move.w d1,(a0)+
    move.w d0,(a1)+
    bra.s .next
.rear:
    neg.w d0
    neg.w d1
    move.w d0,(a0)+
    move.w d1,(a1)+
.next:
    dbra d6,.view
.done:
    rts

; Preorder traversal needs no recursion, stack or object slots. A rejected
; cone skips its entire subtree. Only accepted leaves transform their stars.
    q_subr sky_project
    clr.w sky_count(a6)
    lea sky_pixels(a6),a4
    lea sky_matrix(a6),a2
    lea sky_catalogue(pc),a0
    lea sky_catalogue_end(pc),a5
.node:
    cmpa.l a5,a0
    bhs .done
    move.w (a0)+,d0
    muls.w 12(a2),d0
    move.w (a0)+,d1
    muls.w 14(a2),d1
    add.l d1,d0
    move.w (a0)+,d1
    muls.w 16(a2),d1
    add.l d1,d0
    cmp.l (a0)+,d0
    blt.s .reject
    move.w (a0)+,d7
    bpl.s .node
    moveq #sky_leaf_count-1,d7
.star:
    bsr sky_project_star
    addq.l #6,a0
    dbra d7,.star
    bra.s .node
.reject:
    move.w (a0)+,d0
    bpl.s .skip
    neg.w d0
.skip:
    adda.w d0,a0
    bra.s .node
.done:
    rts

; A0 = immutable Q14 direction, A2 = view matrix, A4 = pixel write pointer.
; Cull before DIVS, keeping every division bounded and off-screen stars cheap.
    q_subr sky_project_star
    move.w (a0),d0
    muls.w 12(a2),d0
    move.w 2(a0),d1
    muls.w 14(a2),d1
    add.l d1,d0
    move.w 4(a0),d1
    muls.w 16(a2),d1
    add.l d1,d0
    ble .done
    asl.l #2,d0
    swap d0
    move.w d0,d5             ; Q14 depth
    beq .done
    move.w (a0),d2
    muls.w (a2),d2
    move.w 2(a0),d1
    muls.w 2(a2),d1
    add.l d1,d2
    move.w 4(a0),d1
    muls.w 4(a2),d1
    add.l d1,d2
    asl.l #2,d2
    swap d2
    ext.l d2
    move.w d2,d1
    bpl.s .x_positive
    neg.w d1
.x_positive:
    move.w d5,d0
    lsr.w #2,d0
    move.w d5,d4
    lsr.w #8,d4
    lsr.w #1,d4
    add.w d4,d0             ; negative DIVS truncation can still produce x_min
    addq.w #2,d0
    cmp.w d0,d1
    bhi .done
    move.w (a0),d3
    muls.w 6(a2),d3
    move.w 2(a0),d1
    muls.w 8(a2),d1
    add.l d1,d3
    move.w 4(a0),d1
    muls.w 10(a2),d1
    add.l d1,d3
    asl.l #2,d3
    swap d3
    ext.l d3
    move.w d3,d1
    bpl.s .y_positive
    neg.w d1
.y_positive:
    move.w d5,d0
    lsr.w #3,d0              ; 1/8 > 56/512: cheap conservative vertical bound
    addq.w #2,d0
    cmp.w d0,d1
    bhi.s .done
    asl.l #8,d2
    add.l d2,d2
    divs.w d5,d2
    cmp.w #x_min,d2
    blt.s .done
    cmp.w #x_max,d2
    bgt.s .done
    asl.l #8,d3
    add.l d3,d3
    divs.w d5,d3
    cmp.w #y_min,d3
    blt.s .done
    cmp.w #y_max,d3
    bgt.s .done
    cmp.w #sky_capacity,sky_count(a6)
    bhs.s .done
    move.w d2,(a4)+
    move.w d3,(a4)+
    addq.w #1,sky_count(a6)
.done:
    rts

    include "sky.dat"
