    include "common.def"
    include "macros.m68"

; Seeded surface markings on a sphere. Q12 geometry, Q14 object orientation.
; The globe retains the flight renderer's circular, orthographic silhouette.
; Its viewing axis follows the actual eye-to-centre direction in all four views.
; Only the current system's map is cached; gameplay RNG is never advanced.
    xref sqrt,calc_yvector,set_colour,c_solid_polygon,c_line,solid_polygon
    xref set_planet_colour,draw_point,w_swap_front
    ifne blit_ok
    xref wait_clear
    endc
    ifne shadow_ok
    xref shadow_live,mirror_valid
    endc

ps_features: equ 12
ps_points: equ 13
ps_feature_bytes: equ ps_points*6
ps_min_radius: equ 12*zoom_y ; details start at a 24-pixel diameter

    q_vars planet_surface
ps_map: rs.b ps_features*ps_feature_bytes
ps_rng: rs.l 1
ps_kind: rs.w 1 ; 0 = plain, 1 = crater outlines, 2 = filled regions
ps_ink: rs.w 1
ps_radius: rs.w 1
ps_size: rs.w 1
ps_aspect: rs.w 1
ps_cos: rs.w 1
ps_sin: rs.w 1
ps_active: rs.w 1
ps_rim_radii: rs.w 8
ps_feature: rs.w 1
ps_vertex: rs.w 1
ps_colour: rs.l 4
ps_source: rs.l 1
ps_dest: rs.l 1
ps_centre: rs.w 3
ps_tangent: rs.w 3
ps_bitangent: rs.w 3
ps_eye: rs.w 3
ps_right: rs.w 3
ps_up: rs.w 3
ps_matrix: rs.w 9
ps_view_points: rs.w ps_points*3
ps_triangle: rs.w 9
ps_clipped: rs.w 12
ps_count: rs.w 1
ps_nodes: rs.b 12*node_len
ps_segment: rs.w 6
ps_line: rs.w 4
ps_work_bytes: equ __RS-ps_map
ps_portrait_backup: rs.b ps_work_bytes
ps_portrait_object: rs.b obj_len
ps_portrait_destination: rs.l 1
ps_portrait_colours: rs.w 1 ; palette indices needed by the last portrait
    q_end_vars planet_surface

    q_module planet_surface

; Planet Data portrait. D0/D1 = logical screen centre, radius 40 pixels.
; Return D0 = palette-index mask; preserve all other registers.
; Use the same invisible-screen scratch as the old texture path, then copy
; only a bounded rectangle. Preserve the live map, world object and arrival yaw.
    q_subr draw_planet_portrait,global
    movem.l d0-d7/a0-a5,-(sp)
    move.l colour_ptr(a6),-(sp)
    move.w sun_flare(a6),-(sp)
    move.l w_view_ptr(a6),-(sp)
    ifne blit_ok
    jsr wait_clear
    endc
    ifne shadow_ok
    move.w shadow_live,-(sp)
    clr.w shadow_live ; render directly to the scratch Chip RAM screen
    endc
    move.l scr_base(a6),-(sp)
    sub.w #48,d0
    sub.w #40,d1
    mulu.w #zoom_x,d0
    lsr.w #3,d0
    mulu.w #zoom_y*row_stride,d1
    add.l d1,d0
    add.l scr_base(a6),d0
    move.l d0,ps_portrait_destination(a6)
    lea ps_map(a6),a0
    lea ps_portrait_backup(a6),a1
    move.w #ps_work_bytes/2-1,d7
.save_map:
    move.w (a0)+,(a1)+
    dbra d7,.save_map
    lea ps_portrait_object(a6),a4
    move.l a4,a0
    move.w #obj_len/2-1,d7
.clear_object:
    clr.w (a0)+
    dbra d7,.clear_object
    move.w #planet,type(a4)
    move.l #100000,this_zpos(a4)
    move.w #40*zoom_y+1,scr_radius(a4)
    move.l splanet+seed(a6),-(sp)
    move.w splanet+seed+4(a6),-(sp)
    move.w current(a6),-(sp)
    move.l cplanet+seed(a6),splanet+seed(a6)
    move.w cplanet+seed+4(a6),splanet+seed+4(a6)
    move.w req_planet(a6),current(a6)
    jsr set_planet_colour ; use the existing galaxy/planet colour lookup
    bsr init_planet_surface ; identity orientation, without arrival rotation
    moveq #0,d0
    move.w obj_colour(a4),d1
    bset d1,d0
    tst.w ps_kind(a6)
    beq.s .portrait_colours_ready
    move.w ps_ink(a6),d1
    bset d1,d0
.portrait_colours_ready:
    move.w d0,ps_portrait_colours(a6)
    move.w (sp)+,current(a6)
    move.w (sp)+,splanet+seed+4(a6)
    move.l (sp)+,splanet+seed(a6)
    move.l #w_swap_front,w_view_ptr(a6)
    move.l scr_base(a6),d0
    move.l flip_screen(a6),d1
    eor.l d1,d0
    move.l d0,scr_base(a6)
    move.l d0,a0
    lea (y_top+y_max-40*zoom_y)*row_stride+(x_left-x_min-48*zoom_x)/8(a0),a0
    move.w #80*zoom_y,d7
.clear_row:
    moveq #3,d6
.clear_plane:
    move.w #3*zoom_x-1,d5
.clear_words:
    clr.l (a0)+
    dbra d5,.clear_words
    lea bpr-12*zoom_x(a0),a0
    dbra d6,.clear_plane
    dbra d7,.clear_row
    clr.w sun_flare(a6)
    lea ps_portrait_object(a6),a5
    move.w #planet,d0
    jsr draw_point
    move.l scr_base(a6),a0
    lea (y_top+y_max-40*zoom_y)*row_stride+(x_left-x_min-48*zoom_x)/8(a0),a0
    move.l ps_portrait_destination(a6),a1
    move.w #80*zoom_y,d7
.copy_row:
    moveq #3,d6
.copy_plane:
    move.w #3*zoom_x-1,d5
.copy_words:
    move.l (a0)+,(a1)+
    dbra d5,.copy_words
    lea bpr-12*zoom_x(a0),a0
    lea bpr-12*zoom_x(a1),a1
    dbra d6,.copy_plane
    dbra d7,.copy_row
    move.l (sp)+,scr_base(a6)
    ifne shadow_ok
    move.w (sp)+,shadow_live
    clr.w mirror_valid ; the direct screen copies bypassed both mirrors
    endc
    move.l (sp)+,w_view_ptr(a6)
    move.w (sp)+,sun_flare(a6)
    move.l (sp)+,colour_ptr(a6)
    lea ps_portrait_backup(a6),a0
    lea ps_map(a6),a1
    move.w #ps_work_bytes/2-1,d7
.restore_map:
    move.w (a0)+,(a1)+
    dbra d7,.restore_map
    movem.l (sp)+,d0-d7/a0-a5
    moveq #0,d0
    move.w ps_portrait_colours(a6),d0
    rts

; A4 = newly created planet. Preserve every register, including A5.
    q_subr init_planet_surface,global
    movem.l d0-d7/a0-a5,-(sp)
    clr.w ps_kind(a6)
    lea ps_map(a6),a0
    move.w #ps_features*ps_feature_bytes/4-1,d7
.clear_map:
    clr.l (a0)+
    dbra d7,.clear_map
    lea x_vector(a4),a0
    moveq #8,d7
.clear_orientation:
    clr.w (a0)+
    dbra d7,.clear_orientation
    move.w #unit,x_vector+i(a4)
    move.w #unit,y_vector+j(a4)
    move.w #unit,z_vector+k(a4)
    bset #yvector_ok,flags(a4)
    clr.w rot_count(a4)
    move.w obj_colour(a4),d0
    cmp.w #yellow,d0
    bne.s .base_ready
    moveq #red,d0
    move.w d0,obj_colour(a4)
.base_ready:
    cmp.w #lgt_grey,d0
    beq.s .craters
    cmp.w #lgt_green,d0
    blo.s .other_colour
    cmp.w #mid_green,d0
    bls.s .seas
    cmp.w #lgt_blue,d0
    blo.s .other_colour
    cmp.w #mid_blue,d0
    bhi.s .other_colour
    move.w #mid_green,ps_ink(a6)
    bra.s .land
.seas:
    move.w #mid_blue,ps_ink(a6)
    bra.s .land
.other_colour:
    ; Match the valid, static planet backgrounds accepted by DRAW_POINT.
    cmp.w #white,d0
    bhi .done
    tst.w d0
    beq .done
    cmp.w #drk_grey,d0
    beq .done
    cmp.w #black,d0
    beq .done
    cmp.w #pulse,d0
    beq .done
    move.w #-1,ps_ink(a6) ; choose a different static colour after seeding
.land:
    move.w #8,ps_active(a6)
    move.w #2,ps_kind(a6)
    bra.s .seed
.craters:
    move.w #12,ps_active(a6)
    move.w #1,ps_kind(a6)
    move.w #drk_grey,ps_ink(a6)
.seed:
    move.l splanet+seed(a6),d0
    rol.l #5,d0
    move.w splanet+seed+4(a6),d1
    eor.w d1,d0
    bne.s .seed_ok
    move.l #$6d2b79f5,d0
.seed_ok:
    move.l d0,ps_rng(a6)
    ; One solid shade per planet, without advancing the geometry generator.
    cmp.w #2,ps_kind(a6)
    bne.s .colour_ready
    tst.w ps_ink(a6)
    bmi.s .continent_colour
    btst #8,d0
    beq.s .colour_ready
    subq.w #1,ps_ink(a6) ; medium -> light blue/green
    bra.s .colour_ready
.continent_colour:
    move.l d0,d1
    swap d1
    eor.w d0,d1
    and.l #$ffff,d1
    divu.w #ps_continent_count,d1
    swap d1
    add.w d1,d1
    lea ps_continent_colours(pc),a0
    move.w (a0,d1.w),d2
    cmp.w obj_colour(a4),d2
    bne.s .store_continent_colour
    addq.w #2,d1 ; skip a match, wrapping within the static palette
    cmp.w #ps_continent_count*2,d1
    blo.s .next_continent_colour
    clr.w d1
.next_continent_colour:
    move.w (a0,d1.w),d2
.store_continent_colour:
    move.w d2,ps_ink(a6)
.colour_ready:
    lea ps_map(a6),a0
    move.l a0,ps_dest(a6)
    lea ps_centres(pc),a0
    cmp.w #1,ps_kind(a6)
    beq.s .anchors
    lea ps_sea_centres(pc),a0
.anchors:
    move.l a0,ps_source(a6)
    move.w ps_active(a6),ps_feature(a6)
    subq.w #1,ps_feature(a6)
.feature:
    move.l ps_source(a6),a2
    lea ps_centre(a6),a3
    moveq #2,d7
.jitter:
    bsr ps_random
    and.w #2047,d0
    sub.w #1024,d0
    add.w (a2)+,d0
    move.w d0,(a3)+
    dbra d7,.jitter
    move.l a2,ps_source(a6)
    movem.w ps_centre(a6),d0-d2
    bsr ps_normalize
    movem.w d0-d2,ps_centre(a6)
    move.l ps_dest(a6),a3
    move.w d0,(a3)+
    move.w d1,(a3)+
    move.w d2,(a3)+
    move.l a3,ps_dest(a6)
    move.w d0,d2
    move.w d1,d0
    neg.w d0
    move.w d2,d1
    clr.w d2
    bsr ps_normalize
    movem.w d0-d2,ps_tangent(a6)
    lea ps_centre(a6),a0
    lea ps_tangent(a6),a1
    bsr ps_cross
    movem.w d0-d2,ps_bitangent(a6)
    move.w #4096,ps_aspect(a6)
    move.w #16384,ps_cos(a6)
    clr.w ps_sin(a6)
    bsr ps_random
    cmp.w #1,ps_kind(a6)
    bne.s .sea_shape
    and.w #511,d0
    add.w #400,d0
    move.w d0,ps_size(a6)
    bra.s .size_ok
.sea_shape:
    ; Elongated, independently oriented regions with variable-width coasts.
    ; Their overlap forms larger connected seas, narrows and peninsulas.
    and.w #2047,d0
    add.w #2500,d0
    move.w d0,ps_size(a6)
    bsr ps_random
    and.w #1023,d0
    add.w #1300,d0
    move.w d0,ps_aspect(a6)
    bsr ps_random
    and.w #63,d0
    lsl.w #2,d0
    lea ps_longitudes(pc),a0
    move.w (a0,d0.w),ps_cos(a6)
    move.w 2(a0,d0.w),ps_sin(a6)
.size_ok:
    clr.w ps_vertex(a6)
.vertex:
    bsr ps_random
    and.w #1023,d0
    cmp.w #1,ps_kind(a6)
    beq.s .crater_radius
    add.w d0,d0
    add.w #1900,d0
    bra.s .radius_ready
.crater_radius:
    add.w #3072,d0
.radius_ready:
    mulu.w ps_size(a6),d0
    lsr.l #8,d0
    lsr.l #4,d0
    move.w d0,d6
    move.w ps_vertex(a6),d5
    lea ps_ring12(pc),a2
    cmp.w #1,ps_kind(a6)
    bne.s .trig
    lea ps_ring8(pc),a2
    cmp.w #8,d5
    blo.s .rim_vertex
    bsr ps_make_ray
    bra.s .point_ready
.rim_vertex:
    move.w d5,d0
    add.w d0,d0
    lea ps_rim_radii(a6),a0
    move.w d6,(a0,d0.w)
.trig:
    lsl.w #2,d5
    move.w (a2,d5.w),d3
    move.w 2(a2,d5.w),d4
    muls.w d6,d3
    muls.w d6,d4
    asr.l #8,d3
    asr.l #4,d3
    asr.l #8,d4
    asr.l #4,d4
.point_ready:
    muls.w ps_aspect(a6),d4
    asr.l #8,d4
    asr.l #4,d4
    move.w d3,d0
    muls.w ps_cos(a6),d0
    move.w d4,d1
    muls.w ps_sin(a6),d1
    sub.l d1,d0
    move.w d3,d1
    muls.w ps_sin(a6),d1
    muls.w ps_cos(a6),d4
    add.l d4,d1
    asr.l #8,d0
    asr.l #6,d0
    asr.l #8,d1
    asr.l #6,d1
    move.w d0,d3
    move.w d1,d4
    lea ps_tangent(a6),a0
    lea ps_bitangent(a6),a1
    lea ps_centre(a6),a2
    lea ps_segment(a6),a3
    moveq #2,d7
.component:
    move.w (a0)+,d0
    muls.w d3,d0
    move.w (a1)+,d1
    muls.w d4,d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #4,d0
    add.w (a2)+,d0
    move.w d0,(a3)+
    dbra d7,.component
    movem.w ps_segment(a6),d0-d2
    bsr ps_normalize
    move.l ps_dest(a6),a3
    move.w d0,(a3)+
    move.w d1,(a3)+
    move.w d2,(a3)+
    move.l a3,ps_dest(a6)
    addq.w #1,ps_vertex(a6)
    cmp.w #12,ps_vertex(a6)
    blo .vertex
    subq.w #1,ps_feature(a6)
    bpl .feature
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Extend an actual rim vertex by 0.5..1.0 of its radius, with an
; independent -10..+10 degree deflection. Geometry is generated only once.
ps_make_ray:
    move.w ps_vertex(a6),d5
    subq.w #8,d5
    lsl.w #2,d5 ; byte offset of every other rim radius
    lea ps_rim_radii(a6),a0
    move.w (a0,d5.w),d6
    add.w d5,d5 ; byte offset of that vertex's sine/cosine
    lea ps_ring8(pc),a2
    adda.w d5,a2
    bsr ps_random
    and.w #511,d0
    add.w #512,d0
    mulu.w d6,d0
    lsr.l #8,d0
    lsr.l #2,d0
    move.w d0,d7
    bsr ps_random
    and.w #7,d0
    lsl.w #2,d0
    lea ps_ray_angles(pc),a0
    move.w 2(a0,d0.w),d1
    move.w (a0,d0.w),d0
    muls.w d7,d0
    muls.w d7,d1
    asr.l #8,d0
    asr.l #4,d0
    asr.l #8,d1
    asr.l #4,d1
    add.w d0,d6
    move.w d1,d7
    move.w (a2),d3
    muls.w d6,d3
    move.w 2(a2),d4
    muls.w d7,d4
    sub.l d4,d3
    move.w (a2),d0
    muls.w d7,d0
    move.w 2(a2),d4
    muls.w d6,d4
    add.l d0,d4
    asr.l #8,d3
    asr.l #4,d3
    asr.l #8,d4
    asr.l #4,d4
    rts

; Nonzero xorshift32. Only D0/D1 and our private state change.
ps_random:
    move.l ps_rng(a6),d0
    move.l d0,d1
    lsl.l #8,d1
    lsl.l #5,d1
    eor.l d1,d0
    move.l d0,d1
    lsr.l #8,d1
    lsr.l #8,d1
    lsr.l #1,d1
    eor.l d1,d0
    move.l d0,d1
    lsl.l #5,d1
    eor.l d1,d0
    move.l d0,ps_rng(a6)
    rts

; Hyperspace arrival or station launch: choose a cosmetic longitude from the existing
; random state without consuming gameplay randomness or changing geography.
; A4 = planet, all registers preserved. 64 longitudes, 5.625 degrees apart.
    q_subr turn_planet_surface,global
    movem.l d0-d2/a0,-(sp)
    move.l random_seed(a6),d0
    move.l d0,d1
    swap d1
    eor.w d1,d0
    and.w #63,d0
    lsl.w #2,d0
    lea ps_longitudes(pc),a0
    move.w (a0,d0.w),d1
    move.w 2(a0,d0.w),d2
    move.w d1,x_vector+i(a4)
    move.w d1,z_vector+k(a4)
    move.w d2,z_vector+i(a4)
    neg.w d2
    move.w d2,x_vector+k(a4)
    bclr #yvector_ok,flags(a4)
    movem.l (sp)+,d0-d2/a0
    rts

; Normalize a nonzero signed triple (each component <= 16384) to Q12.
; A zero vector is handled defensively. All other registers are preserved.
ps_normalize:
    movem.l d3-d7,-(sp)
    move.w d0,d4
    move.w d1,d5
    move.w d2,d6
    muls.w d0,d0
    muls.w d1,d1
    muls.w d2,d2
    add.l d1,d0
    add.l d2,d0
    jsr sqrt
    tst.w d2
    beq.s .zero
    move.w d2,d3
    move.w d4,d0
    ext.l d0
    asl.l #8,d0
    asl.l #4,d0
    divs.w d3,d0
    move.w d5,d1
    ext.l d1
    asl.l #8,d1
    asl.l #4,d1
    divs.w d3,d1
    move.w d6,d2
    ext.l d2
    asl.l #8,d2
    asl.l #4,d2
    divs.w d3,d2
    bra.s .done
.zero:
    clr.w d0
    clr.w d1
    move.w #4096,d2
.done:
    movem.l (sp)+,d3-d7
    rts

; Cross product A0 x A1, Q12 -> D0/D1/D2. D3 corrupted.
ps_cross:
    move.w 2(a0),d0
    muls.w 4(a1),d0
    move.w 4(a0),d3
    muls.w 2(a1),d3
    sub.l d3,d0
    asr.l #8,d0
    asr.l #4,d0
    move.w 4(a0),d1
    muls.w (a1),d1
    move.w (a0),d3
    muls.w 4(a1),d3
    sub.l d3,d1
    asr.l #8,d1
    asr.l #4,d1
    move.w (a0),d2
    muls.w 2(a1),d2
    move.w 2(a0),d3
    muls.w (a1),d3
    sub.l d3,d2
    asr.l #8,d2
    asr.l #4,d2
    rts

    q_subr draw_planet_surface,global
    btst #f_planets,user+1(a6)
    beq .return
    tst.w ps_kind(a6)
    beq .return
    cmp.w #ps_min_radius,scr_radius(a5)
    blt .return ; no transformation or raster work for distant planets
    movem.l d0-d7/a0-a5,-(sp)
    move.w scr_radius(a5),d0
    sub.w #3*zoom_y,d0 ; allow for the circle's radius decrement and raster rounding
    move.w d0,d1
    lsr.w #8,d1 ; bound accumulated fixed-point rounding on very large globes
    sub.w d1,d0
    move.w d0,ps_radius(a6)
    bsr ps_make_matrix
    move.w ps_ink(a6),d0
    jsr set_colour
    ; SOLID_POLYGON selects two alternating eight-byte rows. Use the same
    ; solid masks for both rows, while crater lines use the first row.
    move.l colour_ptr(a6),a0
    lea ps_colour(a6),a1
    move.l (a0),(a1)
    move.l 4(a0),4(a1)
    move.l (a0),8(a1)
    move.l 4(a0),12(a1)
    move.l a1,colour_ptr(a6)
    lea ps_map(a6),a0
    move.l a0,ps_source(a6)
    move.w ps_active(a6),ps_feature(a6)
    subq.w #1,ps_feature(a6)
.feature:
    move.l ps_source(a6),a0
    lea ps_view_points(a6),a2
    moveq #ps_points-1,d7
.transform:
    lea ps_matrix(a6),a1
    moveq #2,d6
.axis:
    move.w (a0),d0
    muls.w (a1),d0
    move.w 2(a0),d1
    muls.w 6(a1),d1
    add.l d1,d0
    move.w 4(a0),d1
    muls.w 12(a1),d1
    add.l d1,d0
    asr.l #8,d0
    asr.l #4,d0
    move.w d0,(a2)+
    addq.l #2,a1
    dbra d6,.axis
    addq.l #6,a0
    dbra d7,.transform
    move.l a0,ps_source(a6)
    lea ps_view_points(a6),a0
    moveq #ps_points-1,d7
.visible:
    tst.w 4(a0)
    ble.s .has_front
    addq.l #6,a0
    dbra d7,.visible
    bra .next_feature
.has_front:
    clr.w ps_vertex(a6)
    cmp.w #1,ps_kind(a6)
    beq .crater
    bsr ps_fast_region
    tst.w d0
    bne .next_feature
.face:
    lea ps_triangle(a6),a2
    lea ps_view_points(a6),a0
    move.l (a0),(a2)+
    move.w 4(a0),(a2)+
    move.w ps_vertex(a6),d0
    mulu.w #6,d0
    lea 6(a0,d0.w),a1
    move.l (a1),(a2)+
    move.w 4(a1),(a2)+
    addq.l #6,a1
    cmp.w #11,ps_vertex(a6)
    bne.s .next_point
    lea 6(a0),a1
.next_point:
    move.l (a1),(a2)+
    move.w 4(a1),(a2)+
    bsr ps_triangle_draw
    addq.w #1,ps_vertex(a6)
    cmp.w #12,ps_vertex(a6)
    blo .face
    bra.s .next_feature
.crater:
    move.w ps_vertex(a6),d0
    move.w d0,d1
    addq.w #1,d1
    and.w #7,d1
    addq.w #1,d0
    addq.w #1,d1
    bsr ps_segment_draw
    addq.w #1,ps_vertex(a6)
    cmp.w #8,ps_vertex(a6)
    blo .crater
    clr.w ps_vertex(a6)
.ray:
    move.w ps_vertex(a6),d0
    move.w d0,d1
    add.w d0,d0
    addq.w #1,d0
    add.w #9,d1
    bsr ps_segment_draw
    addq.w #1,ps_vertex(a6)
    cmp.w #4,ps_vertex(a6)
    blo .ray
.next_feature:
    subq.w #1,ps_feature(a6)
    bpl .feature
    movem.l (sp)+,d0-d7/a0-a5
.return:
    rts

; An entirely visible, screen-contained, y-monotone coast can be filled in
; one pass. Concave coasts with multiple spans fall back to the triangle fan.
; This check is geometric: it never changes or simplifies the seeded map.
ps_fast_region:
    lea ps_view_points+6(a6),a0
    lea ps_nodes(a6),a2
    move.w #32767,poly_min_y(a6)
    move.w #-32768,poly_max_y(a6)
    moveq #11,d7
.node:
    tst.w 4(a0)
    bgt .fallback
    movem.w (a0),d0-d1
    bsr ps_project
    cmp.w #x_min,d0
    blt .fallback
    cmp.w #x_max,d0
    bgt .fallback
    cmp.w #y_min,d1
    blt .fallback
    cmp.w #y_max,d1
    bgt .fallback
    move.w d0,scr_x(a2)
    move.w d1,scr_y(a2)
    cmp.w poly_min_y(a6),d1
    bge.s .min
    move.w d1,poly_min_y(a6)
.min:
    cmp.w poly_max_y(a6),d1
    ble.s .max
    move.w d1,poly_max_y(a6)
    move.l a2,top_ptr(a6)
.max:
    lea -node_len(a2),a1
    move.l a1,prev(a2)
    lea node_len(a2),a1
    move.l a1,next(a2)
    move.l a1,a2
    addq.l #6,a0
    dbra d7,.node
    lea ps_nodes(a6),a0
    lea -node_len(a2),a1
    move.l a0,next(a1)
    move.l a1,prev(a0)
    moveq #0,d4 ; first non-horizontal edge direction
    moveq #0,d5 ; previous direction
    moveq #0,d6 ; direction changes
    moveq #11,d7
.edge:
    move.l next(a0),a1
    move.w scr_y(a1),d0
    sub.w scr_y(a0),d0
    beq.s .flat
    moveq #1,d1
    tst.w d0
    bpl.s .sign
    moveq #-1,d1
.sign:
    tst.w d4
    bne.s .first
    move.w d1,d4
    move.w d1,d5
.first:
    cmp.w d1,d5
    beq.s .flat
    addq.w #1,d6
    move.w d1,d5
.flat:
    move.l a1,a0
    dbra d7,.edge
    cmp.w d4,d5
    beq.s .closed
    addq.w #1,d6
.closed:
    cmp.w #2,d6
    bne.s .fallback
    jsr solid_polygon
    moveq #1,d0
    rts
.fallback:
    moveq #0,d0
    rts

; Compose the object's orientation, current cockpit view and eye direction.
ps_make_matrix:
    jsr calc_yvector
    movem.l this_xpos(a5),d0-d2
.reduce:
    move.l d0,d3
    bpl.s .abs_x
    neg.l d3
.abs_x:
    move.l d1,d4
    bpl.s .abs_y
    neg.l d4
.abs_y:
    or.l d4,d3
    or.l d2,d3 ; visible planet centre always has positive view Z
    cmp.l #8191,d3
    bls.s .reduced
    asr.l #1,d0
    asr.l #1,d1
    asr.l #1,d2
    bra.s .reduce
.reduced:
    bsr ps_normalize
    movem.w d0-d2,ps_eye(a6)
    neg.w d0
    exg d0,d2
    clr.w d1
    bsr ps_normalize
    movem.w d0-d2,ps_right(a6)
    lea ps_eye(a6),a0
    lea ps_right(a6),a1
    bsr ps_cross
    movem.w d0-d2,ps_up(a6)
    lea x_vector(a5),a2
    lea ps_matrix(a6),a3
    moveq #2,d7
.basis:
    movem.w (a2),d0-d2
    move.l w_view_ptr(a6),a0
    jsr (a0)
    lea ps_right(a6),a1
    bsr ps_dot_basis
    move.w d3,(a3)+
    lea ps_up(a6),a1
    bsr ps_dot_basis
    move.w d3,(a3)+
    lea ps_eye(a6),a1
    bsr ps_dot_basis
    move.w d3,(a3)+
    addq.l #6,a2
    dbra d7,.basis
    rts

ps_dot_basis:
    move.w d0,d3
    muls.w (a1),d3
    move.w d1,d4
    muls.w 2(a1),d4
    add.l d4,d3
    move.w d2,d4
    muls.w 4(a1),d4
    add.l d4,d3
    asr.l #8,d3
    asr.l #6,d3
    rts

; Clip one triangle against the spherical horizon, z <= 0. Intersections
; are normalized onto the limb; simply clipping screen polygons would show
; the far hemisphere through the near side of the planet.
ps_triangle_draw:
    lea ps_triangle+12(a6),a0
    lea ps_triangle(a6),a1
    lea ps_clipped(a6),a2
    clr.w ps_count(a6)
    moveq #2,d7
.edge:
    ; A vertex exactly on the horizon is inside. A sign-bit XOR alone
    ; would emit it twice on both adjacent edges and overflow four slots.
    tst.w 4(a0)
    bgt.s .from_back
    tst.w 4(a1)
    ble.s .no_cross
    bra.s .crossing
.from_back:
    tst.w 4(a1)
    bgt.s .no_cross
.crossing:
    bsr ps_intersection
    move.w d0,(a2)+
    move.w d1,(a2)+
    clr.w (a2)+
    addq.w #1,ps_count(a6)
.no_cross:
    tst.w 4(a1)
    bgt.s .outside
    move.l (a1),(a2)+
    move.w 4(a1),(a2)+
    addq.w #1,ps_count(a6)
.outside:
    move.l a1,a0
    addq.l #6,a1
    dbra d7,.edge
    cmp.w #3,ps_count(a6)
    blo .done
    lea ps_clipped(a6),a0
    lea ps_nodes(a6),a2
    move.w ps_count(a6),d7
    subq.w #1,d7
    clr.w clip_panel(a6)
    move.w #32767,poly_min_y(a6)
    move.w #-32768,poly_max_y(a6)
.node:
    movem.w (a0),d0-d1
    bsr ps_project
    move.w d0,scr_x(a2)
    move.w d1,scr_y(a2)
    moveq #0,d2
    cmp.w #x_min,d0
    bge.s .left_ok
    bset #off_left,d2
.left_ok:
    cmp.w #x_max,d0
    ble.s .right_ok
    bset #off_right,d2
.right_ok:
    cmp.w #y_min,d1
    bge.s .bottom_ok
    bset #off_bottom,d2
.bottom_ok:
    cmp.w #y_max,d1
    ble.s .top_ok
    bset #off_top,d2
.top_ok:
    clr.w nflags(a2)
    move.b d2,nflags(a2)
    or.b d2,clip_panel(a6)
    cmp.w poly_min_y(a6),d1
    bge.s .min_ok
    move.w d1,poly_min_y(a6)
.min_ok:
    cmp.w poly_max_y(a6),d1
    ble.s .max_ok
    move.w d1,poly_max_y(a6)
    move.l a2,top_ptr(a6)
.max_ok:
    lea -node_len(a2),a3
    move.l a3,prev(a2)
    lea node_len(a2),a3
    move.l a3,next(a2)
    move.l a3,a2
    addq.l #6,a0
    dbra d7,.node
    lea -node_len(a2),a3
    lea ps_nodes(a6),a4
    move.l a4,next(a3)
    move.l a3,prev(a4)
    ; Rasterising a zero-height face adds no useful detail.
    move.w poly_min_y(a6),d0
    cmp.w poly_max_y(a6),d0
    beq.s .done
    jsr c_solid_polygon
.done:
    rts

; A0/A1 straddle z=0. Return the normalized intersection in D0/D1/D2.
ps_intersection:
    movem.l d3-d7,-(sp)
    move.w 4(a0),d6
    move.w 4(a1),d5
    sub.w d6,d5
    move.w (a1),d0
    sub.w (a0),d0
    muls.w d6,d0
    divs.w d5,d0
    neg.w d0
    add.w (a0),d0
    move.w 2(a1),d1
    sub.w 2(a0),d1
    muls.w d6,d1
    divs.w d5,d1
    neg.w d1
    add.w 2(a0),d1
    clr.w d2
    bsr ps_normalize
    movem.l (sp)+,d3-d7
    rts

; D0/D1 are point indices. The two endpoints get independent hemisphere and
; viewport clipping, so a crater never disappears as a whole at the limb.
ps_segment_draw:
    mulu.w #6,d0
    mulu.w #6,d1
    lea ps_view_points(a6),a2
    lea (a2,d0.w),a0
    lea (a2,d1.w),a1
    lea ps_segment(a6),a2
    move.l (a0),(a2)
    move.w 4(a0),4(a2)
    move.l (a1),6(a2)
    move.w 4(a1),10(a2)
    move.l a2,a0
    lea 6(a2),a1
    tst.w 4(a0)
    ble.s .first_front
    tst.w 4(a1)
    bgt .done
    bsr ps_intersection
    move.w d0,(a0)
    move.w d1,2(a0)
    bra.s .project
.first_front:
    tst.w 4(a1)
    ble.s .project
    bsr ps_intersection
    move.w d0,(a1)
    move.w d1,2(a1)
.project:
    movem.w (a0),d0-d1
    bsr ps_project
    movem.w d0-d1,ps_line(a6)
    movem.w (a1),d0-d1
    bsr ps_project
    move.w d0,d2
    move.w d1,d3
    movem.w ps_line(a6),d0-d1
    jsr c_line
.done:
    rts

; Q12 disk coordinate -> view pixel. Long additions saturate safely before
; the existing viewport clipper; no signed-word wrap for very close planets.
ps_project:
    muls.w ps_radius(a6),d0
    muls.w ps_radius(a6),d1
    add.l #2048,d0 ; round to nearest, avoiding a negative-coordinate bias
    add.l #2048,d1
    asr.l #8,d0
    asr.l #4,d0
    asr.l #8,d1
    asr.l #4,d1
    ifne circle_stretch
    add.l d0,d0 ; match the independent Amiga circle raster
    endc
    move.w centre_x(a5),d2
    ext.l d2
    add.l d2,d0
    move.w centre_y(a5),d2
    ext.l d2
    add.l d2,d1
    cmp.l #16000,d0
    ble.s .x_high
    move.l #16000,d0
.x_high:
    cmp.l #-16000,d0
    bge.s .x_low
    move.l #-16000,d0
.x_low:
    cmp.l #16000,d1
    ble.s .y_high
    move.l #16000,d1
.y_high:
    cmp.l #-16000,d1
    bge.s .done
    move.l #-16000,d1
.done:
    rts

; Icosahedral anchors distribute features around the entire sphere.
ps_sea_centres:
    dc.w 2365,2365,2365,-2365,-2365,-2365,2365,-2365,-2365,-2365,2365,2365
    dc.w -2365,2365,-2365,2365,-2365,2365,-2365,-2365,2365,2365,2365,-2365
ps_centres:
    dc.w 0,2153,3484,0,-2153,3484,0,2153,-3484,0,-2153,-3484
    dc.w 2153,3484,0,-2153,3484,0,2153,-3484,0,-2153,-3484,0
    dc.w 3484,0,2153,3484,0,-2153,-3484,0,2153,-3484,0,-2153
ps_ring12:
    dc.w 4096,0,3547,2048,2048,3547,0,4096,-2048,3547,-3547,2048
    dc.w -4096,0,-3547,-2048,-2048,-3547,0,-4096,2048,-3547,3547,-2048
ps_ring8:
    dc.w 4096,0,2896,2896,0,4096,-2896,2896
    dc.w -4096,0,-2896,-2896,0,-4096,2896,-2896

ps_longitudes:
    dc.w 16384,0
    dc.w 16305,1606
    dc.w 16069,3196
    dc.w 15679,4756
    dc.w 15137,6270
    dc.w 14449,7723
    dc.w 13623,9102
    dc.w 12665,10394
    dc.w 11585,11585
    dc.w 10394,12665
    dc.w 9102,13623
    dc.w 7723,14449
    dc.w 6270,15137
    dc.w 4756,15679
    dc.w 3196,16069
    dc.w 1606,16305
    dc.w 0,16384
    dc.w -1606,16305
    dc.w -3196,16069
    dc.w -4756,15679
    dc.w -6270,15137
    dc.w -7723,14449
    dc.w -9102,13623
    dc.w -10394,12665
    dc.w -11585,11585
    dc.w -12665,10394
    dc.w -13623,9102
    dc.w -14449,7723
    dc.w -15137,6270
    dc.w -15679,4756
    dc.w -16069,3196
    dc.w -16305,1606
    dc.w -16384,0
    dc.w -16305,-1606
    dc.w -16069,-3196
    dc.w -15679,-4756
    dc.w -15137,-6270
    dc.w -14449,-7723
    dc.w -13623,-9102
    dc.w -12665,-10394
    dc.w -11585,-11585
    dc.w -10394,-12665
    dc.w -9102,-13623
    dc.w -7723,-14449
    dc.w -6270,-15137
    dc.w -4756,-15679
    dc.w -3196,-16069
    dc.w -1606,-16305
    dc.w 0,-16384
    dc.w 1606,-16305
    dc.w 3196,-16069
    dc.w 4756,-15679
    dc.w 6270,-15137
    dc.w 7723,-14449
    dc.w 9102,-13623
    dc.w 10394,-12665
    dc.w 11585,-11585
    dc.w 12665,-10394
    dc.w 13623,-9102
    dc.w 14449,-7723
    dc.w 15137,-6270
    dc.w 15679,-4756
    dc.w 16069,-3196
    dc.w 16305,-1606

; The same visible colours allowed for planet backgrounds; yellow is for suns.
ps_continent_colours:
    dc.w lgt_grey,orange,magenta,red,lgt_green,mid_green
    dc.w drk_green,lgt_blue,mid_blue,drk_blue,white
ps_continent_count: equ (*-ps_continent_colours)/2

ps_ray_angles:
    dc.w 4034,-711
    dc.w 4065,-499
    dc.w 4086,-286
    dc.w 4095,-71
    dc.w 4095,71
    dc.w 4086,286
    dc.w 4065,499
    dc.w 4034,711
