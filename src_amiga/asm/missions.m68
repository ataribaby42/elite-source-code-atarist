	include "common.def"
; Ported from src-orig/MISSIONS_M68; edit this copy.
* @@   @@  @@@@@@	@@@@	@@@@   @@@@@@	@@@   @@   @@	@@@@
* @@@ @@@	 @@    @@  @@  @@  @@	 @@    @@ @@  @@@  @@  @@  @@
* @@@@@@@	 @@    @@	   @@		 @@   @@   @@ @@@@ @@  @@
* @@@@@@@	 @@ 	@@@@	@@@@	 @@   @@   @@ @@ @@@@	@@@@
* @@ @ @@	 @@ 	   @@	   @@	 @@   @@   @@ @@  @@@	   @@
* @@   @@	 @@    @@  @@  @@  @@	 @@    @@ @@  @@   @@  @@  @@
* @@   @@  @@@@@@	@@@@	@@@@   @@@@@@	@@@   @@   @@	@@@@

* Routines to display mission related messages.

* Mission #1 - Stolen Constrictor

*	$10 - print message offering mission upon docking
*	$11 - waiting until docked with briefing planet, then display message
*		  informing the player to make a inter-galactic jump
*	$12 - waiting for inter-galactic jump, then initialises number of
*		  planets to visit to 5
*	$13 - waiting for player to visit the five planets. Each time the
*		  player docks a new planet is chosen.
*	$14 - wait until entering system with Constrictor in it.
*	$15 - get attacked by Constrictor in deep space.
*	$16 - give reward at next docking

* Atari ST Version 1.0 13th May 1988 Copyright (c) 1988 Mr. Micro Ltd.
* Designed and coded by Rob Nicholson. Adapted from the MSX version.

; Modification history:

;	V1.0	13/05/88	Original version.
;	V1.1	26/03/90	Spelling mistake. 'the sun is this' changed to
;						'the sun in this' in text1.

	include "macros.m68"

	xref yes_no,cargo_spare,prepare_text,str_copy,build_number,print_centre
	xref print_string,attract,search,build_name,init_cursor,choose_planet,data
	xref continue,status,launch,buy_cargo,sell_cargo,equip_ship,galactic_chart
	xref local_chart,market_prices,inventory,disk,find_planet,home_cursor
	xref options

* ---- LOCAL CONSTANTS ----

max_mission: equ 5 ; max. # of missions

	q_module missions


* ***************************************
* **								   **
* ** NEW_MISSION - START A NEW MISSION **
* **								   **
* ***************************************

* Starts a new mission - called when JUMP_COUNT = 0

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr new_mission,global

	move #mission_rate,jump_count(a6) ; reset counter
	move next_mission(a6),d0 ; no more missions ?
	cmp #max_mission+1,d0
	q_ret eq ; yes, return (no mission)
	q_inc next_mission(a6) ; advance to next mission
	asl #4,d0 ; set state #0 (e.g. $10)
	move d0,mission(a6)

	q_ret return


*************************************
**								   **
** DOCK_CHECK - MISSION DOCK CHECK **
**								   **
*************************************

* Perform checks for special messages on docking.

* Entry:  None
* Exit:   None

* Regs:   ?
* Subr:   ?

	q_subr dock_check,global

	move mission(a6),d0 ; constrictor mission ?
	move d0,d1
	and #240,d1
	cmp #$10,d1
; Quelo: 	if <eq> then.s						yes
	bne.s q_missions_m68_1
	cmp #$10,d0 ; start of mission ?
	beq offer1 ; yes, offer mission
	cmp #$11,d0 ; check for briefing planet ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_missions_m68_3
	move current(a6),d0 ; reached required planet ?
	cmp mission_planet(a6),d0
	beq gone1 ; yes, display message
q_missions_m68_3:
	cmp #$13,d0 ; check for reaching planet ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_missions_m68_5
	move current(a6),d0 ; reached required planet ?
	cmp mission_planet(a6),d0
	beq gone2 ; yes, display message
q_missions_m68_5:
	cmp #$16,d0 ; give reward ?
	beq thanks2 ; yes
	jmp status ; display status screen and return
q_missions_m68_1:
	cmp #$20,d1 ; thargoid documents mission ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_missions_m68_7
	cmp #$20,d0 ; offer mission ?
	beq offer1 ; yes
	move current(a6),d0 ; at correct planet ?
	cmp mission_planet(a6),d0
	beq thanks1 ; yes, display thanks message
	jmp status
q_missions_m68_7:
	cmp #$30,d1 ; rescue refugees ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_missions_m68_9
	cmp #$31,d0 ; offer mission ?
	beq offer3 ; yes
	cmp #$34,d0 ; give thanks ?
	beq thanks3 ; receive thanks
	jmp status
q_missions_m68_9:
	cmp #$40,d0 ; display warning ?
	beq warning4 ; yes
	cmp #$50,d0 ; display another warning ?
	beq warning5 ; yes
	cmp #$53,d0 ; thanks for mission ?
	beq thanks5 ; yes
	jmp status ; display status screen


*********************************************
**										   **
** MISSION_SCREEN - PREPARE MISSION SCREEN **
**										   **
*********************************************

* Prepares the text screen and prints the current mission number.

* Entry:  HL = Pointer to text (AT format)
* Exit:   None

* Regs: ?
* Subr: ?

	q_subr mission_screen

	q_push.l a0 ; save text pointer
	jsr prepare_text ; prepare text screen
	lea text15(pc),a0 ; build title
	lea pad(a6),a1
	jsr str_copy
	move.l a1,a0
	q_dec.l a0
	move mission(a6),d0
	lsr #4,d0
	q_hclr d0
	clr d1
	jsr build_number
	st slow_print(a6) ; start slow print
	lea pad(a6),a0 ; print title
	moveq #title_y,d1
	jsr print_centre
	lea text16(pc),a0 ; display commanders name
	jsr print_string
	lea player_name(a6),a0
	jsr print_string
	q_pop.l a0 ; print full text
	jmp print_string


**********************************
**								**
** OFFER1 - OFFER MISSION #1/#2 **
**								**
**********************************

* Offer the player the choice of taking the Constrictor or Thargoid
* documents mission.

* Entry:  None
* Exit:   None

* Regs:   ?
* Subr:   ?

	q_subr offer1

	cmp #$10,mission(a6) ; Mission #1 ?
	q_call eq,attract ; display constrictor
	movem splanet+xcoord(a6),d0/d1 ; find furthest planet
	jsr search
	move d0,mission_planet(a6)
	lea text17(pc),a0 ; display mission screen
	bsr mission_screen
	cmp #$10,mission(a6) ; constrictor mission ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_missions_m68_11
	lea text6(pc),a0
	bra.s q_missions_m68_12
q_missions_m68_11:
	lea text11(pc),a0
q_missions_m68_12:
	jsr print_string ; print 1st section
	q_push.l a0 ; save pointer to next section
	move mission_planet(a6),d0 ; print planet name
	jsr build_name
	lea planet_name(a6),a0
	jsr print_string
	q_pop.l a0 ; print 2nd section
	jsr print_string
	clr slow_print(a6) ; stop slow print
	lea text19(pc),a0 ; accept mission ?
	jsr yes_no
	cmp.b #'N',d0
; Quelo: 	if <eq> then.s						no
	bne.s q_missions_m68_13
	clr mission(a6) ; mission over
	jmp status
q_missions_m68_13:
	q_inc mission(a6) ; state #1
	cmp #$21,mission(a6) ; mission #2 ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_missions_m68_15
	move.l #1,hold+documents*4(a6) ; install documents
	move #70,equip+fuel(a6) ; fill her up
	move #4,equip+missiles(a6)
	lea text20(pc),a0 ; display screen
	bsr mission_screen
	bra.s q_missions_m68_16
q_missions_m68_15:
	lea text7(pc),a0 ; display screen
	bsr mission_screen
	q_push.l a0
	move mission_planet(a6),d0
	jsr build_name
	lea planet_name(a6),a0
	jsr print_string
	q_pop.l a0
	jsr print_string
q_missions_m68_16:
	clr slow_print(a6)
	lea mission_table(pc),a0 ; initialise mouse and exit
	jmp init_cursor


* *******************************
* **						   **
* ** OFFER3 - OFFER MISSION #3 **
* **						   **
* *******************************

* Offers the mission of saving the refugees from their exploding sun.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr offer3

	q_inc mission(a6) ; mission state #2
	lea hold(a6),a0 ; empty the hold
	q_loop 1,max_products
	clr.l (a0)+
	q_next 1
	lea text1(pc),a0 ; display mission screen
	bsr mission_screen
	clr slow_print(a6)
	lea text18(pc),a0 ; input yes/no answer
	jsr yes_no
	cmp.b #'Y',d0 ; yes ?
; Quelo: 	if <ne> then.s						no
	beq.s q_missions_m68_17
	lea text5(pc),a0 ; display text and exit
	bra.s q_missions_m68_18
q_missions_m68_17:
	jsr cargo_spare ; fill cargo with refugees
	move.l d3,hold+refugees*4(a6)
	q_inc mission(a6) ; mission state #3
	lea text4(pc),a0
q_missions_m68_18:
	bsr mission_screen ; print message
	clr slow_print(a6)
	lea mission_table(pc),a0
	jmp init_cursor


* *************************************************
* **											 **
* ** WARNING4 - DISPLAY WARNING ABOUT THE COUGAR **
* **											 **
* *************************************************

* Display a warning screen about the Cougar.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr warning4

	lea text21(pc),a0 ; print message
	bsr mission_screen
	clr slow_print(a6)
	q_inc mission(a6) ; move to state #$41
	lea mission_table(pc),a0
	jmp init_cursor


* ************************************************
* **											**
* ** WARNING - DISKPLAY WARNING ABOUT THARGOIDS **
* **											**
* ************************************************

* Display message about the invasion of a local system.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr warning5

	lea text13(pc),a0 ; print message
	bsr mission_screen
	clr slow_print(a6)
	q_inc mission(a6) ; move to state #$51
	lea mission_table(pc),a0
	jmp init_cursor


*******************************
**							 **
** GONE1 - DISPLAY A MESSAGE **
**							 **
*******************************

* Display the message informing the player that the Constrictor has
* made a galactic jump.

	q_subr gone1,global

	lea text8(pc),a0 ; display message
	bsr mission_screen
	clr slow_print(a6)
	q_inc mission(a6) ; move to state #$12
	lea mission_table(pc),a0 ; initialise mouse and return
	jmp init_cursor


*******************************
**							 **
** GONE2 - DISPLAY A MESSAGE **
**							 **
*******************************

* Display the message informing the player that the Constrictor has
* left this system.

	q_subr gone2,global

	jsr choose_planet ; Choose close another planet
	lea text9(pc),a0 ; Display message
	bsr mission_screen
	move mission_planet(a6),d0 ; Display planet
	jsr build_name
	lea planet_name(a6),a0
	jsr print_string
	clr slow_print(a6)
	q_dec mission_count(a6) ; Enough planets visited ?
; Quelo: 	if <eq> then.s						Yes
	bne.s q_missions_m68_19
	q_inc mission(a6) ; Mission state #4
q_missions_m68_19:
	lea mission_table(pc),a0 ; initialise mouse and exit
	jmp init_cursor


*****************************************************
**												   **
** THANKS - DISPLAY THANKS FOR CONSTRICTOR MISSION **
**												   **
*****************************************************

* Display thank you message for completing the Constrictor missions. Install
* a military energy unit as a reward.

	q_subr thanks1

	lea text12(pc),a0 ; Display message
	bsr mission_screen
	clr slow_print(a6)
	move #2,equip+energy_unit(a6) ; Military energy unit
	clr mission(a6) ; mission over
	clr.l hold+documents*4(a6) ; remove documents
	lea mission_table(pc),a0
	jmp init_cursor


* *************************************************************
* **														 **
* ** THANKS2 - DISPLAY THANKS FOR THARGOID DOCUMENTS MISSION **
* **														 **
* *************************************************************

* Display thank you message for completing the Thargoid documents missioms. As
* as reward, add 10,000 credits to the players cash.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr thanks2

	lea text10(pc),a0 ; Display message
	bsr mission_screen
	clr slow_print(a6)
	add.l #100000,cash(a6) ; reward for 10,000 credits
	clr mission(a6) ; mission over
	lea mission_table(pc),a0
	jmp init_cursor



* ***************************************************
* **											   **
* ** THANKS3 - DISPLAY THANKS FOR REFUGEES MISSION **
* **											   **
* ***************************************************

* Display thank you message for carrying the refugees to the next space
* station. As a reward, add 1kg of gem-stones to the players hold.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr thanks3

	lea text2(pc),a0 ; display mission screen
	bsr mission_screen
	clr slow_print(a6)
	clr.l hold+refugees*4(a6) ; remove refugees
	move.l #1000,hold+gem_stones*4(a6) ; add gem-stones
	clr mission(a6) ; mission over
	lea mission_table(pc),a0
	jmp init_cursor


* ***********************************************************
* **													   **
* ** THANKS5 - DISPLAY THANKS FOR DESTROYING SPACE STATION **
* **													   **
* ***********************************************************

* Display a thank you message and fit the ECM jammer.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr thanks5

	lea text14(pc),a0 ; display thank you
	bsr mission_screen
	clr slow_print(a6)
	clr mission(a6) ; Mission over
	move #1,equip+ecm_jammer(a6) ; Fit ECM jammer
	lea mission_table(pc),a0
	jmp init_cursor


* ******************************************************
* **												  **
* ** WAIT_TILL_READ - WAIT UNTIL SCREEN HAS BEEN READ **
* **												  **
* ******************************************************

* Prompts the player to press any key to continue then jump to status
* screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr wait_till_read

	jsr continue ; wait for key press
	jmp status ; display status screen


* ---- LOCAL DATA ----

* Mission mouse action table.

mission_table:

	include "icons.m68"
	dc.w -1
	dc.l 0

* Text messages.

text1:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 6*8,'Warning - the sun in this system is'
	dc.b c_cursor,0, 7*8,'going Supernova. You are advised to'
	dc.b c_cursor,0, 8*8,'leave as soon as possible.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,10*8,'Please help us! Everyone else has fled'
	dc.b c_cursor,0,11*8,'the supernova but we were left behind'
	dc.b c_cursor,0,12*8,'when our shuttle was damaged by an'
	dc.b c_cursor,0,13*8,'asteroid. We managed to limp back to the'
	dc.b c_cursor,0,14*8,'space station but face certain death if'
	dc.b c_cursor,0,15*8,'we don''t leave soon.'

	dc.b c_ink,lgt_blue
	dc.b c_cursor,0,17*8,'There are only a few of us - we could'
	dc.b c_cursor,0,18*8,'fit in your cargo hold.',0

text2:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 9*8,'Thank you for saving our lives and'
	dc.b c_cursor,0,10*8,'carrying us to safety. Please accept a'
	dc.b c_cursor,0,11*8,'selection of precious Zanxian gem stones'
	dc.b c_cursor,0,12*8,'as a token of our appreciation.',0

text4:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 8*8,'Thank you - you will be well rewarded by'
	dc.b c_cursor,0, 9*8,'our government.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,11*8,'I''m afraid that we''ve had to dump any'
	dc.b c_cursor,0,12*8,'cargo you had to get us all in. If'
	dc.b c_cursor,0,13*8,'you could just drop us off at the'
	dc.b c_cursor,0,14*8,'nearest system that''ll be fine.',0

text5:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0,10*8,'We hope you die a horribly long and'
	dc.b c_cursor,0,11*8,'lingering death at the hands of a slimey'
	dc.b c_cursor,0,12*8,'green lobstoid, that''s if you''re not'
	dc.b c_cursor,0,13*8,'blown to bits by our sun!',0

text6:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 7*8,'A prototype model of the new top-secret'
	dc.b c_cursor,0, 8*8,'military ship, the '
	dc.b c_ink,pulse,'CONSTRICTOR',c_ink,magenta,', has been'
	dc.b c_cursor,0, 9*8,'been stolen by unknown agents from the'
	dc.b c_cursor,0,10*8,'navy research base at '
	dc.b c_ink,white,0

	dc.b c_ink,yellow
	dc.b c_cursor,0,12*8,'Due to a capabilities of this ship, the'
	dc.b c_cursor,0,13*8,'Galactic Co-operative of Worlds is'
	dc.b c_cursor,0,14*8,'offering a large reward to anyone who'
	dc.b c_cursor,0,15*8,'destroys the Constrictor before it falls'
	dc.b c_cursor,0,16*8,'into enemy hands.',0

text7:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 7*8,'For full mission briefing, please report'
	dc.b c_cursor,0, 8*8,'to the space station at '
	dc.b c_ink,white,0

	dc.b c_ink,yellow
	dc.b c_cursor,0,11*8,'Due to the sensitive nature of this'
	dc.b c_cursor,0,12*8,'assignment, it is vital that you keep'
	dc.b c_cursor,0,13*8,'details of the Constrictor to yourself.'

	dc.b c_ink,lgt_blue
	dc.b c_cursor,0,16*8,'Good luck Commander!',0

text8:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 8*8,'The Galactic Intelligence Agency (GIA)'
	dc.b c_cursor,0, 9*8,'reports that the Constrictor made an'
	dc.b c_cursor,0,10*8,'inter-galactic jump out of this system'
	dc.b c_cursor,0,11*8,'a short while ago.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,13*8,'It is suggested that you make the same'
	dc.b c_cursor,0,14*8,'jump and report to the nearest space'
	dc.b c_cursor,0,15*8,'station for further details.',0

text9:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 8*8,'GIA reports that after causing havoc,'
	dc.b c_cursor,0, 9*8,'the Constrictor made a hyperspace jump'
	dc.b c_cursor,0,10*8,'out of this system.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,13*8,'The deep space tracking station suggests'
	dc.b c_cursor,0,14*8,'that it''s destination was ',c_ink,white,0

text10:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 6*8,'The Galactic Co-opertive of Worlds is'
	dc.b c_cursor,0, 7*8,'forever in your debt, oh mighty trader!'

	dc.b c_ink,yellow
	dc.b c_cursor,0, 9*8,'As a small token of our appreciation,'
	dc.b c_cursor,0,10*8,'please accept a reward of 10,000 credits'
	dc.b c_cursor,0,11*8,'for your trouble.'

	dc.b c_ink,lgt_blue
	dc.b c_cursor,0,13*8,'While I have your attention, the'
	dc.b c_cursor,0,14*8,'Galactic Police would like me to remind'
	dc.b c_cursor,0,15*8,'you about the small matter of several'
	dc.b c_cursor,0,16*8,'hundred unpaid parking tickets!',0

text11:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 6*8,'The navy has managed to obtain rare'
	dc.b c_cursor,0, 7*8,'blueprints of a Thargoid battle ship'
	dc.b c_cursor,0, 8*8,'giving details of the drive and weapon'
	dc.b c_cursor,0, 9*8,'systems.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,11*8,'These documents need to be taken as soon'
	dc.b c_cursor,0,12*8,'as possible to the main naval base in'
	dc.b c_cursor,0,13*8,'orbit around the planet '
	dc.b c_ink,white,0

	dc.b c_ink,lgt_blue
	dc.b c_cursor,0,15*8,'The enemy is unaware that we have these'
	dc.b c_cursor,0,16*8,'documents, so the journey should proceed'
	dc.b c_cursor,0,17*8,'without any trouble.',0

text20:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 9*8,'The documents have been placed in your'
	dc.b c_cursor,0,10*8,'cargo hold. Your ship has been fully'
	dc.b c_cursor,0,11*8,'serviced and is ready for takeoff.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,13*8,'Good luck Commander!',0

text12:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 5*8,'We are (again) forever in your debt'
	dc.b c_cursor,0, 6*8,'for bringing these very important'
	dc.b c_cursor,0, 7*8,'documents to us.'

	dc.b c_ink,yellow
	dc.b c_cursor,0, 9*8,'As a reward we have fitted your Cobra'
	dc.b c_cursor,0,10*8,'with the latest naval energy unit which'
	dc.b c_cursor,0,11*8,'will recharge your energy banks at twice'
	dc.b c_cursor,0,12*8,'the normal rate. In light of the number'
	dc.b c_cursor,0,13*8,'of ''incidents'' you get yourself involved'
	dc.b c_cursor,0,14*8,'in, you will probably find it rather'
	dc.b c_cursor,0,15*8,'useful.'

	dc.b c_ink,lgt_blue
	dc.b c_cursor,0,17*8,'The GIA also wishes to apologise for the'
	dc.b c_cursor,0,18*8,'security leak to the Thargoids. They are'
	dc.b c_cursor,0,19*8,'carrying out intensive investigations'
	dc.b c_cursor,0,20*8,'and the culprit will soon be found.',0

text13:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 7*8,'The Galactic Intelligence Agency reports'
	dc.b c_cursor,0, 8*8,'that a nearby system has been invaded by'
	dc.b c_cursor,0, 9*8,'Thargoid ships and that the space'
	dc.b c_cursor,0,10*8,'station has been captured. All available'
	dc.b c_cursor,0,11*8,'forces are being gathered to destroy the'
	dc.b c_cursor,0,12*8,'invading force.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,14*8,'The space station has become the main'
	dc.b c_cursor,0,15*8,'Thargoid headquarters and it''s from this'
	dc.b c_cursor,0,16*8,'base that the planetary attack is being'
	dc.b c_cursor,0,17*8,'mounted. The space station must be'
	dc.b c_cursor,0,18*8,'detroyed - no matter what the cost!',0

text14:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,magenta
	dc.b c_cursor,0, 8*8,'Thanks for destroying the Thargoid base.'

	dc.b c_ink,yellow
	dc.b c_cursor,0,10*8,'A new device was salvaged from one of'
	dc.b c_cursor,0,11*8,'Thargoid ships which we have fitted to'
	dc.b c_cursor,0,12*8,'your Cobra. The device appears to jam'
	dc.b c_cursor,0,13*8,'ECM broadcasts and is activated by the'
	dc.b c_cursor,0,14*8,'L key on your flight console.',0

text21:

*						0123456789012345678901234567890123456789'
	dc.b c_ink,pulse
	dc.b c_cursor,0, 7*8,'Warning to all Traders:'

	dc.b c_ink,magenta
	dc.b c_cursor,0, 9*8,'Reports having been coming in from'
	dc.b c_cursor,0,10*8,'Traders in this sector of an unknown'
	dc.b c_cursor,0,11*8,'hostile ship with awesome capabilities.'
	dc.b c_cursor,0,12*8,'Rumours suggest that this ship is fitted'
	dc.b c_cursor,0,13*8,'with a device which causes on-board'
	dc.b c_cursor,0,14*8,'computer systems to malfunction.',0

text15: dc.b 'Mission No. ',0
text16: dc.b c_cursor,0,3*8,c_ink,orange,'Attn: '
	dc.b c_ink,lgt_green,'Commander ',0
text17: dc.b 0
text18: dc.b 'Will you help us',0
text19: dc.b 'Accept mission',0
