; Paula sample playback. Original Amiga effects are extracted at build time.
; Native Amiga music decoding and instruments are provided by music.m68.
    include "common.def"
    include "macros.m68"
    xdef fx,sound,quiet,start_tune,start_fade,sounds_used
    xref amiga_music_init,amiga_music_tick,amiga_music_periods
    xref amiga_music_volumes,amiga_music_mute,amiga_music_retrigger
    xref amiga_music_attack,amiga_music_loops
    include "beam-loops.inc"
    include "rcs-loop.inc"
    include "engine-loop.inc"
    xdef prepare_rcs_frame,publish_rcs_sound,stop_rcs_sound
sounds_used: equ 0
; Length of the ECM wave in VBL ticks, 2.32 seconds at PAL 50 Hz. The Atari
; driver keeps ECM_ON set for exactly as long as its PSG effect plays, which
; is this many ticks: DO_ECM sweeps the tone from 100 to 200 in steps of 50
; and back, ECM_DUR (20) times. Paula has no equivalent, so the wave is timed.
ecm_wave: equ 116
    section text,code
    cnop 0,4
; Discrete incoming hits retrigger the shield sample; ordinary repeated
; effects retain their existing duplicate suppression and Effects/music gates.
    xdef laser_impact_sound
laser_impact_sound:
    tst audio_resetting
    bne.s .done
    btst #f_fx,user(a6)
    beq.s .done
    tst music_playing
    bne.s .done
    st laser_impact_pending     ; one atomic publication to the VBL consumer
.done:
    rts

    xdef comm_arrival_sound
comm_arrival_sound:
    tst audio_resetting
    bne.s .done
    btst #f_fx,user(a6)
    beq.s .done
    tst music_playing
    bne.s .done
    st comm_audio_pending ; short receipt tone, retriggered at the next VBL
.done:
    rts

fx:
    tst audio_resetting
    bne .return
    cmp.w #sfx_hyperspace,d0
    bne .not_warp
    ifne display_ntsc
    move.w #180,warp_ticks      ; three seconds at 60 Hz
    else
    move.w #150,warp_ticks      ; three seconds at 50 Hz
    endc
    st end_hyperspace(a6)
.not_warp:
; ECM is a gameplay state, not a sound: ECM_ON is what makes ECM (COMBAT)
; destroy every missile in the world. It is started here, ahead of the Effects
; switch and of the music, so the wave runs whatever the player is listening to.
    cmp.w #sfx_ecm,d0
    bne .enabled
    move.w #ecm_wave,ecm_ticks
    st ecm_on(a6)
.enabled:
    cmp.w #sfx_spacejump,d0
    bne.s .torus_ready
    st torus_audio_requested   ; owner state keeps the loop alive until quiet
.torus_ready:
    btst #f_fx,user(a6)
    beq .return
    cmp.w #sfx_identify,d0
    beq.s .request_enabled
    cmp.w #sfx_countdown,d0
    beq.s .request_enabled
    cmp.w #sfx_teletype,d0
    bhi .return
.request_enabled:
    tst music_playing
    bne .return
    move.l a0,-(sp)
    lea effect_requests,a0
    st (a0,d0.w)                ; publish atomically; Paula is serviced in VBL
    move.l (sp)+,a0
.return:
    rts

play_effect:
    movem.l d0-d7/a0-a5,-(sp)
    lea effect_ids,a0
    lea effect_ticks,a1
    moveq #3,d7
.same:
    cmp.b (a0)+,d0
    bne .next
    tst.w (a1)
    beq.s .next
    cmp.w #sfx_comm,d0
    bne.s .shield_repeat
    tst comm_audio_pending
    beq .done
    bra.s .restart
.shield_repeat:
    cmp.w #sfx_shields,d0
    bne .done
    tst laser_impact_pending
    beq .done                   ; ordinary held effects still do not restart
.restart:
    moveq #3,d6
    sub.w d7,d6                 ; restart the existing impact or receipt voice
    bra .channel_ready
.next:
    addq.l #2,a1
    dbra d7,.same
    ; Prefer a free voice, then RCS, before rotating through ordinary effects.
    moveq #0,d6
    lea effect_ticks,a1
.find_free:
    cmp.w #3,d6
    bne.s .check_rcs
    tst beam_kind
    bne.s .next_free
.check_rcs:
    move.w d6,d7
    addq.w #1,d7
    cmp.w rcs_voice,d7
    beq.s .next_free
    cmp.w engine_voice,d7
    beq.s .next_free
    tst.w (a1)
    beq .channel_ready
.next_free:
    addq.l #2,a1
    addq.w #1,d6
    cmp.w #4,d6
    bne.s .find_free
    tst engine_voice
    beq.s .try_rcs
    move.w engine_voice,d6
    subq.w #1,d6
    bsr stop_engine_voice
    bra.s .channel_ready
.try_rcs:
    tst rcs_voice
    beq.s .rotate
    move.w rcs_voice,d6
    subq.w #1,d6
    bsr stop_rcs_voice
    bra.s .channel_ready
.rotate:
    move.w next_channel,d6
    lea effect_ids,a0
    moveq #3,d7
.find_replaceable:
    cmp.w #3,d6
    bne.s .check_owner
    tst beam_kind
    bne.s .next_candidate
.check_owner:
    cmp.b #sfx_spacejump,(a0,d6.w)
    beq.s .check_live
    cmp.b #sfx_alert,(a0,d6.w)
    bne.s .channel_ready
.check_live:
    move.w d6,d1
    add.w d1,d1
    lea effect_ticks,a1
    tst.w (a1,d1.w)
    beq.s .channel_ready
.next_candidate:
    addq.w #1,d6
    and.w #3,d6
    dbra d7,.find_replaceable
    bra .done                  ; never replace a sustained owner or held beam
.channel_ready:
    move.w d6,d1
    lsl.w #4,d1
    lea effect_envelopes,a4
    move.w (a4,d1.w),-(sp)      ; old voice may have slid beyond period 428
    move.w d6,next_channel
    addq.w #1,next_channel
    and.w #3,next_channel
    lea effect_ids,a0
    move.b d0,(a0,d6.w)
    lea effect_map(pc),a0
    move.b (a0,d0.w),d0
    and.w #255,d0
    move.w d0,d5                ; original Amiga effect/sample number
    lsl.w #3,d0
    lea amiga_effect_descriptors(pc),a2
    adda.w d0,a2
    moveq #0,d0
    move.b 1(a2),d0
    add.w d0,d0
    lea amiga_effect_periods(pc),a0
    move.w (a0,d0.w),d7
    move.w d5,d0
    lsl.w #2,d0
    lea amiga_sample_offsets(pc),a0
    move.l (a0,d0.w),d1
    lea amiga_samples,a0
    adda.l d1,a0
    add.w d5,d5
    lea amiga_sample_lengths(pc),a1
    moveq #0,d2
    move.w (a1,d5.w),d2
    ; The original byte counter runs for duration+1 services per pass.
    ; Repeat zero still means two passes; fading starts after the last one.
    moveq #0,d3
    move.b 5(a2),d3
    addq.w #1,d3
    moveq #0,d0
    move.b 7(a2),d0
    cmp.b #255,d0
    beq.s .sustained
    addq.w #2,d0
    mulu.w d0,d3
    moveq #0,d0
    move.b 6(a2),d0
    beq.s .envelope_setup
    moveq #0,d1
    move.b 3(a2),d1
    divu.w d0,d1
    add.w d1,d3                 ; original fade includes the zero-volume service
    bra.s .envelope_setup
.sustained:
    moveq #-1,d3               ; no arbitrary lifetime for alerts or torus
.envelope_setup:
    move.w d6,d0
    lsl.w #4,d0
    lea effect_envelopes,a4
    adda.w d0,a4
    move.w d7,(a4)
    moveq #0,d0
    move.b 2(a2),d0
    move.w d0,6(a4)
    add.w d0,d0
    lea amiga_effect_periods(pc),a1
    move.w (a1,d0.w),2(a4)
    moveq #0,d0
    move.b 4(a2),d0
    move.w d0,4(a4)
    move.b 3(a2),d0
    move.w d0,8(a4)
    move.b 6(a2),d0
    move.w d0,10(a4)
    move.b 5(a2),12(a4)         ; remaining duration in the current pass
    move.b 5(a2),13(a4)         ; duration reloaded between passes
    move.b 7(a2),14(a4)         ; signed original repeat counter, 255=sustained
    clr.b 15(a4)               ; original alternating-pitch phase
    lea effect_ids,a1
    cmp.b #sfx_laser,(a1,d6.w)
    bne.s .envelope_ready
    ; Original Pulse enables DMA on its first envelope update, not during
    ; initialization. Start at that audible state without adding input latency.
    ; Counting the silent setup frame as playback repeats the PCM attack on PAL.
    subq.w #1,d3
    subq.b #1,12(a4)
    sub.w 6(a4),d7
    move.w d7,(a4)
.envelope_ready:
    move.w d6,d4
    add.w d4,d4
    lea effect_ticks,a1
    move.w d3,(a1,d4.w)
    moveq #1,d4
    lsl.w d6,d4
    lsl.w #4,d6
    lea $dff0a0,a1
    adda.w d6,a1
    move.w #0,8(a1)             ; do not expose the previous held DAC sample
    move.w (sp)+,d1
    bsr effect_settle          ; latch zero volume at the old sample period
    move.w d4,$dff096
    move.w d7,6(a1)
    move.w #0,10(a1)            ; replace the stopped channel's data with silence
    move.l a0,(a1)
    lsr.w #1,d2
    move.w d2,4(a1)
    moveq #4,d1                 ; at least four full scanlines (>2 periods at 428)
    bsr audio_settle
    or.w #$8200,d4
    move.w d4,$dff096
    move.w 8(a4),8(a1)
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Paula applies volume at a sample-period boundary. Original pitch arithmetic
; can reach a 12-bit period, so allow two old sample periods before DMA-off.
; 112 Paula clocks per half scanline is conservative on both PAL and NTSC.
effect_settle:
    and.l #$fff,d1
    cmp.w #428,d1
    bhs.s .period
    move.w #428,d1             ; also covers a free/RCS/engine/beam voice
.period:
    divu.w #112,d1
    addq.w #1,d1

; Wait for scanline transitions, including the transition already in progress.
; D1 = line transitions minus one; D0/D1 are scratch. No OS calls from VBL.
audio_settle:
.line:
    move.b $dff006,d0           ; VHPOSR high byte: vertical line, not horizontal ticks
.wait:
    cmp.b $dff006,d0
    beq .wait
    dbra d1,.line
    rts

quiet:
    st audio_resetting         ; the main task may be interrupted by sound's VBL
    bsr stop_engine_voice
    clr engine_request
    clr rcs_voice
    clr rcs_volume
    clr rcs_request
    clr rcs_valid
    clr laser_audio_request(a6)
    clr beam_kind
    clr beam_volume
    clr music_playing
    clr music_dma
    clr fade_ticks
    clr warp_ticks
    clr end_hyperspace(a6)
    clr ecm_ticks
    clr ecm_on(a6)
    clr who_ecm(a6)
    clr.l effect_ticks
    clr.w laser_impact_pending
    clr.w comm_audio_pending
    clr.l effect_ticks+4
    lea effect_requests,a0
    moveq #sfx_count-1,d0
.requests:
    clr.b (a0)+
    dbra d0,.requests
    clr alert_fx(a6)
    clr torus_audio_requested
    move.w #0,$dff0a8           ; DMA-off alone leaves the last sample at the DAC
    move.w #0,$dff0b8
    move.w #0,$dff0c8
    move.w #0,$dff0d8
    move.l d1,-(sp)
    moveq #37,d1                ; covers every original 12-bit effect period
    bsr audio_settle
    move.l (sp)+,d1
    move.w #15,$dff096
    clr audio_resetting
    rts

start_tune:
    movem.l d0-d7/a0-a5,-(sp)
    bsr quiet
    jsr amiga_music_init
    st music_playing
    movem.l (sp)+,d0-d7/a0-a5
    rts
start_fade:
    tst music_playing
    beq .done
    move.w #32,fade_ticks
.done:
    rts

sound:
    tst audio_resetting
    bne .return
    tst warp_ticks
    beq .ecm
    subq.w #1,warp_ticks
    bne .ecm
    clr end_hyperspace(a6)
.ecm:
    tst ecm_ticks
    beq .music
    subq.w #1,ecm_ticks
    bne .music
    clr ecm_on(a6)              ; the three things DO_ECM does on the Atari
    clr who_ecm(a6)             ; when its effect reaches the end
    clr f_echar(a6)
.music:
    tst music_playing
    bne play_music
    bsr update_beam_sound
    clr alert_fx(a6)
    lea effect_ticks,a0
    lea effect_envelopes,a2
    lea $dff0a0,a3
    lea effect_ids,a4
    moveq #1,d0
    moveq #3,d7
.effects:
    tst.w (a0)
    beq .next
    cmp.b #sfx_spacejump,(a4)
    bne.s .alert_owner
    tst torus_on(a6)
    beq .expire
    tst docked(a6)
    bne .expire
    tst game_over(a6)
    bne .expire
    bra.s .owner_enabled
.alert_owner:
    cmp.b #sfx_alert,(a4)
    bne.s .lifetime
    cmp.w #2,condition(a6)
    bne .expire
    st alert_fx(a6)
.owner_enabled:
    btst #f_fx,user(a6)
    beq .expire
.lifetime:
    cmp.w #-1,(a0)
    beq.s .pitch
    subq.w #1,(a0)
    beq .expire
    tst.b 12(a2)
    bne.s .duration
    tst.b 14(a2)
    bmi.s .fade
    subq.b #1,14(a2)
    move.b 13(a2),12(a2)
    bra .next                  ; a reload service does not update the pitch
.fade:
    move.w 8(a2),d1
    sub.w 10(a2),d1
    move.w d1,8(a2)
    move.w d1,8(a3)
    bra .next
.duration:
    subq.b #1,12(a2)
.pitch:
    move.w (a2),d1
    btst #2,5(a2)
    bne.s .alternate
    btst #1,5(a2)
    bne.s .down
    btst #0,5(a2)
    beq .next
    cmp.w #180,d1
    beq .next
    sub.w 6(a2),d1
    bra.s .period
.down:
    cmp.w #428,d1
    beq .next
    add.w 6(a2),d1
    bra.s .period
.alternate:
    not.b 15(a2)
    beq .next
    move.w 2(a2),d1            ; preserve the original handler's phase behaviour
.period:
    and.w #$fff,d1             ; original Paula period arithmetic, not clamping
    move.w d1,(a2)
    move.w d1,6(a3)
    bra.s .next
.expire:
    clr.w (a0)
    clr.w 8(a2)
    move.w #0,8(a3)            ; fully mute an expired effect, including held data
    move.l d0,-(sp)
    move.w (a2),d1
    bsr effect_settle
    move.l (sp)+,d0
    move.w d0,$dff096
.next:
    addq.l #2,a0
    addq.l #1,a4
    lea 16(a2),a2
    lea 16(a3),a3
    add.w d0,d0
    dbra d7,.effects
    tst.w comm_audio_pending
    beq.s .no_comm
    moveq #sfx_comm,d0 ; independent single receipt beep
    bsr play_effect
    clr.w comm_audio_pending
.no_comm:
    tst.w laser_impact_pending
    beq.s .ordinary_requests
    moveq #sfx_shields,d0
    bsr play_effect
    clr.w laser_impact_pending
.ordinary_requests:
    lea effect_requests,a0
    moveq #0,d0
.request:
    tst.b (a0)
    beq .advance
    clr.b (a0)
    bsr play_effect
.advance:
    addq.l #1,a0
    addq.w #1,d0
    cmp.w #sfx_count,d0
    bne .request
    ; A transient owner change between game-frame steps must not permanently
    ; lose the drive loop. Quiet cancels this permission as well as the voice.
    tst torus_audio_requested
    beq.s .no_torus
    tst torus_on(a6)
    beq.s .no_torus
    tst docked(a6)
    bne.s .no_torus
    tst game_over(a6)
    bne.s .no_torus
    btst #f_fx,user(a6)
    beq.s .no_torus
    moveq #sfx_spacejump,d0
    bsr play_effect
.no_torus:
    bsr update_rcs_sound       ; ordinary pending effects always get first choice
    bsr update_engine_sound    ; manual throttle is below RCS and all effects
.return:
    rts

; One DMA loop on channel 3. The main task only publishes a word-sized request;
; hardware writes, channel reservation and the attack/release all run in VBL.
update_beam_sound:
    move.w laser_audio_request(a6),d5
    cmp.w #2,d5
    blo .disabled
    cmp.w #3,d5
    bhi .disabled
    cmp.w laser_type(a6),d5
    bne .disabled
    btst #f_fx,user(a6)
    beq .disabled
    tst game_frozen(a6)
    bne .disabled
    tst game_over(a6)
    bne .disabled
    tst docked(a6)
    bne .disabled
    tst cockpit_on(a6)
    beq .disabled
    tst controls_locked(a6)
    bne .disabled
    cmp.w #max_ltemp,laser_temp(a6)
    bhs .disabled
    bra .request
.disabled:
    moveq #0,d5
    clr laser_audio_request(a6)
.request:
    tst beam_kind
    beq .start
    cmp.w beam_kind,d5
    beq .attack
    move.w beam_volume,d0
    sub.w #16,d0
    bpl .release_volume
    moveq #0,d0
.release_volume:
    move.w d0,beam_volume
    move.w d0,$dff0d8
    bne .done
    moveq #4,d1
    bsr audio_settle            ; latch silence before stopping the held DAC
    move.w #8,$dff096
    clr beam_kind
.start:
    tst.w d5
    beq .done
    cmp.w #4,rcs_voice         ; the beam may reclaim its dedicated channel
    bne.s .voice_ready
    bsr stop_rcs_voice
.voice_ready:
    cmp.w #4,engine_voice
    bne.s .engine_ready
    bsr stop_engine_voice
.engine_ready:
    clr effect_ticks+6
    move.b #-1,effect_ids+3
    move.w #0,$dff0d8
    move.w effect_envelopes+48,d1
    bsr effect_settle          ; a previous discrete effect may have a long period
    move.w #8,$dff096
    move.w #beam_audio_period,$dff0d6
    move.w #0,$dff0da
    lea beam_samples,a0
    cmp.w #3,d5
    bne .sample_ready
    adda.l #beam_sample_bytes,a0
.sample_ready:
    move.l a0,$dff0d0
    move.w #beam_sample_words,$dff0d4
    moveq #4,d1
    bsr audio_settle
    move.w #$8208,$dff096
    move.w d5,beam_kind
    clr beam_volume
.attack:
    move.w beam_volume,d0
    add.w #16,d0
    cmp.w #48,d0
    bls .volume
    moveq #48,d0
.volume:
    move.w d0,beam_volume
    move.w d0,$dff0d8
.done:
    rts

; Game-frame publication includes manual input and automatic centring.
prepare_rcs_frame:
    tst rcs_valid
    bne.s .done
    move.w roll_angle(a6),rcs_roll
    move.w climb_angle(a6),rcs_pitch
    st rcs_valid
.done:
    rts

publish_rcs_sound:
    move.l d0,-(sp)
    moveq #0,d0
    tst.b key_states+$40(a6) ; Space: accelerate
    bne.s .engine_on
    tst.b key_states+$3a(a6) ; slash: decelerate
    beq.s .engine_publish
.engine_on:
    moveq #1,d0
.engine_publish:
    move.w d0,engine_request ; only a gameplay frame may enable the motor
    moveq #0,d0
    tst rcs_valid
    beq.s .publish
    move.w roll_angle(a6),d0
    cmp.w rcs_roll,d0
    bne.s .changed
    move.w climb_angle(a6),d0
    cmp.w rcs_pitch,d0
    bne.s .changed
    moveq #0,d0
    bra.s .publish
.changed:
    moveq #1,d0
.publish:
    move.w roll_angle(a6),rcs_roll
    move.w climb_angle(a6),rcs_pitch
    st rcs_valid
    move.w d0,rcs_request
    move.l (sp)+,d0
    rts

; Synchronous cinematic shutdown. Keep the VBL out of hardware updates.
stop_rcs_sound:
    move.w audio_resetting,-(sp)
    st audio_resetting
    clr rcs_request
    clr rcs_valid
    bsr stop_rcs_voice
    clr engine_request
    bsr stop_engine_voice
    move.w (sp)+,audio_resetting
    rts

; Release just our voice, preserving the caller's registers and request.
stop_rcs_voice:
    tst rcs_voice
    beq.s .done
    movem.l d0-d2/d4/a1,-(sp)
    move.w rcs_voice,d2
    subq.w #1,d2
    moveq #1,d4
    lsl.w d2,d4
    lsl.w #4,d2
    lea $dff0a0,a1
    adda.w d2,a1
    move.w #0,8(a1)
    moveq #4,d1
    bsr audio_settle
    move.w d4,$dff096
    move.w #0,10(a1)
    clr rcs_voice
    clr rcs_volume
    movem.l (sp)+,d0-d2/d4/a1
.done:
    rts

; Unlike the ST, Paula has independent samples: other noise effects may coexist.
update_rcs_sound:
    btst #f_no_rcs,user(a6)
    bne .disabled
    btst #f_fx,user(a6)
    beq .disabled
    tst game_frozen(a6)
    bne .disabled
    tst game_over(a6)
    bne .disabled
    tst docked(a6)
    bne .disabled
    tst cockpit_on(a6)
    beq .disabled
    tst controls_locked(a6)
    bne .disabled
    tst rcs_request
    beq .release
    tst rcs_voice
    bne .attack
    moveq #0,d2
    lea effect_ticks,a0
.find:
    cmp.w #3,d2
    bne.s .available
    tst beam_kind
    bne .reclaim_engine
.available:
    move.w d2,d0
    addq.w #1,d0
    cmp.w engine_voice,d0
    beq.s .next_voice
    tst.w (a0)+
    beq.s .start
    bra.s .advance_voice
.next_voice:
    addq.l #2,a0
.advance_voice:
    addq.w #1,d2
    cmp.w #4,d2
    bne.s .find
.reclaim_engine:
    tst engine_voice
    beq .done
    move.w engine_voice,d2
    subq.w #1,d2
    bsr stop_engine_voice
.start:
    move.w d2,rcs_voice
    addq.w #1,rcs_voice
    moveq #1,d4
    lsl.w d2,d4
    lsl.w #4,d2
    lea $dff0a0,a1
    adda.w d2,a1
    move.w #0,8(a1)
    moveq #4,d1
    bsr audio_settle
    move.w d4,$dff096
    move.w #rcs_audio_period,6(a1)
    move.w #0,10(a1)
    move.l #rcs_samples,(a1)
    move.w #rcs_sample_words,4(a1)
    moveq #4,d1
    bsr audio_settle
    or.w #$8200,d4
    move.w d4,$dff096
    clr rcs_volume
.attack:
    move.w rcs_volume,d0
    addq.w #2,d0
    cmp.w #8,d0               ; subdued hiss, well below the continuous beam
    bls.s .volume
    moveq #8,d0
    bra.s .volume
.release:
    tst rcs_voice
    beq.s .done
    move.w rcs_volume,d0
    subq.w #3,d0
    ble stop_rcs_voice
.volume:
    move.w d0,rcs_volume
    move.w rcs_voice,d2
    subq.w #1,d2
    lsl.w #4,d2
    lea $dff0a0,a1
    move.w d0,8(a1,d2.w)
.done:
    rts
.disabled:
    clr rcs_request
    clr rcs_valid
    bra stop_rcs_voice

stop_engine_voice:
    tst engine_voice
    beq.s .done
    movem.l d0-d2/d4/a1,-(sp)
    move.w engine_voice,d2
    subq.w #1,d2
    moveq #1,d4
    lsl.w d2,d4
    lsl.w #4,d2
    lea $dff0a0,a1
    adda.w d2,a1
    ; Avoid cutting the hum at an arbitrary sample with full gain. The ramp
    ; takes at most 48 scanlines (about 3 ms), without leaving a release tail
    ; for another VBL or delaying a cinematic until the next game frame.
    move.w engine_volume,d2
    beq.s .muted
.fade:
    subq.w #1,d2
    move.w d2,8(a1)
    moveq #0,d1
    bsr audio_settle
    tst.w d2
    bne.s .fade
.muted:
    move.w #0,8(a1)
    moveq #4,d1
    bsr audio_settle
    move.w d4,$dff096
    move.w #0,10(a1)
    clr engine_voice
    clr engine_volume
    movem.l (sp)+,d0-d2/d4/a1
.done:
    rts

update_engine_sound:
    btst #f_no_rcs,user(a6)
    bne .disabled
    btst #f_fx,user(a6)
    beq .disabled
    tst game_frozen(a6)
    bne .disabled
    tst game_over(a6)
    bne .disabled
    tst docked(a6)
    bne .disabled
    tst cockpit_on(a6)
    beq .disabled
    tst controls_locked(a6)
    bne .disabled
    tst jettison_pending(a6)
    bne .disabled
    tst engine_request
    beq .stop
    tst.b key_states+$40(a6)
    beq.s .decelerate
    move.w speed(a6),d3
    cmp.w hull_speed(a6),d3
    blt.s .speed
.decelerate:
    tst.b key_states+$3a(a6)
    beq .stop ; release is observed at the next VBL, not next game frame
    tst.w speed(a6)
    ble .stop ; the held key cannot slow the ship below zero
.speed:
    move.w speed(a6),d3
    bpl.s .positive
    moveq #0,d3
.positive:
    cmp.w hull_speed(a6),d3
    bls.s .speed_ok
    move.w hull_speed(a6),d3
.speed_ok:
    mulu.w #214,d3
    divu.w hull_speed(a6),d3
    neg.w d3
    add.w #428,d3
    tst engine_voice
    bne .running
    moveq #0,d2
    lea effect_ticks,a0
.find:
    cmp.w #3,d2
    bne.s .check_rcs
    tst beam_kind
    bne .done
.check_rcs:
    move.w d2,d0
    addq.w #1,d0
    cmp.w rcs_voice,d0
    beq.s .next
    tst.w (a0)
    beq.s .start
.next:
    addq.l #2,a0
    addq.w #1,d2
    cmp.w #4,d2
    bne.s .find
    rts
.start:
    move.w d2,engine_voice
    addq.w #1,engine_voice
    moveq #1,d4
    lsl.w d2,d4
    lsl.w #4,d2
    lea $dff0a0,a1
    adda.w d2,a1
    move.w #0,8(a1)
    moveq #4,d1
    bsr audio_settle
    move.w d4,$dff096
    move.w d3,6(a1)
    move.w #0,10(a1)
    move.l #engine_samples,(a1)
    move.w #engine_sample_words,4(a1)
    moveq #4,d1
    bsr audio_settle
    or.w #$8200,d4
    move.w d4,$dff096
    moveq #4,d1
    bsr audio_settle          ; fetch the new loop while the channel is muted
    ; Reach normal volume in about 3 ms using single-level steps, avoiding
    ; both the initial gain jump and the old four-VBL staircase.
    moveq #0,d2
.attack:
    addq.w #1,d2
    move.w d2,8(a1)
    moveq #0,d1
    bsr audio_settle
    cmp.w #48,d2              ; normal effect level, matching the continuous laser
    blo.s .attack
    move.w d2,engine_volume
.running:
    move.w engine_voice,d2
    subq.w #1,d2
    lsl.w #4,d2
    lea $dff0a0,a1
    adda.w d2,a1
    move.w d3,6(a1) ; vary pitch without restarting the loop
.done:
    rts
.disabled:
    clr engine_request
.stop:
    bra stop_engine_voice

play_music:
    tst fade_ticks
    beq .play
    subq.w #1,fade_ticks
    beq quiet
.play:
    jsr amiga_music_tick
    moveq #0,d7
    move.b amiga_music_mute,d7
    not.w d7
    and.w #15,d7               ; channels requested by the original envelopes
    move.w music_dma,d6
    not.w d6
    or.w amiga_music_retrigger,d6
    and.w d7,d6                ; channels needing a fresh sample attack
    move.w d7,d5
    not.w d5
    and.w music_dma,d5
    or.w d6,d5                 ; old channels to stop or restart
    beq .program
    lea $dff0a0,a3
    moveq #0,d4
.mute:
    btst d4,d5
    beq .next_mute
    move.w #0,8(a3)
.next_mute:
    lea 16(a3),a3
    addq.w #1,d4
    cmp.w #4,d4
    bne .mute
    moveq #16,d1
    bsr audio_settle           ; retain the click-free held-DAC shutdown
    move.w d5,$dff096
.program:
    lea amiga_music_periods,a0
    lea amiga_music_attack,a1
    lea $dff0a0,a3
    moveq #0,d4
.channel:
    move.w (a0)+,6(a3)
    btst d4,d6
    beq .next
    move.w #0,8(a3)
    move.w #0,10(a3)
    move.l (a1),(a3)
    move.w 4(a1),4(a3)
.next:
    lea 16(a1),a1
    lea 16(a3),a3
    addq.w #1,d4
    cmp.w #4,d4
    bne .channel
    tst.w d6
    beq .volumes
    moveq #16,d1
    bsr audio_settle           ; let stopped channels consume silent AUDxDAT
    move.w d6,d0
    or.w #$8200,d0
    move.w d0,$dff096
.volumes:
    moveq #32,d5
    tst fade_ticks
    beq .gain
    move.w fade_ticks,d5       ; scale each envelope, including silent rests
.gain:
    lea amiga_music_volumes,a0
    lea $dff0a8,a3
    moveq #0,d4
.volume:
    moveq #0,d0
    move.b (a0)+,d0
    btst d4,d7
    bne .scale
    moveq #0,d0
.scale:
    mulu.w d5,d0
    lsr.l #5,d0
    move.w d0,(a3)
    lea 16(a3),a3
    addq.w #1,d4
    cmp.w #4,d4
    bne .volume
    tst.w d6
    beq .done
    moveq #2,d1
    bsr audio_settle           ; Paula must fetch the attack before loop reloads
    lea amiga_music_loops,a0
    lea $dff0a0,a3
    moveq #0,d4
.loop:
    btst d4,d6
    beq .next_loop
    move.l (a0),(a3)
    move.w 4(a0),4(a3)
.next_loop:
    lea 16(a0),a0
    lea 16(a3),a3
    addq.w #1,d4
    cmp.w #4,d4
    bne .loop
.done:
    move.w d7,music_dma
    rts

    include "amiga-samples.inc"
; Shared ST events -> corresponding effects in the supplied Amiga player.
; Launch uses its own engine loop.
; Radio receipt and countdown share original effect 18, distinct from target lock.
effect_map:
    dc.b 0,1,15,3,7,6,4,16,17,12,11,14,13,10,16,8
    dc.b 0,18,18,9
    even
    section amiga_audio,data
amiga_samples:
    incbin "amiga-samples.bin"
    even
beam_samples:
    incbin "beam-loops.bin"
    even
rcs_samples:
    incbin "rcs-loop.bin"
    even
engine_samples:
    incbin "engine-loop.bin"
    section audio_vars,bss
laser_impact_pending: ds.w 1
comm_audio_pending: ds.w 1
effect_ticks: ds.w 4
effect_ids: ds.b 4
effect_requests: ds.b sfx_count
    even
; Per voice: period, alternate period, mode, pitch step, volume, decay (words),
; then current duration, reload duration, signed repeats and pitch phase (bytes).
effect_envelopes: ds.b 64
next_channel: ds.w 1
music_playing: ds.w 1
fade_ticks: ds.w 1
warp_ticks: ds.w 1
ecm_ticks: ds.w 1
music_dma: ds.w 1
audio_resetting: ds.w 1
beam_kind: ds.w 1
beam_volume: ds.w 1
rcs_voice: ds.w 1 ; zero=off, otherwise Paula channel index plus one
rcs_volume: ds.w 1
rcs_request: ds.w 1
rcs_valid: ds.w 1
rcs_roll: ds.w 1
rcs_pitch: ds.w 1
engine_voice: ds.w 1
engine_request: ds.w 1 ; gameplay permission, not a speed-change detector
engine_volume: ds.w 1
torus_audio_requested: ds.w 1 ; a drive request remains owned by TORUS_ON
