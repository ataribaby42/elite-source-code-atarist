; Native AmigaOS 1.3 startup, display ownership, input and vertical blank.
; Exec remains running for input.device and AmigaDOS commander files.
amiga_implementation: equ 1
    include "common.def"
    include "macros.m68"
    xref elite,vars,vblank,key_change,other_screen,quiet
    xdef amiga_entry,amiga_exit,amiga_install,amiga_present,amiga_poll
    xdef amiga_start_display,amiga_wait_title,amiga_rows_full,amiga_rows_art
    xdef palette,frclock,dos_base,set_palette,random_seed_value
    xdef bitmap_bank,bitmap_bytes
    xref active_files,directory_lock,file_init,file_shutdown
    xdef amiga_flip_address
    xdef cpu_level,clear_burst,maths_fast
    ifne blit_ok
    xdef clear_blit,clear_pending,clear_early,wait_clear
    xdef graphics_base,blitter_owned
    endc
    ifne blit_ok*frametime
    xref raster_line
    endc
    ifne shadow_ok
    xdef shadow_base,view_base,shadow_live,in_shadow,mirror_ptr
    xdef mirror_valid,mirror_full,mirror_blank,forget_mirror
    endc
    ifeq cpu_68020
    xref divide_by_10,divide_by_10_020,divide_by_1e5,divide_by_1e5_020
    xref sky_multiply,sky_multiply_020
    endc
    section text,code
amiga_entry:
    movem.l d2-d7/a2-a6,-(sp)
    move.l sp,host_stack
    move.l 4.w,a6
    move.l a6,exec_base
    bsr probe_cpu
    suba.l a1,a1
    jsr -294(a6)                 ; FindTask(NULL)
    move.l d0,a2
    tst.l 172(a2)               ; Process.pr_CLI: zero for a Workbench launch
    bne .cli
    lea 92(a2),a0               ; Process.pr_MsgPort
    jsr -384(a6)                 ; WaitPort: Workbench owns our startup message
    lea 92(a2),a0
    jsr -372(a6)                 ; GetMsg
    move.l d0,workbench_message
.cli:
    ; Check and publish one system-wide owner without a task-switch window.
    ; Do this before opening files or changing display/input/audio ownership.
    jsr -132(a6)                 ; Forbid
    lea instance_name(pc),a1
    jsr -390(a6)                 ; FindPort
    tst.l d0
    bne instance_busy
    lea instance_port(pc),a1
    jsr -354(a6)                 ; AddPort also initializes the message list
    st instance_owned
    jsr -138(a6)                 ; Permit
    lea dos_name(pc),a1
    moveq #0,d0
    jsr -552(a6)                 ; OpenLibrary
    move.l d0,dos_base
    beq startup_failed
    move.l workbench_message,d0
    beq .directory_ready
    move.l d0,a0
    tst.l 28(a0)                ; WBStartup.sm_NumArgs
    beq .directory_ready
    move.l 36(a0),a0            ; sm_ArgList: first argument is the executable
    move.l (a0),d1              ; WBArg.wa_Lock: borrowed, never UnLock it here
    move.l dos_base,a6
    jsr -126(a6)                 ; CurrentDir: assets and HDD saves live here
    move.l d0,workbench_old_directory
    st workbench_directory_changed
    move.l exec_base,a6
.directory_ready:
    jsr file_init               ; disk-swap paths and requester policy
    move.l #bitmap_bytes,d0     ; the expanded bitmap bank outgrows a KS1.x BSS Hunk
    move.l #$10000,d1           ; MEMF_CLEAR, any memory: Fast RAM when there is some
    jsr -198(a6)                 ; AllocMem
    move.l d0,bitmap_bank
    beq startup_failed
    ifne shadow_ok
; The flight view is drawn here and copied to the screen once a frame. Fast RAM
; or nothing: in Chip RAM the copy would cost more than the drawing it saves.
; A 68000 pays the same way round, so it keeps the memory and blits instead.
    tst.w cpu_level
    beq.s .no_shadow
    move.l #shadow_maps_bytes,d0
    move.l #$10004,d1           ; MEMF_FAST|MEMF_CLEAR
    jsr -198(a6)                 ; AllocMem
    move.l d0,shadow_block
    beq.s .no_shadow
    move.l d0,shadow_base       ; drawn into first
    move.l d0,d1
    sub.l #y_top*row_stride,d1  ; the drawing maths adds the row back
    move.l d1,view_base
    add.l #view_bytes,d0
    move.l d0,mirror_ptr        ; what the first buffer shows
    add.l #view_bytes,d0
    move.l d0,mirror_ptr+4      ; and the second
    add.l #view_bytes,d0
    move.l d0,mirror_blank
.no_shadow:
    endc
    lea graphics_name(pc),a1
    moveq #0,d0
    jsr -552(a6)
    move.l d0,graphics_base
    beq startup_failed
    move.l d0,a6
    move.l 34(a6),old_view
    suba.l a1,a1
    jsr -222(a6)                 ; LoadView(NULL)
    jsr -270(a6)                 ; WaitTOF twice for the old Copper list
    jsr -270(a6)
    move.w $dff002,saved_dma
    move.w #$0120,$dff096        ; stop old bitplanes and sprites
    st display_owned
    jsr elite
amiga_exit:
    clr amiga_active
    move.l exec_base,a6
    tst input_added
    beq .no_handler
    lea input_request,a1
    move.w #10,28(a1)            ; IND_REMHANDLER
    jsr -456(a6)                 ; DoIO
    clr input_added
.no_handler:
    tst input_open
    beq .no_input
    lea input_request,a1
    jsr -450(a6)                 ; CloseDevice
    clr input_open
.no_input:
    tst vblank_added
    beq .no_vblank
    lea vblank_server,a1
    moveq #5,d0
    jsr -174(a6)                 ; RemIntServer
    clr vblank_added
.no_vblank:
    tst signal_owned
    beq .no_signal
    moveq #0,d0
    move.b input_port+15,d0
    jsr -336(a6)                 ; FreeSignal
    clr signal_owned
.no_signal:
    tst display_owned
    beq startup_failed
    lea vars,a6
    jsr quiet                   ; mute Paula before returning display ownership
    move.w #$01af,$dff096        ; stop our display/audio DMA
    move.l graphics_base,a6
    ifne blit_ok
    tst blitter_owned            ; a clear caught mid-flight still holds it
    beq.s .no_blitter
    jsr -228(a6)                 ; WaitBlit before the blitter goes back
    jsr -462(a6)                 ; DisownBlitter
    clr blitter_owned
.no_blitter:
    endc
    move.l old_view,a1
    jsr -222(a6)
    move.l 38(a6),$dff080       ; restore graphics.library's Copper startup list
    move.w saved_dma,d0
    or.w #$8000,d0
    move.w d0,$dff096
    jsr -270(a6)
    jsr -270(a6)
    clr display_owned
startup_failed:
    move.l dos_base,d0
    beq .files_closed
    move.l d0,a6
    lea active_files,a2
    moveq #7,d7
.close_file:
    move.l (a2),d1
    beq .next_file
    clr.l (a2)
    jsr -36(a6)                 ; Close
.next_file:
    addq.l #4,a2
    dbra d7,.close_file
    move.l directory_lock,d1
    beq .files_closed
    jsr -90(a6)                 ; UnLock
    clr.l directory_lock
.files_closed:
    jsr file_shutdown
    tst workbench_directory_changed
    beq .directory_restored
    move.l dos_base,a6
    move.l workbench_old_directory,d1
    jsr -126(a6)
    clr workbench_directory_changed
.directory_restored:
    move.l exec_base,a6
    ifne shadow_ok
    move.l shadow_block,d0
    beq.s .no_shadow_free
    move.l d0,a1
    move.l #shadow_maps_bytes,d0
    jsr -210(a6)                 ; FreeMem
    clr.l shadow_block
    clr.l shadow_base
    clr.l view_base
    clr.l mirror_blank
.no_shadow_free:
    endc
    move.l bitmap_bank,d0
    beq .no_bitmaps
    move.l d0,a1
    move.l #bitmap_bytes,d0
    jsr -210(a6)                 ; FreeMem
    clr.l bitmap_bank
.no_bitmaps:
    move.l graphics_base,d0
    beq .no_graphics
    move.l d0,a1
    jsr -414(a6)                 ; CloseLibrary
.no_graphics:
    move.l dos_base,d0
    beq .no_dos
    move.l d0,a1
    jsr -414(a6)
.no_dos:
    tst instance_owned
    beq finish_process
    jsr -132(a6)                 ; keep the marker until all cleanup has finished
    lea instance_port(pc),a1
    jsr -360(a6)                 ; RemPort: remove only this process's marker
    clr instance_owned
    jsr -138(a6)                 ; Permit
finish_process:
    move.l workbench_message,d0
    beq .return
    move.l d0,a2
    jsr -132(a6)                 ; Forbid: WB may unload us as soon as we reply
    move.l a2,a1
    jsr -378(a6)                 ; ReplyMsg; process termination releases Forbid
.return:
    move.l host_stack,sp
    movem.l (sp)+,d2-d7/a2-a6
    moveq #0,d0
    rts

instance_busy:
    jsr -138(a6)                 ; balance the unsuccessful ownership check
    bra finish_process          ; WB still needs its startup message replied

; Display-only startup also serves the loading picture, before game init.
amiga_start_display:
    movem.l d0-d7/a0-a6,-(sp)
    tst vblank_added
    bne .done
    lea amiga_primary,a0
    move.l a0,display_front
    move.l exec_base,a6
    lea vblank_server,a1
    moveq #5,d0
    jsr -168(a6)                 ; AddIntServer
    move.l frclock,title_frame
    st vblank_added
.done:
    movem.l (sp)+,d0-d7/a0-a6
    rts

; Loading work counts towards the hold. Two extra VBLs cover publishing the
; first Copper frame, so even a fast HDD launch shows a complete second.
amiga_wait_title:
    movem.l d0-d2/a0-a1/a6,-(sp)
    tst vblank_added             ; optional picture absent: no display to hold
    beq .done
    move.l exec_base,a6
    moveq #0,d2
    move.b 530(a6),d2            ; ExecBase.VBlankFrequency: PAL 50 / NTSC 60
    addq.l #2,d2
    move.l graphics_base,a6
.wait:
    move.l frclock,d0
    sub.l title_frame,d0
    cmp.l d2,d0
    bhs .done
    jsr -270(a6)                 ; WaitTOF: sleep until the next frame
    bra .wait
.done:
    movem.l (sp)+,d0-d2/a0-a1/a6
    rts

amiga_install:
    bsr amiga_wait_title
    movem.l d0-d7/a0-a6,-(sp)
    move.l exec_base,a6
    moveq #-1,d0
    jsr -330(a6)                 ; AllocSignal
    tst.b d0
    bmi .failed
    st signal_owned
    move.b d0,input_port+15
    suba.l a1,a1
    jsr -294(a6)                 ; FindTask
    move.l d0,input_port+16
    lea input_port+20,a0
    lea 4(a0),a1
    move.l a1,(a0)
    clr.l 4(a0)
    move.l a0,8(a0)
    lea input_name(pc),a0
    lea input_request,a1
    moveq #0,d0
    moveq #0,d1
    jsr -444(a6)                 ; OpenDevice
    tst d0
    bne .failed
    st input_open
    lea input_request,a1
    move.w #9,28(a1)
    move.l #input_server,40(a1)
    jsr -456(a6)
    tst.b input_request+31
    bne .failed
    st input_added
    bsr amiga_start_display     ; install once, including when TITLE.PC1 is absent
    st amiga_active
    movem.l (sp)+,d0-d7/a0-a6
    rts
.failed:
    movem.l (sp)+,d0-d7/a0-a6
    jmp amiga_exit

 ; Present the actual OCS framebuffer; no screen conversion or shadow bitmap.
amiga_present:
    move.l scr_base(a6),display_pending
    st ready
.wait:
    bsr amiga_poll
    tst ready
    bne .wait
    rts

; Display the full screen height; the flight view owns every row.
amiga_rows_full:
    move.w #diwstop_rows,copper_diwstop
    rts

; Display art_rows only, so 200-row artwork keeps its original framing.
amiga_rows_art:
    move.w #diwstop_art,copper_diwstop
    rts

; AttnFlags bit 3 is set from the 68040 up, bit 7 from the 68060. The first is
; what MOVE16 needs; CLEAR_IMAGE checks the screen's alignment itself.
probe_cpu:
    moveq #0,d0
    move.w 296(a6),d0            ; ExecBase.AttnFlags
    moveq #0,d1
    btst #1,d0
    beq.s .level
    moveq #2,d1
    btst #3,d0
    beq.s .level
    moveq #4,d1
    btst #7,d0
    beq.s .level
    moveq #6,d1
.level:
    move.w d1,cpu_level
    ifne blit_ok
    clr.b clear_pending
    clr.b clear_early
    clr.b clear_blit
    tst.w d1                     ; a 68000 or 68010 clears with the blitter
    bne.s .blit_done
    st clear_blit
.blit_done:
    endc
    clr.b clear_burst
    ifne clear_burst_ok
    cmp.w #4,d1
    blo.s .burst_done
    st clear_burst
.burst_done:
    endc
    st maths_fast
    ifeq cpu_68020
    clr.b maths_fast
    cmp.w #2,d1                  ; 32-bit multiply and divide from the 68020 up
    blo.s .done
; Patching code means clearing the instruction cache afterwards. CacheClearU
; arrived with Kickstart 2.0; under 1.3 a 68020 or 68030 can do it through CACR
; in supervisor state, and a 68040 or better, which no 1.3 machine has, is left
; with the MC68000 arithmetic rather than an unflushed patch.
    cmp.w #36,20(a6)             ; Library.lib_Version
    bhs.s .patch
    cmp.w #2,d1
    bne.s .done
.patch:
    lea fast_pairs(pc),a0
.pair:
    move.l (a0)+,d0
    beq.s .patched
    move.l d0,a1
    move.w #$4ef9,(a1)+          ; JMP to the twin, over an entry nothing else enters
    move.l (a0)+,(a1)
    bra.s .pair
.patched:
    st maths_fast
    cmp.w #36,20(a6)
    blo.s .cacr
    jsr -636(a6)                 ; CacheClearU
    rts
.cacr:
    lea flush_cacr(pc),a5
    jmp -30(a6)                  ; Supervisor, which returns for us
.done:
    endc
    rts

    ifeq cpu_68020
; Clear the instruction cache the way Kickstart 1.3 has no call for. SUPERVISOR
; enters this in supervisor state and expects an RTE.
flush_cacr:
	mc68020
    movec cacr,d0
    ori.w #8,d0                  ; CACR: clear the instruction cache
    movec d0,cacr
    rte
	mc68000
    endc

    ifeq cpu_68020
fast_pairs:
    dc.l divide_by_10,divide_by_10_020
    dc.l divide_by_1e5,divide_by_1e5_020
    dc.l sky_multiply,sky_multiply_020
    dc.l 0
    endc

; Flip an address inside either source screen, preserving its byte offset.
; XOR is only valid for the bases when AmigaDOS chooses unaligned allocations.
amiga_flip_address:
    move.l d1,-(sp)
    move.l d0,d1
    sub.l #amiga_primary,d1
    cmp.l #scr_bytes,d1
    blo .primary
    sub.l #other_screen,d0
    add.l #amiga_primary,d0
    bra .done
.primary:
    move.l d1,d0
    add.l #other_screen,d0
.done:
    move.l (sp)+,d1
    ifne shadow_ok
    bsr.s forget_mirror          ; every caller writes where it points
    endc
    rts

    ifne shadow_ok
; A write about to reach a Chip buffer past the shadow. Landing in that buffer's
; flight view, it leaves the buffer's mirror wrong, so the mirror is forgotten
; and the next transfer there sends every piece. D0 = the address.
forget_mirror:
    move.l d1,-(sp)
    tst.l shadow_block
    beq.s .kept
    move.l d0,d1
    sub.l #amiga_primary+y_top*row_stride,d1
    cmp.l #view_bytes,d1
    bhs.s .not_first
    clr.b mirror_valid
    bra.s .kept
.not_first:
    move.l d0,d1
    sub.l #other_screen+y_top*row_stride,d1
    cmp.l #view_bytes,d1
    bhs.s .kept
    clr.b mirror_valid+1
.kept:
    move.l (sp)+,d1
    rts
    endc

amiga_poll:
    tst quit_requested
    bne amiga_exit
    rts

    ifne blit_ok
; Drain a clear started by CLEAR_IMAGE. Every routine that begins writing
; inside the viewport calls this first; with no blit running it is one byte
; test, so machines that clear another way pay nothing.
wait_clear:
    tst.b clear_pending
    beq.s .idle
    movem.l d0/d1/a1,-(sp)
    ifne frametime
    jsr raster_line             ; what the clear costs here is the wait, not the fill
    move d0,-(sp)
    endc
    lea $dff000,a1
    move.w #-1,d0               ; a blit that never ends stutters, it does not hang
.busy:
    btst #6,2(a1)               ; DMACONR, BBUSY
    bne.s .again
    btst #6,2(a1)               ; Agnus can raise it late, so read it twice
    beq.s .done
.again:
    dbra d0,.busy
.done:
    ifne frametime
    jsr raster_line
    sub (sp)+,d0
    add d0,clear_lines(a6)
    endc
    movem.l (sp)+,d0/d1/a1
    clr.b clear_pending
    move.l a6,-(sp)              ; the blitter goes back the moment the fill ends
    move.l graphics_base,a6
    jsr -462(a6)                 ; DisownBlitter
    move.l (sp)+,a6
    clr blitter_owned
.idle:
    rts
    endc


amiga_vblank:
    movem.l d0-d7/a0-a6,-(sp)
    addq.l #1,frclock
    tst ready
    beq .same
    move.l display_pending,display_front
    clr ready
.same:
    lea copper_planes,a0
    move.l display_front,d0
    ifne display_lace
    btst #7,$dff004             ; LOF: the long frame shows the even rows
    bne.s .long_frame
    add.l #row_stride,d0        ; the short frame starts one row down
.long_frame:
    endc
    moveq #scr_planes-1,d7
.pointers:
    swap d0
    move.w d0,2(a0)
    swap d0
    move.w d0,6(a0)
    add.l #bpr,d0
    addq.l #8,a0
    dbra d7,.pointers
    lea palette,a0
    lea $dff180,a1
    moveq #(1<<scr_planes)-1,d7
.colours:
    move.w (a0)+,d0
    move.w d0,(a1)+
    dbra d7,.colours
    move.l #copper,$dff080
    ; Copper restarts itself each frame. Do not strobe COPJMP1 while a blit runs.
    move.w #$83c0,$dff096        ; master, bitplane, Copper and blitter DMA
    tst amiga_active
    beq .end                    ; loading: no cursor, sound or game clock work
    lea vars,a6
    bsr poll_joystick
    jsr vblank                  ; cursor/sound work must follow display setup
.end:
    movem.l (sp)+,d0-d7/a0-a6
    moveq #0,d0                  ; VERTB must leave Z set
    rts

poll_joystick:
    move.w $dff00c,d0
    lea key_states+$78(a6),a0
    move.w d0,d1
    lsr.w #1,d1
    eor.w d0,d1
    btst #8,d1
    sne (a0)+
    btst #0,d1
    sne (a0)+
    btst #9,d0
    sne (a0)+
    btst #1,d0
    sne (a0)+
    move.b -4(a0),d1            ; byte array starts at an odd address on MC68000
    or.b -3(a0),d1
    or.b -2(a0),d1
    or.b -1(a0),d1
    beq .no_joystick
    st device(a6)
.no_joystick:
    btst #7,$bfe001
    seq d0
    or.b mouse_right,d0
    move.b d0,key_states+$7d(a6) ; fire shares right mouse button
    rts

amiga_input:
    movem.l d1-d7/a0-a6,-(sp)
    lea vars,a6
    move.l a0,a4
.event:
    move.l a4,d0
    beq .done
    cmp.b #1,4(a4)
    beq .key
    cmp.b #2,4(a4)
    bne .next
    move.w 10(a4),d0
    add.w d0,move_x(a6)
    move.w 12(a4),d0
    add.w d0,move_y(a6)
    move.w 8(a4),d0
    btst #14,d0
    sne key_states+$7c(a6)
    btst #13,d0
    sne mouse_right
    bra .next
.key:
    move.w 6(a4),d2
    cmp.w #$59,d2                ; Ctrl+F10 returns to AmigaDOS
    bne .translate
    btst #3,9(a4)               ; IEQUALIFIER_CONTROL; plain F10 is inventory
    beq .translate
    st quit_requested
.translate:
    move.w d2,d1
    and.w #$ff,d1
    jsr key_change
.next:
    move.l (a4),a4
    bra .event
.done:
    movem.l (sp)+,d1-d7/a0-a6
    moveq #0,d0                  ; consume events while the game owns input
    rts

 ; Asset palette import; the runtime palette contains native 12-bit OCS values.
set_palette:
    movem.l d0-d2/a0-a1,-(sp)
    lea palette,a1
    moveq #15,d1
.copy:
    move.w (a0)+,d0
    and.w #$0777,d0
    move.w d0,d2
    add.w d0,d0
    lsr.w #2,d2
    and.w #$0111,d2             ; replicate each component's top bit, 3 to 4
    or.w d2,d0
    move.w d0,(a1)+
    dbra d1,.copy
    movem.l (sp)+,d0-d2/a0-a1
    rts
random_seed_value:
    move.l $dff004,d0
    eor.l #$631ac947,d0
    rts

    section text,code
dos_name: dc.b 'dos.library',0
graphics_name: dc.b 'graphics.library',0
input_name: dc.b 'input.device',0
empty_name: dc.b 0
instance_name: dc.b 'Elite.Native.Amiga',0
    even
; Public marker only; no signal allocation and no message-based game API.
instance_port:
    dc.l 0,0
    dc.b 4,0                    ; NT_MSGPORT, priority 0
    dc.l instance_name
    dc.b 2,0                    ; PA_IGNORE, unused signal bit
    dc.l 0,0,0,0                ; signal task and message-list pointers
    dc.w 0                      ; message-list type/padding (MsgPort is 34 bytes)
input_port:
    dc.l 0,0
    dc.b 4,0
    dc.l 0
    dc.b 0,0
    dc.l 0,0,0,0
input_request:
    dc.l 0,0
    dc.b 5,0
    dc.l 0,input_port
    dc.w 48
    dcb.b 28,0
input_server:
    dc.l 0,0
    dc.b 2,100
    dc.l input_name,0,amiga_input
vblank_server:
    dc.l 0,0
    dc.b 2,-60
    dc.l input_name,0,amiga_vblank

    section amiga_copper,data
copper:
    dc.w $2001,$fffe            ; allow the VBL server to publish pointers first
    dc.w $100,$0200,$08e,$2c81,$090
copper_diwstop:
    dc.w diwstop_art
    dc.w $092,ddfstrt,$094,ddfstop
    dc.w $102,0,$104,0,$108,row_stride*(1+display_lace)-bpr,$10a,row_stride*(1+display_lace)-bpr
copper_planes:
    dc.w $0e0,0,$0e2,0,$0e4,0,$0e6,0,$0e8,0,$0ea,0,$0ec,0,$0ee,0
    dc.w $100,bplcon0_on,$ffff,$fffe

    section platform_vars,bss
host_stack: ds.l 1
workbench_message: ds.l 1
workbench_old_directory: ds.l 1
workbench_directory_changed: ds.w 1
exec_base: ds.l 1
bitmap_bank: ds.l 1
dos_base: ds.l 1
graphics_base: ds.l 1
old_view: ds.l 1
display_front: ds.l 1
display_pending: ds.l 1
frclock: ds.l 1
title_frame: ds.l 1
palette: ds.w 16
saved_dma: ds.w 1
display_owned: ds.w 1
    ifne blit_ok
blitter_owned: ds.w 1
    endc
amiga_active: ds.w 1
ready: ds.w 1
quit_requested: ds.w 1
signal_owned: ds.w 1
input_open: ds.w 1
input_added: ds.w 1
vblank_added: ds.w 1
mouse_right: ds.w 1
cpu_level: ds.w 1
clear_burst: ds.b 1
maths_fast: ds.b 1
    ifne blit_ok
clear_blit: ds.b 1
clear_pending: ds.b 1
clear_early: ds.b 1
    endc
    even
    ifne shadow_ok
shadow_block: ds.l 1 ; the allocation, whichever way its viewports have turned
shadow_base: ds.l 1
mirror_ptr: ds.l 2 ; per buffer: the viewport holding what it shows
mirror_blank: ds.l 1 ; per buffer and row: its viewport shows that row empty
view_base: ds.l 1
shadow_live: ds.w 1
mirror_valid: ds.b 2 ; per buffer: its mirror is what it holds
mirror_full: ds.b 1 ; this transfer sends every block
in_shadow: ds.w 1
    endc
	even
instance_owned: ds.w 1
