yard_errors: dc.l 0,yard_cash,yard_equipment,yard_cargo,yard_missiles,yard_same
yard_trade_text: dc.b 'Trade-in: ',0
yard_title: dc.b 'Shipyards',0
yard_bought: dc.b 'Ship purchased - fuel tanks filled',0
yard_cash: dc.b 'Not enough credits after trade-in',0
yard_equipment: dc.b 'Sell ordinary equipment and lasers first',0
