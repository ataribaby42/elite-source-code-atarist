	include "common.def"
	include "macros.m68"
	xref check_docked,invert_icon,prepare_text,print_centre,text_colour
	xref locate,print_number,print_string,put_bitmap,init_cursor,clear_input,error_box
	xref build_number,registration_new_player,hide_cursor,restore_cursor,set_colour,ui_line
	xref launch,buy_cargo,sell_cargo,equip_ship,galactic_chart,local_chart,data
	xref market_prices,inventory,status,disk,find_planet,home_cursor,options
	xref obj_data
	q_module ships

; D0.w persistent hull ID -> A0 profile. D0 and all other registers preserved.
	q_subr ship_profile,global
	move.l d0,-(sp)
	mulu #ship_profile_size,d0
	lea ship_profiles(pc),a0
	adda.l d0,a0
	move.l (sp)+,d0
	rts

; A0 profile -> A0 existing model name, also used by in-flight identification.
; Object headers and their text pointers are relocated during game startup.
	q_subr ship_name,global
	move.l d0,-(sp)
	move.w sp_model(a0),d0
	lsl.w #2,d0
	lea obj_data,a0
	move.l (a0,d0.w),a0
	move.l text-nodes(a0),a0
	move.l (sp)+,d0
	rts

; Validate the optional save extension before any flight/UI code reads a profile.
	q_subr ship_validate,global
	cmp.l #$53485031,player_ship_tag(a6)
	bne.s .legacy
	cmp.w #ship_count,player_ship(a6)
	blo.s .valid
.legacy:
	clr.w player_ship(a6)
.valid:
	move.l #$53485031,player_ship_tag(a6)
	bsr ship_apply
	move.w hull_fuel(a6),d0
	cmp.w equip+fuel(a6),d0
	bhs.s .done
	move.w d0,equip+fuel(a6)
.done:
	rts

	q_subr ship_apply,global
	movem.l d0-d1/a0-a1,-(sp)
	move.w player_ship(a6),d0
	bsr ship_profile
	lea hull_speed(a6),a1
	moveq #13,d1
.copy:
	move.w (a0)+,(a1)+
	dbra d1,.copy
	move.w hull_speed(a6),d0
	mulu #3,d0
	move.w d0,hull_auto_speed(a6)
	move.w hull_speed(a6),d0
	lsr.w #1,d0
	move.w d0,hull_scoop_speed(a6)
	move.w hull_speed(a6),d0
	mulu #7,d0
	lsr.w #3,d0
	move.w d0,hull_red_speed(a6)
	move.w hull_roll(a6),d0
	add.w d0,d0
	move.w d0,hull_roll_span(a6)
	move.w hull_pitch(a6),d0
	add.w d0,d0
	move.w d0,hull_pitch_span(a6)
	movem.l (sp)+,d0-d1/a0-a1
	rts

; D0.w atlas group (0=status, 1=planet, 2=yard) -> A0 current-hull bitmap.
	q_subr ship_bitmap,global
	movem.l d0-d1/a1,-(sp)
	mulu #ship_count,d0
	move.w d0,d1
	move.w player_ship(a6),d0
	bsr ship_profile
	add.w sp_atlas(a0),d1
	lsl.w #2,d1
	move.w d1,d0
	bsr ship_decode_bitmap
	movem.l (sp)+,d0-d1/a1
	rts

 ; D0.w sprite table byte offset -> A0 transient masked bitmap.
; Byte tokens: 1..127 literals, 128..255 back-reference lengths 3..130,
; followed by a big-endian byte distance. Zero terminates each sprite.
	q_subr ship_decode_bitmap,global
	movem.l d0-d2/a1-a2,-(sp)
	lea ship_sprite_bank,a0
	move.l (a0,d0.w),d0
	adda.l d0,a0
	lea ship_bitmap_workspace,a1
.token:
	moveq #0,d0
	move.b (a0)+,d0
	beq.s .done
	bmi.s .match
	subq.w #1,d0
.literal:
	move.b (a0)+,(a1)+
	dbra d0,.literal
	bra.s .token
.match:
	and.w #127,d0
	addq.w #2,d0
	moveq #0,d1
	move.b (a0)+,d1
	lsl.w #8,d1
	move.b (a0)+,d1
	move.l a1,a2
	suba.l d1,a2
.copy:
	move.b (a2)+,(a1)+
	dbra d0,.copy
	bra.s .token
.done:
	lea ship_bitmap_workspace,a0
	movem.l (sp)+,d0-d2/a1-a2
	rts

; Equipment prices in tenths of a credit. D0.w item -> D0.l price only.
	q_subr ship_equipment_price,global
	movem.l d1/a0,-(sp)
	move.w hull_category(a6),d1
	mulu #15*4,d1
	lsl.w #2,d0
	add.w d1,d0
	lea ship_equipment_prices(pc),a0
	move.l (a0,d0.w),d0
	bne.s .done
	moveq #0,d0
	move.w price_fuel(a6),d0
.done:
	movem.l (sp)+,d1/a0
	rts

; Installed equipment mass in tonnes. D0 only changes; missiles and bay are free.
	q_subr ship_equipment_mass,global
	movem.l d1-d3/a0,-(sp)
	moveq #0,d0
	lea equip+ecm_system(a6),a0
	moveq #13,d3
.item:
	move.w (a0)+,d1
	bpl.s .device
	and.w #15,d1
	moveq #3,d2
.laser:
	lsr.w #1,d1
	bcc.s .next_bit
	addq.w #1,d0
.next_bit:
	dbra d2,.laser
	bra.s .next
.device:
	tst.w d1
	beq.s .next
	addq.w #1,d0
.next:
	dbra d3,.item
	movem.l (sp)+,d1-d3/a0
	rts

; Total occupied hold in grams, including equipment. Only D0 changes.
	q_subr ship_used_hold,global
	movem.l d1/a0,-(sp)
	bsr ship_equipment_mass
	mulu #15625,d0
	lsl.l #6,d0
	lea hold(a6),a0
	moveq #max_products-1,d1
.cargo:
	add.l (a0)+,d0
	dbra d1,.cargo
	movem.l (sp)+,d1/a0
	rts

; Signed free grams. Keep the historical CARGO_SPARE register contract.
	q_subr ship_cargo_spare,global
	move.l d0,-(sp)
	move.w hull_cargo(a6),d3
	tst.w equip+cargo_bay(a6)
	beq.s .base
	move.w hull_expanded(a6),d3
.base:
	mulu #15625,d3
	lsl.l #6,d3
	bsr ship_used_hold
	sub.l d0,d3
	move.l (sp)+,d0
	rts

; D0 hull -> D0 error: 0 success, 1 cash, 2 equipment, 3 cargo, 4 missiles, 5 same.
; No persistent state changes until all checks pass.
	q_subr ship_purchase,global
	movem.l d1-d7/a0-a5,-(sp)
	cmp.w #ship_count,d0
	bhs .same
	cmp.w player_ship(a6),d0
	beq .same
	move.w d0,d6
	bsr ship_profile
	move.l a0,a3
	lea equip+cargo_bay(a6),a1
	moveq #12,d2
.equipment:
	move.w (a1)+,d1
	cmp.w #5,d2 ; energy unit is the sixth remaining entry (index 9)
	bne.s .ordinary
	cmp.w #2,d1
	beq.s .next
.ordinary:
	and.w #$7fff,d1
	bne .equipment_error
.next:
	dbra d2,.equipment
	move.w equip+missiles(a6),d1
	cmp.w sp_missiles(a3),d1
	bhi .missiles_error
	bsr ship_used_hold
	move.w sp_cargo(a3),d1
	mulu #15625,d1
	lsl.l #6,d1
	cmp.l d0,d1
	blo .cargo_error
	move.w player_ship(a6),d0
	bsr ship_profile
	move.l cash(a6),d1
	add.l sp_trade(a0),d1
	sub.l sp_price(a3),d1
	bcs .cash_error
	move.l d1,cash(a6)
	move.w d6,player_ship(a6)
	bsr ship_apply
	move.w hull_fuel(a6),equip+fuel(a6)
	clr.w missile_state(a6)
	clr.w retro_used(a6)
	jsr registration_new_player
	moveq #0,d0
	bra.s .exit
.cash_error:
	moveq #1,d0
	bra.s .exit
.equipment_error:
	moveq #2,d0
	bra.s .exit
.cargo_error:
	moveq #3,d0
	bra.s .exit
.missiles_error:
	moveq #4,d0
	bra.s .exit
.same:
	moveq #5,d0
.exit:
	movem.l (sp)+,d1-d7/a0-a5
	rts

; D0 item, D1 laser mount, D2 sell (0/1). D0 error, everything else preserved.
; Both direct purchase and laser replacement are atomic. Sale/replacement pays 50%.
	q_subr ship_equip_transaction,global
	movem.l d1-d7/a0-a5,-(sp)
	move.w d0,d6
	move.w d1,d7
	move.w d2,d5
	cmp.w #15,d0
	bhs .invalid
	tst.w d0
	beq .invalid
	bsr ship_equipment_price
	move.l d0,d4
	move.w d6,d0
	add.w d0,d0
	lea equip(a6),a5
	adda.w d0,a5
	move.w (a5),d0
	bmi .laser
	tst.w d5
	bne .sell_device
	cmp.w #1,d6
	beq.s .buy_missile
	tst.w d0
	bne .already
	cmp.w #2,d6
	beq .buy_device
	bsr ship_cargo_spare
	cmp.l #1000000,d3
	blt .space
	bra .buy_device
.buy_missile:
	cmp.w hull_missiles(a6),d0
	bhs .full
.buy_device:
	move.l cash(a6),d0
	sub.l d4,d0
	bcs .cash
	move.l d0,cash(a6)
	addq.w #1,(a5)
	bra .success
.sell_device:
	tst.w d0
	beq .invalid
	cmp.w #9,d6
	bne.s .bay
	cmp.w #2,d0
	beq .unique
.bay:
	cmp.w #2,d6
	bne.s .sell
	bsr ship_used_hold
	move.w hull_cargo(a6),d1
	mulu #15625,d1
	lsl.l #6,d1
	cmp.l d0,d1
	blo .space
.sell:
	subq.w #1,(a5)
	lsr.l #1,d4
	add.l d4,cash(a6)
	cmp.w #14,d6
	bne .success
	clr.w retro_used(a6)
	bra .success
.laser:
	cmp.w #4,d7
	bhs .invalid
	tst.w d5
	bne.s .sell_laser
	move.w hull_mounts(a6),d0
	btst d7,d0
	beq .invalid
	btst d7,1(a5)
	bne .already
	lea ship_lasers(pc),a0
	suba.l a4,a4
	moveq #3,d3
.find_old:
	move.w (a0)+,d0
	lea equip(a6),a1
	adda.w d0,a1
	btst d7,1(a1)
	beq.s .next_old
	move.l a1,a4
	lsr.w #1,d0
	bsr ship_equipment_price
	lsr.l #1,d0
	sub.l d0,d4
.next_old:
	dbra d3,.find_old
	move.l a4,d0
	bne.s .pay_laser
	bsr ship_cargo_spare
	cmp.l #1000000,d3
	blt .space
.pay_laser:
	move.l cash(a6),d0
	sub.l d4,d0
	bmi .cash ; a cheaper replacement can produce a refund
	move.l d0,cash(a6)
	move.l a4,d0
	beq.s .mount
	bclr d7,1(a4)
.mount:
	bset d7,1(a5)
	bra .success
.sell_laser:
	btst d7,1(a5)
	beq.s .invalid
	bclr d7,1(a5)
	lsr.l #1,d4
	add.l d4,cash(a6)
.success:
	moveq #0,d0
	bra.s .exit
.cash:
	moveq #1,d0
	bra.s .exit
.space:
	moveq #2,d0
	bra.s .exit
.already:
	moveq #3,d0
	bra.s .exit
.invalid:
	moveq #4,d0
	bra.s .exit
.full:
	moveq #5,d0
	bra.s .exit
.unique:
	moveq #6,d0
.exit:
	movem.l (sp)+,d1-d7/a0-a5
	rts

 ; A4 target -> D0 = 1 destroyed, 0 survives/immune. Only D0 and health change.
	q_subr ship_missile_damage,global
	moveq #0,d0
	cmp.w #spacestn,type(a4)
	beq.s .done
	cmp.w #dodec,type(a4)
	beq.s .done
	btst #invincible,flags(a4)
	bne.s .done
	sub.w #40,health(a4)
	bcs.s .kill
	tst.w health(a4)
	bne.s .done
.kill:
	clr.w health(a4)
	moveq #1,d0
.done:
	rts

; Match Unbound's relative shielding without changing Cobra's banks/gauges.
	q_subr ship_shield_damage,global
	move.l d1,-(sp)
	mulu #7,d0
	moveq #0,d1
	move.w hull_strength(a6),d1
	lsr.w #1,d1
	add.l d1,d0
	divu hull_strength(a6),d0
	and.l #$ffff,d0
	move.l (sp)+,d1
	rts

; A5 collider -> D0 base damage, or -1 for a lethal size mismatch.
	q_subr ship_collision_damage,global
	movem.l d1/a0,-(sp)
	move.w type(a5),d0
	moveq #4,d1
	cmp.w #max_obj_num,d0
	bhs.s .class
	lea ship_collision_classes(pc),a0
	move.b (a0,d0.w),d1
.class:
	sub.w hull_class(a6),d1
	cmp.w #2,d1
	bge.s .fatal
	move.w health(a5),d0
	lsr.w #5,d0
	addq.w #8,d0 ; Cobra health 72 -> the historical 10-point collision
	tst.w d1
	beq.s .done
	bmi.s .smaller
	addq.w #4,d0
	bra.s .done
.smaller:
	lsr.w #1,d0
	cmp.w #-1,d1
	beq.s .done
	lsr.w #1,d0
	bra.s .done
.fatal:
	moveq #-1,d0
.done:
	movem.l (sp)+,d1/a0
	rts

; Shipyard offers are a deterministic function of government and economy.
	q_subr ship_build_offers,global
	movem.l d0-d3/a0-a1,-(sp)
	move.w splanet+econ(a6),d0
	and.w #7,d0
	lea ship_offer_counts(pc),a0
	moveq #0,d1
	move.b (a0,d0.w),d1
	lea ship_offers_normal(pc),a0
	tst.w splanet+govern(a6)
	bne.s .copy
	lea ship_offer_bonus(pc),a0
	add.b (a0,d0.w),d1
	lea ship_offers_anarchy(pc),a0
	cmp.w #3,d0
	blo.s .copy
	lea ship_offers_anarchy_mid(pc),a0
	cmp.w #6,d0
	blo.s .copy
	lea ship_offers_anarchy_low(pc),a0
	beq.s .copy
	lea ship_offers_normal(pc),a0
.copy:
	move.w d1,yard_count(a6)
	subq.w #1,d1
	lea yard_offers(a6),a1
.loop:
	moveq #0,d0
	move.b (a0)+,d0
	move.w d0,(a1)+
	dbra d1,.loop
	movem.l (sp)+,d0-d3/a0-a1
	rts

	q_subr shipyards,global
	jsr check_docked
	moveq #icon_ships,d0
	jsr invert_icon
	jsr prepare_text
	lea yard_title(pc),a0
	moveq #title_y,d1
	jsr print_centre
	bsr ship_build_offers
	clr.w yard_slot(a6)
.draw:
	bsr yard_profile
	move.w sp_atlas(a0),d0
	add.w #ship_count*2,d0
	lsl.w #2,d0
	bsr ship_decode_bitmap
	bsr yard_coords
	jsr put_bitmap
	bsr yard_coords
	lsr.w #3,d0
	addq.w #1,d0 ; centre the six-character price in the 64-pixel tile
	add.w #41,d1
	jsr locate
	moveq #orange,d0
	moveq #trans,d1
	jsr text_colour
	bsr yard_profile
	move.l sp_price(a0),d0
	; Whole prices are multiples of 100 Cr; divide before multiplying to avoid DIVU overflow.
	divu #1000,d0
	and.l #$ffff,d0
	mulu #100,d0
	move.w #$8006,d1
	jsr print_number
	addq.w #1,yard_slot(a6)
	move.w yard_slot(a6),d0
	cmp.w yard_count(a6),d0
	blo .draw
	move.w #-1,yard_selected(a6)
	lea yard_actions(pc),a0
	jsr init_cursor
	bra yard_balance

yard_profile:
	move.w yard_slot(a6),d0
	add.w d0,d0
	lea yard_offers(a6),a0
	move.w (a0,d0.w),d0
	bra ship_profile

yard_coords:
	moveq #0,d0
	move.w yard_slot(a6),d0
	divu #5,d0
	move.w d0,d1
	mulu #52,d1
	add.w #17,d1
	swap d0
	lsl.w #6,d0
	rts

yard_highlight:
	movem.l d0-d7/a0-a5,-(sp)
	jsr set_colour
	jsr hide_cursor
	bsr yard_coords
	move.w d0,d4
	move.w d1,d5
	move.w d0,d2
	add.w #63,d2
	move.w d1,d3
	movem.l d4-d5,-(sp)
	jsr ui_line
	movem.l (sp)+,d4-d5
	move.w d4,d0
	move.w d5,d1
	move.w d4,d2
	move.w d5,d3
	add.w #48,d3
	movem.l d4-d5,-(sp)
	jsr ui_line
	movem.l (sp)+,d4-d5
	move.w d4,d0
	add.w #63,d0
	move.w d5,d1
	move.w d0,d2
	move.w d5,d3
	add.w #48,d3
	movem.l d4-d5,-(sp)
	jsr ui_line
	movem.l (sp)+,d4-d5
	move.w d4,d0
	move.w d5,d1
	add.w #48,d1
	move.w d4,d2
	add.w #63,d2
	move.w d1,d3
	movem.l d4-d5,-(sp)
	jsr ui_line
	movem.l (sp)+,d4-d5
	jsr restore_cursor
	movem.l (sp)+,d0-d7/a0-a5
	rts
yard_unhighlight:
	move.w yard_selected(a6),d0
	bmi.s .done
	move.w d0,yard_slot(a6)
	moveq #black,d0
	bsr yard_highlight
.done:
	rts
s_yard:
	cmp.w yard_count(a6),d0
	bhs yard_none
	move.w d0,-(sp)
	bsr yard_unhighlight
	move.w (sp)+,d0
	move.w d0,yard_slot(a6)
	move.w d0,yard_selected(a6)
	moveq #white,d0
	bsr yard_highlight
	jsr clear_input
	bsr yard_profile
	bsr ship_name
	move.w #prompt_y,d1
	jmp print_centre
yard_none:
	bsr yard_unhighlight
	move.w #-1,yard_selected(a6)
	bra yard_balance
yard_balance:
	jsr clear_input
	lea yard_trade_text(pc),a0
	jsr print_string
	move.w player_ship(a6),d0
	bsr ship_profile
	move.l sp_trade(a0),d0
	move.w #128,d1
	jmp print_number
yard_icon:
	move.w yard_selected(a6),d0
	bmi shipyards
	bra d_yard
d_yard:
	cmp.w yard_count(a6),d0
	bhs yard_none
	move.w d0,yard_slot(a6)
	bsr yard_profile
	bsr ship_purchase
	tst.w d0
	bne.s .error
	bsr shipyards
	jsr clear_input ; replace the trade-in line with the purchase confirmation
	lea yard_bought(pc),a0
	move.w #prompt_y,d1
	jmp print_centre
.error:
	lsl.w #2,d0
	lea yard_errors(pc),a0
	move.l (a0,d0.w),a0
	jmp error_box

yard_actions:
	q_action 149,175,179,181,0,0,yard_icon
	q_action 0,17,63,65,0,-1,yard
	q_action 64,17,127,65,1,-1,yard
	q_action 128,17,191,65,2,-1,yard
	q_action 192,17,255,65,3,-1,yard
	q_action 256,17,319,65,4,-1,yard
	q_action 0,69,63,117,5,-1,yard
	q_action 64,69,127,117,6,-1,yard
	q_action 128,69,191,117,7,-1,yard
	q_action 192,69,255,117,8,-1,yard
	q_action 256,69,319,117,9,-1,yard
	q_action 0,121,63,169,10,-1,yard
	q_action 64,121,127,169,11,-1,yard
	q_action 128,121,191,169,12,-1,yard
	include "icons.m68"
	dc.w -1
	dc.l yard_none

ship_lasers: dc.w pulse_lasers,beam_lasers,mining_lasers,military_lasers
ship_offer_counts: dc.b 10,8,6,5,4,4,3,1
ship_offer_bonus: dc.b 3,3,3,2,2,2,1,0
ship_offers_normal: dc.b 1,2,3,4,0,5,6,7,8,9
ship_offers_anarchy: dc.b 10,1,11,2,3,12,4,0,5,6,7,8,9
ship_offers_anarchy_mid: dc.b 10,1,11,2,3,4,0
ship_offers_anarchy_low: dc.b 10,1,2,3
; Types: station, missile, canister, asteroid, worm, thargon, alloy, letters,
; Viper, Dodec, then the native ship database order through the panels.
ship_collision_classes:
	dc.b 4,0,0,4,0,0,0,0,0,0,0,2,4
	dc.b 3,4,3,4,3,2,4,4,2,3,2,2,3,1,3,2,4,3,3
	dcb.b 11,4
	even
ship_equipment_prices:
	dc.l 0,250,6000,6000,4000,10000,5250,3000,25000,15000,15000,50000,8000,60000,80000
