	include "common.def"
; Ported from src-orig/CHECKSUM_M68; edit this copy.
*	@@@@   @@  @@ @@@@@@@	@@@@  @@@  @@	@@@@   @@  @@ @@   @@
*  @@  @@  @@  @@  @@	@  @@  @@  @@  @@  @@  @@  @@  @@ @@@ @@@
* @@	   @@  @@  @@ @   @@	   @@ @@   @@	   @@  @@ @@@@@@@
* @@	   @@@@@@  @@@@   @@	   @@@@ 	@@@@   @@  @@ @@@@@@@
* @@	   @@  @@  @@ @   @@	   @@ @@	   @@  @@  @@ @@ @ @@
*  @@  @@  @@  @@  @@	@  @@  @@  @@  @@  @@  @@  @@  @@ @@   @@
*	@@@@   @@  @@ @@@@@@@	@@@@  @@@  @@	@@@@	@@@@  @@   @@

* Calculate and check for hacking routines.

	include "macros.m68"

	xref checksum_start,checksum_end,disp_debug,shut_down,cockpit

	q_module checksum

start:

* Jump table to checksum routines (so that the JSR's never change).

	q_subr checksum,global

	bra _checksum

	q_subr check_hack,global

	bra _check_hack


* ***********************************
* **							   **
* ** CHECKSUM - CALCULATE CHECKSUM **
* **							   **
* ***********************************

* Calculates the checksum and stores in down in memory.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr _checksum,global

	lea checksum_start,a0 ; start of memory to check
	clr d0 ; checksum = 0
	clr d1 ; high byte = 0 (always)
q_checksum_m68_1:
	move.b (a0)+,d1 ; add byte to checksum
	add d1,d0
	cmp.l #checksum_end,a0
	bne q_checksum_m68_1
q_checksum_m68_2:
	move d0,prog_checksum(a6) ; store checksum
	move d0,ok_checksum(a6) ; Hunk relocation changes absolute operands at load time
	ifne calc_checksum
	move.l a0,-(sp)
	lea cockpit+2,a0
	jsr set_palette
	move.l (sp)+,a0
	jsr disp_debug ; display checksum
q_checksum_m68_3:
	bra q_checksum_m68_3
q_checksum_m68_4:
	endc

	q_ret return


* ***************************************************
* **											   **
* ** CHECK_HACK - CHECK IF PROGRAM HAS BEEN HACKED **
* **											   **
* ***************************************************

* Checks if the program has been hacked and bombing out if required.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr _check_hack

	lea prog_checksum-1234(a6),a0 ; checksum ok ?
	lea ok_checksum-4321(a6),a1
	move 1234(a0),d0
	cmp 4321(a1),d0
	q_ret eq ; yes, return
	jmp shut_down ; shut down the program

end:

	ds.b 512-(end-start) ; pad out to 1k
