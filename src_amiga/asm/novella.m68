; Novella protection system.

; Atari ST Version 1.1 March 26, 1990 Copyright (c) 1990 Mr. Micro Ltd.
; Designed and coded by Rob Nicholson.

; Modification history:

;	V1.0	??/??/??	Original release.
;	V1.1	26/03/90	Hacker password changed to Suzanne and encoded.

	include "macros.m68"

	xref rand,print_string,print_number,prepare_text,input_line,blank_screen
	xref clear_input,print_centre,wait_key,monst,str_compare,shut_down

* ---- LOCAL CONSTANTS ----

key_vect: equ (64+6)*4 ; keyboard/midi exception vector
xor_mask: equ 36 ; mask to XOR stored input

	q_module novella


* ******************************************
* **									  **
* ** NOVELLA - PERFORM NOVELLA PROTECTION **
* **									  **
* ******************************************

* Picks a random word from the list of 100 words and asks the user to
* enter the number.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr novella,global

	ifne noprotect ; skip the question without changing other protection checks
	q_ret
	endc
	ifeq use_novella ; debug - no protection required
	q_ret
	endc
	bset #f_fx,user(a6) ; enable keyclick
	q_loop 1,3 ; allow upto three guesses
	q_push d7
	jsr blank_screen ; prepare text screen
	jsr prepare_text
	lea text6(pc),a0
	moveq #title_y,d1
	jsr print_centre
	move #no_words,d2 ; choose a random word
	jsr rand
	asl #2,d0
	lea words(pc),a0
	move.l (a0,d0),a5
	lea text1(pc),a0 ; print text (4 numbers)
	q_loop 2,4
	q_push d7
	jsr print_string ; print string (e.g. paragraph)
	q_push.l a0 ; save pointer to next string
	move (a5)+,d0 ; print number (e.g. page #)
	ext.l d0
	clr d1
	jsr print_number
	q_pop.l a0 ; next number
	q_pop.w d7
	q_next 2
	q_push.l a5 ; save pointer to words
q_novella_m68_1:
	jsr clear_input ; print prompt
	lea text5(pc),a0
	jsr print_string
	moveq #'A',d0 ; input string
	moveq #'Z',d1
	moveq #11,d2
	moveq #-1,d3
	jsr input_line
	cmp #27,d0 ; ESC pressed ?
; Quelo: 			if <ne> then.s				no
	beq.s q_novella_m68_3
	move.b input(a6),d0 ; null input ?
	bne.s q_novella_m68_2
q_novella_m68_3:
	bra q_novella_m68_1
q_novella_m68_2:
	lea input(a6),a0 ; encode input
q_novella_m68_5:
	move.b (a0),d0 ; end of string ?
	beq.s q_novella_m68_6
	eor.b #xor_mask,d0 ; encode character
	move.b d0,(a0)+
	bra q_novella_m68_5
q_novella_m68_6:
	lea input(a6),a0 ; special name ?
	lea text7(pc),a1
	jsr str_compare
; Quelo: 		if <eq> then.s					yes
	bne.s q_novella_m68_7
	st allow_hack(a6) ; allow hacker
q_novella_m68_7:
	q_pop.l a5 ; fetch pointer to 1st word
	q_pop.w d7 ; restore loop counter
	q_loop 2,d6,3 ; check all three languages
	move.l a5,a0 ; match ?
	lea input(a6),a1
	jsr str_compare
	q_ret eq ; yes, return
q_novella_m68_9:
	tst.b (a5)+
	bne q_novella_m68_9
q_novella_m68_10:
	q_next 2,d6 ; next language
	q_next 1 ; next try
	jmp shut_down ; shut down the system


