* Misc. text strings.

text1: dc.b c_colour,white,black
	dc.b c_cursor,0,text_top+1*8
	dc.b 'Please enter the following word from'
	dc.b c_cursor,0,text_top+2*8
	dc.b 'your copy of the ''Space Trader''s Flight'
	dc.b c_cursor,0,text_top+3*8
	dc.b 'Training Manual'' and press return.'
	dc.b c_cursor,0,text_top+5*8
	dc.b 'Punctuation should be ignored.'
	dc.b c_cursor,12,text_top+8*8,c_ink,lgt_blue
	dc.b 'Page ',0
text2: dc.b c_cursor,12,text_top+10*8,c_ink,lgt_green
	dc.b 'Paragraph ',0
text3: dc.b c_cursor,12,text_top+12*8,c_ink,red
	dc.b 'Line ',0
text4: dc.b c_cursor,12,text_top+14*8,c_ink,yellow
	dc.b 'Word ',0
text5: dc.b 'Enter word -> ',0
text6: dc.b '- Novella Protection -',0
text7: dc.b 'S'^xor_mask
	dc.b 'U'^xor_mask
	dc.b 'Z'^xor_mask
	dc.b 'A'^xor_mask
	dc.b 'N'^xor_mask
	dc.b 'N'^xor_mask
	dc.b 'E'^xor_mask
	dc.b 0
