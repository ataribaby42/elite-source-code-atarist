; Native MC68000 adaptation of BBC/C64 Elite's STARS1, STARS6, STARS2
; depth, motion and recycling model by Ian Bell and David Braben.
; Source annotations: Mark Moxon, https://elite.bbcelite.com/c64/
; See ../STARFIELD.md for source links, scaling and deliberate adaptations.
    include "common.def"
    include "macros.m68"
    xref random,rand,set_colour,c_plotxy

; Screen offsets retain subpixel motion. Depth has the original 8.8 scale.
    rsset 0
dust_x: rs.l 1
dust_y: rs.l 1
dust_z: rs.w 1
dust_len: equ __RS
dust_store: equ no_dust*dust_len

    q_vars dust
dust_front: rs.b dust_store
dust_rear: rs.b dust_store
dust_left: rs.b dust_store
dust_right: rs.b dust_store
dust_ptr: rs.l 1
move_ptr: rs.l 1
dust_motion: rs.w 1            ; front/rear/left/right, including retro reversal
dust_step: rs.w 1              ; speed*64 in depth's 8.8 units
dust_speed: rs.w 1
dust_count: rs.w 1
dust_plane_sin: rs.w 1         ; signed Q14 angles at the host projection scale
dust_plane_cos: rs.w 1
dust_vertical_sin: rs.w 1
dust_vertical_cos: rs.w 1
    q_end_vars dust
    q_module dust

; Uniform initial coordinates, including both extreme viewport columns.
    q_subr new_coords
    move.w #x_size,d2
    jsr rand
    add.w #x_min,d0
    move.w d0,-(sp)
    move.w #y_size,d2
    jsr rand
    add.w #y_min,d0
    swap d0
    clr.w d0
    move.l d0,dust_y(a5)
    move.w (sp)+,d0
    swap d0
    clr.w d0
    move.l d0,dust_x(a5)
    rts

; STARS1: replace departed dust with distant particles spread over the view.
    q_subr new_front
    bsr new_coords
    move.w dust_x(a5),d0
    bpl.s .positive_x
    cmp.w #-8,d0
    ble.s .y
    move.l #-8*65536,dust_x(a5)
    bra.s .y
.positive_x:
    cmp.w #8,d0
    bge.s .y
    move.l #8*65536,dust_x(a5)
.y:
    move.w dust_y(a5),d0
    bpl.s .positive_y
    cmp.w #-4,d0
    ble.s .depth
    move.l #-4*65536,dust_y(a5)
    bra.s .depth
.positive_y:
    cmp.w #4,d0
    bge.s .depth
    move.l #4*65536,dust_y(a5)
.depth:
    jsr random
    or.w #144,d0
    lsl.w #8,d0
    move.w d0,dust_z(a5)
    rts

; STARS6: new rear-view particles enter on any of the four borders.
    q_subr new_rear
    bsr new_coords
    jsr random
    and.w #3,d0
    add.w d0,d0
    lea rear_edges(pc),a0
    move.w (a0,d0.w),d1
    cmp.w #4,d0
    bge.s .horizontal
    swap d1
    clr.w d1
    move.l d1,dust_x(a5)
    bra.s .depth
.horizontal:
    swap d1
    clr.w d1
    move.l d1,dust_y(a5)
.depth:
    jsr random
    and.w #127,d0
    add.w #10,d0
    lsl.w #8,d0
    move.w d0,dust_z(a5)
    rts

; STARS2: use the incoming side, or the opposite vertical edge after a turn.
; D2 = outcodes, bit 0/1 horizontal, bit 2/3 vertical.
    q_subr new_side
    move.l dust_y(a5),-(sp)    ; retain the fractional overshoot before recycling
    move.w d2,-(sp)
    bsr new_coords
    move.w (sp)+,d2
    move.l (sp)+,d1
    and.w #3,d2
    beq.s .vertical
    move.w #x_max,d0
    cmp.w #2,dust_motion(a6)
    beq.s .x
    move.w #x_min,d0
.x:
    swap d0
    clr.w d0
    move.l d0,dust_x(a5)
    bra.s .depth
.vertical:
    ; Wrap the complete 16.16 position instead of snapping every new star
    ; to the same row. Stars retain their distinct phase during steady roll.
    cmp.l #y_min*65536,d1
    blt.s .below
    sub.l #y_size*65536,d1
    cmp.l #(y_max+1)*65536,d1
    blt.s .entry_y
    move.l #y_min*65536,d1     ; recover safely from invalid large coordinates
    bra.s .entry_y
.below:
    add.l #y_size*65536,d1
    cmp.l #y_min*65536,d1
    bge.s .entry_y
    move.l #y_max*65536,d1
.entry_y:
    move.l d1,dust_y(a5)
.depth:
    jsr random
    or.w #8,d0
    lsl.w #8,d0
    move.w d0,dust_z(a5)
    rts

    q_subr init_dust,global
    lea dust_front(a6),a5
    move.w #no_dust*4-1,d7
.loop:
    bsr new_front
    lea dust_len(a5),a5
    dbra d7,.loop
    rts

; Native speed units feed the original speed*64 depth step. Stopping the
; engines really stops translation; the BBC's minimum quotient applies only
; while moving. No direction lookup files are needed.
    q_subr setup_dust
    move.w view(a6),d0
    and.w #3,d0
    move.w d0,d1
    mulu #dust_store,d0
    lea dust_front(a6),a5
    adda.w d0,a5
    move.l a5,dust_ptr(a6)
    move.w d1,dust_motion(a6)
    tst.w retro_count(a6)
    beq.s .speed
    eor.w #1,dust_motion(a6)
.speed:
    move.w speed(a6),d0
    cmp.w #max_speed,d0
    bls.s .retro
    move.w #max_speed,d0
.retro:
    tst.w retro_count(a6)
    beq.s .special
    move.w retro_count(a6),d0
    mulu #max_speed,d0
    divu #retro_life,d0
.special:
    tst.w dust_type(a6)
    beq.s .step
    move.w #max_speed/8,d0
.step:
    move.w d0,dust_speed(a6)
    lsl.w #6,d0
    move.w d0,dust_step(a6)
    move.w dust_motion(a6),d0
    lsl.w #2,d0
    lea movement_vectors(pc),a0
    move.l (a0,d0.w),move_ptr(a6)

    ; Q24 game angles -> Q14. A positive vertical sine moves dust up.
    move.l roll_sin(a6),d0
    move.l roll_cos(a6),d1
    move.l climb_sin(a6),d2
    move.l climb_cos(a6),d3
    moveq #10,d4
    asr.l d4,d0
    asr.l d4,d1
    asr.l d4,d2
    asr.l d4,d3
    move.w view(a6),d4
    cmp.w #2,d4
    blo.s .front_rear
    exg d0,d2
    exg d1,d3
    cmp.w #2,d4
    bne.s .angles
    neg.w d0                   ; left: inverse pitch, inverse roll
    neg.w d2
    bra.s .angles
.front_rear:
    tst.w d4
    beq.s .front
    neg.w d0                   ; rear: inverse roll, positive pitch
    bra.s .angles
.front:
    neg.w d2
.angles:
    move.w d0,dust_plane_sin(a6)
    move.w d1,dust_plane_cos(a6)
    move.w d2,dust_vertical_sin(a6)
    move.w d3,dust_vertical_cos(a6)
    rts

; STARS1/STARS6 radial expansion/contraction: q=(64*speed/z_hi)|1.
    q_subr move_forward
    tst.w dust_step(a6)
    beq.s .done
    moveq #0,d6
    move.w dust_z(a5),d6
    sub.w dust_step(a6),d6
    cmp.w #16*256,d6
    blo new_front
    bsr radial_delta
    add.l d2,dust_x(a5)
    add.l d3,dust_y(a5)
    move.w d6,dust_z(a5)
.done:
    rts

    q_subr move_rear
    moveq #0,d6
    move.w dust_z(a5),d6
    moveq #0,d0
    move.w dust_step(a6),d0
    add.l d0,d6
    cmp.l #160*256,d6
    bhs new_rear
    tst.w d0
    beq.s .done
    bsr radial_delta
    sub.l d2,dust_x(a5)
    sub.l d3,dust_y(a5)
    move.w d6,dust_z(a5)
.done:
    rts

; Returns Q16 pixel deltas in D2/D3. D6 keeps the updated depth.
    q_subr radial_delta
    moveq #0,d7
    move.w dust_step(a6),d7
    move.w dust_z(a5),d4
    lsr.w #8,d4
    divu d4,d7
    or.w #1,d7
    move.w dust_x(a5),d2
    ; The BBC magnitude byte truncates towards zero, also left/below centre.
    bpl.s .y
    tst.w dust_x+2(a5)
    beq.s .y
    addq.w #1,d2
.y:
    move.w dust_y(a5),d3
    bpl.s .multiply
    tst.w dust_y+2(a5)
    beq.s .multiply
    addq.w #1,d3
.multiply:
    muls d7,d2
    muls d7,d3
    asl.l #8,d2
    asl.l #8,d3
    rts

    q_subr move_left
    moveq #-1,d7
    bra move_side

    q_subr move_right
    moveq #1,d7

; STARS2's 8*speed/z_hi pixels, retaining fractional motion at all depths.
    q_subr move_side
    moveq #0,d2
    move.w dust_speed(a6),d2
    beq.s .done
    lsl.l #8,d2
    lsl.l #3,d2
    move.w dust_z(a5),d3
    lsr.w #8,d3
    divu d3,d2
    and.l #$ffff,d2
    lsl.l #8,d2
    tst.w d7
    bpl.s .add
    neg.l d2
.add:
    add.l d2,dust_x(a5)
.done:
    rts

; Apply the two view-dependent rotations using this game's focal length 512.
; Plane rotation accumulates deltas rather than throwing away subpixel bits.
; Vertical rotation projects (x, y*cos + 512*sin, cos - y*sin/512), avoiding
; the BBC front-view approximation's sideways bias during pitch.
    q_subr rotate_dust
    move.w dust_plane_sin(a6),d0
    move.w dust_plane_cos(a6),d1
    sub.w #16384,d1
    move.w d0,d4
    or.w d1,d4
    beq.s .vertical
    move.w dust_x(a5),d2
    move.w dust_y(a5),d3
    move.w d2,d4
    muls d1,d4
    move.w d3,d5
    muls d0,d5
    sub.l d5,d4
    muls d0,d2
    muls d1,d3
    add.l d3,d2
    asl.l #2,d4
    asl.l #2,d2
    add.l d4,dust_x(a5)
    add.l d2,dust_y(a5)
.vertical:
    move.w dust_vertical_sin(a6),d0
    beq .done
    move.w dust_vertical_cos(a6),d1
    move.w dust_y(a5),d3
    move.w d3,d4
    muls d0,d4
    asr.l #8,d4
    asr.l #1,d4
    move.w d1,d6
    sub.w d4,d6               ; denominator = cos - y*sin/512, in Q14
    ble.s .outside
    move.w #16384,d4
    sub.w d6,d4
    move.w dust_x(a5),d2
    muls d4,d2
    asl.l #8,d2
    divs d6,d2               ; delta x in signed 8.8
    bvs.s .outside
    ext.l d2
    asl.l #8,d2
    add.l d2,dust_x(a5)
    sub.w d6,d1
    muls d1,d3
    ext.l d0
    asl.l #8,d0
    asl.l #1,d0
    add.l d0,d3
    asl.l #8,d3
    divs d6,d3               ; delta y in signed 8.8
    bvs.s .outside
    ext.l d3
    asl.l #8,d3
    add.l d3,dust_y(a5)
.done:
    rts
.outside:
    move.l #(y_max+256)*65536,dust_y(a5)
    rts

; Return outcodes in D2; NEW_SIDE preserves the vertical boundary overshoot.
    q_subr dust_bounds
    clr.w d2
    move.w dust_x(a5),d0
    cmp.w #x_min,d0
    bge.s .right
    bset #0,d2
.right:
    cmp.w #x_max,d0
    ble.s .bottom
    bset #1,d2
.bottom:
    move.w dust_y(a5),d1
    cmp.w #y_min,d1
    bge.s .top
    bset #2,d2
.top:
    cmp.w #y_max,d1
    ble.s .done
    bset #3,d2
.done:
    tst.w d2
    rts

    q_subr recycle_dust
    cmp.w #1,dust_motion(a6)
    beq new_rear
    blo new_front
    bra new_side

    q_subr update_dust
    bsr dust_bounds
    bne recycle_dust
    cmp.w #8*256,dust_z(a5)    ; valid denominator before any depth division
    bhs.s .rotate
    moveq #3,d2
    bra recycle_dust
.rotate:
    bsr rotate_dust
    bsr dust_bounds
    bne recycle_dust
    move.l move_ptr(a6),a0
    jsr (a0)
    bsr dust_bounds
    bne recycle_dust
    rts

; Keep every star exactly one pixel, regardless of depth.
    q_subr plot_dust
    move.w dust_x(a5),d0
    move.w dust_y(a5),d1
    jmp c_plotxy

    q_subr draw_dust
    tst.w witch_space(a6)
    bne.s .done
    bsr setup_dust
    moveq #yellow,d0
    jsr set_colour
    move.l dust_ptr(a6),a5
    move.w #no_dust,dust_count(a6)
.loop:
    tst.w dust_type(a6)
    beq.s .draw
    move.w dust_count(a6),d0
    and.w #7,d0
    add.w d0,d0
    lea dust_colours(pc),a0
    move.w (a0,d0.w),d0
    jsr set_colour
.draw:
    ; Like objects, display the current state then advance it for next frame.
    bsr plot_dust
    bsr update_dust
    lea dust_len(a5),a5
    subq.w #1,dust_count(a6)
    bne.s .loop
.done:
    rts

; Preserve the game's coloured torus/hyperspace trail duration and growth.
    q_subr dust_cloud,global
    tst.w dust_type(a6)
    beq draw_dust
    move.w dust_size(a6),d7
    q_loop 1
    q_push d7
    bsr draw_dust
    q_pop d7
    q_next 1
    subq.w #1,dust_ctr(a6)
    bne.s .done
    move.w latch(a6),dust_ctr(a6)
    move.w dust_size(a6),d0
    cmp.w max_len(a6),d0
    bhs.s .done
    addq.w #1,dust_size(a6)
.done:
    rts

; ---- LOCAL DATA ----
movement_vectors:
    dc.l move_forward,move_rear,move_left,move_right
rear_edges:
    dc.w x_min,x_max,y_min,y_max
dust_colours:
    dc.w red,lgt_green,mid_blue,magenta,white,yellow,lgt_blue,lgt_grey
