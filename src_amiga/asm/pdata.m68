	xref ship_put_bitmap,ship_bitmap,draw_planet_portrait,cockpit
	include "common.def"
; Ported from src_orig/asm/pdata.m68; edit this copy.
* @@@@@@  @@@@@ 	 @@    @@@@@@	 @@
*  @@  @@  @@ @@	@@@@   @ @@ @	@@@@
*  @@  @@  @@  @@  @@  @@	 @@    @@  @@
*  @@@@@   @@  @@  @@  @@	 @@    @@  @@
*  @@	   @@  @@  @@@@@@	 @@    @@@@@@
*  @@	   @@ @@   @@  @@	 @@    @@  @@
* @@@@	  @@@@@    @@  @@	@@@@   @@  @@

* Planet data screen. Also contains (possibly confusingly) several
* general purpose trading based routines.

* Atari ST Version 1.0 19th April 1988 Copyright (c) 1988 Mr. Micro Ltd
* Designed and coded by Rob Nicholson. Adapted from the MSX version.

	include "macros.m68"
	include "bitlist.m68"

	xref get_planet_info,sqrt,fx,invert_icon,g_lock_on,l_lock_on
	xref build_name,str_copy,str_cat,print_centre,prepare_text,buy_cargo
	xref sell_cargo,equip_ship,galactic_chart,local_chart,status,init_cursor
	xref print_string,wait,clear_input,print_number,text_colour,locate
	xref print_table,funny_str,texture,draw_screen,set_colour,plotxy
	xref launch,disk,find_planet,home_cursor,market_prices
	xref inventory,ui_line,getrandx,dot_to_addr,monst,bit_masks,wait_key
	xref find_bitmap,put_bitmap,find_table,str_len,build_number,options

* ---- LOCAL CONSTANTS ----

planet_x: equ 272 ; screen coords of planet
planet_y: equ 74
planet_rad: equ 40 ; radius of planet
head_x: equ 8 ; coords of head
head_y: equ text_top+8
body_x: equ head_x ; coords of body
body_y: equ head_y+32
max_desc: equ 8 ; max. description length (humanoid)
text_x: equ 80 ; text x coordinate

* ---- LOCAL VARIABLES ----

	q_vars pdata

circle_x: rs.w 1 ; centre of grabbed circle
circle_y: rs.w 1
xl: rs.w 1 ; x left coord
xr: rs.w 1 ; x right coord
yc: rs.w 1 ; y coord
portrait_colours: rs.w 1 ; palette indices reserved by the rendered planet

	q_end_vars pdata

* ---- LOCAL MACROS ----

* DRAW - Draw horizontal line of circle (8 way symmetry)

draw macro

	ifc '\2','x' ; build up end coords
	move d0,d4
	endc
	ifc '\2','y'
	move d1,d4
	endc
	ifc '\1','-'
	neg d4
	endc
	ifc '\4','x'
	move d0,d5
	endc
	ifc '\4','y'
	move d1,d5
	endc
	ifc '\3','-'
	neg d5
	endc
	ifc '\6','x'
	move d0,d6
	endc
	ifc '\6','y'
	move d1,d6
	endc
	ifc '\5','-'
	neg d6
	endc
	bsr planet_line ; draw line of planet

	endm

	q_module pdata


* **********************************
* **							  **
* ** DATA - DATA ON PLANET SCREEN **
* **							  **
* **********************************

* Display the data on the current hyperspace plane.

* Entry: REQ_PLANET = planet # to display
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr data,global

	tst cockpit_on(a6) ; cockpit displayed ?
; Quelo: 	if <eq> then.s						no
	bne.s q_pdata_m68_1
	moveq #icon_data,d0
	jsr invert_icon
q_pdata_m68_1:
	jsr prepare_text ; prepare display
	lea text1(pc),a0 ; build title (data on xxx)
	lea pad(a6),a1
	jsr str_copy
	move req_planet(a6),d0
	jsr build_name
	lea pad(a6),a0
	lea planet_name(a6),a1
	jsr str_cat
	lea pad(a6),a0 ; print title
	moveq #title_y,d1
	jsr print_centre
	lea text2(pc),a0 ; print headings
	jsr print_string
	moveq #text_x/8+9,d0 ; print economy
	moveq #text_top,d1
	jsr locate
	moveq #lgt_blue,d0
	moveq #trans,d1
	jsr text_colour
	move cplanet+econ(a6),d0
	eor #7,d0
	lea economy(pc),a0
	jsr print_table
	cmp #4,cplanet+econ(a6)
; Quelo: 	if <hs> then.s
	blo.s q_pdata_m68_3
	lea text3(pc),a0
	bra.s q_pdata_m68_4
q_pdata_m68_3:
	lea text4(pc),a0
q_pdata_m68_4:
	jsr print_string
	moveq #text_x/8+12,d0 ; print government
	moveq #text_top+8,d1
	jsr locate
	moveq #orange,d0
	moveq #trans,d1
	jsr text_colour
	move cplanet+govern(a6),d0
	lea government(pc),a0
	jsr print_table
	moveq #text_x/8+12,d0 ; print tech. level
	moveq #text_top+16,d1
	jsr locate
	moveq #white,d0
	moveq #trans,d1
	jsr text_colour
	move cplanet+tech(a6),d0
	clr d1
	jsr print_number
	moveq #text_x/8+5,d0 ; print population
	moveq #text_top+24,d1
	jsr locate
	moveq #yellow,d0
	moveq #trans,d1
	jsr text_colour
	move cplanet+seed(a6),d0
	and #63,d0
	q_inc d0
	ext.l d0
	move #$80,d1
	jsr print_number
	lea text5(pc),a0
	jsr print_string
	moveq #text_x/8+5,d0 ; print producivity
	moveq #14*8,d1
	jsr locate
	moveq #white,d0
	moveq #trans,d1
	jsr text_colour
	move cplanet+seed(a6),d0
	and #63,d0
	q_inc d0
	mulu #27,d0
	divu #5,d0
	ext.l d0
	move #$80,d1
	jsr print_number
	lea text6(pc),a0
	jsr print_string
	jsr funny_str ; print funny description
	bsr draw_planet ; draw the planet
	moveq #lgt_grey,d0 ; draw the distance line and arrow
	jsr set_colour
	move #text_x+26,d0
	move #planet_y,d1
	move #planet_x-planet_rad-7,d2
	move d1,d3
	movem d0/d2,-(sp) ; save x coords of line
	jsr ui_line
	moveq #bit_arrow_right,d0
	jsr find_bitmap
	move #planet_x-planet_rad-6,d0
	move #planet_y-2,d1
	jsr put_bitmap
	moveq #1,d0 ; the ship covers the distance line at its origin
	jsr ship_bitmap
	moveq #text_x,d0
	moveq #planet_y-22,d1
	jsr ship_put_bitmap
	moveq #orange,d0 ; print in orange
	moveq #trans,d1
	jsr text_colour
	bsr fuel_distance ; calculate fuel distance
	q_hclr d0 ; build into a number
	move #$80,d1
	lea pad(a6),a0
	jsr build_number
	movem (sp)+,d0/d2 ; calculate width of the line
	sub d0,d2
	move d2,d6
	lea pad(a6),a0 ; centre distance along the line
	jsr str_len
	asl #3,d0
	sub d6,d0
	neg d0
	lsr #1,d0
	add #text_x+32,d0
	lsr #3,d0
	moveq #planet_y-9,d1
	jsr locate
	jsr print_string ; print distance
	lea text10(pc),a0 ; centre 'Light Years' along the line
	jsr str_len
	asl #3,d0
	sub d6,d0
	neg d0
	lsr #1,d0
	add #text_x+32,d0
	lsr #3,d0
	moveq #planet_y+2,d1
	jsr locate
	jsr print_string ; print 'Light Years'
	move #132,row(a6) ; set print row
	moveq #orange,d0 ; print in orange
	moveq #trans,d1
	jsr text_colour
	tst.b cplanet+seed+5(a6) ; human colonial ?
; Quelo: 	if <pl> then.s						yes
	bmi.s q_pdata_m68_5
	move cplanet+seed+0(a6),d0 ; choose a head (two choices)
	and #1,d0
	add #bit_h_human,d0
	jsr find_bitmap
	moveq #head_x,d0 ; draw the head
	moveq #head_y,d1
	jsr put_bitmap
	move cplanet+seed+2(a6),d0 ; choose a body (three choices)
	mulu #3,d0
	swap d0
	add #bit_b_humanoid,d0
	jsr find_bitmap
	moveq #body_x,d0 ; draw the body
	moveq #body_y,d1
	jsr put_bitmap
	lea human(pc),a0 ; print 'human colonial'
	clr d0
	jsr print_word
	lea human(pc),a0
	moveq #1,d0
	bsr print_word
	bra q_pdata_m68_6
q_pdata_m68_5:
	move.b cplanet+seed+4(a6),d0 ; determine colour # (0..7)
	lsr.b #5,d0
	and #7,d0
	lea inhab_palette(pc),a0 ; set palette
	lea palette,a1
	q_inc d0
	mulu #6,d0
	lea (a0,d0.w),a2
	moveq #2,d3
.copy_inhab_colours:
	move.w (a2)+,d0 ; table uses ST RGB, runtime palette uses native OCS RGB
	and.w #$0777,d0
	move.w d0,d2
	add.w d0,d0
	lsr.w #2,d2
	and.w #$0111,d2
	or.w d2,d0 ; expand each component exactly as SET_PALETTE does
	move.w (a0)+,d1
	move.w d0,(a1,d1.w)
	dbra d3,.copy_inhab_colours
	move.b cplanet+seed+2(a6),d0 ; choose a type of head (e.g. slimey)
	move.b cplanet+seed+0(a6),d1
	eor.b d1,d0
	and #7,d0
	q_push d0 ; index into table of choices
	asl #2,d0
	lea heads(pc),a0
	lea (a0,d0),a0
	move 0(a0),d0 ; choose head within type
	mulu cplanet+seed+0(a6),d0
	swap d0
	add 2(a0),d0
	jsr find_bitmap
	moveq #head_x,d0 ; draw the head
	moveq #head_y,d1
	jsr put_bitmap
	move.b cplanet+seed+4(a6),d0 ; choose a type of body (e.g. bird)
	and #3,d0
	add (sp)+,d0
	and #7,d0
	asl #2,d0 ; index into table of choices
	lea bodies(pc),a0
	lea (a0,d0),a0
	move 0(a0),d0 ; choose a body within type
	mulu cplanet+seed+2(a6),d0
	swap d0
	add 2(a0),d0
	jsr find_bitmap
	moveq #body_x,d0 ; draw the body
	moveq #body_y,d1
	jsr put_bitmap
	move.b cplanet+seed+4(a6),d0 ; print size (e.g. small)
	lsr.b #2,d0
	q_push d0
	and #7,d0
	lea inhab_size,a0
	bsr print_word
	q_pop d0 ; print colour (e.g. blue)
	lsr.b #3,d0
	and #7,d0
	lea inhab_colour,a0
	bsr print_word
	move.b cplanet+seed+2(a6),d0 ; print looks (e.g. slimy)
	move.b cplanet+seed+0(a6),d1
	eor.b d1,d0
	and #7,d0
	q_push d0
	lea inhab_looks,a0
	bsr print_word
	move.b cplanet+seed+4(a6),d0 ; print type string (e.g. rodent)
	and #3,d0
	add (sp)+,d0
	and #7,d0
	lea inhab_type,a0
	bsr print_word
q_pdata_m68_6:
	bsr match_planet_palette
	lea data_action_table(pc),a0 ; initialise cursor
	jsr init_cursor

	q_ret


; Reserve only the flight RGB entries actually needed by the rendered globe.
; Fit the inhabitants' shades into the remaining private palette entries.
; OFF retains the original palette changes and bitmap without this conversion.
    q_subr match_planet_palette
    btst #f_planets,user+1(a6)
    beq .done
    movem.l d0-d7/a0-a5,-(sp)
    suba.w #12,sp ; original inhabitant RGBs, followed by three destination indices
    move.l palette+lgt_green*2,(sp)
    move.w palette+drk_green*2,4(sp)
    lea cockpit+2+red*2,a0
    lea palette+red*2,a1
    move.w portrait_colours(a6),d6
    moveq #red,d7
.copy_palette:
    move.w (a0)+,d0
    and.w #$0777,d0
    move.w d0,d1
    add.w d0,d0
    lsr.w #2,d1
    and.w #$0111,d1
    or.w d1,d0 ; match SET_PALETTE: ST components to native OCS RGB
    btst d7,d6
    beq.s .keep_shade
    move.w d0,(a1)
.keep_shade:
    addq.l #2,a1
    addq.w #1,d7
    cmp.w #drk_green,d7
    bls.s .copy_palette
    tst.b cplanet+seed+5(a6)
    bpl .restore ; humans use the standard UI colours
    move.l sp,a1
    lea 6(sp),a2
    move.w d6,d0
    bsr fit_inhabitant_palette
    lea 6(sp),a4
    move.l scr_base(a6),a0
    lea head_y*zoom_y*row_stride(a0),a0
    move.w #104*zoom_y-1,d7 ; 32-pixel head and 72-pixel body
.row:
    move.w #5*zoom_x-1,d6 ; include the eight-pixel left margin
.group:
    bsr remap_inhabitant_word
    lea 2(a0),a0
    dbra d6,.group
    lea row_stride-10*zoom_x(a0),a0
    dbra d7,.row
.restore:
    adda.w #12,sp
    movem.l (sp)+,d0-d7/a0-a5
.done:
    rts


; Evaluate all six assignments of the three original shades to palette 7..9.
; Planet entries stay locked. Minimize RGB error weighted by actual sprite use,
; so a large body area takes priority over a few highlight pixels.
; D0 = locked-index mask, A1 = original shades, A2 = output pixel indices.
ip_palette: equ 0
ip_source: equ 32
ip_counts: equ 38
ip_best_palette: equ 44
ip_best_map: equ 50
ip_map: equ 56
ip_best_score: equ 62
ip_mask: equ 66
ip_output: equ 68
ip_size: equ 72

    q_subr fit_inhabitant_palette
    movem.l d0-d7/a0-a5,-(sp)
    and.w #$0380,d0
    bne.s .fit
    move.w #lgt_green,(a2)
    move.w #mid_green,2(a2)
    move.w #drk_green,4(a2)
    bra .done
.fit:
    suba.w #ip_size,sp
    move.w d0,ip_mask(sp)
    move.l a2,ip_output(sp)
    move.l (a1),ip_source(sp)
    move.w 4(a1),ip_source+4(sp)
    clr.l ip_counts(sp)
    clr.w ip_counts+4(sp)
    lea palette,a0
    lea ip_palette(sp),a1
    moveq #15,d7
.copy:
    move.w (a0)+,(a1)+
    dbra d7,.copy
    lea ip_counts(sp),a2
    lea inhabitant_bit_counts(pc),a3
    move.l scr_base(a6),a0
    lea head_y*zoom_y*row_stride(a0),a0
    move.w #104*zoom_y-1,d7
.count_row:
    move.w #5*zoom_x-1,d6
.count_group:
    bsr count_inhabitant_word
    lea 2(a0),a0
    dbra d6,.count_group
    lea row_stride-10*zoom_x(a0),a0
    dbra d7,.count_row
    move.l #$7fffffff,ip_best_score(sp)
    moveq #0,d6
.candidate:
    lea inhabitant_permutations(pc),a3
    adda.w d6,a3
    lea ip_source(sp),a1
    lea ip_palette+lgt_green*2(sp),a0
    move.w ip_mask(sp),d4
    moveq #lgt_green,d5
.assign:
    move.w (a3)+,d0
    btst d5,d4
    bne.s .locked
    move.w (a1,d0.w),(a0)
.locked:
    addq.l #2,a0
    addq.w #1,d5
    cmp.w #drk_green,d5
    bls.s .assign
    lea ip_palette(sp),a0
    lea ip_source(sp),a1
    lea ip_map(sp),a2
    lea ip_counts(sp),a4
    moveq #0,d4
    moveq #2,d7
.score:
    bsr nearest_inhabitant_colour
    mulu.w (a4)+,d0
    add.l d0,d4
    addq.l #2,a1
    addq.l #2,a2
    dbra d7,.score
    cmp.l ip_best_score(sp),d4
    bhs.s .next
    move.l d4,ip_best_score(sp)
    move.l ip_palette+lgt_green*2(sp),ip_best_palette(sp)
    move.w ip_palette+drk_green*2(sp),ip_best_palette+4(sp)
    move.l ip_map(sp),ip_best_map(sp)
    move.w ip_map+4(sp),ip_best_map+4(sp)
.next:
    addq.w #6,d6
    cmp.w #36,d6
    blo.s .candidate
    lea palette+lgt_green*2,a0
    move.l ip_best_palette(sp),(a0)
    move.w ip_best_palette+4(sp),4(a0)
    move.l ip_output(sp),a2
    move.l ip_best_map(sp),(a2)
    move.w ip_best_map+4(sp),4(a2)
    adda.w #ip_size,sp
.done:
    movem.l (sp)+,d0-d7/a0-a5
    rts

; Count original indices 7..9 in a sixteen-pixel group.
; A2 = three counters, A3 = byte popcounts. Preserve the scan counters.
    q_subr count_inhabitant_word
    movem.l d6/a2,-(sp)
    move.w (a0),d0
    move.w bpr(a0),d1
    move.w bpr*2(a0),d2
    move.w bpr*3(a0),d3
    move.w d3,d4
    not.w d4
    and.w d0,d4
    and.w d1,d4
    and.w d2,d4
    move.w d0,d5
    or.w d1,d5
    or.w d2,d5
    not.w d5
    and.w d3,d5
    move.w d1,d6
    or.w d2,d6
    not.w d6
    and.w d0,d6
    and.w d3,d6
    bsr.s .count_mask
    move.w d5,d4
    bsr.s .count_mask
    move.w d6,d4
    bsr.s .count_mask
    movem.l (sp)+,d6/a2
    rts
.count_mask:
    moveq #0,d0
    move.b d4,d0
    moveq #0,d1
    move.b (a3,d0.w),d1
    lsr.w #8,d4
    add.b (a3,d4.w),d1
    add.w d1,(a2)+
    rts

inhabitant_permutations:
    dc.w 0,2,4, 0,4,2, 2,0,4, 2,4,0, 4,0,2, 4,2,0
inhabitant_bit_counts:
    dc.b 0,1,1,2,1,2,2,3,1,2,2,3,2,3,3,4
    dc.b 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5
    dc.b 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5
    dc.b 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6
    dc.b 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5
    dc.b 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6
    dc.b 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6
    dc.b 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7
    dc.b 1,2,2,3,2,3,3,4,2,3,3,4,3,4,4,5
    dc.b 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6
    dc.b 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6
    dc.b 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7
    dc.b 2,3,3,4,3,4,4,5,3,4,4,5,4,5,5,6
    dc.b 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7
    dc.b 3,4,4,5,4,5,5,6,4,5,5,6,5,6,6,7
    dc.b 4,5,5,6,5,6,6,7,5,6,6,7,6,7,7,8

; A0 = candidate palette, A1 = source native RGB, A2 = output index.
; Return D0 = squared RGB error. Palette 14 flashes in the UI.
    q_subr nearest_inhabitant_colour
    movem.l d1-d7,-(sp)
    move.w #$7fff,d7
    moveq #1,d5
.candidate:
    cmp.w #pulse,d5
    beq.s .next
    move.w d5,d0
    add.w d0,d0
    move.w (a0,d0.w),d2
    move.w (a1),d1
    clr.w d3
    moveq #2,d4
.channel:
    move.w d1,d6
    and.w #15,d6
    move.w d2,d0
    and.w #15,d0
    sub.w d0,d6
    muls.w d6,d6
    add.w d6,d3
    lsr.w #4,d1
    lsr.w #4,d2
    dbra d4,.channel
    cmp.w d7,d3
    bhs.s .next
    move.w d3,d7
    move.w d5,(a2)
.next:
    addq.w #1,d5
    cmp.w #white,d5
    bls.s .candidate
    move.w d7,d0
    movem.l (sp)+,d1-d7
    rts

; Recolour indices 7..9 in one sixteen-pixel group, using original masks so
; a mapped pixel is never converted a second time. A4 points to three indices.
    q_subr remap_inhabitant_word
    movem.l d6-d7/a1-a2,-(sp)
    move.w (a0),d0
    move.w bpr(a0),d1
    move.w bpr*2(a0),d2
    move.w bpr*3(a0),d3
    move.w d3,d4
    not.w d4
    and.w d0,d4
    and.w d1,d4
    and.w d2,d4 ; index 7
    move.w d0,d5
    or.w d1,d5
    or.w d2,d5
    not.w d5
    and.w d3,d5 ; index 8
    move.w d1,d6
    or.w d2,d6
    not.w d6
    and.w d0,d6
    and.w d3,d6 ; index 9
    subq.l #6,sp
    move.w d4,(sp)
    move.w d5,2(sp)
    move.w d6,4(sp)
    move.l sp,a2
    move.l a4,a1
    moveq #2,d7
.shade:
    move.w (a2)+,d4
    move.w (a1)+,d5
    move.w d4,d6
    not.w d6
    and.w d6,d0
    and.w d6,d1
    and.w d6,d2
    and.w d6,d3
    btst #0,d5
    beq.s .p1
    or.w d4,d0
.p1:
    btst #1,d5
    beq.s .p2
    or.w d4,d1
.p2:
    btst #2,d5
    beq.s .p3
    or.w d4,d2
.p3:
    btst #3,d5
    beq.s .next
    or.w d4,d3
.next:
    dbra d7,.shade
    addq.l #6,sp
    move.w d0,(a0)
    move.w d1,bpr(a0)
    move.w d2,bpr*2(a0)
    move.w d3,bpr*3(a0)
    movem.l (sp)+,d6-d7/a1-a2
    rts


* ********************************************
* **										**
* ** PRINT_WORD - PRINT WORD OF DESCRIPTION **
* **										**
* ********************************************

* Prints a word of the inhabitants description, e.g. 'rodent'

* Entry: D0  = index into description table (0..7)
*		 A0  = ptr: description table
*		 ROW = current print row
* Exit:  ROW = ROW+8 (if anything printed)

* Regs: ?
* Subr: ?


	q_subr print_word

	jsr find_table ; find string
	tst.b (a0) ; null string ?
	q_ret eq ; yes, return
	jsr str_len ; centre string
	sub #max_desc,d0
	neg d0
	lsr #1,d0
	move row(a6),d1
	jsr locate
	jsr print_string ; print word
	add #8,row(a6) ; next row

	q_ret return


* ***************************************
* **								   **
* ** CHECK_DOCKED - CHECK FOR DOCKING  **
* **								   **
* ***************************************

* Action: Check if currently docked. if not, the computer beeps. clears the
*		  top address on the stack an returns.

* Entry:  None
* Exits:  None

* Regr:   ?
* Subr:   BEEP

	q_subr check_docked,global

	tst docked(a6) ; docked ?
	q_ret ne ; yes, return
	addq.l #4,sp ; clear stack
	q_sfx error ; beep error

	q_ret return




* **************************************************
* **											  **
* ** FUEL_DISTANCE - CALCULATE DISTANCE TO PLANET **
* **											  **
* **************************************************

* Computes distance from current planet system to required planet system.

* Entry: None
* Exits: D0 = distance

* Regr:   ?
* Subr:   Get_planet_info, Calc_distance

	q_subr fuel_distance,global

	tst witch_space(a6) ; Special which space check
; Quelo: 	if <eq> then.s
	bne.s q_pdata_m68_7
	move current(a6),d0 ; stack coordinates of current planet
	bsr get_planet_info
	q_push cplanet+xcoord(a6)
	q_push cplanet+ycoord(a6)
	bra q_pdata_m68_8
q_pdata_m68_7:
	q_push witch_x(a6) ; stack witch space coords
	q_push witch_y(a6)
q_pdata_m68_8:
	move req_planet(a6),d0 ; get coords of required planet
	bsr get_planet_info
	move cplanet+xcoord(a6),d0
	move cplanet+ycoord(a6),d1
	q_pop d3 ; fetch other planets coords
	q_pop d2
	sub d2,d0 ; calculate squared distance
	sub d3,d1
	muls d0,d0
	muls d1,d1
	add.l d1,d0
	jsr sqrt ; take square root
	move d2,d0 ; multiply result by 4
	asl #2,d0

	q_ret


* ****************************************
* **									**
* ** DRAW_PLANET - DRAW TEXTURED PLANET **
* **									**
* ****************************************

* Draws the textured planet on the planet data screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr draw_planet

    btst #f_planets,user+1(a6)
    beq.s .bitmap
    move.w #planet_x,d0
    move.w #planet_y,d1
    jsr draw_planet_portrait
    move.w d0,portrait_colours(a6)
    bra q_pdata_m68_10 ; keep the original diameter caption and arrows
.bitmap:
	move.l scr_base(a6),d0 ; expand texture screen into the
	move.l flip_screen(a6),d1 ; invisible screen
	eor.l d1,d0
	move.l d0,a1
	lea texture,a0
	jsr draw_screen
	jsr getrandx ; generate grab centre coords
	mulu #scr_width-2*planet_rad*zoom_x,d0
	swap d0
	add #planet_rad*zoom_x,d0
	move d0,circle_x(a6)
	mulu #(art_rows-2*planet_rad)*zoom_y,d1
	swap d1
	add #planet_rad*zoom_y,d1
	move d1,circle_y(a6)
	clr d0 ; x = 0
	move #planet_rad*zoom_y,d1 ; y = planet radius, in screen rows
	move #3-2*planet_rad*zoom_y,d2 ; d = 3-2*radius
q_pdata_m68_9:
	draw -,x,+,x,+,y ; draw horizontal lines
	draw -,y,+,y,+,x
	draw -,y,+,y,-,x
	draw -,x,+,x,-,y
	tst d2 ; d < 0 ?
; Quelo: 		if <mi> then.s					yes
	bpl.s q_pdata_m68_11
	move d0,d3 ; d = d + 4*x + 6
	asl #2,d3
	add d3,d2
	addq #6,d2
	bra.s q_pdata_m68_12
q_pdata_m68_11:
	move d0,d3 ; d = d + 4*(x - y) + 10
	sub d1,d3
	asl #2,d3
	add d3,d2
	add #10,d2
	q_dec d1 ; --y
q_pdata_m68_12:
	q_inc d0 ; ++x
	cmp d1,d0
	ble q_pdata_m68_9
q_pdata_m68_10:
	moveq #planet_x/8-4,d0 ; print radius
	moveq #planet_y+43,d1
	jsr locate
	moveq #orange,d0
	moveq #trans,d1
	jsr text_colour
	move cplanet+seed(a6),d0
	and #32767,d0
	add #15000,d0
	q_hclr d0
	clr d1
	jsr print_number
	lea text9(pc),a0 ; print 'km'
	jsr print_string
	moveq #bit_arrow_left,d0 ; print left arrow
	jsr find_bitmap
	move #planet_x-planet_rad,d0
	move #planet_y+43+1,d1
	jsr put_bitmap
	moveq #lgt_grey,d0
	jsr set_colour
	move #planet_x-planet_rad+3,d0
	move #planet_y+43+3,d1
	move #planet_x-planet_rad+7,d2
	move d1,d3
	jsr ui_line
	moveq #bit_arrow_right,d0 ; print right arrow
	jsr find_bitmap
	move #planet_x+planet_rad-2,d0
	move #planet_y+43+1,d1
	jsr put_bitmap
	move #planet_x+planet_rad-3,d0
	move #planet_y+43+3,d1
	move #planet_x+planet_rad-7,d2
	move d1,d3
	jsr ui_line

	q_ret


* *********************************************
* **										 **
* ** PLANET_LINE - DRAW A LINE OF THE PLANET **
* **										 **
* *********************************************

* Draws a horizontal line of the planet. NOTE - all coords passed to the
* routine are signed offsets from the centre of the grabbed circle.

* Entry: D4 = x coord of left edge
*		 D5 = x coord of right edge
*		 D6 = y coord of line
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr planet_line

	movem d0-d2,-(sp) ; save registers
	ifne circle_stretch
	add d4,d4 ; keep the planet round where a pixel is half as wide as tall
	add d5,d5
	endc
	movem d4-d6,xl(a6) ; store coordinates
	move xl(a6),d0 ; calculate screen address (real)
	move yc(a6),d1
	add #planet_x*zoom_x,d0
	add #planet_y*zoom_y,d1
	jsr dot_to_addr
	move.l a0,a1
	and #15,d0 ; calculate output bit #
	eor #15,d0
	move d0,d2
	move xl(a6),d0 ; calculate texture screen address
	move yc(a6),d1
	add circle_x(a6),d0
	add circle_y(a6),d1
	jsr dot_to_addr
	move.l a0,d1
	exg d0,d1
	jsr amiga_flip_address
	exg d0,d1
	move.l d1,a0
	and #15,d0 ; calculate input bit #
	eor #15,d0
	move xr(a6),d7 ; calculate width
	sub xl(a6),d7
	q_loop 1 ; loop for each pixel
	move #plane3,d6 ; last native OCS plane
q_pdata_m68_13:
	move (a0,d6),d1 ; fetch input data word
	move (a1,d6),d3 ; fetch output data word
	bclr d2,d3 ; clear current bit
	btst d0,d1 ; bit set ?
; Quelo: 			if <ne> then.s				yes
	beq.s q_pdata_m68_15
	bset d2,d3 ; set output data bit
q_pdata_m68_15:
	move d3,(a1,d6) ; store new bit
	sub #bpr,d6 ; next plane
	bpl q_pdata_m68_13
q_pdata_m68_14:
	q_dec d0 ; next pixel
; Quelo: 		if <mi> then.s
	bpl.s q_pdata_m68_17
	and #15,d0
	addq.l #2,a0
q_pdata_m68_17:
	q_dec d2
; Quelo: 		if <mi> then.s
	bpl.s q_pdata_m68_19
	and #15,d2
	addq.l #2,a1
q_pdata_m68_19:
	q_next 1 ; next pixel
	movem (sp)+,d0-d2 ; restore registers

	q_ret return


* ***********************************************
* **										   **
* ** MESSAGE - PRINT MESSAGE IN COMMAND WINDOW **
* **										   **
* ***********************************************

* Prints a string, waits a while and clears the command window.

* Entry: A0 = address of the string
* Exits: None

* Regr: ?
* Subr: ?

	q_subr message,global

	jsr print_string ; Print string
	move #2*50,d0 ; Wait a while
	jsr wait
	jmp clear_input ; clear command window

* ---- LOCAL DATA ----

* Planet data mouse action table.

data_action_table:

	include "icons.m68"
	dc.w -1
	dc.l 0

* Options for the different creatures.

heads:

	dc 1,bit_h_slimy
	dc 1,bit_h_bug_eyed
	dc 1,bit_h_horned
	dc 1,bit_h_boney
	dc 1,bit_h_fat
	dc 1,bit_h_furry
	dc 1,bit_h_mutant
	dc 1,bit_h_weird

bodies:

	dc 1,bit_b_rodent
	dc 1,bit_b_frog
	dc 1,bit_b_lizard
	dc 1,bit_b_lobster
	dc 1,bit_b_bird
	dc 3,bit_b_humanoid
	dc 1,bit_b_feline
	dc 1,bit_b_insect

* Inhabitant colour palettes.

inhab_palette:

	dc lgt_green*2 ; colours to change
	dc mid_green*2
	dc drk_green*2
	dc $350,$470,$230 ; green
	dc $510,$621,$210 ; red
	dc $660,$440,$220 ; yellow
	dc $146,$356,$016 ; blue
	dc $666,$444,$222 ; white
	dc $524,$534,$505 ; pyscho #1
	dc $211,$431,$221 ; pyscho #2
	dc $350,$470,$230 ; another green

