; Display geometry, shared by the game and the object data. A pixel row holds
; scr_planes bitplane rows of bpr bytes; the bitplane modulo skips the rest.
; Coordinates are authored in a logical 320 x 200 space, and zoom_x and zoom_y
; carry that space to the physical screen.

	ifnd display_ntsc
display_ntsc: equ 0 ; build option: 1 = 60 Hz row count
	endc
	ifnd display_hires
display_hires: equ 0 ; build option: 1 = 640 pixels across, MC68020 or better
	endc
	ifnd display_lace
display_lace: equ 0 ; build option: 1 = interlaced, twice the rows
	endc
	ifnd display_double
display_double: equ 0 ; build option: 1 = DblPAL, twice the rows without interlace, AGA
	endc
	ifnd frame
frame: equ 0 ; build option: 1 = keep the cockpit frame and its 256 x 112 window
	endc

zoom_x: equ 1+display_hires ; physical pixels per logical pixel
; super-hires has twice the pixels per colour clock of hires
display_shres: equ display_double
px_per_clock: equ 2<<(display_hires+display_shres)
display_tall: equ display_lace+display_double ; 1 where a logical row covers two physical rows
zoom_y: equ 1+display_tall
art_cols: equ 40 ; logical 8x8 columns in a DEGAS Elite screen asset
art_rows: equ 200 ; logical rows in a DEGAS Elite screen asset
degas_bpr: equ art_cols*8/8 ; the asset's own bitplane row, never scaled
degas_bytes: equ degas_bpr*4*art_rows ; the asset's own decoded size

bpr: equ degas_bpr*zoom_x ; bytes per bitplane row
scr_planes: equ 4 ; bitplanes
scr_width: equ bpr<<3 ; width in pixels
plane1: equ bpr ; plane offsets within a pixel row
plane2: equ bpr*2
plane3: equ bpr*3
row_stride: equ bpr*scr_planes ; bytes per pixel row
long_fill_min: equ 6 ; span words from which HORIZ_LINE fills in longs
; The shadow crosses sixteen bytes at a time, one MOVEM's worth, and each such
; piece is compared and sent on its own. It must divide the row.
copy_block: equ 16
row_blocks: equ row_stride/copy_block ; pieces in one viewport row
	ifne row_stride-row_blocks*copy_block
	fail "copy_block does not divide row_stride; the shadow would lose the right edge"
	endc
; Three viewports' worth: the one being drawn, and one for each Chip buffer
; holding exactly what that buffer shows. Once a frame has crossed, the one it
; was drawn in is what its buffer shows, so the three trade places instead of
; being copied. Then, for each buffer, one byte a row its viewport shows empty.
shadow_maps_bytes: equ view_bytes*3+y_size*2
	ifne row_stride&31
	fail "the transfer tests an empty row eight longs at a time"
	endc
art_bytes: equ row_stride*art_rows*zoom_y ; an asset expanded to screen scale
bitmap_bytes: equ 125*4+124*4+13567*10*zoom_x*zoom_y ; table + stored headers + masked pixels; no PNG Cobra
	ifne display_ntsc+frame
scr_rows: equ art_rows*zoom_y ; 60 Hz row count, or as many rows as the frame has
	endc
	ifeq display_ntsc+frame
scr_rows: equ 256*zoom_y ; 50 Hz visible rows
	endc
scr_bytes: equ row_stride*scr_rows ; bytes per screen
panel_rows: equ 80*zoom_y ; instrument panel rows at the bottom of COCKPIT.PC1
y_shift: equ scr_rows-art_rows*zoom_y ; panel offset below the 200-row layout
panel_shift: equ y_shift/zoom_y ; the same offset in logical rows
char_w: equ 8*zoom_x ; physical size of one text cell
char_shift: equ 3+display_hires ; log2(char_w)
char_h: equ 8*zoom_y
; colour, planes, hires or super-hires, lace
bplcon0_on: equ $0200|(scr_planes<<12)|((display_hires-display_shres)<<15)|(display_shres<<6)|(display_lace<<2)
fmode_on: equ display_shres ; FMODE bit 0, BPL32
; programmed beam: DblPAL.monitor, edges from monitorstuff.h's ECS branch
beam_prog: equ display_double
	ifne beam_prog
beamcon0_on: equ $1b88
beam_htotal: equ $79+8 ; DblPAL.monitor on AA: Alice pushes the picture 8 clocks
beam_vtotal: equ $23d
beam_minrow: equ $17
beam_hbstrt: equ 1 ; blanking and sync edges
beam_hbstop: equ 30
beam_hsstrt: equ 10
beam_hsstop: equ 19
beam_vbstrt: equ 0
beam_vbstop: equ beam_minrow
beam_vsstrt: equ beam_minrow/3
beam_vsstop: equ beam_minrow/3*2
	endc
; display window and data fetch
	ifne beam_prog
; DblPAL.monitor's default view position on AA: VPMINX plus half of VPRANGEX.
diw_fetch1: equ $28 ; FETCH1 with BUG_ALICE_LHS_PROG
diw_hstart: equ (diw_fetch1<<1)+1+((((beam_htotal+1)-diw_fetch1)<<3)-scr_width)/8
diw_skew: equ 1 ; 35 ns pixels the picture shows late, and the window closes late
	endc
	ifeq beam_prog
diw_hstart: equ $81
diw_skew: equ 0
	endc
diw_hstop: equ diw_hstart+scr_width*2/px_per_clock ; the window counts lores pixels
; fetch the visible clocks, rounded down to the fetch granularity
ddf_clocks: equ scr_width/px_per_clock
ddf_grain: equ 8/zoom_x
ddfstrt: equ ((diw_hstart-17+8*display_hires)/2)/ddf_grain*ddf_grain
ddfstop: equ ddfstrt+ddf_clocks-8
; BPLCON1 delays both playfields by the clocks the rounding fetched early.
ddf_early: equ (diw_hstart-17+8*display_hires)/2-ddfstrt
ddf_delay: equ ddf_early*8+diw_skew ; in 35 ns pixels
bplcon1_on: equ (((ddf_delay>>2)&15)*$11)|((ddf_delay&3)*$1100)
; an interlaced field shows half the rows
	ifne beam_prog
diw_vstart: equ beam_minrow+(beam_vtotal-beam_minrow-scr_rows)/2 ; centred below the blank
	endc
	ifeq beam_prog
diw_vstart: equ 44
	endc
diw_fields: equ 1+display_lace
diw_vstop_rows: equ diw_vstart+scr_rows/diw_fields
diw_vstop_art: equ diw_vstart+art_rows*zoom_y/diw_fields
diwstrt: equ (diw_vstart<<8)|(diw_hstart&255)
diwstop_rows: equ ((diw_vstop_rows&255)<<8)|(diw_hstop&255)
diwstop_art: equ ((diw_vstop_art&255)<<8)|(diw_hstop&255)
; DIWHIGH: the high bits, of DIWSTRT too once written
diwhigh_rows: equ ((diw_vstop_rows>>8)<<8)|((diw_hstop>>8)<<13)|(diw_vstart>>8)|((diw_hstart>>8)<<5)|(diw_skew<<11)
; the Copper waits here for the plane pointers only
	ifne beam_prog
copper_wait: equ ((diw_vstart-4)<<8)|1
	endc
	ifeq beam_prog
copper_wait: equ $2001 ; where PAL and NTSC have always waited
	endc
diwhigh_art: equ ((diw_vstop_art>>8)<<8)|((diw_hstop>>8)<<13)|(diw_vstart>>8)|((diw_hstart>>8)<<5)|(diw_skew<<11)


; Dimensions of cockpit.

	ifne frame
y_top: equ 8*zoom_y ; y coordinate of top edge, clear of the view indicator
no_cols: equ 32 ; columns across the window the frame leaves
no_rows: equ 14 ; rows down it
	endc
	ifeq frame
y_top: equ 0 ; the flight view reaches the top and carries its own name
no_cols: equ art_cols ; text columns across the flight view
no_rows: equ (scr_rows-panel_rows-y_top)/char_h ; text rows down it
	endc
x_size: equ no_cols*char_w ; width in pixels
; The credit scroller keeps one character per byte of each plane, so a hires
; cell fills a whole word instead of half of one.
scroll_words: equ no_cols*zoom_x/2 ; words it writes across the view
scroll_stride: equ (no_cols*zoom_x+2)*4 ; bytes one pixel line takes in it
y_size: equ no_rows*char_h ; depth in pixels
x_min: equ -(x_size>>1) ; inclusive bounds cover every viewport column
x_max: equ (x_size>>1)-1
y_min: equ -(y_size>>1)
y_max: equ (y_size>>1)-1
x_left: equ (scr_width-x_size)>>1 ; x coordinate of left edge
; lines per field and a line in 1/1024 ms; a colour clock is 0.2794 us
	ifne beam_prog
field_lines: equ beam_vtotal+1
line_scale: equ ((beam_htotal+1)*2861+5000)/10000
	endc
	ifeq beam_prog
field_lines: equ 262+51*(1-display_ntsc)
line_scale: equ 66-display_ntsc
	endc
view_bytes: equ y_size*row_stride ; the viewport, one flat run when frameless
clear_bursts: equ view_bytes/16 ; sixteen bytes to a MOVE16
	ifeq (scr_width-x_size)+(view_bytes&15)
clear_burst_ok: equ 1 ; whole rows, and a whole number of MOVE16 lines
	else
clear_burst_ok: equ 0
	endc
; One blitter fill covers the viewport. A frameless viewport is one flat run,
; so 64-word rows and no modulo; an inset one is a plane run per blit row and
; the plane spacing carries the modulo from plane to plane and row to row.
	ifeq scr_width-x_size
blit_words: equ 0 ; the width field takes 64 words as zero
blit_rows: equ view_bytes/128
blit_mod: equ 0
	ifeq (view_bytes&127)+blit_rows/1025 ; the division is a range check: 0 up to 1024
blit_fits: equ 1 ; whole 64-word rows, and the height fits BLTSIZE
	else
blit_fits: equ 0
	endc
	else
blit_words: equ x_size/16
blit_rows: equ y_size*scr_planes
blit_mod: equ bpr-x_size/8
	ifeq (x_size&15)+blit_rows/1025+blit_words/65 ; the divisions are range checks
blit_fits: equ 1 ; whole words across, and both BLTSIZE fields in range
	else
blit_fits: equ 0
	endc
	endc
no_dust: equ 15*(x_size/zoom_x)*(y_size/zoom_y)/(256*112) ; 15 in a 256x112 view
arm_entries: equ scr_rows+4 ; SOLID_POLYGON indexes its arms by physical screen row
proj_shift_x: equ 9+display_hires ; projection scale, a wider screen needs more
proj_shift_y: equ 9+display_tall ; likewise a taller one
circle_stretch: equ zoom_x/zoom_y-1 ; 1 where a pixel is half as wide as tall
dither_bit: equ display_tall ; row bit that picks the dither phase
view_x_min: equ x_min/zoom_x ; the viewport in logical units
view_x_max: equ x_max/zoom_x
view_y_min: equ y_min/zoom_y
view_y_max: equ y_max/zoom_y
view_x_size: equ x_size/zoom_x
view_y_size: equ y_size/zoom_y

; Scenery modelled to fill a 256 x 112 window, scaled to the viewport in use.
view_num_x: equ x_max+1 ; half the viewport, in physical pixels
view_den_x: equ 128<<(proj_shift_x-9) ; half the 256 x 112 window, at this scale
view_num_y: equ y_max+1
view_den_y: equ 56<<(proj_shift_y-9)

; Docking bay cross section. Its walls reach z = 400, where tunnel_scale 1
; covers the view and 2 covers it from z = 800 onwards.
	ifne frame
tunnel_scale: equ 1 ; the window the bay was modelled for
	endc
	ifeq frame
tunnel_scale: equ 2
	endc
tunnel_x: equ tunnel_scale*100*view_num_x/view_den_x
tunnel_y: equ tunnel_scale*45*view_num_y/view_den_y
; The docking doors are as tall as half the tunnel, so the pair fills it,
; and each clears the view after travelling its own height again.
dock_door_open: equ tunnel_scale*95*view_num_y/view_den_y
bay_door_open: equ tunnel_scale*90*view_num_y/view_den_y

; Hangar and bay walls, which end 1600 units ahead of the viewer. The top
; overshoots the view, as the ship sits low in the bay.
hangar_x: equ (400*view_num_x+view_den_x-1)/view_den_x
hangar_top: equ (275*view_num_y+view_den_y-1)/view_den_y
hangar_bottom: equ (175*view_num_y+view_den_y-1)/view_den_y
hangar_ship_x: equ 200*view_num_x/view_den_x ; parked ships
hangar_ship_y: equ 80*view_num_y/view_den_y
bay_shift: equ -85 ; the docking bay hangs below the axis
