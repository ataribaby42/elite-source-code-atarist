	q_inc d2
q_bios_m68_83:
	bra q_bios_m68_82
q_bios_m68_81:
; Quelo: 			if d0 <hs> d5 then.s		check for valid character
	cmp d5,d0
	blo q_bios_m68_85
; Quelo: 				if d0 <ls> d6 then.s
	cmp d6,d0
	bhi q_bios_m68_87
	tst d2 ; buffer full ?
; Quelo: 					if <ne> then.s		no
