	cmp #13,d0
	bne q_bios_m68_79
	clr.b (a4) ; terminate buffer
	bra q_bios_m68_78
q_bios_m68_79:
	cmp #27,d0 ; ESC ?
	beq q_bios_m68_78
	bsr hide_cursor
; Quelo: 		if d0 <eq> #127 then.s			if delete
	cmp #127,d0
	bne q_bios_m68_81
	tst d4 ; buffer empty ?
; Quelo: 			if <ne> then.s				no
	beq q_bios_m68_83
