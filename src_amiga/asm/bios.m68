	move.b (a0)+,d0 ; get next character
	beq q_bios_m68_94
	mulu #10,d1 ; multiply number by 10
	sub.b #'0',d0 ; add digit
	ext d0
	add d0,d1
	bra q_bios_m68_93
q_bios_m68_94:
	moveq #-1,d0 ; number is ok

	q_ret


* **********************************
* **							  **
* ** YES_NO - ASK YES/NO QUESTION **
* **							  **
* **********************************

* Waits for the user to either press the 'Y' or 'N' key.

* Entry: A0 = prompt
* Exit:  D0 = key pressed

