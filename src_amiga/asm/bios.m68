char_colour_masks:

	dc.b $00,$00,$00,$00 ; ;0
	dc.b $ff,$00,$00,$00 ; ;1
	dc.b $00,$ff,$00,$00 ; ;2
	dc.b $ff,$ff,$00,$00 ; ;3
	dc.b $00,$00,$ff,$00 ; ;4
	dc.b $ff,$00,$ff,$00 ; ;5
	dc.b $00,$ff,$ff,$00 ; ;6
	dc.b $ff,$ff,$ff,$00 ; ;7
	dc.b $00,$00,$00,$ff ; ;8
	dc.b $ff,$00,$00,$ff ; ;9
	dc.b $00,$ff,$00,$ff ; ;A
	dc.b $ff,$ff,$00,$ff ; ;B
	dc.b $00,$00,$ff,$ff ; ;C
	dc.b $ff,$00,$ff,$ff ; ;D
	dc.b $00,$ff,$ff,$ff ; ;E
	dc.b $ff,$ff,$ff,$ff ; ;F

* Icon coords at the bottom of the text screens.

icon_coords:

	dc 36,174,73,180 ; launch
	dc 77,174,97,180 ; buy_cargo
	dc 101,174,127,180 ; sell_cargo
	dc 131,174,163,180 ; equip_ship
	dc 167,174,205,180 ; galactic_chart
	dc 209,174,240,180 ; local_chart
	dc 244,174,282,180 ; data
	dc 19,183,57,189 ; market_prices
	dc 61,183,116,189 ; inventory
	dc 120,183,158,189 ; status
	dc 162,183,188,189 ; disk
	dc 192,183,218,189 ; find
	dc 222,183,248,189 ; home_cursor
	dc 252,183,296,189 ; options

* Cursor action table for keypad.

keypad_table:

	q_action 0,0,0,0,'7',-1,0
	q_action 0,0,0,0,'8',-1,0
	q_action 0,0,0,0,'9',-1,0
	q_action 0,0,0,0,'4',-1,0
	q_action 0,0,0,0,'5',-1,0
	q_action 0,0,0,0,'6',-1,0
	q_action 0,0,0,0,'1',-1,0
	q_action 0,0,0,0,'2',-1,0
	q_action 0,0,0,0,'3',-1,0
	q_action 0,0,0,0,'0',-1,0
	q_action 0,0,0,0,127,-1,0
	q_action 0,0,0,0,13,-1,0
	q_action 0,0,0,0,0,-1,0
	dc.w -1
	dc.l escape_input

* Table of offsets of each key.

keypad_offsets:

	dc 7,7,24,7,41,7,7,23,24,23,41,23,7,39,24,39,41,39,7,55,24,55,41,55

* Error box action table.

error_table:

	q_action error_x+96,error_y+35,error_x+120,error_y+52,0,0,0
	dc.w -1
	dc.l 0

* Confirm box action table.

confirm_table:

	q_action confirm_x+11,confirm_y+15,confirm_x+41,confirm_y+29,-1,0,0
	q_action confirm_x+76,confirm_y+15,confirm_x+98,confirm_y+29,0,0,0
	dc.w -1
	dc.l 0

* Full size screen mouse table.

full_screen:

	q_action 0,0,319,199,0,0,0
	dc.w -1
	dc.l 0

* Box details - maximum column and row #

box_details:

	dc 27,9*8,27,10*8,27,11*8,24,12*8,24,13*8,24,14*8

* Text messages.

text1: dc.b c_backspace,32,c_backspace,0
text2: dc.b '? ',0
text3: dc.b c_cursor,4,prompt_y,c_colour,white,trans,0
text4: dc.b ' ? ',0
