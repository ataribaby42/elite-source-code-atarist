	bsr save_cursor ; save cursor state
	lea full_screen(pc),a0 ; initialise cursor for full screen
	bsr init_cursor
q_bios_m68_71:
	tst button_pressed(a6) ; mouse button pressed ?
; Quelo: 		if <ne> then.s					yes
	beq q_bios_m68_73
	clr button_pressed(a6) ; clear flag
	clr d0 ; key value = 0
	bra q_bios_m68_72
