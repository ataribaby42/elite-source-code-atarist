	include "common.def"
; Ported from src_orig/asm/cargo.m68; edit this copy.
*	@@@@	 @@   @@@@@@	@@@@	@@@
*  @@  @@	@@@@   @@  @@  @@  @@  @@ @@
* @@	   @@  @@  @@  @@ @@	  @@   @@
* @@	   @@  @@  @@@@@  @@	  @@   @@
* @@	   @@@@@@  @@ @@  @@  @@@ @@   @@
*  @@  @@  @@  @@  @@  @@  @@  @@  @@ @@
*	@@@@   @@  @@ @@@  @@	@@@@@	@@@

* Routines for the buying and selling of cargo. NOTE - includes the ICONS.M68
* file into the action table (bottom of file).

* Version 1.0 14th July 1988 Copyright (c) 1988 Mr. Micro Ltd.
* Designed and coded by Rob Nicholson.

	include "macros.m68"
	include "bitlist.m68"

	xref invert_icon,prepare_text,print_centre,text_colour,find_bitmap,locate
	xref put_bitmap,print_number,block,init_cursor,error_box,print_table,tab
	xref clear_input,hide_cursor,print_string,print_char,restore_cursor,ui_line
	xref input_number,product_list,find_table,str_copy,str_cat,build_number
	xref str_len,set_colour,launch,divide_by_1e5,equip_ship,galactic_chart
	xref local_chart,data,status,disk,find_planet,home_cursor,options
	xref check_docked,build_name,disp_message
	xref alloc_object,create_object,open_jettison_confirm,poll_jettison_confirm,fx
	xref random,fix_unit,calc_yvector

* ---- LOCAL CONSTANTS ----

cargo_x: equ 16 ; coords of 1st cargo icon
cargo_y: equ 20
info_y: equ 162 ; y coord of info line
rip_off: equ 19 ; sell rip-off factor
key_left_x: equ 48 ; coords of key pad
key_right_x: equ 208
key_top_y: equ 60

* ---- LOCAL VARIABLES ----

	q_vars cargo

this_cargo: rs.w 1 ; current cargo item #
xc1: rs.w 1 ; coords of highlight box
yc1: rs.w 1
xc2: rs.w 1
yc2: rs.w 1
selected: rs.w 1 ; flag: cargo item selected
max_cargo: rs.w 1 ; maximum cargo item to be sold
cargo_items: rs.b max_products ; commodity behind each displayed icon

	q_end_vars cargo

* ---- LOCAL MACROS ----

* draw_line x1,y1,x2,y2 - draw line between coords

draw_line macro

	move \1(a6),d0
	move \2(a6),d1
	move \3(a6),d2
	move \4(a6),d3
	jsr ui_line

	endm

	q_module cargo


* *****************************************
* **									 **
* ** BUY_CARGO - SELECT BUG CARGO SCREEN **
* **									 **
* *****************************************

* Mouse entry routine for buy cargo screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr buy_cargo,global

	jsr check_docked ; check we're docked
	moveq #icon_buy,d0 ; invert icon
	jsr invert_icon
	jsr prepare_text ; prepare text screen
	lea text9(pc),a0 ; print 'Buy Cargo'
	moveq #title_y,d1
	jsr print_centre
	bsr draw_icons ; draw cargo items
	clr selected(a6) ; nothing selected
	bsr print_buy_info ; print buy info line
	lea buy_cargo_action(pc),a0 ; initialise mouse cursor
	jsr init_cursor

	q_ret


* *******************************************
* **									   **
* ** MARKET_PRICES - DISPLAY MARKET PRICES **
* **									   **
* *******************************************

* Displays the market prices screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr market_prices,global

	moveq #icon_prices,d0 ; invert icon
	jsr invert_icon
	jsr prepare_text ; prepare text screen
	move current(a6),d0 ; find name of current planet
	jsr build_name
	lea planet_name(a6),a0 ; build 'xxx Market Prices'
	lea pad(a6),a1
	jsr str_copy
	lea pad(a6),a0
	lea text19(pc),a1
	jsr str_cat
	lea pad(a6),a0 ; print heading
	moveq #title_y,d1
	jsr print_centre
	bsr draw_icons ; draw cargo items
	clr selected(a6) ; nothing selected
	lea prices_action_table(pc),a0 ; initialise mouse cursor
	jsr init_cursor

	q_ret


* ***********************************
* **							   **
* ** DRAW_ICONS - DRAW CARGO ICONS **
* **							   **
* ***********************************

* Draws all the cargo icons for the buy/market prices screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr draw_icons

	moveq #orange,d0 ; set colour of price
	moveq #black,d1
	jsr text_colour
	clr this_cargo(a6) ; start with item #0
q_cargo_m68_1:
	move this_cargo(a6),d0 ; find bit map
	add #bit_cargo,d0
	jsr find_bitmap
	bsr icon_coords ; fetch icon coords
	bsr put_bitmap ; put bit map on screen
	bsr icon_coords ; locate cursor for price
	lsr #3,d0
	add #4*8,d1
	jsr locate
	bsr find_buy ; find product record
	move price(a5),d0 ; print price
	asl #2,d0
	ext.l d0
	move #$8085,d1
	jsr print_number
	move quantity(a5),d4 ; any available ?
; Quelo: 		if <ne> then.s					yes
	beq.s q_cargo_m68_3
	mulu #31,d4 ; calculate height of the bar
	divu #63,d4
	q_inc d4
	bsr icon_coords ; calculate position of the bar
	add #5*8,d0
	add #32,d1
	sub d4,d1
	clr d2 ; draw the bar
	moveq #3,d3
	moveq #pulse,d5
	jsr block
q_cargo_m68_3:
	q_inc this_cargo(a6) ; next item of cargo
	cmp #18,this_cargo(a6)
	bne q_cargo_m68_1
q_cargo_m68_2:

	q_ret return


* *******************************************
* **									   **
* ** SELL_CARGO - SELECT SELL CARGO SCREEN **
* **									   **
* *******************************************

* Entry point for sell cargo screen.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr sell_cargo,global

	jsr check_docked ; only when docked
	moveq #icon_sell,d0 ; invert icon
	jsr invert_icon
	lea hold(a6),a0 ; any cargo to sell ?
	moveq #0,d0
	q_loop 1,max_products
	or.l (a0)+,d0
	q_next 1
; Quelo: 	if <eq> then.s						no
	bne.s q_cargo_m68_5
	lea text14(pc),a0 ; print error message
	jsr error_box
	moveq #-1,d0 ; restore icon and exit
	jmp invert_icon
q_cargo_m68_5:
	jsr prepare_text ; prepare text screen
	lea text13(pc),a0 ; print 'Sell Cargo'
	moveq #title_y,d1
	jsr print_centre
	bsr draw_cargo ; draw cargo screen
	lea sell_cargo_action(pc),a0 ; initialise mouse cursor
	jsr init_cursor

	q_ret


* *******************************************
* **									   **
* ** INVENTORY - DISPLAY INVENTORY OF HOLD **
* **									   **
* *******************************************

* Display inventory of cargo hold.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr inventory,global

	tst cockpit_on(a6) ; cockpit displayed ?
; Quelo: 	if <eq> then.s						no
	bne.s q_cargo_m68_7
	moveq #icon_inventory,d0 ; invert icon
	jsr invert_icon
q_cargo_m68_7:
	lea hold(a6),a0 ; any cargo in hold ?
	moveq #0,d0
	q_loop 1,max_products
	or.l (a0)+,d0
	q_next 1
; Quelo: 	if <eq> then.s						no
	bne.s q_cargo_m68_9
	tst cockpit_on(a6) ; cockpit displayed ?
; Quelo: 		if <eq> then.s					no
	bne.s q_cargo_m68_11
	lea text20(pc),a0 ; print error message
	jsr error_box
	moveq #-1,d0 ; restore icon
	jmp invert_icon
q_cargo_m68_11:
	lea text20(pc),a0 ; display message in cockpit
	jmp disp_message ; (and return)
q_cargo_m68_9:

	q_subr refresh_inventory
	jsr prepare_text ; prepare text screen
	lea text21(pc),a0 ; print 'Inventory'
	moveq #title_y,d1
	jsr print_centre
	bsr draw_cargo ; draw cargo screen
	lea inventory_action_table(pc),a0 ; initialise mouse cursor
	jsr init_cursor

	q_ret


* *******************************************
* **									   **
* ** DRAW_CARGO - DRAW ITEMS IN CARGO HOLD **
* **									   **
* *******************************************

* Draws all the items in the cargo hold.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr draw_cargo

	bsr print_buy_info ; print buy info line
	moveq #orange,d0 ; print in orange
	moveq #trans,d1
	jsr text_colour
	clr this_cargo(a6) ; start at top left
	lea hold(a6),a5 ; scan through cargo hold
	q_loop 1,max_products
	tst.l (a5) ; carrying this item ?
; Quelo: 		if <ne> then.s					yes
	beq q_cargo_m68_13
	q_push.w d7 ; draw cargo icon
	q_push.l a5
	moveq #max_products-1,d0
	sub d7,d0
	lea cargo_items(a6),a0
	move this_cargo(a6),d1
	move.b d0,(a0,d1) ; remember the displayed commodity if cargo is lost in combat
	q_push d0
	add #bit_cargo,d0
	jsr find_bitmap
	bsr icon_coords
	jsr put_bitmap
	cmp #18,(sp)+ ; refugees or documents ?
; Quelo: 			if <lo> then.s				no
	bhs.s q_cargo_m68_15
	bsr icon_coords ; position cursor for quantity
	lsr #3,d0
	q_inc d0
	add #4*8,d1
	jsr locate
	move.l (sp),a5 ; fetch quantity
	move.l (a5),d0
	moveq #2,d1 ; divide down to < 1000
q_cargo_m68_17:
	cmp.l #1000,d0
	blo q_cargo_m68_18
	divu #1000,d0
	q_hclr d0
	q_dec d1
	bra q_cargo_m68_17
q_cargo_m68_18:
	q_push d1 ; print quantity
	clr d1
	jsr print_number
	q_pop d0 ; print units
	lea units_table(pc),a0
	jsr print_table
q_cargo_m68_15:
	q_pop.l a5 ; next item
	q_inc this_cargo(a6)
	q_pop d7
q_cargo_m68_13:
	addq.l #4,a5 ; next item of cargo
	q_next 1
	move this_cargo(a6),max_cargo(a6) ; save maximum cargo #
; Quelo: 	if <eq> then.s						no cargo
	bne.s q_cargo_m68_19
	lea text17(pc),a0 ; print "Cargo Hold Is Empty"
	moveq #10*8,d1
	jsr print_centre
q_cargo_m68_19:
	clr selected(a6) ; nothing selected

	rts ; return


* *************************************************
* **											 **
* ** ICON_COORDS - RETURN COORDS OF CURRENT ICON **
* **											 **
* *************************************************

* Returns the x and y coords of the current cargo icon.

* Entry: THIS_CARGO = current cargo item #
* Exit:  (D0,D1)	= screen coords

* Regs: ?
* Subr: ?

	q_subr icon_coords

	move this_cargo(a6),d1 ; index into coords table
	asl #2,d1
	lea cargo_coords(pc),a1
	move 0(a1,d1),d0 ; fetch x coord
	move 2(a1,d1),d1 ; fetch y coord

	q_ret return


* *********************************
* **							 **
* ** CLICK_BUY - SELECT BUY ICON **
* **							 **
* *********************************

* This routine is called everytime the buy icon is clicked (single or double)

	q_subr buy_icon

	moveq #icon_buy,d0 ; invert icon
	jsr invert_icon
	tst selected(a6) ; cargo selected ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_21
	move this_cargo(a6),d0 ; buy it
	bsr d_buy
q_cargo_m68_21:

	q_ret


* ***********************************
* **							   **
* ** CLICK_SELL - SELECT SELL ICON **
* **							   **
* ***********************************

* This routine is called everytime the sell icon is clicked (single/double).
* buy cargo screen

	q_subr sell_icon

	moveq #icon_sell,d0 ; invert icon
	jsr invert_icon
	tst selected(a6) ; cargo selected ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_23
	move this_cargo(a6),d0 ; buy it
	bsr d_sell
q_cargo_m68_23:

	q_ret


* **********************************************
* **										  **
* ** S_BUY - CLICK ON BUY CARGO ICON (SINGLE) **
* **										  **
* **********************************************

* Action routine for single click on cargo item on the buy screen. If the buy
* icon has been selected, then an attempt is made to buy the item using the
* double click routine. If the icon isn't selected, then information about
* the cargo item is displayed.

* Entry: D0 = cargo item #
* Exit:  None

* Regs:  ?
* Subr:  ?

	q_subr s_buy

	tst icon_inverted(a6) ; buy item ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_25
	bsr d_buy ; attempt to buy it
	bra.s q_cargo_m68_26
q_cargo_m68_25:
	bsr display_buy ; display information for buy
q_cargo_m68_26:

	q_ret return


* **********************************************
* **										  **
* ** D_BUY - CLICK ON BUY CARGO ITEM (DOUBLE) **
* **										  **
* **********************************************

* Action routine for double click on cargo item on buy screen. Attempts to
* buy the selected cargo item.

* Entry: THIS_CARGO = cargo item #
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr d_buy

	bsr draw_highlight ; draw highlight around cargo item

buy_again:

	bsr find_buy ; find product record
	tst quantity(a5) ; any available ?
; Quelo: 	if <eq> then.s						no
	bne.s q_cargo_m68_27
	lea text4(pc),a0 ; print error message
	jsr error_box
	bra no_select ; remove selection
q_cargo_m68_27:
	jsr clear_input ; clear input line
	jsr hide_cursor ; print prompt
	lea text5(pc),a0
	jsr print_string
	move quantity(a5),d0
	clr d1
	jsr print_number
	move units(a5),d0
	lea units_table(pc),a0
	jsr print_table
	move.b #')',d0
	jsr print_char
	jsr restore_cursor
	bsr icon_coords ; decide where to put the keypad
; Quelo: 	if d0 <lo> #160 then.s
	cmp #160,d0
	bhs.s q_cargo_m68_29
	move #key_right_x,d3
	bra.s q_cargo_m68_30
q_cargo_m68_29:
	move #key_left_x,d3
q_cargo_m68_30:
	moveq #key_top_y,d4 ; input amount to buy
	jsr input_number
	cmp #27,d0 ; ESC pressed ?
	beq no_select ; yes, clear selection and exit
	tst d0 ; just return pressed ?
	beq no_select ; yes, clear selection and exit
	tst d1 ; zero type ?
	beq no_select ; yes, clear selection and exit
; Quelo: 	if d1 <hi> quantity(a5) then.s		not enough goods
	cmp quantity(a5),d1
	bls.s q_cargo_m68_31
	lea text6(pc),a0 ; print message
	jsr error_box
	bra buy_again
q_cargo_m68_31:
	move price(a5),d0 ; fetch price and multiply by the
	asl #2,d0 ; number wanted
	mulu d1,d0
	move.l cash(a6),d2 ; subtract from cash
	sub.l d0,d2
; Quelo: 	if <cs> then.s						not enough money
	bcc.s q_cargo_m68_33
	lea text7(pc),a0 ; print message
	jsr error_box
	bra buy_again
q_cargo_m68_33:
	bsr cargo_spare ; calculate free cargo space
	move units(a5),d0 ; determine size of each unit
	bsr get_unit
	bsr reduce_hold ; enough room in cargo hold ?
	tst.l d3
; Quelo: 	if <mi> then.s						no
	bpl.s q_cargo_m68_35
	lea text8(pc),a0 ; No room in the inn
	jsr error_box
	bra buy_again
q_cargo_m68_35:
	move.l d2,cash(a6) ; update cash left
	move this_cargo(a6),d0 ; add to cargo hold
	asl #2,d0
	lea hold(a6),a0
	move d1,d7
	q_dec d7
	q_loop 1
	add.l d4,(a0,d0)
	q_next 1
	sub d1,quantity(a5) ; remove from planet array
	bsr illegal ; check for illegal goods
	bsr icon_coords ; erase the bar
	add #5*8,d0
	clr d2
	moveq #3,d3
	moveq #32,d4
	moveq #black,d5
	jsr block
	move quantity(a5),d4 ; any available ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_37
	mulu #31,d4 ; calculate height of the bar
	divu #63,d4
	q_inc d4
	bsr icon_coords ; calculate position of the bar
	add #5*8,d0
	add #32,d1
	sub d4,d1
	clr d2 ; draw the bar
	move #3,d3
	move #pulse,d5
	jsr block
q_cargo_m68_37:
	bsr print_buy_info ; print cash and cargo hold
	bra no_select ; clear selection


* ************************************************
* **											**
* ** S_SELL - CLICK ON SELL CARGO ICON (SINGLE) **
* **											**
* ************************************************

* Action routine for single click on cargo item on the sell screen.

* Entry: D0 = position on screen
* Exit:  None

* Regs:  ?
* Subr:  ?

	q_subr s_sell

	cmp max_cargo(a6),d0 ; icon not used ?
	bhs no_select ; yes, just de-select
	tst icon_inverted(a6) ; buy item ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_39
	bsr d_sell ; sell it
	bra.s q_cargo_m68_40
q_cargo_m68_39:
	bsr display_sell ; display information for buy
q_cargo_m68_40:

	q_ret return


* ************************************************
* **											**
* ** D_SELL - CLICK ON SELL CARGO ITEM (DOUBLE) **
* **											**
* ************************************************

* Action routine for double click on cargo item on sell screen.

* Entry: D0 = position on screen
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr d_sell

	cmp max_cargo(a6),d0 ; icon not used ?
	bhs no_select ; yes, just de-select
	bsr draw_highlight ; highlight icon
	bsr find_sell ; find products and cargo records
	cmp #18,d1 ; refugees or documents ?
; Quelo: 	if <hs> then.s						yes
	blo.s q_cargo_m68_41
	lea text18(pc),a0 ; print error message
	jsr error_box
	bra no_select
q_cargo_m68_41:
	move units(a5),d0 ; find size of each unit
	jsr get_unit
	move price(a5),d1 ; calculate how much it's worth
	asl #2,d1
	mulu #rip_off,d1
	divu #20,d1
	ext.l d1
	clr.l d0
	move.l (a4),d2
q_cargo_m68_43:
	add.l d1,d0
	sub.l d4,d2
	bhi q_cargo_m68_43
q_cargo_m68_44:
	add.l d0,cash(a6) ; add to cash
	clr.l (a4) ; remove from hold
	jsr prepare_text ; prepare text screen
	lea text13(pc),a0 ; print 'Sell Cargo'
	moveq #title_y,d1
	jsr print_centre
	bsr draw_cargo ; draw cargo screen
	st csr_on(a6) ; turn cursor back on

	rts


; Inventory keeps its normal single-click description. A double click in
; flight offers up to one tonne, with the commodity saved across the dialog.

	q_subr s_inventory
	cmp max_cargo(a6),d0
	bhs no_select
	move this_cargo(a6),-(sp)
	move d0,this_cargo(a6)
	bsr find_sell
	move this_cargo(a6),d0
	move (sp)+,this_cargo(a6) ; leave the previous highlight available to erase
	tst.l (a4)
	beq refresh_inventory ; live combat may have removed the displayed item
	bra display_sell

	q_subr d_inventory
	tst docked(a6)
	bne display_sell
	cmp max_cargo(a6),d0
	bhs no_select
	bsr draw_highlight
	bsr find_sell
	cmp #refugees,d1
	bhs jettison_invalid_selection
	tst.l (a4)
	beq jettison_invalid_selection
	move d1,jettison_item(a6) ; keep the commodity while combat continues
	bsr jettison_question
	bsr cargo_notice
	jmp open_jettison_confirm ; return to the normal input/game-logic loop

	q_subr poll_jettison,global
	jsr poll_jettison_confirm ; -1 = waiting, 0 = cancel, 1 = confirm
	tst d0
	bmi.s .waiting
	beq .cancel
	move jettison_item(a6),d0 ; JETTISON_CARGO rechecks cargo and free slots
	bsr jettison_cargo
	tst d0
	bmi .full
	beq jettison_invalid_selection
	q_sfx locked
	bsr refresh_inventory
	lea jettison_done(pc),a0
	bra cargo_notice
.waiting:
	rts
.cancel:
	tst game_over(a6)
	bne.s .waiting
	tst docked(a6)
	bne.s .waiting
	tst cockpit_on(a6)
	bne.s .waiting
	bsr refresh_inventory ; reflect any cargo lost while the dialog was open
	jsr clear_input
	bra no_select
.full:
	lea jettison_full(pc),a0
	bra jettison_notice_error
jettison_invalid_selection:
	lea jettison_invalid(pc),a0
jettison_notice_error:
	move.l a0,-(sp)
	bsr refresh_inventory
	move.l (sp)+,a0
	bsr cargo_notice
	q_sfx error
	rts

; A4 = selected hold entry, D1.W = commodity. A0 = exact-quantity prompt.
; D0-D4/D7/A0-A1 corrupt. No rounding: use kg only for whole kilograms.
	q_subr jettison_question
	move d1,-(sp)
	lea jettison_prompt(pc),a0
	lea pad(a6),a1
	jsr str_copy
	lea -1(a1),a0
	move.l (a4),d0
	moveq #0,d4 ; tonnes
	cmp.l #1000000,d0
	blo .smaller
	moveq #1,d0
	bra .number
.smaller:
	moveq #2,d4 ; grams unless the kilogram division is exact
	move.l d0,d2
	divu #1000,d2 ; quotient <= 999, safe on 68000
	swap d2
	tst d2
	bne .number
	swap d2
	move.l d2,d0
	moveq #1,d4 ; kilograms
.number:
	moveq #0,d1
	jsr build_number
	lea -1(a0),a1
	move d4,d0
	lea units_table(pc),a0
	jsr find_table
	jsr str_copy
	move.b #' ',-1(a1)
	move (sp)+,d0
	lea product_list,a0
	jsr find_table
	jsr str_copy
	lea pad(a6),a0
	rts

	q_subr cargo_notice
	jsr clear_input
	move #prompt_y,d1
	jmp print_centre

; D0.W = commodity index; D0.W = 1 success, 0 ineligible, -1 no free slot.
; All other registers preserved. No cargo, counters or legal status change on
; failure. Deferred removal still owns its slot until REMOVE_OBJECTS runs.
	q_subr jettison_cargo
	movem.l d1-d7/a0-a5,-(sp)
	tst docked(a6)
	bne .invalid
	cmp #refugees,d0
	bhs .invalid
	move d0,d6
	lsl #2,d0
	lea hold(a6),a3
	adda.w d0,a3
	move.l (a3),d5
	beq .invalid
	cmp.l #1000000,d5
	bls .amount_ready
	move.l #1000000,d5
.amount_ready:
	jsr alloc_object
	bcc .full
	move.l a4,a0
	move #obj_len/2-1,d7
.clear:
	clr.w (a0)+
	dbra d7,.clear
	move.b #(1<<in_use)|(1<<no_bounty),flags(a4)
	move.l #-400,zpos(a4) ; aft, beyond the canister's 150-unit collision radius
	move #barrel,type(a4)
	move #log_twisting,logic(a4)
	jsr create_object
	bsr jettison_motion
	move d6,cargo_type(a4) ; CREATE_OBJECT loads the ordinary barrel header first
	move.l d5,cargo_mass(a4) ; preserve the exact payload, including kg/g remainders
	sub.l d5,(a3)
	bsr jettison_penalty
	moveq #1,d0
	bra .done
.full:
	moveq #-1,d0
	bra .done
.invalid:
	moveq #0,d0
.done:
	movem.l (sp)+,d1-d7/a0-a5
	rts

; A4 = newly created canister. All registers preserved.
; Choose a rearward direction within 35.3 degrees of straight aft. Build an
; orthonormal model basis so tumbling does not distort the canister or its path.
	q_subr jettison_motion
	movem.l d0-d3/d7/a0/a5,-(sp)
	jsr random
	sub #128,d0
	asl #6,d0
	move d0,z_vector+i(a4)
	jsr random
	sub #128,d0
	asl #6,d0
	move d0,z_vector+j(a4)
	move #-unit,z_vector+k(a4) ; negative Z guarantees rearward drift
	lea z_vector(a4),a0
	jsr fix_unit
	move z_vector+k(a4),x_vector+i(a4)
	clr x_vector+j(a4)
	move z_vector+i(a4),d0
	neg d0
	move d0,x_vector+k(a4) ; perpendicular to Z, never a zero vector
	lea x_vector(a4),a0
	jsr fix_unit
	move.l a4,a5
	bclr #yvector_ok,flags(a5)
	jsr calc_yvector
	jsr random
	and #3,d0
	addq #3,d0 ; slow but nonzero: 3..6 world units per movement step
	move d0,velocity(a4)
	move d0,vel_max(a4) ; twisting/cruise logic must not accelerate back to 11
	bsr jettison_orientation
	movem.l (sp)+,d0-d3/d7/a0/a5
	rts

; A4 = canister with an orthonormal basis. All registers preserved.
; Choose a random roll around the flight axis without changing Z or velocity.
; A random nonzero linear combination of X/Y followed by normalization covers
; the full turn without extending the game's limited-angle trig table.
	q_subr jettison_orientation
	movem.l d0-d4/d7/a0-a1/a5,-(sp)
	jsr random
	sub #128,d0
	move d0,d3
	jsr random
	sub #128,d0
	move d0,d4
	or d3,d0
	bne .coefficients
	moveq #1,d3 ; avoid a zero vector when both random coefficients are zero
.coefficients:
	move d3,d0
	bpl .abs_first
	neg d0
.abs_first:
	move d4,d1
	bpl .abs_second
	neg d1
.abs_second:
	or d1,d0
.precision:
	cmp #64,d0 ; avoid normalizing a tiny vector after integer rounding
	bhs .basis
	add d3,d3
	add d4,d4
	add d0,d0
	bra .precision
.basis:
	lea x_vector(a4),a0
	lea y_vector(a4),a1
	moveq #2,d7
.component:
	move (a0),d0
	muls d3,d0
	move (a1)+,d1
	muls d4,d1
	add.l d1,d0
	asr.l #7,d0 ; keep the result inside a signed word before normalization
	move d0,(a0)+
	dbra d7,.component
	lea x_vector(a4),a0
	jsr fix_unit
	move.l a4,a5
	bclr #yvector_ok,flags(a5)
	jsr calc_yvector
	movem.l (sp)+,d0-d4/d7/a0-a1/a5
	rts

; Same 0..255 legal scale and 50-point Fugitive threshold as C64 Unbound.
	q_subr jettison_penalty
	tst radar_obj(a6)
	beq .done
	tst splanet+govern(a6) ; Anarchy does not police dumping
	beq .done
	add.b #15,police_record+1(a6)
	bcc .done
	move #255,police_record(a6)
.done:
	rts

* *******************************************************
* **												   **
* ** DRAW_HIGHLIGHT - DRAW HIGHLIGHT AROUND CARGO ITEM **
* **												   **
* *******************************************************

* Draws outline around current cargo item.

* Entry: D0 = cargo item #
* Exit:  None

* Regs: ?
* Subr: ?


	q_subr draw_highlight

	q_push d0 ; cargo item already selected ?
	tst selected(a6)
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_45
	moveq #black,d0 ; remove highlight
	bsr highlight
q_cargo_m68_45:
	move (sp)+,this_cargo(a6) ; highlight selected item
	moveq #white,d0
	bsr highlight
	st selected(a6) ; item selected

	rts ; return


* ***********************************************
* **										   **
* ** DISPLAY_BUY - DISPLAY INFORMATION FOR BUY **
* **										   **
* ***********************************************

* Displays the description, and quantities for the selected cargo item.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr display_buy

	bsr draw_highlight ; draw highlight around cargo item
	jsr clear_input ; clear input line
	move this_cargo(a6),d0 ; find description of item
	lea product_list,a0
	jsr find_table
	lea pad(a6),a1 ; copy into pad buffer
	jsr str_copy
	lea pad(a6),a0 ; add " - "
	lea text1(pc),a1
	jsr str_cat
	bsr find_buy ; find product record
	q_dec a0 ; any available ?
	move quantity(a5),d0
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_47
	clr d1
	jsr build_number
	move units(a5),d0 ; add units (e.g. kg)
	lea units_table(pc),a0
	jsr find_table
	move.l a0,a1
	bra.s q_cargo_m68_48
q_cargo_m68_47:
	lea text3(pc),a1 ; add "None"
q_cargo_m68_48:
	lea pad(a6),a0
	jsr str_cat
	lea pad(a6),a0 ; add " available"
	lea text2(pc),a1
	jsr str_cat
	lea pad(a6),a0 ; print message (centered)
	move #prompt_y,d1
	jmp print_centre


* *************************************************
* **											 **
* ** DISPLAY_SELL - DISPLAY INFORMATION FOR SELL **
* **											 **
* *************************************************

* Displays the description and worth of current item

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr display_sell

	cmp max_cargo(a6),d0 ; valid box ?
	bhs no_select ; no
	bsr draw_highlight ; draw highlight around cargo item
	jsr clear_input ; clear input line
	bsr find_sell ; find description of item
	q_push d1
	move d1,d0
	lea product_list,a0
	jsr find_table
	lea pad(a6),a1 ; copy into pad buffer
	jsr str_copy
	cmp #18,(sp)+ ; special cargo ?
; Quelo: 	if <lo> then.s						no
	bhs.s q_cargo_m68_49
	lea pad(a6),a0 ; add " - worth "
	lea text15(pc),a1
	jsr str_cat
	move units(a5),d0 ; find size of each unit
	jsr get_unit
	move price(a5),d1 ; calculate how much it's worth
	asl #2,d1
	mulu #rip_off,d1
	divu #20,d1
	ext.l d1
	clr.l d0
	move.l (a4),d2
q_cargo_m68_51:
	add.l d1,d0
	sub.l d4,d2
	bhi q_cargo_m68_51
q_cargo_m68_52:
	q_dec.l a0 ; add how much it's worth
	move #128,d1
	jsr build_number
	lea pad(a6),a0 ; add " credits"
	lea text16(pc),a1
	jsr str_cat
q_cargo_m68_49:
	lea pad(a6),a0 ; centre text in window
	jsr str_len
	sub #40,d0
	neg d0
	lsr #1,d0
	jsr tab
	lea pad(a6),a0 ; print message
	jmp print_string


* **************************************
* **								  **
* ** NO_SELECT - REMOVE ANY SELECTION **
* **								  **
* **************************************

* Routine called everytime an area outside other boundaries is selected.

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr no_select

	tst selected(a6) ; cargo item selected ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_cargo_m68_53
	moveq #black,d0 ; remove highlight
	bsr highlight
	clr selected(a6) ; nothing selected
q_cargo_m68_53:
	jsr clear_input ; clear input window
	moveq #-1,d0 ; clear any inverted icon
	jmp invert_icon


* ***********************************************
* **										   **
* ** HIGHLIGHT - HIGHLIGHT SELECTED CARGO ITEM **
* **										   **
* ***********************************************

* Highlight (or remove) the selected cargo item.

* Entry: D0 = colour to draw lines
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr highlight

	jsr set_colour ; set line colour
	jsr hide_cursor ; remove cursor
	bsr icon_coords ; calculate coords of box
	move d0,d2
	move d1,d3
	subq #2,d0
	subq #2,d1
	add #44,d2
	add #42,d3
	movem d0-d3,xc1(a6)
	draw_line xc1,yc1,xc2,yc1 ; top edge
	draw_line xc2,yc1,xc2,yc2 ; right edge
	draw_line xc2,yc2,xc1,yc2 ; bottom edge
	draw_line xc1,yc2,xc1,yc1 ; left edge
	jmp restore_cursor


* *************************************
* **								 **
* ** FIND_BUY - FIND PRODUCTS RECORD **
* **								 **
* *************************************

* Returns a pointer to the relevant record in the products list.

* Entry: THIS_CARGO = current cargo item #
* Exit:  A5 		= ptr: cargo record

* Regs: ?
* Subr: ?

	q_subr find_buy

	move this_cargo(a6),d0 ; index into array
	mulu #product_len,d0
	lea products(a6),a5
	lea (a5,d0),a5

	q_ret return


* ************************************************
* **											**
* ** FIND_SELL - FIND CARGO AND PRODUCTS RECORD **
* **											**
* ************************************************

* Returns pointers to the relevant product and cargo hold records.

* Entry: THIS_CARGO = position of screen
* Exit:  A4 = ptr: cargo hold record
*		 A5 = ptr: products record
*		 D1 = index #

* Regs: D0-D2/A0/A4/A5 corrupt.
* Subr: None

	q_subr find_sell

	move this_cargo(a6),d0
	lea cargo_items(a6),a0
	moveq #0,d1
	move.b (a0,d0),d1 ; use the displayed icon, not a fresh scan of live cargo
	move d1,d2
	lsl #2,d2
	lea hold(a6),a4
	adda.w d2,a4
	move d1,d2 ; index into products array
	mulu #product_len,d2
	lea products(a6),a5
	lea (a5,d2),a5

	q_ret return


* ******************************************
* **									  **
* ** PRINT_BUY_INFO - PRINT BUY INFO LINE **
* **									  **
* ******************************************

* Prints the line of info on the buy screen (cash and cargo hold spare)

* Entry: None
* Exit:  None

* Regs: ?
* Subr: ?

	q_subr print_buy_info

	clr d0 ; clear info line
	move #info_y,d1
	clr d2
	move #320,d3
	move #8,d4
	move #black,d5
	jsr block
	lea text10(pc),a0 ; copy "Cash: " into buffer
	lea pad(a6),a1
	jsr str_copy
	exg a0,a1 ; add cash left
	q_dec.l a0
	move.l cash(a6),d0
	move #128,d1
	jsr build_number
	lea pad(a6),a0 ; add " credits, Cargo hold: "
	lea text11(pc),a1
	jsr str_cat
	q_push.l a0
	jsr cargo_spare ; add amount of cargo space left
	jsr divide_by_1e5
	q_pop.l a0
	q_dec.l a0
	move #128,d1
	jsr build_number
	lea pad(a6),a0 ; add "t spare"
	lea text12(pc),a1
	jsr str_cat
	lea pad(a6),a0 ; print line of text (centered)
	move #info_y,d1
	jmp print_centre


* *****************************************
* **									 **
* ** GET_UNIT - GET POINTER TO UNIT SIZE **
* **									 **
* *****************************************

* Action: Returns a pointer to the size of one unit.

* Entry: D0.W = Unit: 0 = tonnes, 1 = kg, 2 = grammes
* Exits: D4.L = unit size

* Regr: D0 and D4 corrupt.
* Subr: None

	q_subr get_unit,global

	move.l #1000000,d4 ; assume tonnes
	tst d0
	q_ret eq ; correct
	move.l #1000,d4 ; asumme kilogrammes
	q_dec d0
	q_ret eq ; correct
	move.l #1,d4 ; must be grammes

	q_ret


; Inspect all tradable cargo on entry into station space. Only complete
; tonnes count. The existing market factors are 4 for Slaves/Narcotics and
; 2 for Firearms, independent of government. Saturate the record at 255.
; Preserve every data/address register; no cargo or market values change.
	q_subr check_cargo,global
	movem.l d0-d1/d7/a0-a1,-(sp)
	move police_record(a6),d1
	lea hold(a6),a0
	lea products(a6),a1
	moveq #refugees-1,d7 ; mission cargo has no market entry
.item:
	tst naughty(a1)
	beq.s .next
	move.l (a0),d0
; floor(grams / 1,000,000), without a 68020 long division or DIVU overflow:
; 1,000,000 = 64 * 15,625; even $ffffffff grams fit the 16-bit quotient.
	lsr.l #6,d0
	divu #15625,d0
	mulu naughty(a1),d0
	add d0,d1
	cmp #255,d1
	blo.s .next
	move #255,d1
	bra.s .done
.next:
	addq.l #4,a0
	lea product_len(a1),a1
	dbra d7,.item
.done:
	move d1,police_record(a6)
	movem.l (sp)+,d0-d1/d7/a0-a1
	rts


* ****************************************
* **									**
* ** ILLEGAL - CHECK FOR ILLEGAL GOODS	**
* **									**
* ****************************************

* Increase police record if illegal goods have just been bought.

* Entry: D1 = Amount of goods purchased
*		 A5 = Pointer to relevant PRODUCTS entry
* Exits: None

* Regr:   ?
* Subr:   FX

	q_subr illegal,global

	move d1,d0 ; multiply amount by illegal factor
	mulu naughty(a5),d0
	add.b d0,police_record+1(a6) ; Add to police record and clamp at 255
; Quelo: 	if <cs> then.s
	bcc.s q_cargo_m68_59
	move #255,police_record(a6)
q_cargo_m68_59:

	q_ret


* ***********************************************
* **										   **
* ** CARGO_SPARE - CALCULATE SPARE CARGO SPACE **
* **										   **
* ***********************************************

* Calculate how much cargo space is spare.

* Entry:  None
* Exits:  D3 = Amount of free cargo space (g)

* Regr:   D3/D7/A0 corrupt.
* Subr:   REDUCE_HOLD

	q_subr cargo_spare,global

	move.l #20000000,d3 ; assume 20t cargo hold
	tst equip+cargo_bay(a6)
; Quelo: 	if <ne> then.s
	beq.s q_cargo_m68_61
	move.l #35000000,d3 ; wrong we have 35t
q_cargo_m68_61:
	lea hold(a6),a0 ; subtract any cargo in the hold
	q_loop 1,max_products
	sub.l (a0)+,d3
	q_next 1

	q_ret


* ************************************************
* **											**
* ** REDUCE_HOLD - REDUCE AMOUNT OF CARGO SPACE **
* **											**
* ************************************************

* Remove space from cargo hold, and even goes minus if there isn't enough room

* Entry:  D1.W = amount wanted, e.g. 45 tonnes or 16 grammes
*		  D3.L = amount of free space in cargo hold (grammes)
*		  D4.L = size of on unit, e.g. 1000 for kilogrammes
* Exits:  D3.L = D3 - D1*D4

* Regr:   D3 and D7 corrupt.
* Subr:   None

	q_subr reduce_hold,global

	move d1,d7 ; loop for each item
	q_dec d7
	q_loop 1 ; loop for each item
	sub.l d4,d3 ; subtract from cargo space
	q_next 1

	q_ret


