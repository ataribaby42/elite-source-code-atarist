	xref ship_shield_damage
	include "common.def"
; Ported from src_orig/asm/combat.m68; edit this copy.
;	@@@@	@@@   @@   @@ @@@@@@	 @@    @@@@@@
;  @@  @@  @@ @@  @@@ @@@  @@  @@	@@@@   @ @@ @
; @@	  @@   @@ @@@@@@@  @@  @@  @@  @@	 @@
; @@	  @@   @@ @@@@@@@  @@@@@   @@  @@	 @@
; @@	  @@   @@ @@ @ @@  @@  @@  @@@@@@	 @@
;  @@  @@  @@ @@  @@   @@  @@  @@  @@  @@	 @@
;	@@@@	@@@   @@   @@ @@@@@@   @@  @@	@@@@

; Performs all combat related routines.

; Atari ST Version 1.0 18th May 1988 Copyright (c) 1988 Mr. Micro Ltd.
; Designed and coded by Rob Nicholson.

; Modification history:

;	V1.0	18/05/88	Original version.
;	V1.1	26/03/90	Rating clamped at Elite. See Add_Kill.
;						Reduce_Shields routine debugged.

	include "macros.m68"

	xref fx,disp_message,check_inflight,random,start_peel_off
	xref release_cargo,random,rand,alloc_object,create_object,line,copy_object
	xref short_equip,find_table,str_copy,str_cat,monst,orbit,vector_pos
	xref random_direction,move_object,calc_distance,magnitude_table,sqrt
	xref local_x_rotate,local_z_rotate,calc_yvector,start_run_off

; ---- LOCAL CONSTANTS ----

slow_charge: equ 24 ; Charge rates
medium_charge: equ 15
fast_charge: equ 9
rand_range: equ $2000 ; range for orbit's
rand_limit: equ $4000 ; minimum distance
launch_range: equ $1800 ; player range before launch
platlet_life: equ 50 ; life of platlet
platlet_vel: equ 50 ; speed of platlet
spacing1: equ 700 ; spacing of squadrons
spacing2: equ 1000 ; spacing of encounter groups
encounter_range: equ radar_range-rand_limit-$800 ; room for formation offsets and trig rounding
; Roles a random encounter's template can ask for. The pirate and trader roles
; roll from their own tables, which are narrower than RANDOM_PIRATE's type
; range on purpose; the other three name one ship and are never rolled.
; Numbered from one: a zero byte ends a row of ENCOUNTER_GROUPS, so no role
; may be zero or the walk would stop in the middle of a template.
role_pirate: equ 1
role_trader: equ 2
role_thargoid: equ 3
role_viper: equ 4
role_bounty: equ 5
role_convoy: equ 6 ; peaceful traders sharing a cruise speed until combat
; The player's own fire rolls RATING*4+MISSILE_PROB before a ship lets go of a
; missile or a group of thargons. His combat rating means nothing in a fight he
; is not part of, so ship against ship uses the middle rating band, as
; NPC_DAMAGE is the middle of the DAMAGE table. A thargon release is also
; smaller there; see THARGONS.
npc_launch_prob: equ 4*4+missile_prob

; ---- LOCAL VARIABLES ----

	q_vars combat

exploded: rs.w 1 ; flag: object exploded
bomb_active: rs.w 1 ; suppress individual explosions during an energy bomb
found: rs.w 1 ; object found
launch_rate: rs.w 1 ; rate of viper launch
next_pos: rs.w 1 ; next position for pirate
obj_hit: rs.w 1 ; flag: object hit with this laser
magnitude: rs.w 1 ; magnitude of vector
encounter_row: rs.l 1 ; ptr: the chosen template's next role/count pair
encounter_lead: rs.l 1 ; ptr: the group's first member, zero until it exists
encounter_role: rs.w 1 ; the role being placed
encounter_left: rs.w 1 ; how many of that role are still to come
encounter_seat: rs.w 1 ; which offset the next follower takes

	q_end_vars combat

	q_module combat

; ****************************************************
; **												**
; ** ENGAGE_ECM - ENGAGE ELECTRONIC COUNTER MEASURE **
; **												**
; ****************************************************

; Engages (starts) the ECM if fitted. Called from ACTION.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr engage_ecm,global

	jsr check_inflight ; check we're flying
	tst equip+ecm_system(a6) ; ECM fitted ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_1
	lea text14(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_1:
	tst ecm_jammed(a6) ; ECM jammed ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_combat_m68_3
	lea text15(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_3:
	tst ecm_on(a6) ; ECM already on ?
	bne beep ; yes
	q_sfx ecm ; start sound effect
	clr f_echar(a6) ; flag instrument change

	q_ret


; **************************************
; **								  **
; ** ECM - ELECTRONIC COUNTER MEASURE **
; **								  **
; **************************************

; Process the ECM is activated.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr ecm,global

	tst ecm_on(a6) ; ECM active ?
	q_ret eq ; no, return
	move.b loop_ctr(a6),d0 ; only reduce 1 in 4
	and.b #3,d0
; Quelo: 	if <eq> then.s
	bne.s q_combat_m68_5
	tst who_ecm(a6) ; did player start ECM ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_combat_m68_7
	tst shields_fx(a6) ; shields reduced effect
; Quelo: 			if <eq> then.s
	bne.s q_combat_m68_9
	q_sfx shields
q_combat_m68_9:
	moveq #1,d0 ; reduce energy
	bsr reduce_energy
q_combat_m68_7:
q_combat_m68_5:
	clr exploded(a6) ; assume no objects exploded
	lea objects(a6),a4 ; loop for each object
	q_loop 1,max_objects
	bsr ecm_check ; check if destroyed by ECM
	add.l #obj_len,a4
	q_next 1
	tst exploded(a6) ; any objects destroyed ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_combat_m68_11
	q_sfx explosion ; start explosion
q_combat_m68_11:

	q_ret


; **************************************************
; **											  **
; ** ECM_CHECK - CHECK IF OBJECT DESTROYED BY ECM **
; **											  **
; **************************************************

; Checks if an object is destroyed by the current ECM wave.

; Entry: A4 = ptr: object record (must be active)
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr ecm_check

	btst #in_use,flags(a4) ; object in use ?
	q_ret eq ; no
	cmp #missile,type(a4) ; missile ?
	q_ret ne ; no
	btst #point,flags(a4) ; exploding missile ?
	q_ret ne ; yes
	bset #no_bounty,flags(a4) ; no bounty for ECM
	bra explode_object


; *************************
; **					 **
; ** BEEP - PRODUCE BEEP **
; **					 **
; *************************

; Produce an error beep.

; Entry: None
; Exit:  None

; Regs: D0 corrupt.
; Subr: FX

	q_subr beep

	q_sfx error

	q_ret


; ***************************************************
; **											   **
; ** IS_COMBAT_SHIP - DOES THIS OBJECT TAKE PART ? **
; **											   **
; ***************************************************

; Tests whether an object takes part in faction targeting, either as a hunter
; or as a victim. The contiguous type range covers the traders, the pirates
; and the shuttles; VIPER and THARGON sit outside it. The station, canisters,
; missiles, title letters, panels and both mission ships are excluded.

; Entry: A4 = ptr: object record
; Exit:  D0 = 1 when the object takes part, 0 otherwise (Z set)

; Regs: D0 corrupt.

	q_subr is_combat_ship,global

	move type(a4),d0
	cmp #viper,d0 ; police
	beq.s .yes
	cmp #thargon,d0 ; tharglet
	beq.s .yes
	cmp #first_combat,d0 ; traders, pirates and shuttles
	blo.s .no
	cmp #last_combat,d0
	bhi.s .no
.yes:
	moveq #1,d0
	rts
.no:
	moveq #0,d0
	rts


; ******************************************
; **									  **
; ** IS_HOSTILE - FACTION RELATION TEST	  **
; **									  **
; ******************************************

; Tests whether the hunter's faction attacks the candidate's faction. Bit n of
; a mask entry means "hostile to SHIP_TYPE n". The Constrictor also carries
; TYP_ALIEN, but IS_COMBAT_SHIP rejects it, so inside this system TYP_ALIEN
; means a Thargoid or a Thargon.

; Entry: A5 = ptr: hunter's record
;		 A4 = ptr: candidate's record
; Exit:  D0 = 1 when hostile, 0 otherwise (Z set)

; Regs: D0, D1, D2, A0 corrupt.

	q_subr is_hostile,global

	moveq #0,d0
	move ship_type(a5),d1
	lea faction_mask(pc),a0
	move.b 0(a0,d1.w),d1 ; hunter's hostility mask
	move ship_type(a4),d2
	btst d2,d1
	beq.s .done
	moveq #1,d0
.done:
	rts

; Hostility masks indexed by SHIP_TYPE.

faction_mask:

	dc.b $82,$95,$82,$00,$82,$00,$00,$17
	; trader pirate shuttle debris police bounty missile alien

	even


; ***********************************************
; **										   **
; ** CHEBYSHEV_RANGE - CHEAP DISTANCE RANKING  **
; **										   **
; ***********************************************

; Largest axis difference between two objects. Used only to rank candidates
; against each other, so no square root and no division are needed. Ships stay
; within a few tens of thousands of units because anything beyond scanner
; range is removed, so the signed subtraction cannot overflow.

; Entry: A5 = ptr: first object
;		 A4 = ptr: second object
; Exit:  D0.L = max(|dx|,|dy|,|dz|)

; Regs: D0, D1 corrupt.

	q_subr chebyshev_range,global

	move.l xpos(a4),d0
	sub.l xpos(a5),d0
	bpl.s .x_positive
	neg.l d0
.x_positive:
	move.l ypos(a4),d1
	sub.l ypos(a5),d1
	bpl.s .y_positive
	neg.l d1
.y_positive:
	cmp.l d1,d0
	bhs.s .y_done
	move.l d1,d0
.y_done:
	move.l zpos(a4),d1
	sub.l zpos(a5),d1
	bpl.s .z_positive
	neg.l d1
.z_positive:
	cmp.l d1,d0
	bhs.s .done
	move.l d1,d0
.done:
	rts


; ****************************************************
; **												**
; ** PICK_TARGET - CHOOSE THE NEAREST HOSTILE SHIP	**
; **												**
; ****************************************************

; Selects the nearest hostile candidate for a hunter. The player is an
; ordinary candidate whenever the hunter's faction attacks him, or whenever
; the hunter is angry because the player has already shot at it; ANGRY only
; adds him to the set and never locks the choice. Candidates are limited to
; the player's scanner range, so fights only happen where the player can see
; them. OBJ_RANGE is reused throughout: it is the distance from the player and
; is already computed by GET_RANGE.

; Entry: A5 = ptr: hunter's record
; Exit:  TARGET updated, D0 = 1 when a target was found, 0 otherwise

; Regs: D0, D1, D2, D3, A0, A1, A4 corrupt.
; Subr: IS_COMBAT_SHIP, IS_HOSTILE, CHEBYSHEV_RANGE

	q_subr pick_target,global

	q_push d7 ; save the loop counter
	move.l #no_target,target(a5) ; nothing chosen yet
	move.l #$7fffffff,d3 ; best distance so far
	btst #angry,flags(a5) ; player already provoked this ship ?
	bne.s .player
	cmp #typ_pirate,ship_type(a5) ; pirates and aliens always hunt him
	beq.s .player
	cmp #typ_alien,ship_type(a5)
	bne.s .ships
.player:
	cmp.l #radar_range,obj_range(a5) ; he obeys the same scanner limit
	bhi.s .ships
	move.l obj_range(a5),d3 ; the player sits at the origin
	clr.l target(a5)
.ships:
	lea objects(a6),a4 ; scan every object record
	q_loop 1,max_objects
	cmpa.l a4,a5 ; never target itself
	beq.s .next
	btst #in_use,flags(a4)
	beq.s .next
	btst #remove,flags(a4)
	bne.s .next
	cmp #log_exploding,logic(a4)
	beq.s .next
	cmp.l #radar_range,obj_range(a4) ; inside the player's scanner ?
	bhi.s .next
	bsr is_combat_ship
	beq.s .next
	bsr is_hostile
	beq.s .next
	bsr chebyshev_range ; D0.L = distance from the hunter
	cmp.l d3,d0
	bhs.s .next ; no closer than the best so far
	move.l d0,d3
	move.l a4,target(a5)
.next:
	lea obj_len(a4),a4 ; next object
	q_next 1
	moveq #0,d0
	cmp.l #no_target,target(a5)
	beq.s .done
	moveq #1,d0
.done:
	q_pop d7 ; restore the loop counter

	q_ret


; ****************************************************
; **												**
; ** COMBAT_STATE - IS THIS LOGIC OPEN TO A FIGHT ? **
; **												**
; ****************************************************

; Classifies a logic type for target selection. Launch, docking, explosion and
; missile logics run to their end untouched; a cruising ship may be drawn into
; a fight; a fighting ship only swaps targets.

; Entry: D1 = logic type
; Exit:  D0 = 0 ineligible, 1 passive, 2 already fighting

; Regs: D0 corrupt.

	q_subr combat_state,global

	moveq #1,d0 ; passive, may be drawn in
	cmp #log_cruise,d1
	beq.s .done
	cmp #log_fly_planet,d1
	beq.s .done
	moveq #2,d0 ; already in a fight
	cmp #log_attack,d1
	beq.s .done
	cmp #log_peel_off,d1
	beq.s .done
	cmp #log_run_off,d1
	beq.s .done
	cmp #log_avoid,d1
	beq.s .done
	moveq #0,d0 ; leave this logic alone
.done:
	rts


; **************************************************
; **											  **
; ** RETARGET - REFRESH ONE SHIP'S FACTION TARGET **
; **											  **
; **************************************************

; Called for each object in the main loop. One slot re-targets per game frame,
; so the whole scan costs about MAX_OBJECTS comparisons per frame instead of
; MAX_OBJECTS squared. A ship must be a combat ship and able to fight back,
; which excludes the Python, the Shuttle and the Transporter.

; Entry: A5 = ptr: current object
; Exit:  None

; Regs: D0, D1, D2, D3, A0, A1, A4 corrupt.
; Subr: IS_COMBAT_SHIP, COMBAT_STATE, PICK_TARGET

	q_subr retarget,global

	move this_obj(a6),d0 ; this slot's turn this frame ?
	cmp retarget_slot(a6),d0
	bne.s .done ; no
	move.l a5,a4 ; a hunter must be a combat ship
	bsr is_combat_ship
	beq.s .done
	cmp #act_attack,attack_type(a5) ; and must be able to fight back
	bne.s .done
	move logic(a5),d1 ; may this logic be disturbed ?
	bsr combat_state
	tst d0
	beq.s .done ; no
	move d0,-(sp) ; remember passive or fighting
	bsr check_patrol_record ; only encounter vipers inspect changing legal status
	bsr pick_target
	move (sp)+,d1
	tst d0 ; anything hostile in range ?
	beq.s .nothing
	cmp #1,d1 ; was it cruising ?
; Quelo: 	if <eq> then.s						yes
	bne.s .done
	move #log_attack,logic(a5) ; turn to attack
	clr on_course(a5)
	move health(a5),pre_attack(a5)
	bra.s .done
.nothing:
	cmp #2,d1 ; was it fighting ?
	bne.s .done
	move #log_cruise,logic(a5) ; nothing left to fight, fly off
	move #1,on_course(a5)
.done:
	rts


; ****************************************************
; **												**
; ** HIT_REACTION - BREAK OFF FROM AN INCOMING SHOT **
; **												**
; ****************************************************

; The evasive turn a ship makes the moment a shot lands on it. A ship already
; on an attack run or in the middle of a peel off presses on; anything else
; breaks off in the direction its ATTACK_TYPE allows. Shared by CHECK_HIT and
; DAMAGE_TARGET, so a ship reacts to another ship's fire exactly as it reacts
; to the player's.

; Entry: A5 = ptr: the ship that was hit
; Exit:  None

; Regs: D0, D1 corrupt.
; Subr: START_PEEL_OFF

	q_subr hit_reaction,global

	move logic(a5),d0 ; on attack run ?
	cmp #log_attack,d0
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_69
	cmp #log_peel_off,d0 ; peeling off ?
; Quelo: 		if <ne> then.s					no
	beq.s q_combat_m68_71
	move attack_type(a5),d1 ; decide on action to take
	cmp #act_nothing,d1
; Quelo: 			if <ne> then.s
	beq.s q_combat_m68_73
	cmp #act_runaway,d1
; Quelo: 				if <eq> then.s
	bne.s q_combat_m68_75
	move #log_cruise,d0
	bra.s q_combat_m68_76
q_combat_m68_75:
	cmp #log_run_off,d0
; Quelo: 					if <ne> then.s
	beq.s q_combat_m68_77
	move #log_attack,d0
	move health(a5),pre_attack(a5)
	bra.s q_combat_m68_78
q_combat_m68_77:
	move #log_avoid,d0
q_combat_m68_78:
q_combat_m68_76:
	move d0,next_logic(a5) ; store next logic type
	bsr start_peel_off ; start to peel off
q_combat_m68_73:
q_combat_m68_71:
q_combat_m68_69:
	rts


; *********************************************
; **										 **
; ** DAMAGE_TARGET - HIT ANOTHER SHIP		 **
; **										 **
; *********************************************

; Applies laser damage from one ship to another. The player takes damage
; through REDUCE_SHIELDS instead; this path exists only for AI against AI.
; NPC_KILL tells EXPLODE_OBJECT that the player made no kill here, so his
; score, rating, bounty and police record are all left alone.

; The damaged ship reacts with the same two steps CHECK_HIT gives it when the
; player scores the hit: the immediate break-off, and, once more than half its
; energy has gone in one attack run, the LOW_ENERGY retreat. NPC_HIT holds the
; missile back over that second step, so AI against AI stays a laser fight and
; the player is never told about a missile he did not provoke.

; Entry: A5 = ptr: shooter, whose TARGET is another ship
;		 D0 = hit power
; Exit:  None

; Regs: D0, D1, D2, A0, A1, A4 corrupt.
; Subr: HIT_REACTION, LOW_ENERGY, EXPLODE_OBJECT, TARGET_LOST, RELEASE_CARGO

	q_subr damage_target,global

	move.l a5,-(sp) ; the shooter; every reaction below works on A5
	move d0,-(sp) ; HIT_REACTION corrupts the hit power
	move.l target(a5),a5 ; A5 = ptr: the ship that was hit
	bsr hit_reaction ; break off from the shot
	move (sp)+,d0
	sub d0,health(a5) ; reduce its health
	bcs.s .destroyed
	move health(a5),d0 ; lost over half its energy this attack run ?
	add d0,d0
	cmp pre_attack(a5),d0
	bhs.s .done ; no
	st npc_hit(a6) ; hold the missile back, this was not the player
	bsr low_energy
	clr npc_hit(a6)
.done:
	move.l (sp)+,a5
	rts
.destroyed:
	move.l a5,a4 ; EXPLODE_OBJECT and its friends all take A4
	move.l (sp)+,a5
	st npc_kill(a6) ; the player gets no credit for this
	bsr explode_object
	bsr target_lost ; his missile may have been locked on it
	jsr release_cargo ; containers still drop
	clr npc_kill(a6)
	rts


; ****************************************
; **									**
; ** EXPLODE_OBJECT - EXPLODE AN OBJECT **
; **									**
; ****************************************

; Explodes an object and adds its kill rating to players score.

; Entry: A4 = ptr: object record
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr explode_object,global

	q_save_all save ; all registers
; Mission objectives belong to a ship's destruction, not to the weapon that
; managed it, so they are counted here: laser, missile, ramming and the energy
; bomb all arrive through EXPLODE_OBJECT. Both are guarded on the objective
; actually being the active one, and on the wreck not already exploding, so
; nothing is counted twice.
	cmp #log_exploding,logic(a4) ; already going up ?
	beq.s .mission_checked
	move type(a4),d0
	cmp #dodec,d0 ; alien space station, objective #5 ?
	bne.s .not_the_station
	cmp #$52,mission(a6)
	bne.s .mission_checked
	st station_destroyed(a6)
	q_inc mission(a6) ; state #$53: reward at the next normal station
	bra.s .mission_checked
.not_the_station:
	cmp #constr,d0 ; Constrictor, objective #1 ?
	bne.s .mission_checked
	cmp #$15,mission(a6)
	bne.s .mission_checked
	q_inc mission(a6) ; state #$16: reward at the next station
.mission_checked:
	move #15,force(a4) ; initialise explosion
	move #rate,force_timer(a4)
	move #exp_dur,exp_timer(a4)
	clr exp_rad(a4)
	clr velocity(a4)
	move #log_exploding,logic(a4)
	bset #invincible,flags(a4) ; can't be shot
	bset #point,flags(a4) ; not normal 3D object
	bset #no_radar,flags(a4) ; remove from radar
	st exploded(a6) ; object exploded
	tst npc_kill(a6) ; did the player make this kill ?
; Quelo: 	if <eq> then.s						yes
	bne.s .no_credit
	bsr add_kill ; add kill rating
	bra.s .credited
.no_credit:
	bset #no_bounty,flags(a4) ; and pay no bounty either
	bra.s q_combat_m68_13 ; never touch his police record
.credited:
	tst collided(a6) ; collided with object ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_13
	move ship_type(a4),d0 ; trader ?
	cmp #typ_trader,d0
; Quelo: 		if <eq> then.s					yes
	bne.s q_combat_m68_15
	bsr inc_record ; increase police record
	bra.s q_combat_m68_16
q_combat_m68_15:
	cmp #typ_police,d0 ; police ?
; Quelo: 			if <eq> then.s				yes
	bne.s q_combat_m68_17
	bsr inc_record ; increase police record
q_combat_m68_17:
q_combat_m68_16:
q_combat_m68_13:
	cmp #thargoid,type(a4) ; thargoid ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_19
	lea objects(a6),a0 ; scatter any thargons
; THIS_OBJ is the main loop's cursor, not the slot of the ship that just died.
; The two agree only while the loop services the dying ship itself, which is
; the player's laser and a collision. A missile detonating in DO_LOCKED and an
; NPC laser in DAMAGE_TARGET both arrive here while the loop is servicing the
; missile or the shooter, so MOTHER matched nothing and the brood of a mother
; killed either way stayed in the fight, hunting and evading as before. The
; cursor is a valid slot too, so it could equally match the mother of another,
; still living Thargoid and put the wrong brood to sleep. A4 is the ship that
; died; take the slot from it.
	move.l a4,d0 ; slot of the mother that actually died
	sub.l a0,d0
	divu #obj_len,d0 ; D0.w = its index; MOTHER is compared as a word
	q_loop 1,max_objects
	btst #in_use,flags(a0)
; Quelo: 			if <ne> then.s
	beq.s q_combat_m68_21
	cmp #thargon,type(a0)
; Quelo: 				if <eq> then.s
	bne.s q_combat_m68_23
	cmp mother(a0),d0
; Quelo: 					if <eq> then.s
	bne.s q_combat_m68_25
	move #log_cruise,logic(a0)
	move #act_nothing,attack_type(a0)
q_combat_m68_25:
q_combat_m68_23:
q_combat_m68_21:
	lea obj_len(a0),a0
	q_next 1
q_combat_m68_19:
	tst collided(a6) ; collided ?
	bne.s give_up ; yes, no platlets
	move.l a4,a5 ; release a few platlets
	q_loop 1,6
	jsr alloc_object ; allocate an object
	bcc.s give_up ; none left
	q_push d7 ; copy main object
	jsr copy_object
	move.b #%10000011,flags(a4) ; no radar, in use
	jsr random_direction ; move in random direction
	move #platlet,type(a4) ; it's a platlet
	move #log_timer,logic(a4) ; logic is timing
	move #platlet_life,counter(a4)
	st velocity(a4) ; move at full speed
	jsr create_object ; create the object
	moveq #no_colours,d2 ; choose random colour from the list
	jsr rand
	add d0,d0
	lea platlet_colours(pc),a0
	move (a0,d0),obj_colour(a4)
	move #platlet_vel,velocity(a4) ; set speed of fragment
	q_pop d7 ; next platlet
	q_next 1

give_up:

	tst npc_kill(a6) ; a kill he had no part in stays quiet: his laser,
	bne.s .silent ; missile, ramming and energy bomb all leave this clear
	tst bomb_active(a6) ; LAUNCH_BOMB plays one effect for the whole blast
	bne.s .silent
	q_sfx explosion ; sfx: explosion
.silent:
	clr collided(a6) ; clear collided flag
	q_restore_all restore ; all registers

	q_ret


; *****************************************
; **									 **
; ** INC_RECORD - INCREASE POLICE RECORD **
; **									 **
; *****************************************

; Increase police record for destroying a trader or policeman.

; Entry: None
; Exit:  None

; Regs: All registers preserved.
; Subr: None

	q_subr inc_record

	add.b #64,police_record+1(a6) ; increase record by 64
; Quelo: 	if <cs> then.s						clamp at 255
	bcc.s q_combat_m68_27
	move #255,police_record(a6)
q_combat_m68_27:

	q_ret


; *****************************************
; **									 **
; ** ADD_KILL - ADD KILL RATING TO SCORE **
; **									 **
; *****************************************

; Adds an object kill rating to players score.

; V1.1	- Rating clamped at Elite status. Previous versions just carried
;		  on through memory (Rating: Fuel)

; Entry: A4 = ptr: object record
; Exit:  None

; Regs: ?

	q_subr add_kill

	move.l score(a6),d0 ; add rating to score
	move.w kill_rating(a4),d1
	ext.l d1
	add.l d1,d0
	move.l d0,score(a6)
	cmp #max_rating,rating(a6) ; at Elite status ?
; Quelo: 	if <lo> then.s						no
	bhs.s q_combat_m68_29
	move rating(a6),d1 ; entered new rating band ?
	asl #2,d1
	lea rating_bands(pc),a0
	cmp.l (a0,d1),d0
; Quelo: 		if <hs> then.s					yes
	blo.s q_combat_m68_31
	q_inc rating(a6) ; next rating
	bra.s q_combat_m68_32
q_combat_m68_31:
	q_inc.b kill_count+1(a6) ; increment kill counter
	q_ret ne ; not 256 kills
q_combat_m68_32:
	bra.s q_combat_m68_30
q_combat_m68_29:
	q_inc.b kill_count+1(a6) ; increment kill counter
	q_ret ne ; not 256 kills
q_combat_m68_30:
	lea text5(pc),a0 ; print message
	jmp disp_message


; **************************************
; **								  **
; ** RECHARGE - RECHARGE ENERGY BANKS **
; **								  **
; **************************************

; Recharges the shields and energy banks.

; Entry:  None
; Exit:   None

; Regs:   ?
; Subr:   CHARGE_ENERGY, CHARGE_SHIELDS

	q_subr recharge,global

	lea recharge_count(a6),a0 ; ready for recharge ?
	q_dec (a0)
	q_ret ne ; no
	move equip+energy_unit(a6),d0 ; hull recharge plus fitted unit
	add.w hull_recharge(a6),d0
	subq.w #1,d0
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_33
	move #slow_charge,(a0) ; reload counter
	bsr charge_energy ; charge energy banks
	cmp #max_energy,energy(a6) ; at full capacity ?
; Quelo: 		if <eq> then.s					yes
	bne.s q_combat_m68_35
	bsr charge_shields ; charge shields
q_combat_m68_35:
	bra.s q_combat_m68_34
q_combat_m68_33:
	q_dec d0 ; determine rate of charge
; Quelo: 		if <eq> then.s
	bne.s q_combat_m68_37
	moveq #medium_charge,d0
	bra.s q_combat_m68_38
q_combat_m68_37:
	cmp.w #2,d0
	blo.s .naval_rate
	moveq #7,d0
	bra.s q_combat_m68_38
.naval_rate:
	moveq #fast_charge,d0
q_combat_m68_38:
	move d0,(a0) ; reload counter
	bsr charge_energy ; change energy and shields then exit
	bsr charge_shields
q_combat_m68_34:

	q_ret


; *****************************************
; **									 **
; ** CHARGE_ENERGY - CHARGE ENERGY BANKS **
; **									 **
; *****************************************

; Increases the charge in the energy banks by 1 unit unless already at
; full charge. Also reduces temperature of lasers.

; Entry:  None
; Exit:   None

; Regs:   ?
; Subr:   None

	q_subr charge_energy

	tst laser_temp(a6) ; lasers cold ?
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_39
	q_dec laser_temp(a6) ; reduce temperature
	clr f_laser(a6)
q_combat_m68_39:
	cmp #max_energy,energy(a6) ; already at max ?
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_41
	q_inc energy(a6) ; increase energy
	clr f_energy(a6)
q_combat_m68_41:

	q_ret


; *************************************************
; **											 **
; ** CHARGE_SHIELDS - CHARGE FRONT & AFT SHIELDS **
; **											 **
; *************************************************

; Charges the front and aft shields by one unit unless already at full
; charge.

; Entry:  None
; Exit:   None

; Regs:   ?
; Subr:   ?

	q_subr charge_shields

	cmp #max_shield,front_shield(a6) ; front already at max ?
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_43
	q_inc front_shield(a6) ; increase shield and update display
	clr f_front(a6)
q_combat_m68_43:
	cmp #max_shield,aft_shield(a6) ; aft already at max ?
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_45
	q_inc aft_shield(a6) ; increase shield and update display
	clr f_aft(a6)
q_combat_m68_45:

	q_ret


; ******************************************
; **									  **
; ** REDUCE_SHIELDS - REDUCE SHIELD POWER **
; **									  **
; ******************************************

; Reduces the shields due to collision or laser fire.

; V1.1	- Routine debugged to prevent loss on equipment you didn't have.
;		  Not entirely satisfied this has been fixed.

; Entry: D0 = Hit power (amount to reduce shields/energy)
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr reduce_shields,global
	jsr ship_shield_damage

; Original listing option: 	list on

	tst shields_fx(a6) ; effect running ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_47
	q_push d0
	q_sfx shields
	q_pop d0
q_combat_m68_47:
	lea front_shield(a6),a0 ; assume front shields
	cmp #photon,type(a5) ; photon bolt ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_49
	tst mother_z(a5) ; test z coord of attacker
	bra.s q_combat_m68_50
q_combat_m68_49:
	tst zpos(a5) ; test z coord of object
q_combat_m68_50:
; Quelo: 	if <mi> then.s						behind us
	bpl.s q_combat_m68_51
	lea aft_shield(a6),a0 ; use aft shields
q_combat_m68_51:
	tst (a0) ; anything left in shields
; Quelo: 	if <ne> then						yes
	beq q_combat_m68_53
	sub d0,(a0) ; reduce shield
; Quelo: 		if <cs> then.s					shields can't take all the power
	bcc.s q_combat_m68_55
	move (a0),d0 ; determine how much left after hit
	neg d0
	clr (a0) ; no shield power
	bra.s q_combat_m68_56
q_combat_m68_55:
	clr d0 ; nothing left
q_combat_m68_56:
	q_push d0 ; update display
	clr f_front(a6)
	clr f_aft(a6)
	q_pop d0
q_combat_m68_53:
	tst d0 ; any hit power left
	q_ret eq ; no, return
	bsr reduce_energy ; reduce energy
	cmp #max_energy/2,energy(a6) ; nearly out of energy ?
	q_ret hs ; no, return
	jsr random ; randomly destroy equipment/cargo
	cmp #destroy_prob,d0
	q_ret hs
	moveq #equip_range+1,d2 ; choose random start position
	jsr rand
	tst d0 ; cargo ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_57
	lea hold(a6),a0 ; do we have any cargo ?
	q_loop 1,max_products-2
	tst.l (a0)+
; Quelo: 			if <ne> then.s				yes
	beq.s q_combat_m68_59
	lea hold(a6),a0 ; empty the hold (except special)
	q_loop 2,max_products-2
	clr.l (a0)+
	q_next 2
	lea text12(pc),a0
	jmp disp_message
q_combat_m68_59:
	q_next 1
	q_ret
q_combat_m68_57:
	addq #first_equip/2-1,d0 ; index into equipment table
	add d0,d0
	lea equip(a6),a0
	q_loop 1,equip_range ; check equipment list
	tst (a0,d0) ; laser ?
; Quelo: 		if <pl> then.s					no
	bmi.s q_combat_m68_61
; Quelo: 			if <ne> then.s				equipment installed!
	beq.s q_combat_m68_63
	clr (a0,d0) ; remove item (that's life)
	lsr #1,d0 ; find equipment description
	lea short_equip,a0
	jsr find_table
	lea pad(a6),a1 ; copy into buffer
	jsr str_copy
	lea pad(a6),a0 ; append ' lost'
	lea text13(pc),a1
	jsr str_cat
	lea pad(a6),a0 ; print message and return
	jmp disp_message
q_combat_m68_63:
q_combat_m68_61:
	addq #2,d0 ; advance to next item of equipment
	cmp #last_equip+2,d0 ; wrap around ?
; Quelo: 		if <hs> then.s					yes
	blo.s q_combat_m68_65
	moveq #first_equip,d0
q_combat_m68_65:
	q_next 1 ; check next item

	q_ret


; *****************************************
; **									 **
; ** REDUCE_ENERGY - REDUCE ENERGY BANKS **
; **									 **
; *****************************************

; Reduces the energy banks by a specified amount and updates the display.

; Entry: D0 = amount to reduce shields
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr reduce_energy,global

	sub d0,energy(a6) ; reduce energy
; Quelo: 	if <cs> then.s						bye, bye - no energy left
	bcc.s q_combat_m68_67
	clr energy(a6)
q_combat_m68_67:
	clr f_energy(a6) ; flag change

	q_ret return


; ******************************************
; **									  **
; ** CHECK_HIT - CHECK WHETHER OBJECT HIT **
; **									  **
; ******************************************

; Checks whether the current object has been hit by the lasers. The OBJ_HIT
; flag is set when the lasers have hit an object. This prevents any cargo
; canisters etc. from being destroyed immediatelty.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

; Test the fixed view axis against the model's circular hit area.
; Graphic jitter is deliberately never consulted here. Missile/ID targeting
; retains CHECK_SIGHTS and its existing behaviour.
	q_subr laser_in_sights

	moveq #0,d0
	tst in_sights(a6) ; also excludes hidden, invincible and off-view objects
	beq.s .done
	cmp #log_exploding,logic(a5)
	beq.s .done
	tst.l this_zpos(a5)
	ble.s .done
	moveq #0,d3
	move.w hits_rad(a5),d3
	move.l this_xpos(a5),d1
	bpl.s .x_positive
	neg.l d1
.x_positive:
	cmp.l d3,d1
	bhi.s .done
	move.l this_ypos(a5),d2
	bpl.s .y_positive
	neg.l d2
.y_positive:
	cmp.l d3,d2
	bhi.s .done
	mulu.w d1,d1
	mulu.w d2,d2
	add.l d2,d1
	bcs.s .done
	mulu.w d3,d3
	cmp.l d3,d1
	bhi.s .done
	moveq #1,d0
.done:
	rts

	q_subr check_hit,global

	tst hit_check(a6) ; shot accepted in this game frame ?
	q_ret eq ; no, return
	bsr laser_in_sights ; fixed centre, independent of beam jitter
	tst.w d0
	q_ret eq ; no, return
	tst obj_hit(a6) ; object already hit ?
	q_ret ne ; yes, return
; ANGRY is what PICK_TARGET reads to decide whether the player is a candidate
; for this ship, and DO_ATTACK was the only thing setting it -- which a ship
; reaches only once it already hunts him. A ship he shot therefore broke off,
; found nothing to fight and cruised away instead of fighting back. His own
; shot is the provocation the flag is named for. Only ACT_ATTACK is marked:
; ANGRY also drives the cockpit attack indicator and the flashing scanner
; blip, which have no business answering a shot at the station, an asteroid,
; a canister or a Thargon left dormant by its mother's death.
	cmp #act_attack,attack_type(a5) ; can it fight back ?
	bne.s .no_quarrel
	bset #angry,flags(a5) ; provoked by the player
.no_quarrel:
	bsr hit_reaction ; break off from the shot
	move laser_power(a6),d0 ; fetch laser power
	move type(a5),d1 ; space station ?
	cmp #spacestn,d1
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_79
	add.b #10,police_record+1(a6) ; increase police record
; Quelo: 		if <cs> then.s
	bcc.s q_combat_m68_81
	move #255,police_record(a6)
q_combat_m68_81:
	st no_entry(a6) ; don't allow entry to space station
	clr d0 ; no laser power at all
q_combat_m68_79:
	sub d0,health(a5) ; reduce object's health
; Quelo: 	if <cs> then.s						dead
	bcc.s q_combat_m68_83
	move.l a5,a4 ; explode object
	bsr explode_object
	bsr target_lost ; check for lost target
	q_sfx explosion
	jsr release_cargo ; release any cargo
	bra.s q_combat_m68_84
q_combat_m68_83:
	move health(a5),d0 ; lost > 1/2 energy this attack ?
	add d0,d0
	cmp pre_attack(a5),d0
; Quelo: 		if <lo> then.s					yes
	bhs.s q_combat_m68_89
	bsr low_energy ; perform low energy logic
q_combat_m68_89:
q_combat_m68_84:
	move.b obj_ctr+viper(a6),d0 ; < 2 vipers around ?
	add.b launch_count+1(a6),d0
	cmp.b #2,d0
; Quelo: 	if <lo> then.s						yes
	bhs.s q_combat_m68_91
	tst radar_obj(a6) ; within space station space ?
; Quelo: 		if <ne> then.s					yes
	beq.s q_combat_m68_93
	move type(a5),d0 ; space station ?
	cmp #spacestn,d0
	beq prep ; yes
	move ship_type(a5),d0 ; trader ?
	cmp #typ_trader,d0
	beq prep ; yes
	cmp #typ_police,d0 ; police ?
	beq prep ; yes
	cmp #typ_alien,d0 ; alien ?
	beq.s scramble ; yes
	cmp #$52,mission(a6) ; mission #5, state #2 ?
; Quelo: 			if <eq> then.s				yes
	bne.s q_combat_m68_95
prep:
	st police_hunt(a6) ; the station is coming for him
	bsr prepare_vipers
	bra.s q_combat_m68_95
; An alien inside station space is the station's business and not necessarily
; his: 1988 scrambles the vipers whenever his shot lands on one, and he may be
; perfectly clean. Leaving the flag clear is what stops them turning on him
; once the aliens are dead, now that a launch can mark its ships for him.
scramble:
	clr police_hunt(a6) ; scrambled against the alien
	bsr prepare_vipers
q_combat_m68_95:
q_combat_m68_93:
q_combat_m68_91:
	st obj_hit(a6) ; set object hit flag
	q_sfx hit ; sfx: hit

	q_ret


; ***********************************
; **							   **
; ** LOW_ENERGY - LOW ENERGY LOGIC **
; **							   **
; ***********************************

; Perform logic checks when energy of object reduced to 1/2 initial value.

; Entry: None
; Exit:  None

; Regs: ?

	q_subr low_energy

	bsr launch_escape ; random launch of escape capsule
; TARGET says which fight the ship is in, NPC_HIT whose shot just landed, and
; only the second one decides who a missile is for. Testing TARGET alone left
; NO_TARGET -- every ship between fights, and the Python, the Shuttle and the
; Transporter for their whole lives, since RETARGET passes over ACT_RUNAWAY --
; on the NPC path, where the launch needs a ship to aim at and is skipped. The
; player could empty a Python without it ever using its missile on him.
	move.l target(a5),d0 ; fighting another ship ?
	bgt.s .away_from_the_player ; yes, that fight is its own
	tst npc_hit(a6) ; and was it his shot that just landed ?
	beq.s .player ; yes, the original path below
.away_from_the_player:
; The same two releases the player's fire provokes, at odds that do not depend
; on his combat rating. LAUNCH_MISSILE aims at the ship being fought and keeps
; the cockpit alert to itself.
	tst no_missiles(a5) ; anything left to let go ?
	beq.s q_combat_m68_97
	jsr random ; fixed odds, free of the player's rating
	cmp #npc_launch_prob,d0
	bhs.s q_combat_m68_97
	cmp #thargoid,type(a5) ; thargons need no target of their own
	beq.s .npc_thargons
	move.l target(a5),d0 ; a ship to aim a missile at ?
	ble.s q_combat_m68_97 ; NO_TARGET, or the player, who is only ever
	bsr launch_missile ; warned by a missile his own attacker fired
	bra.s q_combat_m68_97
.npc_thargons:
	bsr thargons
	bra.s q_combat_m68_97
.player:
	tst no_missiles(a5) ; any missiles left ?
; Quelo: 	if <ne> then.s				yes
	beq.s q_combat_m68_97
	jsr random ; prob = rating*4+missile_prob
	move rating(a6),d1
	asl #2,d1
	add #missile_prob,d1
	cmp d1,d0
; Quelo: 		if <lo> then.s
	bhs.s q_combat_m68_99
	cmp #thargoid,type(a5)
; Quelo: 			if <eq> then.s
	bne.s q_combat_m68_101
	bsr thargons
	bra.s q_combat_m68_102
q_combat_m68_101:
	bsr launch_missile
q_combat_m68_102:
q_combat_m68_99:
q_combat_m68_97:
	cmp #act_nothing,attack_type(a5) ; able to peel off ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_combat_m68_103
	jsr random ; peel off ?
	cmp #peel_prob,d0
; Quelo: 		if <lo> then.s					yes
	bhs.s q_combat_m68_105
	move #log_run_off,d0 ; peel off
	move d0,next_logic(a5)
	jsr start_peel_off
	bra.s q_combat_m68_106
q_combat_m68_105:
	move health(a5),pre_attack(a5)
q_combat_m68_106:
q_combat_m68_103:

	q_ret return


; ************************************************
; **											**
; ** PREPARE_VIPERS - PREPARE VIPERS FOR LAUNCH **
; **											**
; ************************************************

; Prepares vipers for launch from space station.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr prepare_vipers

	move rating(a6),d2 ; no. to launch = RND((rating+1)*2)+1
	q_inc d2
	add d2,d2
	jsr rand
	q_inc d0
; Quelo: 	if d0 <hi> #6 then.s				max. launch of 6
	cmp #6,d0
	bls.s q_combat_m68_107
	moveq #6,d0
q_combat_m68_107:
	move d0,launch_count(a6)
	move #200,launch_rate(a6)

	q_ret


; ***********************************************
; **										   **
; ** LAUNCH_MISSILE - LAUNCH MISSILE AT PLAYER **
; **										   **
; ***********************************************

; Launches a missile at the player from the current object. If no object
; records are available, no missile is launched.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: alloc_object, copy_object, create_object, disp_message

	q_subr launch_missile

	move.l target(a5),d0 ; firing at a ship ?
	bgt.s .at_a_ship ; yes; anything else is the player
	cmp.l #2000,obj_range(a5) ; too close ?
	q_ret lo ; yes, return
	tst cloaking_on(a6) ; cloaking device on ?
	q_ret ne ; yes, return
	bra.s .allocate
.at_a_ship:
; The same guard, measured against the ship being fired at. OBJ_RANGE is the
; distance from the player and the cloaking device hides only him, so neither
; says anything about this launch.
	move.l target(a5),a4
	jsr get_dist ; D2.L = distance between A5 and A4
	cmp.l #2000,d2 ; too close ?
	q_ret lo ; yes, return
.allocate:
	jsr alloc_object ; allocate object record
	q_ret cc ; no record free
	jsr copy_object ; copy current objects record
	move.b #%00100001,flags(a4) ; in use, no bounty
	st velocity(a4) ; move at full speed
	move #missile,type(a4) ; it's a missile
	move.l target(a5),d0 ; flying at a ship ?
	bgt.s .track_the_ship
	move #log_missile,logic(a4) ; fly towards player
	jsr create_object ; create object
	q_dec no_missiles(a5) ; reduce missile count
	q_sfx alert ; trigger single alert
	lea text7(pc),a0 ; print message and exit
	jmp disp_message
.track_the_ship:
	move #log_ai_missile,logic(a4) ; DO_LOCKED, marked as not the player's
	move.l target(a5),target(a4)
	jsr create_object ; create object
	q_dec no_missiles(a5) ; reduce missile count

	q_ret ; no alert, no message: he is not the one being shot at


; **********************************************
; **										  **
; ** THARGONS - LAUNCH THARGONS FROM THARGOID **
; **										  **
; **********************************************

; Releases a group of thargons from a thargoid mother ship.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr thargons

	clr no_missiles(a5) ; no more thargons please
	jsr random ; release 4..7 thargons
	moveq #3,d1
	tst npc_hit(a6) ; driven off by another ship ?
	beq.s .count
	moveq #1,d1 ; yes: 2..3 only, so one release cannot
.count: ; empty the thirty object slots
	and d1,d0
	add d1,d0
	q_loop 1 ; loop for each thargon
	jsr alloc_object ; allocate a record for the thargon
	q_ret cc ; none left, give up
	q_push d0 ; copy thargoid mothership
	jsr copy_object
	move.b #1,flags(a4) ; in use
	st velocity(a4) ; move at full speed
	move #log_run_off,logic(a4) ; run off before attack
	move #thargon,type(a4) ; it's a thargon
	move this_obj(a6),mother(a4) ; store mother ship number
	jsr random_direction ; move in random direction
	jsr start_run_off ; start run off sequence
	jsr create_object ; create the thargon
	q_pop d0 ; next thargon
	q_next 1,d0

	q_ret return


; *******************************************
; **									   **
; ** LAUNCH_ESCAPE - LAUNCH ESCAPE CAPSULE **
; **									   **
; *******************************************

; Launch an escape capsule from the current object.

; Entry: A5 = ptr: current object
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr launch_escape

	jsr random ; random probability
	cmp #escape_prob,d0
	q_ret hs ; no
	move ship_type(a5),d0 ; trader pirate or shuttle ?
	cmp #typ_shuttle,d0
	q_ret hi ; no
	cmp #act_nothing,attack_type(a5) ; dead ?
	q_ret eq ; yes
	jsr alloc_object ; allocate a record
	q_ret cc ; none left
	move #log_abandoned,logic(a5) ; drift, then reclaim beyond scanner range
	move #act_nothing,attack_type(a5) ; do nothing when hit
	clr no_missiles(a5) ; abandoned hull cannot retaliate on this or later hits
	jsr copy_object ; copy current object's record
	move.b #1,flags(a4) ; in use
	st velocity(a4) ; move at full speed
	move #worm,type(a4) ; it's a worm
	jsr random_direction ; fly in random direction
	move #log_cruise,logic(a4) ; leg it
	jmp create_object


; ************************
; **					**
; ** FIRE - FIRE LASERS **
; **					**
; ************************

; Attempt to fire the Cobra's lasers.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr fire,global

; Hits and heat use the original game-frame cooldown. A held beam remains
; visible between accepted shots, but those display-only frames do no damage.
	tst game_frozen(a6)
	bne .done
	tst docked(a6)
	bne .done
	tst laser_type(a6)
	bmi .done
	cmp #max_ltemp,laser_temp(a6)
	bhs .done
	cmp #2,laser_type(a6) ; beam/military: a visual request for this frame
	blt.s .cooldown
	st laser_beam(a6)
.cooldown:
	tst firing(a6)
	bne.s .done
	move laser_rate(a6),firing(a6)
	st laser_pending(a6) ; still an immediate hit in the firing frame
	clr obj_hit(a6)
	clr laser_flash(a6)
	cmp #2,laser_type(a6)
	bge.s .heat
	move.l frclock,d0
	addq.l #3,d0 ; a short visual pulse, independent of the shot cooldown
	move.l d0,laser_flash_end(a6)
	st laser_flash(a6)
.heat:
	q_inc laser_temp(a6) ; exactly once per accepted shot, as before
	clr f_laser(a6)
	cmp #2,laser_type(a6) ; held weapons use the continuous VBL sound
	bge.s .done
	q_sfx laser
.done:
	rts

; *****************************************
; **									 **
; ** OBJECT_LOGIC - PERFORM OBJECT LOGIC **
; **									 **
; *****************************************

; Perform misc. object logic, e.g. creation of asteroids.

; Entry:  None
; Exit:   None

; Regs:   ?
; Subr:   ?

	q_subr object_logic,global

	tst witch_space(a6) ; in witch space ?
	bne create_thargoids ; yes, create thargoids and return
	bsr launch_vipers ; launch any vipers
	bsr launch_shuttle ; launch shuttle
	bsr create_asteroid ; create asteroids in deep space
	bsr create_trader ; create traders (launch/deep space)
	bsr create_pirates ; create pirates

	q_ret


; ************************************************
; **											**
; ** TARGET_LOST - CHECK IF MISSILE TARGET LOST **
; **											**
; ************************************************

; Checks if tan object (which has just been destroyed) was the target of a
; missile. If so, the missile is removed from the 3D world.

; Entry: A4 = ptr: object record
; Exit:  None

; Regs: ?
; Subr: ?

; ****************************************************
; **												**
; ** DROP_MISSILES - CLEAR THE MISSILES CHASING IT  **
; **												**
; ****************************************************

; Removes every missile flying at an object that is about to leave the world.
; DO_LOCKED reads TARGET without checking it, so a missile left behind would
; steer at a freed record. Ships fire missiles at each other, so most of them
; are nothing to do with the player; the one case he is told about is reported
; back to TARGET_LOST.

; Entry: A4 = ptr: object record
; Exit:  D0 = 1 when one of them was the player's, 0 otherwise

; Regs: D0, D1, A0 corrupt.

	q_subr drop_missiles

	q_push d7 ; save the loop counter
	moveq #0,d1 ; none of his so far
	lea objects(a6),a0 ; scan every object record
	q_loop 1,max_objects
	btst #in_use,flags(a0)
	beq.s .next
	btst #remove,flags(a0) ; already leaving the world ?
	bne.s .next ; yes, it chases nothing and reports nothing
	cmp #missile,type(a0)
	bne.s .next
	move.l target(a0),d0 ; flying at this record ?
	cmp.l a4,d0
	bne.s .next
	bset #remove,flags(a0) ; yes, it has nothing left to chase
	cmp #log_locked,logic(a0) ; one of the player's ?
	bne.s .next
	moveq #1,d1
.next:
	lea obj_len(a0),a0 ; next object
	q_next 1
	move d1,d0
	q_pop d7 ; restore the loop counter
	rts


; ************************************************
; **											**
; ** TARGET_LOST - CHECK IF MISSILE TARGET LOST **
; **											**
; ************************************************

	q_subr target_lost,global

	cmp #2,missile_state(a6) ; missile targetted ?
; Quelo: 	if <hs> then.s						yes
	blo.s q_combat_m68_111
	move.l target_ptr(a6),d0 ; targetted on this object ?
	cmp.l a4,d0
; Quelo: 		if <eq> then.s					yes
	bne.s q_combat_m68_113
	bsr unarm_missile ; unarm missile
	bsr drop_missiles
	bra.s remove_missile
q_combat_m68_113:
q_combat_m68_111:
	bsr drop_missiles ; every missile chasing it, whoever fired it
	tst d0 ; was one of them the player's ?
	beq.s q_combat_m68_115 ; no, he is told nothing

remove_missile:

	lea text1(pc),a0 ; print "Target lost"
	jsr disp_message
	clr f_missiles(a6) ; flag instrument update
q_combat_m68_115:

	q_ret


; ******************************************
; **									  **
; ** CHECK_MISSILE - CHECK MISSILE TARGET **
; **									  **
; ******************************************

; Checks if a missile is currently fired at an object.

; Entry: A4 = ptr: objects record
; Exit:  IF missile found THEN
;			D7 >= 0
;			A0 =  ptr: missile's record
;		ELSE
;			D7 < 0
;		ENDIF

; Regs: ?
; Subr: ?

	q_subr check_missile,global

	lea objects(a6),a0 ; point to 1st object
	q_loop 1,max_objects ; loop for each object
	btst #in_use,flags(a0) ; object in use and a missile ?
; Quelo: 		if <ne> then.s
	beq.s q_combat_m68_117
	cmp #missile,type(a0)
; Quelo: 			if <eq> then.s				yes
	bne.s q_combat_m68_119
	cmp #log_locked,logic(a0) ; one of his, not a ship's ?
	bne.s q_combat_m68_119
	move.l target(a0),d0 ; locked onto this object ?
	cmp.l a4,d0
	q_ret eq ; yes, return
q_combat_m68_119:
q_combat_m68_117:
	add.l #obj_len,a0 ; next object
	q_next 1

	q_ret


; ***************************************
; **								   **
; ** TARGET_MISSILE - TARGET A MISSILE **
; **								   **
; ***************************************

; Targets a missile and updates the display.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr target_missile,global

	jsr check_inflight ; check we're flying
	tst missile_state(a6) ; missile already targetted ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_combat_m68_121
	lea text16(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_121:
	tst equip+missiles(a6) ; any missiles ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_123
	lea text17(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_123:
	q_inc missile_state(a6) ; target missile
	clr f_missiles(a6)

	q_ret return


; ***********************************************
; **										   **
; ** UNARM_MISSILE - UNARM A TARGETTED MISSILE **
; **										   **
; ***********************************************

; Unarms a previously targetted missile and updates the display.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr unarm_missile,global

	tst missile_state(a6) ; missile targetted ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_125
	lea text18(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_125:
	clr missile_state(a6) ; unarm missile
	clr f_missiles(a6)

	q_ret return


; *******************************************
; **									   **
; ** FIRE_MISSILE - FIRE MISSILE AT TARGET **
; **									   **
; *******************************************

; Launches a missile at it's target.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr fire_missile,global

	cmp #2,missile_state(a6) ; locked ?
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_127
	lea text19(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_127:
	jsr alloc_object ; allocate object record
; Quelo: 	if <cc> then.s						none left
	bcs.s q_combat_m68_129
	bsr beep ; error beep
	lea text6(pc),a0 ; print "Missile jammed!" and exit
	jmp disp_message
q_combat_m68_129:
	clr missile_state(a6) ; missile not targetted
	move.b #%00100001,flags(a4) ; no bounty, in use
	lea missile_data(pc),a0 ; set coords and vectors
	lea xpos(a4),a1
	q_loop 1,(3*2+3*3)
	move (a0)+,(a1)+
	q_next 1
	move #missile,type(a4) ; it's a missile
	move #log_locked,logic(a4) ; locked onto target
	move.l target_ptr(a6),target(a4) ; set pointer to target object
	st velocity(a4) ; launch at full speed
	jsr create_object ; create object
	q_sfx missile ; launch sound effect
	q_dec equip+missiles(a6) ; missile used
	clr f_missiles(a6)

	q_ret return


; **********************************************
; **										  **
; ** RANDOM_POSITION - CHOOSE RANDOM POSITION **
; **										  **
; **********************************************

; Chooses a random position and direction for an object. Also sets the object
; as 'in use', sets the velocity to maximum and creates the object.

; Entry: A4 = ptr: objects record
; Exit:  None

; Regs: ?
; Subr: RAND, ORBIT, RANDOM_DIRECTION, CREATE_OBJECT

	q_subr random_position

	move.b #1,flags(a4) ; in use
	st velocity(a4) ; move at full speed
	move #rand_range,d2 ; place in random orbit
	jsr rand
	add #rand_limit,d0
	ext.l d0
	move #360,d1
	jsr orbit
	jsr random_direction ; fly in random direction
	jmp create_object ; create the object and return


; **************************************************
; **											  **
; ** LAUNCH_SHIP - LAUNCH SHIP FROM SPACE STATION **
; **											  **
; **************************************************

; Launches a ship from the the space station by copying the space stations
; coordinates and moving the ship along the z axis to the door.

; Entry: A4 = ptr: object record
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr launch_ship

	tst station_destroyed(a6) ; has station been destroyed ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_131
	lea station_rec(a6),a0 ; use stations position and vectors
	q_loop 1,(3*4+9*2)
	move.b xpos(a0,d7),xpos(a4,d7)
	q_next 1
	move obj_rad(a0),d0 ; move to the door
	jsr move_object
	clr velocity(a4) ; slowly speed up
	move #1,on_course(a4) ; object on course
	move.b #1,flags(a4) ; record in use
	jsr create_object ; create the object
q_combat_m68_131:

	q_ret


; ********************************************
; **										**
; ** LAUNCH_VIPERS - LAUNCHES POLICE VIPERS **
; **										**
; ********************************************

; Launches vipers from the space station. Note - if on mission #5, then
; thargoids are launched instead.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr launch_vipers

	tst launch_count(a6) ; any to launch ?
	q_ret eq ; no, return
	q_dec launch_rate(a6) ; ready to launch ?
	q_ret ne ; no
	move #200,launch_rate(a6) ; re-set counter
	jsr alloc_object ; allocate object record
	q_ret cc ; none left
	q_dec launch_count(a6) ; viper has been launched
	cmp #$52,mission(a6) ; on mission #5 ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_133
	moveq #thargoid,d0 ; launch thargoid
	bra.s q_combat_m68_134
q_combat_m68_133:
	moveq #viper,d0 ; launch viper
q_combat_m68_134:
	move d0,type(a4)
	move #log_police,logic(a4) ; attack launch
	bsr launch_ship ; launch object
; PREPARE_VIPERS sizes the wave from the player's combat rating, so a launch is
; always about him, and the ship has to say so: PICK_TARGET offers him only to
; a pirate, an alien or a ship already angry with him, and a policeman is none
; of the three. Unmarked, RETARGET reads LOG_PEEL_OFF and LOG_RUN_OFF as
; fighting, finds the viper nothing to fight, and sends it cruising out of
; scanner range. Set after LAUNCH_SHIP, which writes FLAGS outright, and only
; for a launch POLICE_HUNT says is about him: the same door sends vipers out
; against an alien in the zone, and those have no quarrel with a clean player.
	tst police_hunt(a6) ; is this launch about him ?
	beq.s .scrambled ; no, it answers an alien in the zone
	bset #angry,flags(a4) ; launched to arrest him
.scrambled:

	q_ret


; ********************************************************
; **													**
; ** LAUNCH_SHUTTLE - LAUNCH SHUTTLE FROM SPACE STATION **
; **													**
; ********************************************************

; Routine to launch a shuttle from the space station.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr launch_shuttle

	tst radar_obj(a6) ; within space station space ?
	q_ret eq ; no
	move.l station_range(a6),d0 ; too close ?
	cmp.l #launch_range,d0
	q_ret lo ; yes
	tst.b obj_ctr+shuttle(a6) ; shuttle running ?
	q_ret ne ; yes
	tst.b obj_ctr+transporter(a6) ; transporter running ?
	q_ret ne ; yes
	cmp #$52,mission(a6) ; mission #5, state #2 ?
	q_ret eq ; yes
	q_dec shuttle_ctr(a6) ; ready for shuttle launch ?
	q_ret ne ; no
	move #512,shuttle_ctr(a6) ; re-load counter
	jsr alloc_object ; allocate a new object
	q_ret cc ; no objects left
	jsr random ; random object type
	and #1,d0
	add #shuttle,d0
	move d0,type(a4)
	move #log_fly_planet,logic(a4) ; fly towards planet
	bsr launch_ship ; launch ship

	q_ret


; *****************************************************
; **												 **
; ** CREATE_ASTEROID - CREATE ASTEROID IN DEEP SPACE **
; **												 **
; *****************************************************

; Creates an asteroid in deep space.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr create_asteroid

	tst radar_obj(a6) ; in deep space ?
	q_ret ne ; no
	tst.b obj_ctr+asteroid(a6) ; asteroid around ?
	q_ret ne ; yes
	q_dec asteroid_ctr(a6) ; ready to create ?
	q_ret ne ; no
	move #512,asteroid_ctr(a6) ; re-load counter
	jsr alloc_object ; allocate an object
	q_ret cc ; none left
	move.b #1,flags(a4) ; create asteroid
	move #rand_range,d2 ; range = rand(rand_range)+rand_limit
	jsr rand
	add #rand_limit,d0
	ext.l d0
	move #360,d1
	jsr orbit
	jsr vector_pos ; point at player
	move #asteroid,type(a4) ; it's an asteroid
	move #log_cruise,logic(a4) ; flying through space
	st velocity(a4) ; move at maximum speed
	jsr create_object ; create object
	jsr random ; prob. 0.1 ?
; Quelo: 	if d0 <lo> #26 then.s				yes
	cmp #26,d0
	bhs.s q_combat_m68_135
	and #3,d0 ; release 1..4 platlets when hit
	q_inc d0
	bra.s q_combat_m68_136
q_combat_m68_135:
	clr d0 ; no platlets
q_combat_m68_136:
	move d0,no_canisters(a4)

	q_ret return


; ******************************************
; **									  **
; ** CREATE_TRADER - LAUNCH/CREATE TRADER **
; **									  **
; ******************************************

; Either creates a trader ship in deep space or launches a trader from
; the space station.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr create_trader

	tst trader_count(a6) ; any traders around ?
	q_ret ne ; yes
	q_dec trader_ctr(a6) ; ready to launch
	q_ret ne ; no
	jsr alloc_object ; allocate an object
	q_ret cc ; none left
	move #512,trader_ctr(a6) ; re-load counter
	moveq #no_traders,d2 ; random trader ship
	jsr rand
	add #traders,d0
	move d0,type(a4)
	tst radar_obj(a6) ; deep space ?
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_137
	move #log_cruise,logic(a4) ; crusing through space
	jsr random_position ; create at random position
	bra.s q_combat_m68_138
q_combat_m68_137:
	cmp.l #2000,station_range(a6) ; too close ?
; Quelo: 		if <hi> then.s					no
	bls.s q_combat_m68_139
	move #log_launch,logic(a4) ; launch
	bsr launch_ship
q_combat_m68_139:
q_combat_m68_138:

	q_ret


; ********************************************************
; **													**
; ** CREATE_THARGOIDS - CREATE THARGOIDS IN WITCH SPACE **
; **													**
; ********************************************************

; Keeps creating thargoids when the player hits witch space.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr create_thargoids

	move.b obj_ctr+thargoid(a6),d0 ; max. no. of thargoids around ?
	cmp.b tharg_max+1(a6),d0
	q_ret eq ; yes, return
	jsr alloc_object ; allocate an object
	q_ret cc ; none left
	move #thargoid,type(a4) ; create random thargoid
	move #log_attack,logic(a4)
	clr.l target(a4) ; the player, until RETARGET finds it something nearer
	clr on_course(a4)
	jmp random_position


; ***************************************************
; **											   **
; ** CREATE_PIRATES - CREATE PIRATES IN DEEP SPACE **
; **											   **
; ***************************************************

; Creates a squadron of pirates if it's time.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr create_pirates

	move mission(a6),d0 ; attack by constrictor ?
	cmp #$15,d0
; Quelo: 	if <eq> then.s						yes
	bne.s q_combat_m68_141
	tst.b obj_ctr+constr(a6) ; constrictor around ?
	beq pirate_attack ; no
	q_ret return ; (no other pirates)
q_combat_m68_141:
	tst radar_obj(a6) ; in deep space ?
	q_ret ne ; no
	cmp #2,pirate_count(a6) ; < 2 pirates around ?
	q_ret hs ; no
	q_dec pirate_ctr(a6) ; ready to create ?
	q_ret ne ; no
	move splanet+govern(a6),d0 ; re-load counter
	addq #2,d0
	moveq #9,d1
	asl d1,d0
	move d0,pirate_ctr(a6)
	bra spawn_pirate_wave

; Both timed deep-space waves and torus interruptions use one substitution
; decision. The caller retains its timer, eligibility and flight-state work.

	q_subr spawn_pirate_wave,global

; Half of all ordinary pirate waves become an encounter instead. Every
; mission that spawns a named ship keeps the old path: $21 and $52 want
; Thargoids, $41 the Cougar, and $15 the Constrictor. Do not roll at all for
; these missions, preserving their original random sequence and composition.
	move mission(a6),d0
	cmp #$15,d0
	beq pirate_attack
	cmp #$21,d0
	beq pirate_attack
	cmp #$41,d0
	beq pirate_attack
	cmp #$52,d0
	beq pirate_attack
	jsr random ; a fair coin
	btst #0,d0
	bne random_encounter
	bra pirate_attack ; attack by pirates


; ***********************************************
; **										   **
; ** PIRATE_ATTACK - CREATE PIRATES AND ATTACK **
; **										   **
; ***********************************************

; Create a squadron of pirates which attack the player.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr pirate_attack,global

	jsr alloc_object ; allocate 1st object
	q_ret cc ; none left
	lea text2(pc),a0 ; print "Condition RED!"
	jsr disp_message
	move mission(a6),d0 ; decide on 1st object type
; Quelo: 	if d0 <eq> #$21 or d0 <eq> #$52 then.s
	cmp #$21,d0
	beq.s q_combat_m68_145
	cmp #$52,d0
	bne.s q_combat_m68_143
q_combat_m68_145:
	moveq #thargoid,d0
	bra.s q_combat_m68_144
q_combat_m68_143:
; Quelo: 		if d0 <eq> #$15 then.s
	cmp #$15,d0
	bne.s q_combat_m68_146
	moveq #constr,d0
	bra.s q_combat_m68_147
q_combat_m68_146:
; Quelo: 			if d0 <eq> #$41 then.s
	cmp #$41,d0
	bne.s q_combat_m68_148
	tst.b obj_ctr+cougar(a6)
	q_ret ne
	moveq #cougar,d0
	bra.s q_combat_m68_149
q_combat_m68_148:
	bsr random_pirate
q_combat_m68_149:
q_combat_m68_147:
q_combat_m68_144:
	move d0,type(a4)
	move.b #1,flags(a4) ; in use
	move #log_attack,logic(a4) ; attack player
	clr.l target(a4) ; and say so: ALLOC_OBJECT leaves NO_TARGET
	clr on_course(a4) ; not on course
	st velocity(a4) ; attack at full speed
	move #rand_range,d2 ; random orbit
	jsr rand
	add #rand_limit,d0
	ext.l d0
	move #360,d1
	jsr orbit
	jsr vector_pos ; point at player
	jsr create_object ; create object
	move type(a4),d0 ; constrictor ?
	cmp #constr,d0
	q_ret eq ; yes, no more pirates
	move mission(a6),d0 ; mission #2, state #1 ?
	cmp #$21,d0
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_150
	cmp #$52,d0 ; mission #5, state #2 ?
; Quelo: 		if <ne> then.s					no
	beq.s q_combat_m68_152
	move type(a4),d0 ; thargoid ?
	cmp #thargoid,d0
	q_ret eq ; yes, no more pirates
q_combat_m68_152:
q_combat_m68_150:
	move.l a4,a5 ; calculate y vector
	jsr calc_yvector
	cmp #$41,mission(a6) ; cougar mission ?
; Quelo: 	if <ne> then.s						no
	beq.s q_combat_m68_154
	move rating(a6),d2 ; no. attack=rnd((rating+3)/2)
	addq #3,d2
	lsr #1,d2
	jsr rand
	bra.s q_combat_m68_155
q_combat_m68_154:
	moveq #2,d0 ; create two asps
q_combat_m68_155:
	tst d0 ; no more ?
	q_ret eq ; yes, return
	lea squadron_positions(pc),a0 ; start of positions table
	move d0,d7 ; loop for each object
	q_dec d7
	q_loop 1
	jsr alloc_object ; allocate an object record
	q_ret cc ; none left
	jsr copy_object ; copy red-leader (centre)
	move mission(a6),d0 ; choose object type
; Quelo: 		if d0 <eq> #$41 then.s
	cmp #$41,d0
	bne.s q_combat_m68_156
	moveq #asp,d0
	bra.s q_combat_m68_157
q_combat_m68_156:
; Quelo: 			if d0 <eq> #$21 or d0 <eq> #$52 then.s
	cmp #$21,d0
	beq.s q_combat_m68_160
	cmp #$52,d0
	bne.s q_combat_m68_158
q_combat_m68_160:
	moveq #thargoid,d0
	bra.s q_combat_m68_159
q_combat_m68_158:
	bsr random_pirate
q_combat_m68_159:
q_combat_m68_157:
	move d0,type(a4)
	move (a0)+,d0 ; A1 = ptr: vector to move along
	lea (a4,d0),a1
	move (a0)+,d0 ; fetch the spacing
	lea xpos(a4),a2 ; A2 = ptr: coordinates
	q_loop 2,d6,3 ; loop for each coordinate
	move (a1)+,d1 ; calculate distance along vector
	muls d0,d1
	asl.l #2,d1
	swap d1
	ext.l d1
	add.l d1,(a2)+
	q_next 2,d6 ; next component/coord
	jsr create_object ; create object
	q_next 1 ; next object

	q_ret return


; ******************************************
; **									  **
; ** RANDOM_PIRATE - CHOOSE RANDOM PIRATE **
; **									  **
; ******************************************

; Chooes a random pirate ship.

; Entry: None
; Exit:  D0 = object #

; Regs: ?
; Subr: RAND

	q_subr random_pirate

	moveq #no_pirates,d2 ; choose random type
	jsr rand
	add #pirates,d0

	q_ret return


; ******************************************************
; **												  **
; ** ENCOUNTER_TYPE - CHOOSE A SHIP FOR A GROUP ROLE  **
; **												  **
; ******************************************************

; Turns one of a template's roles into an object type. The pirate and trader
; roles roll from their own tables; convoys use the trader table as well.
; The other three roles name a single ship.

; Entry: D0 = role
; Exit:  D0 = object type

; Regs: D0, D1, D2, A0 corrupt.
; Subr: RAND

	q_subr encounter_type,global

	cmp #role_pirate,d0
	beq.s .pirates
	cmp #role_trader,d0
	beq.s .traders
	cmp #role_convoy,d0
	beq.s .traders
	sub #role_thargoid,d0 ; the three a template names outright
	add d0,d0
	lea encounter_fixed(pc),a0
	move (a0,d0),d0
	rts
.pirates:
	lea encounter_pirates(pc),a0
	moveq #no_encounter_pirates,d2
	bra.s .roll
.traders:
	lea encounter_traders(pc),a0
	moveq #no_encounter_traders,d2
.roll:
	jsr rand ; 0..D2-1
	add d0,d0
	move (a0,d0),d0
	rts


; Ships a random encounter may roll. Neither table holds the Thargoid, which a
; template names where it wants one, and the pirates leave out the Boa and the
; Wolf: the encounter's raiders are the small and medium ships.

encounter_pirates:

	dc.w krait,gecko,moray,adder,mamba,asp,sidewinder

no_encounter_pirates: equ (*-encounter_pirates)/2

encounter_traders:

	dc.w cobra,python,anaconda,cobra_mk1

no_encounter_traders: equ (*-encounter_traders)/2

; Indexed by role minus ROLE_THARGOID.

encounter_fixed:

	dc.w thargoid,viper,ferdelance


; Groups a random encounter may place, from section 4.3 of the design. Each row
; is a weight, the lowest government it may appear under, then role and maximum
; count pairs ended by a zero byte. The actual count is RAND(max)+1, which is 1
; for a maximum of 1, so a fixed member and a variable one follow one rule.

encounter_groups:

	dc.b 1,0,role_thargoid,1,role_pirate,2,0
	dc.b 1,0,role_thargoid,1,role_trader,2,0
	dc.b 4,0,role_pirate,2,role_trader,2,0
	dc.b 3,2,role_pirate,2,role_viper,2,0
	dc.b 3,1,role_pirate,2,role_viper,1,0
	dc.b 2,0,role_pirate,2,role_bounty,1,0
	dc.b 2,0,role_pirate,2,role_bounty,1,role_trader,1,0
	dc.b 2,0,role_convoy,2,0
	dc.b 0 ; end of the table

	even


; ***********************************************
; **										   **
; ** ENCOUNTER_SKIP - STEP TO THE NEXT TEMPLATE **
; **										   **
; ***********************************************

; Entry: A0 = ptr: a row of ENCOUNTER_GROUPS
; Exit:  A0 = ptr: the row after it

; Regs: A0 corrupt.

	q_subr encounter_skip

	addq.l #2,a0 ; past the weight and the government
.pairs:
	tst.b (a0)
	beq.s .done
	addq.l #2,a0
	bra.s .pairs
.done:
	addq.l #1,a0 ; past the terminator
	rts


; ********************************************************
; **													**
; ** ENCOUNTER_TEMPLATE - CHOOSE A GROUP FOR THE SYSTEM **
; **													**
; ********************************************************

; Picks one row by weight, ignoring every row the system's government forbids.
; Two passes: the first totals the weights allowed here, the second walks again
; and stops where the roll runs out. The total is never zero, because six of
; the eight rows carry no government condition.

; Entry: None
; Exit:  A0 = ptr: the chosen row's first role/count pair

; Regs: D0, D1, D2, A0 corrupt.
; Subr: RAND, ENCOUNTER_SKIP

	q_subr encounter_template,global

	move splanet+govern(a6),d1 ; the system the player is in
	moveq #0,d2 ; weight available here
	lea encounter_groups(pc),a0
.total:
	moveq #0,d0
	move.b (a0),d0 ; this row's weight
	beq.s .roll ; end of the table
	cmp.b 1(a0),d1 ; government high enough for it ?
	blo.s .total_next
	add d0,d2
.total_next:
	bsr encounter_skip
	bra.s .total
.roll:
	jsr rand ; 0..D2-1
	move d0,d2 ; the roll
	move splanet+govern(a6),d1 ; RAND uses D1: restore the filter for the second pass
	lea encounter_groups(pc),a0
.pick:
	moveq #0,d0
	move.b (a0),d0
	cmp.b 1(a0),d1 ; a row this government forbids spends no weight
	blo.s .pick_next
	sub d0,d2
	bmi.s .chosen
.pick_next:
	bsr encounter_skip
	bra.s .pick
.chosen:
	addq.l #2,a0 ; past the weight and the government
	rts


; **************************************************
; **											  **
; ** ENCOUNTER_PLACE - PUT THE FIRST MEMBER OUT   **
; **											  **
; **************************************************

; Keep the leader's nominal radius below RADAR_RANGE by 2048 units. This
; covers a follower's 1000-unit stored-axis offset (including fixed-point
; normalization), ORBIT's rounded trig values, and a small safety margin.
; All members start inside scanner range before their first cruise update.
; ORBIT computes z = r*sin(a)*cos(b); mirror ZPOS to put the group ahead and
; point its heading back at the player so peaceful ships initially approach.

; Entry: A4 = ptr: the first member
; Exit:  None

; Regs: D0, D1, D2, A0 corrupt.
; Subr: RAND, ORBIT, VECTOR_POS

	q_subr encounter_place

	move #encounter_range,d2 ; nominal radius 16384..22527, leaving room for followers
	jsr rand
	add #rand_limit,d0
	ext.l d0
	move #360,d1
	jsr orbit
	tst.l zpos(a4) ; did it land behind him ?
	bpl.s .ahead
	neg.l zpos(a4) ; mirror it in front
.ahead:
	jmp vector_pos ; point it at him and return


; ****************************************************
; **												**
; ** ENCOUNTER_OFFSET - STEP A FOLLOWER ASIDE		**
; **												**
; ****************************************************

; Moves a copied member one step along the first member's own axes, in the
; manner of PIRATE_ATTACK's squadron. Four seats cover any group this design
; can build.

; Entry: A4 = ptr: a follower holding the first member's position and vectors
; Exit:  None

; Regs: D0, D1, D6, A0, A1, A2 corrupt.

	q_subr encounter_offset

	move encounter_seat(a6),d0
	addq #1,encounter_seat(a6)
	and #3,d0 ; four seats, wrapping
	asl #2,d0
	lea encounter_positions(pc),a0
	move (a0,d0),d1 ; A1 = ptr: the vector to step along
	lea (a4,d1.w),a1
	move 2(a0,d0),d0 ; the spacing
	lea xpos(a4),a2 ; A2 = ptr: the coordinates
	q_loop 1,d6,3
	move (a1)+,d1
	muls d0,d1
	asl.l #2,d1
	swap d1
	ext.l d1
	add.l d1,(a2)+
	q_next 1,d6
	rts


; Where a follower sits relative to the first member.

encounter_positions:

	dc.w x_vector,+spacing2
	dc.w x_vector,-spacing2
	dc.w y_vector,+spacing2
	dc.w y_vector,-spacing2


; ****************************************************
; **												**
; ** ENCOUNTER_MEMBER - CREATE ONE SHIP OF A GROUP	**
; **												**
; ****************************************************

; Entry: ENCOUNTER_ROLE = the role to place
; Exit:  IF a member was created THEN carry set ELSE carry clear

; Regs: D0, D1, D2, D6, A0, A1, A2, A4, A5 corrupt.
; Subr: ALLOC_OBJECT, ENCOUNTER_PLACE, COPY_OBJECT, ENCOUNTER_OFFSET,
;		ENCOUNTER_TYPE, CREATE_OBJECT

	q_subr encounter_member

	jsr alloc_object ; a record for it
	bcc .none ; none left
	tst.l encounter_lead(a6) ; is this the first of the group ?
	bne.s .follower
	move.l a4,encounter_lead(a6)
	bsr encounter_place
	bra.s .build
.follower:
	move.l encounter_lead(a6),a5 ; its position and vectors
	jsr copy_object
	bsr encounter_offset
.build:
	move encounter_role(a6),d0
	bsr encounter_type
	move d0,type(a4)
	move.b #1,flags(a4) ; in use
	move #log_cruise,logic(a4) ; nobody here is attacking the player
	move.l #no_target,target(a4) ; RETARGET gives it one of its own
	st velocity(a4) ; CREATE_OBJECT raises it to VEL_MAX
	jsr create_object
	cmp #viper,type(a4)
	bne.s .convoy
	move #-2,patrol_record(a4) ; inspect on its first eligible retarget turn
.convoy:
	cmp #role_convoy,encounter_role(a6)
	bne.s .created
; The convoy has at most two members. Match both to the slower model without
; changing VEL_MAX; each ship regains normal performance when it enters combat.
	move.l encounter_lead(a6),a5
	move velocity(a4),d0
	cmp velocity(a5),d0
	bls.s .speed
	move velocity(a5),d0
.speed:
	move d0,velocity(a4)
	move d0,convoy_speed(a4)
	move d0,velocity(a5)
	move d0,convoy_speed(a5)
.created:
	ori #1,ccr ; created
	rts
.none:
	andi #$fe,ccr ; the pool is empty
	rts


; ****************************************************
; **												**
; ** RANDOM_ENCOUNTER - A BATTLE OR TRADER CONVOY	**
; **												**
; ****************************************************

; Places a small battle or peaceful trader convoy in front of the player,
; with room for the whole formation inside scanner range. Nothing is announced.
; RETARGET starts a mixed group's fight through the existing faction rules;
; traders do not attack each other.
; Convoy members keep their common heading and speed until combat intervenes.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ENCOUNTER_TEMPLATE, ENCOUNTER_MEMBER, RAND

	q_subr random_encounter,global

	bsr encounter_template ; A0 = the chosen row's first pair
	move.l a0,encounter_row(a6)
	clr.l encounter_lead(a6) ; no first member yet
	clr encounter_seat(a6)
.roles:
	move.l encounter_row(a6),a0
	moveq #0,d0
	move.b (a0),d0 ; the role, zero ends the row
	beq.s .done
	move d0,encounter_role(a6)
	moveq #0,d2
	move.b 1(a0),d2 ; how many of it at most
	addq.l #2,a0
	move.l a0,encounter_row(a6)
	jsr rand ; 0..max-1
	q_inc d0 ; 1..max
	move d0,encounter_left(a6)
.one:
	bsr encounter_member
	bcc.s .done ; the pool is empty; the group ends here
	q_dec encounter_left(a6)
	bne.s .one
	bra.s .roles
.done:
	rts


; ********************************************
; **										**
; ** CHECK_POLICE - CHECK FOR POLICE ATTACK **
; **										**
; ********************************************

; Checks if the police need to attack the player when entering space station
; space. This depends upon his police record.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr check_police,global

	bsr police_response
	tst d0
	beq.s .clean
	st police_hunt(a6) ; his own police record brought them out
	bra prepare_vipers
.clean:
	q_ret


; Shared station/patrol decision: clean players never consume a random roll.
; D0 = 1 for an arrest, 0 otherwise. D1/D2 corrupt; no launch state changed.

	q_subr police_response,global

	move police_record(a6),d0 ; any record ?
	q_ret eq ; no, return
	lsr #2,d0 ; probability of attack =
	move splanet+govern(a6),d2 ; record/4+govern*16
	asl #4,d2
	add d0,d2
	jsr random ; within probability range ?
	cmp d2,d0
	slo d0
	and #1,d0
	q_ret


; Encounter patrols get one decision on first contact and on each changed
; police record, not a fresh roll every frame. ANGRY has the same meaning as
; for a station arrest: add the player as a candidate, never lock the target.
; Ships already provoked or sent to arrest him keep their existing pursuit.
; CREATE_OBJECT disables this field for every other spawn, including station
; launches, even when a record was copied or recycled from an encounter.
; Entry: A5 = hunter. D0/D1/D2 corrupt.

	q_subr check_patrol_record,global

	cmp #viper,type(a5)
	bne.s .done
	cmp #-1,patrol_record(a5)
	beq.s .done
	btst #angry,flags(a5)
	bne.s .done
	cmp.l #radar_range,obj_range(a5)
	bhi.s .done
	move police_record(a6),d0
	cmp patrol_record(a5),d0
	beq.s .done
	move d0,patrol_record(a5)
	bsr police_response
	tst d0
	beq.s .done
	bset #angry,flags(a5)
.done:
	q_ret


; **************************************
; **								  **
; ** LAUNCH_BOMB - LAUNCH ENERGY BOMB **
; **								  **
; **************************************

; Launches the energy bomb (if fitted) which instantly destroys all objects
; (excepts suns, planets, space station and thargoids). It may only be used
; once.

; Entry: None
; Exit:  None

; Regs: ?
; Subr: ?

	q_subr launch_bomb,global

	jsr check_inflight ; check if inflight
	tst equip+energy_bomb(a6) ; do we have an energy bomb
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_161
	lea text20(pc),a0 ; print error message
	jsr disp_message
	bra beep
q_combat_m68_161:
	lea objects(a6),a4 ; assume all objects
	moveq #max_objects-1,d7
	tst witch_space(a6) ; witch space ?
; Quelo: 	if <eq> then.s						no
	bne.s q_combat_m68_163
	add.l #obj_len*3,a4 ; skip 1st three objects
	subq #3,d7
q_combat_m68_163:
	clr exploded(a6) ; nothing exploded yet
	st bomb_active(a6)
	q_loop 1 ; loop for each object
	btst #in_use,flags(a4) ; in use ?
; Quelo: 		if <ne> then.s					yes
	beq.s q_combat_m68_165
	move type(a4),d0 ; thargoid ?
	cmp #thargoid,d0
	beq ignore_bomb ; yes
	cmp #platlet,d0 ; platlet ?
	beq ignore_bomb ; yes
	cmp #constr,d0 ; constrictor ?
	beq ignore_bomb ; yes
	cmp #cougar,d0 ; cougar ?
	beq ignore_bomb
	q_push d7 ; destroy object
	bset #no_bounty,flags(a4)
	bsr explode_object
	q_pop d7

ignore_bomb:

q_combat_m68_165:
	lea obj_len(a4),a4 ; next object
	q_next 1
	clr bomb_active(a6)
	tst exploded(a6) ; anything exploded ?
; Quelo: 	if <ne> then.s						yes
	beq.s q_combat_m68_167
	clr equip+energy_bomb(a6) ; only use once
	q_sfx bomb ; one energy-bomb effect, only after a successful blast
	bra.s q_combat_m68_168
q_combat_m68_167:
	bsr beep ; beep (nothing to destroy)
q_combat_m68_168:

	q_ret return


; ---- LOCAL DATA ----

; Rating bands for score.

rating_bands:

	dc.l $800,$1000,$2000,$4000,$8000,$20000,$a0000,$190000

; List of colours for platlets.

platlet_colours:

	dc 8,3,47,27,6,25,9

no_colours: equ (*-platlet_colours)/2

; List of positions for pirates around the squadron leader.

squadron_positions:

	dc.w x_vector,+spacing1
	dc.w x_vector,-spacing1
	dc.w y_vector,+spacing1
	dc.w y_vector,-spacing1

; Missile launch data.

missile_data:

	dc.l 0,-40,50
	dc.w unit,0,0
	dc.w 0,unit,0
	dc.w 0,0,unit

; Text strings.

text1: dc.b 'Target lost',0
text2: dc.b 'Condition RED!',0
text5: dc.b 'Right on Commander',0
text6: dc.b 'Missile Jammed!',0
text7: dc.b 'Incoming missile',0
text12: dc.b 'Cargo lost',0
text13: dc.b ' lost',0
text14: dc.b 'ECM Not Installed',0
text15: dc.b 'ECM Jammed',0
text16: dc.b 'Missile Already Targetted',0
text17: dc.b 'No Missiles Left!',0
text18: dc.b 'Missile Not Targetted',0
text19: dc.b 'Missile Not Locked',0
text20: dc.b 'Energy Bomb Not Installed',0
